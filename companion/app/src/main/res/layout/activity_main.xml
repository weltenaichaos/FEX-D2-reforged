<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFC7B377"
        android:textSize="15sp"
        android:text="Not capturing" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button android:id="@+id/btnCapture" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Start capture" />
        <Button android:id="@+id/btnRead" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Read now" />
        <Button android:id="@+id/btnReadDelay" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Read in 3 s" />
        <Button android:id="@+id/btnSave" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Save shot" />
    </LinearLayout>

    <TextView
        android:id="@+id/runStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFE0C060"
        android:textSize="16sp"
        android:text="Run counter starts with Watch for drops" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnRunPlus" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="+1 run" />
        <Button android:id="@+id/btnRunMinus" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="-1 run" />
        <Button android:id="@+id/btnGap" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Run gap 15 s" />
        <Button android:id="@+id/btnUndo" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Undo last drop" />
        <Button android:id="@+id/btnHistory" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Drop history" />
    </LinearLayout>

    <Switch
        android:id="@+id/swAuto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFDDDDDD"
        android:text="Watch for drops: blue, yellow, set, unique, runes (every 2 s)" />

    <ImageView
        android:id="@+id/shot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFDDDDDD"
            android:textSize="14sp"
            android:fontFamily="monospace" />
    </ScrollView>
</LinearLayout>
