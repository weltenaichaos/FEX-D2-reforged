diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
index 74a0c93..764ed04 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -1116,6 +1116,180 @@ NTSTATUS WINAPI NtReleaseSemaphore( HANDLE handle, ULONG count, ULONG *previous
 }
 
 
+/* d2r (fex-d2-reforged, patch 0008): reuse of anonymous events.
+ * Some code makes an unnamed event and closes it again right away, over and over (D2R's
+ * protection thread: ~1,500 a second, never waited on), and every pair costs two
+ * wineserver round trips. An event that NtCreateEvent made without name, root directory,
+ * security descriptor or inherit flag, with EVENT_ALL_ACCESS, is noted as fresh. If the
+ * thread that made it closes it within D2R_EV_LIFE_NS, and nothing else can hold a
+ * reference to it (it was not duplicated, not given to an I/O call or socket event select,
+ * not waited on by another thread), NtClose keeps it open in a small pool instead. The next
+ * such NtCreateEvent of the same type takes it back and sets its state with NtSetEvent or
+ * NtResetEvent (no server call once the inproc sync fd is cached). WINE_D2R_EVENT_REUSE=0
+ * turns it off. */
+#define D2R_EV_SLOTS   256                /* fresh events, by handle value */
+#define D2R_EV_POOL    16                 /* kept events per type */
+#define D2R_EV_LIFE_NS (10 * 1000000)
+
+struct d2r_ev_slot
+{
+    HANDLE  handle;   /* 0 when free */
+    DWORD   tid;      /* thread that made it */
+    BOOL    manual;
+    ULONG64 born_ns;
+};
+
+static struct d2r_ev_slot d2r_ev_slots[D2R_EV_SLOTS];  /* all of this guarded by d2r_ev_mutex */
+static HANDLE d2r_ev_pool[2][D2R_EV_POOL];             /* [manual reset] */
+static unsigned int d2r_ev_pooled[2];
+static pthread_mutex_t d2r_ev_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static inline ULONG64 d2r_ev_now(void)
+{
+    struct timespec ts;
+
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return ts.tv_sec * (ULONG64)1000000000 + ts.tv_nsec;
+}
+
+static inline DWORD d2r_ev_tid(void)
+{
+    return HandleToULong( NtCurrentTeb()->ClientId.UniqueThread );
+}
+
+static inline struct d2r_ev_slot *d2r_ev_slot( HANDLE handle )
+{
+    return &d2r_ev_slots[((ULONG_PTR)handle >> 2) % D2R_EV_SLOTS];
+}
+
+/* counters in __wine_d2r_server_calls */
+enum d2r_ev_counter { D2R_EV_KEPT, D2R_EV_REUSED, D2R_EV_SHARED, D2R_EV_OTHER_THREAD, D2R_EV_TOO_OLD, D2R_EV_POOL_FULL };
+
+static inline void d2r_ev_count( enum d2r_ev_counter which )
+{
+    struct d2r_server_calls *calls = d2r_server_calls;
+
+    if (calls) __atomic_fetch_add( &calls->ev_kept + which, 1, __ATOMIC_RELAXED );
+}
+
+static BOOL d2r_ev_on(void)
+{
+    static int on = -1;
+
+    if (on < 0)
+    {
+        const char *env = getenv( "WINE_D2R_EVENT_REUSE" );
+
+        if (env && env[0] == '0')
+        {
+            ERR( "d2r: anonymous events are closed as in stock Wine (WINE_D2R_EVENT_REUSE=0).\n" );
+            on = 0;
+        }
+        else on = 1;
+    }
+    return on;
+}
+
+/* may an event made with these arguments come from the pool or go back to it? */
+static BOOL d2r_ev_plain( ACCESS_MASK access, const OBJECT_ATTRIBUTES *attr )
+{
+    if (access != EVENT_ALL_ACCESS) return FALSE;
+    if (attr && ((attr->ObjectName && attr->ObjectName->Length) || attr->RootDirectory ||
+                 attr->SecurityDescriptor || attr->SecurityQualityOfService ||
+                 (attr->Attributes & ~(OBJ_CASE_INSENSITIVE | OBJ_OPENIF))))
+        return FALSE;
+    return d2r_ev_on();
+}
+
+static void d2r_ev_note( HANDLE handle, BOOL manual )
+{
+    struct d2r_ev_slot *slot = d2r_ev_slot( handle );
+    sigset_t sigset;
+
+    server_enter_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    slot->tid = d2r_ev_tid();
+    slot->manual = manual;
+    slot->born_ns = d2r_ev_now();
+    __atomic_store_n( &slot->handle, handle, __ATOMIC_RELAXED );
+    server_leave_uninterrupted_section( &d2r_ev_mutex, &sigset );
+}
+
+static HANDLE d2r_ev_take( BOOL manual )
+{
+    HANDLE handle = 0;
+    sigset_t sigset;
+
+    if (!__atomic_load_n( &d2r_ev_pooled[manual], __ATOMIC_RELAXED )) return 0;
+    server_enter_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    if (d2r_ev_pooled[manual]) handle = d2r_ev_pool[manual][--d2r_ev_pooled[manual]];
+    server_leave_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    return handle;
+}
+
+/* the handle goes somewhere that may keep a reference to its object (wait: only a wait by
+ * another thread than the maker counts), so a fresh event behind it is never reused */
+void d2r_event_shared( HANDLE handle, BOOL wait )
+{
+    struct d2r_ev_slot *slot = d2r_ev_slot( handle );
+    sigset_t sigset;
+
+    if (!handle || __atomic_load_n( &slot->handle, __ATOMIC_RELAXED ) != handle) return;
+    server_enter_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    if (slot->handle == handle && (!wait || slot->tid != d2r_ev_tid()))
+    {
+        __atomic_store_n( &slot->handle, 0, __ATOMIC_RELAXED );
+        d2r_ev_count( D2R_EV_SHARED );
+    }
+    server_leave_uninterrupted_section( &d2r_ev_mutex, &sigset );
+}
+
+/* NtClose: TRUE when the handle is a fresh event that stays open in the pool */
+BOOL d2r_event_keep( HANDLE handle )
+{
+    struct d2r_ev_slot *slot = d2r_ev_slot( handle );
+    int counter = -1;
+    unsigned int i, m;
+    BOOL kept = FALSE;
+    sigset_t sigset;
+
+    if (!handle) return FALSE;
+    if (__atomic_load_n( &slot->handle, __ATOMIC_RELAXED ) != handle &&
+        !__atomic_load_n( &d2r_ev_pooled[0], __ATOMIC_RELAXED ) &&
+        !__atomic_load_n( &d2r_ev_pooled[1], __ATOMIC_RELAXED ))
+        return FALSE;
+
+    server_enter_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    if (slot->handle == handle)
+    {
+        __atomic_store_n( &slot->handle, 0, __ATOMIC_RELAXED );
+        if (slot->tid != d2r_ev_tid()) counter = D2R_EV_OTHER_THREAD;
+        else if (d2r_ev_now() - slot->born_ns >= D2R_EV_LIFE_NS) counter = D2R_EV_TOO_OLD;
+        else if (d2r_ev_pooled[slot->manual] >= D2R_EV_POOL) counter = D2R_EV_POOL_FULL;
+        else
+        {
+            d2r_ev_pool[slot->manual][d2r_ev_pooled[slot->manual]++] = handle;
+            counter = D2R_EV_KEPT;
+            kept = TRUE;
+        }
+    }
+    else
+    {
+        /* a handle already in the pool closed again (a double close): it really goes now,
+         * so the pool never hands out a handle the server may give to another object */
+        for (m = 0; m < 2; m++)
+            for (i = 0; i < d2r_ev_pooled[m]; i++)
+                if (d2r_ev_pool[m][i] == handle)
+                {
+                    d2r_ev_pool[m][i] = d2r_ev_pool[m][--d2r_ev_pooled[m]];
+                    break;
+                }
+    }
+    server_leave_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    if (counter >= 0) d2r_ev_count( counter );
+    return kept;
+}
+
+
