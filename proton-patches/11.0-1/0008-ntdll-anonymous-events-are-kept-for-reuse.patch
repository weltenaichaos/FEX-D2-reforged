     if ((ret = alloc_object_attributes( attr, &objattr, &len ))) return ret;
 
     SERVER_START_REQ( create_event )
@@ -1145,6 +1335,7 @@ NTSTATUS WINAPI NtCreateEvent( HANDLE *handle, ACCESS_MASK access, const OBJECT_
     SERVER_END_REQ;
 
     free( objattr );
+    if (!ret && plain) d2r_ev_note( *handle, type == NotificationEvent );
     return ret;
 }
 
