+static inline ULONG64 d2r_call_now(void)
+{
+    struct timespec ts;
+
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return ts.tv_sec * (ULONG64)1000000000 + ts.tv_nsec;
