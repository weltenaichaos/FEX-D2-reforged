  *              NtCreateEvent (NTDLL.@)
  */
@@ -1125,12 +1299,28 @@ NTSTATUS WINAPI NtCreateEvent( HANDLE *handle, ACCESS_MASK access, const OBJECT_
     unsigned int ret;
     data_size_t len;
     struct object_attributes *objattr;
+    BOOL plain;
 
     TRACE( "access %#x, name %s, type %u, state %u\n", access,
            attr ? debugstr_us(attr->ObjectName) : "(null)", type, state );
 
     *handle = 0;
     if (type != NotificationEvent && type != SynchronizationEvent) return STATUS_INVALID_PARAMETER;
+
+    /* d2r (patch 0008): take a kept anonymous event back */
+    if ((plain = d2r_ev_plain( access, attr )) && (*handle = d2r_ev_take( type == NotificationEvent )))
+    {
+        if (!(ret = state ? NtSetEvent( *handle, NULL ) : NtResetEvent( *handle, NULL )))
+        {
+            d2r_ev_note( *handle, type == NotificationEvent );
+            d2r_ev_count( D2R_EV_REUSED );
