diff --git a/dlls/ntdll/exception.c b/dlls/ntdll/exception.c
index 3b524d0..8dc7e41 100644
--- a/dlls/ntdll/exception.c
+++ b/dlls/ntdll/exception.c
@@ -191,6 +191,30 @@ static LONG call_vectored_handlers( EXCEPTION_RECORD *rec, CONTEXT *context )
 }
 
 
+/*******************************************************************
+ *		__wine_d2r_exception_watchers
+ *
+ * d2r (fex-d2-reforged, patch 0015): who could see an exception the calling thread raises
+ * now, other than the frame handlers between the raiser and its own __EXCEPT:
+ * 1 a debugger (PEB BeingDebugged; without it no debug event is sent), 2 a vectored
+ * exception handler (they run before any frame handler), 4 on ARM64EC a patched
+ * KiUserExceptionDispatcher or a wow64 hook (x64 code then runs for every exception).
+ * 0 = nobody. kernelbase's OutputDebugString uses it to leave out the two exceptions only
+ * its own __EXCEPT would catch.
+ */
+ULONG CDECL __wine_d2r_exception_watchers(void)
+{
+    ULONG ret = 0;
+
+    if (NtCurrentTeb()->Peb->BeingDebugged) ret |= 1;
+    if (*(LIST_ENTRY * volatile *)&vectored_exception_handlers.Flink != &vectored_exception_handlers) ret |= 2;
+#ifdef __arm64ec__
+    if (d2r_x64_dispatcher_hooked()) ret |= 4;
+#endif
+    return ret;
+}
+
+
 /*******************************************************************
  *		dispatch_exception
  */
