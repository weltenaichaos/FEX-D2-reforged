diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 04e4a10..af14502 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -7318,6 +7318,75 @@ NTSTATUS WINAPI NtFlushBuffersFile( HANDLE handle, IO_STATUS_BLOCK *io )
 }
 
 
+/* d2r (fex-d2-reforged, patch 0015): NtFlushBuffersFile(Ex) count and time per thread and the
+ * latest 8 calls in __wine_d2r_server_calls_ext for FEX. In b162 D2R's Battle.net SDK thread
+ * (BGS_Thread) was in FlushFileBuffers while the main thread waited in an SRW lock; these
+ * notes say how long its fsyncs take. On with the request counts (WINE_D2R_CALL_COUNTS). */
+static inline ULONG64 d2r_flush_now(void)
+{
+    struct timespec ts;
+
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return ts.tv_sec * (ULONG64)1000000000 + ts.tv_nsec;
+}
+
+static inline void d2r_flush_max( ULONG64 *max, ULONG64 ns )
+{
+    ULONG64 cur = __atomic_load_n( max, __ATOMIC_RELAXED );
+
+    while (ns > cur && !__atomic_compare_exchange_n( max, &cur, ns, TRUE, __ATOMIC_RELAXED, __ATOMIC_RELAXED )) ;
+}
+
+static void DECLSPEC_NOINLINE d2r_flush_note( ULONG64 start_ns, NTSTATUS status, ULONG kind )
+{
+    struct d2r_server_calls_ext *ext = d2r_server_calls_ext;
+    ULONG tid = HandleToULong( NtCurrentTeb()->ClientId.UniqueThread );
+    ULONG64 end_ns = d2r_flush_now(), ns = end_ns - start_ns, n;
+    struct d2r_flush_note *note;
+    unsigned int i;
+    ULONG seq;
+
+    __atomic_fetch_add( &ext->flush_calls, 1, __ATOMIC_RELAXED );
+    __atomic_fetch_add( &ext->flush_ns, ns, __ATOMIC_RELAXED );
+    d2r_flush_max( &ext->flush_max_ns, ns );
+    for (i = 0; i < ARRAY_SIZE(ext->flush_tid); i++)
+    {
+        struct d2r_flush_tid *t = &ext->flush_tid[i];
+        ULONG cur = __atomic_load_n( &t->tid, __ATOMIC_ACQUIRE );
+
+        /* a free slot: take it for this thread, unless another thread just did */
+        if (!cur && __atomic_compare_exchange_n( &t->tid, &cur, tid, FALSE, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE ))
+            cur = tid;
+        if (cur != tid) continue;
+        __atomic_fetch_add( &t->count, 1, __ATOMIC_RELAXED );
+        __atomic_fetch_add( &t->ns, ns, __ATOMIC_RELAXED );
+        d2r_flush_max( &t->max_ns, ns );
+        __atomic_store_n( &t->last_end_ns, end_ns, __ATOMIC_RELAXED );
+        break;
+    }
+    if (i == ARRAY_SIZE(ext->flush_tid))
+    {
+        __atomic_fetch_add( &ext->flush_other_calls, 1, __ATOMIC_RELAXED );
+        __atomic_fetch_add( &ext->flush_other_ns, ns, __ATOMIC_RELAXED );
+    }
+
+    n = __atomic_fetch_add( &ext->flush_next, 1, __ATOMIC_RELAXED );
+    note = &ext->flush[n % ARRAY_SIZE(ext->flush)];
+    seq = __atomic_load_n( &note->seq, __ATOMIC_RELAXED );
+    /* another thread writing this note: leave it to that one */
+    if ((seq & 1) || !__atomic_compare_exchange_n( &note->seq, &seq, seq + 1, FALSE,
+                                                    __ATOMIC_RELAXED, __ATOMIC_RELAXED ))
+        return;
+    __atomic_thread_fence( __ATOMIC_RELEASE );
+    note->tid      = tid;
+    note->status   = status;
+    note->kind     = kind;
+    note->start_ns = start_ns;
+    note->ns       = ns;
+    __atomic_store_n( &note->seq, seq + 2, __ATOMIC_RELEASE );
+}
+
+
 /******************************************************************************
  *              NtFlushBuffersFileEx   (NTDLL.@)
  */
@@ -7327,6 +7396,8 @@ NTSTATUS WINAPI NtFlushBuffersFileEx( HANDLE handle, ULONG flags, void *params,
     HANDLE wait_handle;
     enum server_fd_type type;
     int fd, needs_close;
+    ULONG64 d2r_start = d2r_server_calls_ext ? d2r_flush_now() : 0;  /* patch 0015 */
+    ULONG d2r_kind = 0;
 
     TRACE( "(%p,0x%08x,%p,0x%08x,%p)\n", handle, flags, params, size, io );
 
@@ -7341,20 +7412,26 @@ NTSTATUS WINAPI NtFlushBuffersFileEx( HANDLE handle, ULONG flags, void *params,
 
     if (!ret && (type == FD_TYPE_FILE || type == FD_TYPE_DIR || type == FD_TYPE_CHAR))
     {
+        d2r_kind = 1;
         if (fsync(fd)) ret = errno_to_status( errno );
         io->Status      = ret;
         io->Information = 0;
     }
     else if (!ret && type == FD_TYPE_SERIAL)
     {
+        d2r_kind = 3;
         ret = serial_FlushBuffersFile( fd );
     }
     else if (ret != STATUS_ACCESS_DENIED)
     {
         struct async_irp *async;
 
+        d2r_kind = 2;
         if (!(async = (struct async_irp *)alloc_fileio( sizeof(*async), irp_completion, handle )))
+        {
+            if (d2r_start) d2r_flush_note( d2r_start, STATUS_NO_MEMORY, d2r_kind );
             return STATUS_NO_MEMORY;
+        }
