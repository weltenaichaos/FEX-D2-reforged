 #define D2R_SERVER_CALLS_EXT_U64 272  /* size of __wine_d2r_server_calls_ext in ULONG64 */
+
+/* d2r (patch 0011): this process's thread table, written by the wineserver whenever a
+ * thread's id, Linux tid, TEB, priority, base priority, affinity or name changes (layout in
+ * server/thread.c, struct d2r_thread_table, version 1), mapped read-only. Where it is goes
+ * into PE ntdll's export __wine_d2r_threads (8 ULONG64) for FEX's helpers, so they don't
+ * have to ask the server about every thread. Off with WINE_D2R_THREAD_TABLE=0. */
+struct d2r_threads_info
+{
+    ULONG   version;          /* 1 once table is mapped (written last) */
+    ULONG   size;             /* bytes mapped at table */
+    ULONG64 table;            /* address of the read-only table */
+    ULONG64 system_affinity;  /* get_system_affinity_mask(): AffinityMask = entry affinity & this */
+    ULONG   status;           /* why there is no table (version 0): NTSTATUS or errno | 0xe0000000 */
+    ULONG   pad;
+    ULONG64 reserved[4];
+};
+extern void d2r_threads_init( struct d2r_threads_info *info );
 extern void d2r_event_shared( HANDLE handle, BOOL wait );
 extern BOOL d2r_event_keep( HANDLE handle );
 
