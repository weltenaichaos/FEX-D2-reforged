+        close( fd );
+        return NULL;
+    }
+    /* the process gets a read-only view and must not change the size under the server */
+    fcntl( fd, F_ADD_SEALS, F_SEAL_SHRINK | F_SEAL_GROW );
+    fcntl( fd, F_ADD_SEALS, F_SEAL_FUTURE_WRITE );
