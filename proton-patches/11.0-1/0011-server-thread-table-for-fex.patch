+        close( fd );
+        return NULL;
+    }
+    memset( t, 0, sizeof(*t) );
+    t->map = ptr;
+    t->fd = fd;
+    t->map->header_size = offsetof(struct d2r_thread_table, entry);
+    t->map->entry_size  = sizeof(struct d2r_thread_entry);
+    t->map->max_entries = D2R_THREADS_ENTRIES;
+    t->map->pid         = get_process_id( process );
+    process->d2r_threads = t;
+    LIST_FOR_EACH_ENTRY( thread, &process->thread_list, struct thread, proc_entry )
+        d2r_thread_update( thread );
+    d2r_header_store( &t->map->version, D2R_THREADS_VERSION );
