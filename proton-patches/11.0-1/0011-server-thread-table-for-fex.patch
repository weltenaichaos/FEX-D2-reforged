diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index 9efdac6..4ef4d19 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1080,6 +1080,61 @@ int wine_server_receive_fd( obj_handle_t *handle )
 }
 
 
+/***********************************************************************
+ *           d2r_threads_init
+ *
+ * d2r (patch 0011): map this process's thread table, kept up to date by the wineserver,
+ * for FEX. Called once from load_ntdll_functions, while the process has one thread.
+ */
+C_ASSERT( sizeof(struct d2r_threads_info) == 8 * sizeof(ULONG64) );  /* fits __wine_d2r_threads */
+
+void d2r_threads_init( struct d2r_threads_info *info )
+{
+    obj_handle_t token = 0, expected = 0;
+    unsigned int size = 0, status;
+    sigset_t sigset;
+    void *ptr;
+    int fd = -1;
+
+    server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
+    SERVER_START_REQ( d2r_get_thread_table )
+    {
+        if (!(status = server_call_unlocked( req )))
+        {
+            expected = reply->handle;
+            size = reply->size;
+            fd = wine_server_receive_fd( &token );
+        }
+    }
+    SERVER_END_REQ;
+    server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+
+    if (status) goto failed;
+    if (fd == -1 || token != expected || !size)
+    {
+        status = STATUS_INVALID_HANDLE;
+        goto failed;
+    }
+    ptr = mmap( NULL, size, PROT_READ, MAP_SHARED, fd, 0 );
+    if (ptr == MAP_FAILED)
+    {
+        status = 0xe0000000 | errno;
+        goto failed;
+    }
+    close( fd );
+    info->size = size;
+    info->table = (ULONG_PTR)ptr;
+    info->system_affinity = get_system_affinity_mask();
+    info->status = 0;
+    WriteRelease( (LONG *)&info->version, 1 );
+    return;
+
+failed:
+    if (fd != -1) close( fd );
+    info->status = status;
+}
+
+
 /***********************************************************************/
 /* fd cache support */
 
