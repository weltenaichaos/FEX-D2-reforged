+/* d2r (fex-d2-reforged, patch 0011): thread table for FEX.
+ *
+ * FEX's helpers (priority guard, thread placer, stats log, stall probe) asked the server
+ * about every thread of the process each round: get_next_thread, get_thread_info,
+ * get_thread_times and close_handle, about 300 requests a second in b159.  The server now
+ * writes what NtQueryInformationThread would return for each thread of a process into a
+ * table that the process maps read-only, every time one of those values changes.  The
+ * table is made on the process's first d2r_get_thread_table request; until then, and in
+ * processes that never ask, nothing changes.
+ *
+ * Each entry is written under a sequence lock: seq is odd while the entry changes and
+ * goes up by 2 with every write.  A reader copies the entry and keeps the copy only when
+ * seq was even and the same before and after.  The server only writes to the shared
+ * memory and keeps its own copy of everything it needs, so nothing the process writes
+ * there can change what the server does. */
+
+#ifndef MFD_CLOEXEC
+#define MFD_CLOEXEC 0x0001U
+#endif
+#ifndef MFD_ALLOW_SEALING
+#define MFD_ALLOW_SEALING 0x0002U
+#endif
+#ifndef F_ADD_SEALS
+#define F_ADD_SEALS (1024 + 9)
+#endif
+#ifndef F_SEAL_SHRINK
+#define F_SEAL_SHRINK 0x0002
+#endif
+#ifndef F_SEAL_GROW
+#define F_SEAL_GROW 0x0004
+#endif
+#ifndef F_SEAL_FUTURE_WRITE
+#define F_SEAL_FUTURE_WRITE 0x0010
+#endif
+
+#define D2R_THREADS_VERSION   1
+#define D2R_THREADS_SIZE      65536
+#define D2R_THREADS_ENTRIES   511
+#define D2R_THREAD_NAME       72
+
+/* entry flags */
+#define D2R_THREAD_FIRST          0x01  /* first thread of the process (Priority includes its +1) */
+#define D2R_THREAD_DISABLE_BOOST  0x02  /* priority boost disabled */
+#define D2R_THREAD_DBG_HIDDEN     0x04  /* hidden from the debugger */
+#define D2R_THREAD_NAME_INEXACT   0x08  /* name cut or a character replaced by '?' */
+
+struct d2r_thread_entry               /* 128 bytes */
+{
+    unsigned int   seq;               /* odd while being written, +2 per write */
+    unsigned int   tid;               /* thread id (ClientId.UniqueThread), 0 = free entry */
+    int            unix_tid;          /* Linux tid, -1 until the thread runs */
+    int            priority;          /* ThreadBasicInformation.Priority */
+    int            base_priority;     /* ThreadBasicInformation.BasePriority */
+    unsigned int   flags;             /* D2R_THREAD_* */
+    client_ptr_t   teb;               /* ThreadBasicInformation.TebBaseAddress */
+    affinity_t     affinity;          /* the server's affinity; AffinityMask = this & system mask */
+    unsigned int   serial;            /* number of this thread in the table, never reused */
+    unsigned int   name_len;          /* length of the whole name in characters */
+    timeout_t      creation_time;     /* ThreadTimes.CreateTime */
+    char           name[D2R_THREAD_NAME]; /* ThreadNameInformation as ASCII, NUL terminated */
+};
+
+struct d2r_thread_table               /* the shared memory, D2R_THREADS_SIZE bytes */
+{
+    unsigned int   version;           /* D2R_THREADS_VERSION */
+    unsigned int   header_size;       /* 128 */
+    unsigned int   entry_size;        /* 128 */
+    unsigned int   max_entries;       /* D2R_THREADS_ENTRIES */
+    unsigned int   used;              /* entries [0, used) can be in use */
+    unsigned int   count;             /* threads listed now */
+    unsigned int   changes;           /* +1 after every entry write */
+    unsigned int   not_listed;        /* threads not listed now because the table is full */
+    unsigned int   pid;               /* process id */
+    unsigned int   serial;            /* serials handed out so far */
+    unsigned int   reserved[22];
+    struct d2r_thread_entry entry[D2R_THREADS_ENTRIES];
+};
+
+C_ASSERT( sizeof(struct d2r_thread_entry) == 128 );
+C_ASSERT( offsetof(struct d2r_thread_table, entry) == 128 );
+C_ASSERT( sizeof(struct d2r_thread_table) == D2R_THREADS_SIZE );
+
+struct d2r_threads                    /* the server's own state, never read from the shared memory */
+{
+    struct d2r_thread_table *map;
+    int            fd;
+    unsigned int   used;
+    unsigned int   count;
+    unsigned int   changes;
+    unsigned int   not_listed;
+    unsigned int   serial;
+    unsigned int   seq[D2R_THREADS_ENTRIES];
+    unsigned char  taken[D2R_THREADS_ENTRIES];
+};
+
+static void d2r_header_store( unsigned int *field, unsigned int value )
+{
+    __atomic_store_n( field, value, __ATOMIC_RELEASE );
+}
+
+/* write one entry under its sequence lock; thread NULL frees it */
+static void d2r_entry_write( struct d2r_threads *t, unsigned int i, struct thread *thread, unsigned int serial )
+{
+    struct d2r_thread_entry *e = &t->map->entry[i];
+    unsigned int seq = t->seq[i];
+
+    __atomic_store_n( &e->seq, seq + 1, __ATOMIC_RELAXED );
+    __atomic_thread_fence( __ATOMIC_RELEASE );
+    if (thread)
+    {
+        data_size_t j, len = thread->desc_len / sizeof(WCHAR);
+        unsigned int flags = 0;
+
+        if (get_process_first_thread( thread->process ) == thread) flags |= D2R_THREAD_FIRST;
+        if (thread->disable_boost) flags |= D2R_THREAD_DISABLE_BOOST;
+        if (thread->dbg_hidden) flags |= D2R_THREAD_DBG_HIDDEN;
+        if (len > D2R_THREAD_NAME - 1) flags |= D2R_THREAD_NAME_INEXACT;
+        for (j = 0; j < len && j < D2R_THREAD_NAME - 1; j++)
+        {
+            WCHAR c = thread->desc[j];
+            if (c < 0x20 || c > 0x7e)
+            {
+                c = '?';
+                flags |= D2R_THREAD_NAME_INEXACT;
+            }
+            e->name[j] = (char)c;
+        }
+        memset( e->name + j, 0, D2R_THREAD_NAME - j );
+        e->tid           = get_thread_id( thread );
+        e->unix_tid      = thread->unix_tid;
+        e->priority      = get_effective_thread_priority( thread );
+        e->base_priority = thread->base_priority;
+        e->flags         = flags;
+        e->teb           = thread->teb;
+        e->affinity      = thread->affinity;
+        if (serial) e->serial = serial;
+        e->name_len      = len;
+        e->creation_time = thread->creation_time;
+    }
+    else
+    {
+        e->tid           = 0;
+        e->unix_tid      = 0;
+        e->priority      = 0;
+        e->base_priority = 0;
+        e->flags         = 0;
+        e->teb           = 0;
+        e->affinity      = 0;
+        e->serial        = 0;
+        e->name_len      = 0;
+        e->creation_time = 0;
+        memset( e->name, 0, sizeof(e->name) );
+    }
+    t->seq[i] = seq + 2;
+    __atomic_store_n( &e->seq, seq + 2, __ATOMIC_RELEASE );
+    d2r_header_store( &t->map->changes, ++t->changes );
+}
+
+/* the thread is gone from the process: free its entry */
+static void d2r_thread_gone( struct thread *thread )
+{
+    struct d2r_threads *t = thread->process->d2r_threads;
+
+    if (t && thread->d2r_slot > 0)
+    {
+        unsigned int i = thread->d2r_slot - 1;
+        struct thread *other;
+
+        d2r_entry_write( t, i, NULL, 0 );
+        t->taken[i] = 0;
+        d2r_header_store( &t->map->count, --t->count );
+        thread->d2r_slot = 0;
+        /* a thread left out while the table was full gets the free entry */
+        if (t->not_listed)
+            LIST_FOR_EACH_ENTRY( other, &thread->process->thread_list, struct thread, proc_entry )
+                if (other != thread && other->d2r_slot < 0)
+                {
+                    d2r_thread_update( other );
+                    break;
+                }
+    }
+    else if (t && thread->d2r_slot < 0)
+        d2r_header_store( &t->map->not_listed, --t->not_listed );
+    thread->d2r_slot = 0;
+}
+
+/* write the thread's entry again after one of its values changed */
+void d2r_thread_update( struct thread *thread )
+{
+    struct d2r_threads *t = thread->process->d2r_threads;
+    unsigned int i, serial = 0;
+
+    if (!t) return;
+    if (thread->state == TERMINATED || !thread->id)
+    {
+        d2r_thread_gone( thread );
+        return;
+    }
+    if (thread->d2r_slot <= 0)
+    {
+        for (i = 0; i < t->used; i++) if (!t->taken[i]) break;
+        if (i == D2R_THREADS_ENTRIES)
+        {
+            if (!thread->d2r_slot)
+            {
+                thread->d2r_slot = -1;
+                d2r_header_store( &t->map->not_listed, ++t->not_listed );
+            }
+            return;
+        }
+        if (thread->d2r_slot < 0) d2r_header_store( &t->map->not_listed, --t->not_listed );
+        t->taken[i] = 1;
+        thread->d2r_slot = i + 1;
+        serial = ++t->serial;
+        d2r_header_store( &t->map->serial, t->serial );
+        d2r_entry_write( t, i, thread, serial );
+        d2r_header_store( &t->map->count, ++t->count );
+        if (i == t->used) d2r_header_store( &t->map->used, ++t->used );
+        return;
+    }
