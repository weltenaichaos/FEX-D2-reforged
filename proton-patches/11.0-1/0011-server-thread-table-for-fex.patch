+static int d2r_memfd(void)
+{
+#if defined(__linux__) && defined(__NR_memfd_create)
+    return syscall( __NR_memfd_create, "wine-d2r-threads", MFD_CLOEXEC | MFD_ALLOW_SEALING );
+#else
+    errno = ENOSYS;
+    return -1;
+#endif
+}
+
+static struct d2r_threads *d2r_threads_create( struct process *process )
+{
+    struct d2r_threads *t;
+    struct thread *thread;
+    void *ptr;
+    int fd;
+
+    if ((fd = d2r_memfd()) == -1)
+    {
+        set_error( STATUS_NOT_SUPPORTED );
+        return NULL;
+    }
+    if (ftruncate( fd, D2R_THREADS_SIZE ) == -1 ||
+        (ptr = mmap( NULL, D2R_THREADS_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 )) == MAP_FAILED)
+    {
