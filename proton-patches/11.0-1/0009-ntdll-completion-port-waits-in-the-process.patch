diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
index 764ed04..d4c7a82 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -3051,6 +3051,142 @@ NTSTATUS WINAPI NtSetIoCompletionEx( HANDLE completion_handle, HANDLE completion
     return ret;
 }
 
+/* d2r (fex-d2-reforged, patch 0009): completion port waits in the process with esync.
+ * The server keeps a completion port's sync signaled while its queue holds entries; with
+ * esync that sync is an eventfd the process can poll. Stock code checks it in the process
+ * only for zero-timeout calls and only with ntsync, so with esync every
+ * GetQueuedCompletionStatus(Ex) went to the server: remove_completion, and for an empty
+ * queue a select on the thread's completion wait that the server then had to time out
+ * (D2R's AIO threads, b154: ~790 of each a second in calm play). Now the wait for "the
+ * queue has an entry" polls the port's fd in the process (alertable as asked) and
+ * remove_completion is sent only once the port is signaled; a wait that times out costs no
+ * server call. When another thread takes the entry first, the rest of the wait is the
+ * stock one (on the thread's completion wait in the server). A port closed during the
+ * wait gives STATUS_ABANDONED_WAIT_0 as in stock Wine. Ports esync can't wait on take the
+ * stock path. WINE_D2R_COMPLETION_WAIT=0 restores the stock path everywhere.
+ * server/completion.c: a server-side waiter that takes the last entry now resets the
+ * port's sync, and remove_completion clears it when it finds the queue empty, so an empty
+ * port no longer stays signaled (it did in stock Wine; nothing in the process waited on it). */
+extern int do_esync(void);
+
+enum d2r_cp_counter { D2R_CP_WOKEN, D2R_CP_TIMED_OUT, D2R_CP_LOST_RACE, D2R_CP_FALLBACK, D2R_CP_EXTRA_SAVED };
+
+static inline void d2r_cp_count( enum d2r_cp_counter which )
+{
+    struct d2r_server_calls_ext *ext = d2r_server_calls_ext;
+
+    if (ext) __atomic_fetch_add( &ext->cp_woken + which, 1, __ATOMIC_RELAXED );
+}
+
+static BOOL d2r_cp_on(void)
+{
+    static int on = -1;
+
+    if (on < 0)
+    {
+        const char *env = getenv( "WINE_D2R_COMPLETION_WAIT" );
+
+        if (!do_esync()) on = 0;
+        else if (env && env[0] == '0')
+        {
+            ERR( "d2r: completion port waits go to the server as in stock Wine (WINE_D2R_COMPLETION_WAIT=0).\n" );
+            on = 0;
+        }
+        else on = 1;
+    }
+    return on;
+}
+
+/* waits in the process until the port holds an entry, then takes up to count entries.
+ * STATUS_NOT_IMPLEMENTED: nothing done, take the stock path. */
+static NTSTATUS d2r_cp_remove( HANDLE handle, FILE_IO_COMPLETION_INFORMATION *info, ULONG count,
+                               ULONG *removed, const LARGE_INTEGER *timeout, BOOLEAN alertable )
+{
+    static const LARGE_INTEGER zero;
+    HANDLE wait_handle = NULL;
+    LARGE_INTEGER end;
+    NTSTATUS status;
+    ULONG i = 0;
+
+    *removed = 0;
+    if (timeout && timeout->QuadPart < 0)
+    {
+        NtQuerySystemTime( &end );
+        end.QuadPart -= timeout->QuadPart;  /* absolute, for the rest of the wait after a lost race */
+    }
+    else if (timeout) end = *timeout;
+
+    status = inproc_wait( 1, &handle, WaitAny, alertable, timeout );
+    if (status == STATUS_TIMEOUT)
+    {
+        d2r_cp_count( D2R_CP_TIMED_OUT );
+        return status;
+    }
+    if (status == STATUS_USER_APC) return status;  /* the APCs ran in the wait */
+    if (status != STATUS_WAIT_0)
+    {
+        d2r_cp_count( D2R_CP_FALLBACK );
+        return STATUS_NOT_IMPLEMENTED;
+    }
+    d2r_cp_count( D2R_CP_WOKEN );
+
+    while (i < count)
+    {
+        SERVER_START_REQ( remove_completion )
+        {
+            req->handle = wine_server_obj_handle( handle );
+            req->alertable = alertable;
+            if (!(status = wine_server_call( req )))
+            {
+                info[i].CompletionKey             = reply->ckey;
+                info[i].CompletionValue           = reply->cvalue;
+                info[i].IoStatusBlock.Information = reply->information;
+                info[i].IoStatusBlock.Status      = reply->status;
+            }
+            else wait_handle = wine_server_ptr_handle( reply->wait_handle );
+        }
+        SERVER_END_REQ;
+        if (status) break;
+        /* stop when the port looks empty instead of asking the server once more */
+        if (++i < count && inproc_wait( 1, &handle, WaitAny, FALSE, &zero ) != STATUS_WAIT_0)
+        {
+            d2r_cp_count( D2R_CP_EXTRA_SAVED );
+            break;
+        }
+    }
+    if (i)
+    {
+        *removed = i;
+        return STATUS_SUCCESS;
+    }
+    if (status == STATUS_USER_APC) return NtDelayExecution( TRUE, NULL );  /* run them, as stock */
+    /* the port was closed while we waited */
+    if (status == STATUS_INVALID_HANDLE) return STATUS_ABANDONED_WAIT_0;
+    if (status != STATUS_PENDING) return status;
+
+    /* another thread took the entry first: the rest of the wait as in stock Wine, on the
+     * thread's completion wait that remove_completion just registered */
+    d2r_cp_count( D2R_CP_LOST_RACE );
+    if (timeout && !timeout->QuadPart) return STATUS_TIMEOUT;
+    status = server_wait_for_object( wait_handle, alertable, timeout ? &end : NULL );
+    if (status != WAIT_OBJECT_0) return status;
+
+    SERVER_START_REQ( get_thread_completion )
+    {
+        if (!(status = wine_server_call( req )))
+        {
+            info[0].CompletionKey             = reply->ckey;
+            info[0].CompletionValue           = reply->cvalue;
+            info[0].IoStatusBlock.Information = reply->information;
+            info[0].IoStatusBlock.Status      = reply->status;
+            *removed = 1;
+        }
+    }
+    SERVER_END_REQ;
+    return status;
+}
+
+
 /***********************************************************************
  *             NtRemoveIoCompletion (NTDLL.@)
  */
@@ -3062,6 +3198,25 @@ NTSTATUS WINAPI NtRemoveIoCompletion( HANDLE handle, ULONG_PTR *key, ULONG_PTR *
 
     TRACE( "(%p, %p, %p, %p, %p)\n", handle, key, value, io, timeout );
 
+    /* d2r (patch 0009): wait in the process with esync */
+    if (d2r_cp_on())
+    {
+        FILE_IO_COMPLETION_INFORMATION entry;
+        ULONG n;
+
+        if ((status = d2r_cp_remove( handle, &entry, 1, &n, timeout, FALSE )) != STATUS_NOT_IMPLEMENTED)
+        {
+            if (!status)
+            {
+                *key            = entry.CompletionKey;
+                *value          = entry.CompletionValue;
+                io->Information = entry.IoStatusBlock.Information;
+                io->Status      = entry.IoStatusBlock.Status;
+            }
+            return status;
+        }
+    }
+
     if (timeout && !timeout->QuadPart && inproc_device_fd >= 0)
     {
         status = NtWaitForSingleObject( handle, FALSE, timeout );
@@ -3117,6 +3272,10 @@ NTSTATUS WINAPI NtRemoveIoCompletionEx( HANDLE handle, FILE_IO_COMPLETION_INFORM
 
     if (!count) return STATUS_INVALID_PARAMETER;
 
+    /* d2r (patch 0009): wait in the process with esync */
+    if (d2r_cp_on() && (status = d2r_cp_remove( handle, info, count, &i, timeout, alertable )) != STATUS_NOT_IMPLEMENTED)
+        goto done;
+
     if (timeout && !timeout->QuadPart && inproc_device_fd >= 0)
     {
         status = NtWaitForSingleObject( handle, alertable, timeout );
diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
index 796de8a..4b96310 100644
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -123,9 +123,10 @@ struct d2r_vm_lock_info
 
 extern struct d2r_vm_lock_info *d2r_vm_lock;
 
-/* d2r (patch 0008): wineserver requests by type (count and time in server_call_unlocked,
- * a select's time includes its wait) and the anonymous event reuse counters, kept in PE
- * ntdll's export __wine_d2r_server_calls for FEX. Version 1 layout. */
+/* d2r (patch 0008): wineserver requests by type (count and time in server_call_unlocked;
+ * a select's time is its request only, the blocking wait comes after the reply) and the
+ * anonymous event reuse counters, kept in PE ntdll's export __wine_d2r_server_calls for
+ * FEX. Version 1 layout (8,256 bytes), unchanged by patch 0009. */
 #define D2R_MAX_REQUESTS 512
 
 struct d2r_server_calls
@@ -144,6 +145,26 @@ struct d2r_server_calls
 };
 
 extern struct d2r_server_calls *d2r_server_calls;
+
+/* d2r (patch 0009): more for FEX in a second export, __wine_d2r_server_calls_ext, so FEX
+ * builds that read version 1 of __wine_d2r_server_calls keep working: the latest caller of
+ * each request type and what the completion port waits in the process did. On with the
+ * request counts (WINE_D2R_CALL_COUNTS). Version 1 layout (2,112 bytes). */
+struct d2r_server_calls_ext
+{
+    ULONG   version;          /* 1 once the unix side writes here */
+    ULONG   nb_requests;      /* REQ_NB_REQUESTS of this build: last_tid[] entries in use */
+    ULONG64 cp_woken;         /* completion port waits in the process that found the port signaled */
+    ULONG64 cp_timed_out;     /* ... that timed out: no server call at all */
+    ULONG64 cp_lost_race;     /* signaled, but no entry left when asked: rest of the wait in the server, as stock */
+    ULONG64 cp_fallback;      /* waits esync can't do in the process: stock server path */
+    ULONG64 cp_extra_saved;   /* GetQueuedCompletionStatusEx batches that stopped without a last empty remove */
+    ULONG64 pad[2];
+    ULONG   last_tid[D2R_MAX_REQUESTS]; /* Windows thread id of the latest caller, by enum request */
+};
+
+extern struct d2r_server_calls_ext *d2r_server_calls_ext;
+#define D2R_SERVER_CALLS_EXT_U64 264  /* size of __wine_d2r_server_calls_ext in ULONG64 */
 extern void d2r_event_shared( HANDLE handle, BOOL wait );
 extern BOOL d2r_event_keep( HANDLE handle );
 
diff --git a/server/completion.c b/server/completion.c
index dbcf4e2..e40d261 100644
--- a/server/completion.c
+++ b/server/completion.c
@@ -150,6 +150,9 @@ static void completion_wait_satisfied( struct object *obj, struct wait_queue_ent
     msg = LIST_ENTRY( msg_entry, struct comp_msg, queue_entry );
     --wait->completion->depth;
     list_remove( &msg->queue_entry );
+    /* d2r (patch 0009): the port's sync must say "queue not empty", as remove_completion keeps
+     * it; left set, waits on the port in the process (ntdll, esync) wake for nothing */
+    if (list_empty( &wait->completion->queue )) reset_sync( wait->completion->sync );
     if (wait->msg) free( wait->msg );
     wait->msg = msg;
 }
@@ -404,6 +407,7 @@ DECL_HANDLER(remove_completion)
     if (!entry)
     {
         reply->wait_handle = current->completion_wait->handle;
+        reset_sync( completion->sync );  /* d2r (patch 0009): queue empty, clear a stale signal */
         set_error( STATUS_PENDING );
     }
     else
