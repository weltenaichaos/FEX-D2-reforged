-DECLSPEC_ALIGN(64) ULONG64 __wine_d2r_server_calls_ext[264];
+DECLSPEC_ALIGN(64) ULONG64 __wine_d2r_server_calls_ext[272];  /* 272 since patch 0010 */
 
 /* WINE_D2R_WAIT_LOCK=0 (read in loader_init): spin until free, as stock Wine does */
 BOOL d2r_wait_lock_spin = FALSE;
