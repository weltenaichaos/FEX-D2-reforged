 }
 
+/* d2r (fex-d2-reforged, patch 0010): reuse of anonymous timers.
+ * D2R's protection thread makes an unnamed timer, sets it, waits until it fires and closes it,
+ * ~93 times a second in play (b157 tid 596): create_timer, set_timer, get_inproc_sync_fd and
+ * close_handle every time. A timer that NtCreateTimer made with an access that can set and
+ * wait (TIMER_MODIFY_STATE and SYNCHRONIZE) and the plain attributes of d2r_ev_plain is noted
+ * in the table of fresh events. NtClose keeps it open in a small pool only when nothing can
+ * still happen to it: closed by the thread that made it within D2R_TM_LIFE_NS; never set with
+ * an APC or a period, never set again before its last setting was seen to fire, and every
+ * setting seen to fire by a wait of that thread; never duplicated, given new handle flags,
+ * cancelled, or set, waited on or queried by another thread. Then no timeout or APC is pending
+ * in the server, a synchronization timer's signal was taken by that wait, and a notification
+ * timer is still signaled. NtCreateTimer of the same type and access takes a kept timer back
+ * (cached inproc sync fd, no server call). The server still holds the old signaled flag and
+ * due time, so the program's first NtSetTimer carries a marker (server/timer.c) that puts the
+ * timer back to a new timer's state before it is set, in the same request. Anything else that
+ * could see the old state first (a wait on a notification timer that fired, NtCancelTimer,
+ * NtQueryTimer, duplication, new handle flags, another thread) sends the marker on its own
+ * first. The server acts on the first marker of each reuse only. WINE_D2R_TIMER_REUSE=0 turns
+ * it off. */
+#define D2R_TM_POOL    16                 /* kept timers per type */
+#define D2R_TM_LIFE_NS (100 * (ULONG64)1000000)
+#define D2R_TM_UNSET   32                 /* reused timers the program hasn't set yet */
+/* set_timer marker: the high half of the argument of a request without APC (an argument the
+ * server never uses then; the same value is in server/timer.c); bits 1-31 hold the reuse number,
+ * bit 0 says "only make it new, don't set it". The server makes a timer new once per reuse
+ * number, so any thread may send the marker, in any order with the program's first setting:
+ * a thread that sees the timer while that setting is on its way still finds it unset */
+#define D2R_TIMER_MARKER 0xd2d2f4e5u
+
+static inline client_ptr_t d2r_tm_marker( unsigned int gen, BOOL only )
+{
+    return ((client_ptr_t)D2R_TIMER_MARKER << 32) | ((client_ptr_t)gen << 1) | (only ? 1 : 0);
+}
+
+struct d2r_tm_kept
+{
+    HANDLE       handle;
+    ACCESS_MASK  access;    /* a reused timer is handed out only for the same access */
+    BOOL         signaled;  /* a notification timer that fired: its sync is still signaled */
+    unsigned int gen;       /* unset list: reuse number */
+};
+
+static struct d2r_tm_kept d2r_tm_pool[2][D2R_TM_POOL];  /* [notification timer], d2r_ev_mutex */
+static unsigned int d2r_tm_pooled[2];
+static struct d2r_tm_kept d2r_tm_unset[D2R_TM_UNSET];   /* d2r_ev_mutex */
+static unsigned int d2r_tm_unsets;
+static unsigned int d2r_tm_gen;                         /* last reuse number (1 to 2^31-1), d2r_ev_mutex */
+
+/* counters in __wine_d2r_server_calls_ext */
+enum d2r_tm_counter { D2R_TM_KEPT, D2R_TM_REUSED, D2R_TM_RESET, D2R_TM_ARMED, D2R_TM_SHARED, D2R_TM_OTHER_THREAD,
+                      D2R_TM_TOO_OLD, D2R_TM_POOL_FULL };
+
+static inline void d2r_tm_count( enum d2r_tm_counter which )
+{
+    struct d2r_server_calls_ext *ext = d2r_server_calls_ext;
+
+    if (ext) __atomic_fetch_add( &ext->tm_kept + which, 1, __ATOMIC_RELAXED );
+}
+
+static BOOL d2r_tm_on(void)
+{
+    static int on = -1;
+
+    if (on < 0)
+    {
+        const char *env = getenv( "WINE_D2R_TIMER_REUSE" );
+
+        if (env && env[0] == '0')
+        {
+            ERR( "d2r: anonymous timers are closed as in stock Wine (WINE_D2R_TIMER_REUSE=0).\n" );
+            on = 0;
+        }
+        else on = 1;
+    }
+    return on;
+}
+
+/* may a timer made with these arguments come from the pool or go back to it? Any access
+ * that can set and wait (the pool is by access); the plain attributes of d2r_ev_plain */
+static BOOL d2r_tm_plain( ACCESS_MASK access, const OBJECT_ATTRIBUTES *attr )
+{
+    if ((access & (TIMER_MODIFY_STATE | SYNCHRONIZE)) != (TIMER_MODIFY_STATE | SYNCHRONIZE)) return FALSE;
+    if (attr && ((attr->ObjectName && attr->ObjectName->Length) || attr->RootDirectory ||
+                 attr->SecurityDescriptor || attr->SecurityQualityOfService ||
+                 (attr->Attributes & ~(OBJ_CASE_INSENSITIVE | OBJ_OPENIF))))
+        return FALSE;
+    return d2r_tm_on();
+}
+
+static void d2r_tm_note( HANDLE handle, BOOL manual, ACCESS_MASK access )
+{
+    struct d2r_ev_slot *slot = d2r_ev_slot( handle );
+    sigset_t sigset;
+
+    server_enter_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    slot->tid = d2r_ev_tid();
+    slot->manual = manual;
+    slot->access = access;
+    slot->born_ns = d2r_ev_now();
+    slot->timer = 1;
+    slot->armed = slot->left = 0;
+    __atomic_store_n( &slot->handle, handle, __ATOMIC_RELAXED );
+    server_leave_uninterrupted_section( &d2r_ev_mutex, &sigset );
+}
+
+/* d2r_ev_mutex held for the d2r_tm_unset helpers */
+static int d2r_tm_unset_find( HANDLE handle )
+{
+    unsigned int i;
+
+    for (i = 0; i < d2r_tm_unsets; i++) if (d2r_tm_unset[i].handle == handle) return i;
+    return -1;
+}
+
+static void d2r_tm_unset_drop( int i )
+{
+    d2r_tm_unset[i] = d2r_tm_unset[--d2r_tm_unsets];
+    __atomic_store_n( &d2r_tm_unsets, d2r_tm_unsets, __ATOMIC_RELAXED );
+}
+
+/* the unset entry of this reuse goes, once the server made the timer new (d2r_ev_mutex not held) */
+static void d2r_tm_unset_done( HANDLE handle, unsigned int gen )
+{
+    sigset_t sigset;
+    int i;
+
+    server_enter_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    if ((i = d2r_tm_unset_find( handle )) >= 0 && d2r_tm_unset[i].gen == gen) d2r_tm_unset_drop( i );
+    server_leave_uninterrupted_section( &d2r_ev_mutex, &sigset );
+}
+
+/* a reused timer goes back to a new timer's state in the server (signal, flag, due time) in a
+ * request of its own, before what would see the old state (d2r_ev_mutex not held) */
+static void d2r_tm_fresh( HANDLE handle, unsigned int gen )
+{
+    SERVER_START_REQ( set_timer )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        req->expire = TIMEOUT_INFINITE;
+        req->arg    = d2r_tm_marker( gen, TRUE );
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    d2r_tm_count( D2R_TM_RESET );
+    d2r_tm_unset_done( handle, gen );
+}
+
+static HANDLE d2r_tm_take( BOOL manual, ACCESS_MASK access )
+{
+    HANDLE handle = 0;
+    sigset_t sigset;
+    unsigned int i;
+
+    if (!__atomic_load_n( &d2r_tm_pooled[manual], __ATOMIC_RELAXED )) return 0;
+    server_enter_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    /* a reused timer needs its unset entry until the program sets it; no room: a new one */
+    for (i = d2r_tm_pooled[manual]; i > 0 && d2r_tm_unsets < D2R_TM_UNSET; i--)
+    {
+        if (d2r_tm_pool[manual][i - 1].access != access) continue;
+        if (!(d2r_tm_gen = (d2r_tm_gen + 1) & 0x7fffffff)) d2r_tm_gen = 1;
+        d2r_tm_unset[d2r_tm_unsets] = d2r_tm_pool[manual][i - 1];
+        d2r_tm_unset[d2r_tm_unsets].gen = d2r_tm_gen;
+        handle = d2r_tm_unset[d2r_tm_unsets].handle;
+        d2r_tm_pool[manual][i - 1] = d2r_tm_pool[manual][d2r_tm_pooled[manual] - 1];
+        __atomic_store_n( &d2r_tm_unsets, d2r_tm_unsets + 1, __ATOMIC_RELAXED );
+        __atomic_store_n( &d2r_tm_pooled[manual], d2r_tm_pooled[manual] - 1, __ATOMIC_RELAXED );
+        break;
+    }
+    server_leave_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    return handle;
+}
+
+/* NtSetTimer, before its request: the argument to send. The first setting of a reused
+ * timer carries the marker (with an APC the marker goes in a request of its own first);
+ * *gen: its reuse number, for d2r_tm_unset_done after the request, or 0 */
+static void *d2r_tm_set( HANDLE handle, LONGLONG expire, PTIMER_APC_ROUTINE callback, void *arg,
+                         ULONG period, unsigned int *gen )
+{
+    struct d2r_ev_slot *slot = d2r_ev_slot( handle );
+    unsigned int fresh = 0;
+    sigset_t sigset;
+    int i;
+
+    *gen = 0;
+    /* the server never uses the argument without an APC: never let it look like a marker */
+    if (!callback && (unsigned int)((client_ptr_t)(ULONG_PTR)arg >> 32) == D2R_TIMER_MARKER) arg = NULL;
+    if (!handle || (__atomic_load_n( &slot->handle, __ATOMIC_RELAXED ) != handle &&
+                    !__atomic_load_n( &d2r_tm_unsets, __ATOMIC_RELAXED )))
+        return arg;
+    server_enter_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    if (d2r_tm_unsets && (i = d2r_tm_unset_find( handle )) >= 0)
+    {
+        if (callback) fresh = d2r_tm_unset[i].gen;
+        else
+        {
+            /* the entry stays until the request is done: another thread that looks at the
+             * timer meanwhile still makes it new first */
+            *gen = d2r_tm_unset[i].gen;
+            arg = (void *)(ULONG_PTR)d2r_tm_marker( *gen, FALSE );
+        }
+    }
+    if (slot->handle == handle && slot->timer)
+    {
+        if (callback || period || slot->armed || slot->tid != d2r_ev_tid())
+        {
+            __atomic_store_n( &slot->handle, 0, __ATOMIC_RELAXED );
+            d2r_tm_count( D2R_TM_SHARED );
+        }
+        else
+        {
+            slot->armed = (expire != TIMEOUT_INFINITE);
+            slot->left = 0;
+        }
+    }
+    server_leave_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    if (fresh) d2r_tm_fresh( handle, fresh );
+    return arg;
+}
+
+/* NtCancelTimer and NtQueryTimer, before their request: a reused timer the program hasn't
+ * set yet goes back to a new timer's state first; cancelling, or a query by another thread,
+ * leaves a fresh timer out of the pool (so a marker still on its way from another thread
+ * never meets a later reuse) */
+static void d2r_tm_look( HANDLE handle, BOOL cancel )
+{
+    struct d2r_ev_slot *slot = d2r_ev_slot( handle );
+    unsigned int fresh = 0;
+    sigset_t sigset;
+    int i;
+
+    if (!handle || (__atomic_load_n( &slot->handle, __ATOMIC_RELAXED ) != handle &&
+                    !__atomic_load_n( &d2r_tm_unsets, __ATOMIC_RELAXED )))
+        return;
+    server_enter_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    if (d2r_tm_unsets && (i = d2r_tm_unset_find( handle )) >= 0) fresh = d2r_tm_unset[i].gen;
+    if ((cancel || slot->tid != d2r_ev_tid()) && slot->handle == handle && slot->timer)
+    {
+        __atomic_store_n( &slot->handle, 0, __ATOMIC_RELAXED );
+        d2r_tm_count( D2R_TM_SHARED );
+    }
+    server_leave_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    if (fresh) d2r_tm_fresh( handle, fresh );
+}
+
+/* a wait returned with this handle signaled (and taken): a timer of the waiting thread
+ * that was set is seen to fire */
+static void d2r_tm_signaled( HANDLE handle )
+{
+    struct d2r_ev_slot *slot = d2r_ev_slot( handle );
+    sigset_t sigset;
+
+    if (!handle || __atomic_load_n( &slot->handle, __ATOMIC_RELAXED ) != handle) return;
+    server_enter_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    if (slot->handle == handle && slot->timer && slot->tid == d2r_ev_tid())
+    {
+        if (slot->armed)
+        {
+            slot->armed = 0;
+            slot->left = slot->manual;
+        }
+        else if (!slot->manual)
+        {
+            /* a signal from no setting seen here: leave it out of the pool */
+            __atomic_store_n( &slot->handle, 0, __ATOMIC_RELAXED );
+            d2r_tm_count( D2R_TM_SHARED );
+        }
+    }
+    server_leave_uninterrupted_section( &d2r_ev_mutex, &sigset );
+}
+
+static void d2r_tm_waited( DWORD count, const HANDLE *handles, WAIT_TYPE type, NTSTATUS status )
+{
+    DWORD i;
+
+    if (type == WaitAny && (DWORD)status < count) d2r_tm_signaled( handles[status] );
+    else if (type == WaitAll && status == STATUS_WAIT_0)
+        for (i = 0; i < count; i++) d2r_tm_signaled( handles[i] );
+}
+
 /* the handle goes somewhere that may keep a reference to its object (wait: only a wait by
- * another thread than the maker counts), so a fresh event behind it is never reused */
+ * another thread than the maker counts), so a fresh event or timer behind it is never
+ * reused; a reused timer the program hasn't set yet goes back to a new timer's state first
+ * when the waiter could see its old signal or someone else could see anything (patch 0010) */
 void d2r_event_shared( HANDLE handle, BOOL wait )
 {
     struct d2r_ev_slot *slot = d2r_ev_slot( handle );
+    unsigned int fresh = 0;
     sigset_t sigset;
+    int i;
 
-    if (!handle || __atomic_load_n( &slot->handle, __ATOMIC_RELAXED ) != handle) return;
+    if (!handle || (__atomic_load_n( &slot->handle, __ATOMIC_RELAXED ) != handle &&
+                    !__atomic_load_n( &d2r_tm_unsets, __ATOMIC_RELAXED )))
+        return;
     server_enter_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    if (d2r_tm_unsets && (i = d2r_tm_unset_find( handle )) >= 0 &&
+        (!wait || d2r_tm_unset[i].signaled || slot->handle != handle || slot->tid != d2r_ev_tid()))
+        fresh = d2r_tm_unset[i].gen;
     if (slot->handle == handle && (!wait || slot->tid != d2r_ev_tid()))
     {
         __atomic_store_n( &slot->handle, 0, __ATOMIC_RELAXED );
-        d2r_ev_count( D2R_EV_SHARED );
+        if (slot->timer) d2r_tm_count( D2R_TM_SHARED );
+        else d2r_ev_count( D2R_EV_SHARED );
     }
     server_leave_uninterrupted_section( &d2r_ev_mutex, &sigset );
+    if (fresh) d2r_tm_fresh( handle, fresh );
+}
+
+/* NtClose, a fresh timer (patch 0010): TRUE when it stays open in the pool; d2r_ev_mutex held */
+static BOOL d2r_tm_keep( HANDLE handle, struct d2r_ev_slot *slot )
+{
+    int counter, u = d2r_tm_unsets ? d2r_tm_unset_find( handle ) : -1;
+    BOOL signaled = slot->left, kept = FALSE;
+
+    if (u >= 0)
+    {
+        signaled |= d2r_tm_unset[u].signaled;
