+/* patch 0014: the class name, looked up once per class while SetupDiGetClassDevs fills a list */
+static BOOL d2r_class_name(struct DeviceInfoSet *set, const GUID *class, WCHAR *name, DWORD size)
+{
+    if (!set->d2r_name_cache || size != ARRAY_SIZE(set->d2r_name))
+        return SetupDiClassNameFromGuidW(class, name, size, NULL);
+    if (set->d2r_name_valid && IsEqualGUID(&set->d2r_name_class, class))
+    {
+        memcpy(name, set->d2r_name, sizeof(set->d2r_name));
+        return TRUE;
+    }
+    if (!SetupDiClassNameFromGuidW(class, name, size, NULL))
+        return FALSE;
+    set->d2r_name_class = *class;
+    memcpy(set->d2r_name, name, sizeof(set->d2r_name));
+    set->d2r_name_valid = TRUE;
+    return TRUE;
+}
