-    SetupDiCallClassInstaller(DIF_DESTROYPRIVATEDATA, device->set, &device_data);
+    /* patch 0014: no installer ran for this device, so none has private data to free */
+    if (device->d2r_installer_called || !d2r_setupapi_fast())
+        SetupDiCallClassInstaller(DIF_DESTROYPRIVATEDATA, device->set, &device_data);
 
