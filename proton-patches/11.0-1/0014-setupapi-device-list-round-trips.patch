+/* patch 0014: fewer registry round trips when device lists are made and destroyed.
+ *
+ * In b161 a D2R thread made a list of 3 HID device interfaces and destroyed it again twice a
+ * second for the whole run: 35 key opens and 27 value reads each time (FEX's registry notes)
+ * and, by the code, 16 key creates, 12 value writes and 48 closes, each a wineserver request
+ * (~300 a second). Two parts of that repeat work whose answer can't change:
+ * - Destroying the list asks every device's installers to free their private data
+ *   (DIF_DESTROYPRIVATEDATA): 4 key opens, 3 value reads, a key create and 4 closes per
+ *   device to find out that there are none. An installer only has private data for a device
+ *   it was called for in this set, so the call is now made only for a device that
+ *   SetupDiCallClassInstaller ran for (an app that installs drivers still gets it).
+ * - Every device added looks up its class name (2 key opens, a value read, 2 closes). While
+ *   one SetupDiGetClassDevs call fills a list it made, devices of the same class share the
+ *   first lookup. The name is used for nothing else and kept only for that call.
+ * WINE_D2R_SETUPAPI_FAST=0 turns both off. */
+static BOOL d2r_setupapi_fast(void)
+{
+    static LONG state; /* 0 not read yet, 1 on, 2 off */
+    LONG s = state;
+
+    if (!s)
+    {
+        char value[16];
+        DWORD len = GetEnvironmentVariableA("WINE_D2R_SETUPAPI_FAST", value, sizeof(value));
+
+        s = (len && len < sizeof(value) && value[0] == '0') ? 2 : 1;
+        state = s;
+    }
+    return s == 1;
+}
+
