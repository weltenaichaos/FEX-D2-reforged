--- a/dlls/xinput9_1_0/xinput9_1_0.spec
+++ b/dlls/xinput9_1_0/xinput9_1_0.spec
@@ -2,3 +2,4 @@
 @ stdcall XInputGetDSoundAudioDeviceGuids(long ptr ptr)
 @ stdcall XInputSetState(long ptr)
