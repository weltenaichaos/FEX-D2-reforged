xinput: No wineserver round trips while holding the controller lock.

The update thread issued each next input read (an overlapped ReadFile, i.e. a wineserver
call) while holding the controller's lock, and XInputSetState() sent every rumble change
synchronously (HidD_SetOutputReport: wineserver, winedevice, the device) under the same
lock. XInputGetState() takes that lock too, so D2R's main thread waited for those round
trips (48 ms frame in the b133 run), and in fights the render workers sat in XInputSetState
(b52/b53).

Device I/O now runs under a second lock (io_crit, taken after crit): the read is issued
after crit is released, and XInputSetState() only records the latest strength and wakes the
update thread, which sends it. XInputGetState() waits only for a state copy.

WINE_D2R_XINPUT=0 restores the stock behaviour (read under crit, rumble sent by the caller).
The export __wine_d2r_xinput = 1 tells FEX to leave XInputSetState alone (FEX_RUMBLE); xinput9_1_0
(D2R's import, a wrapper that calls xinput1_4) carries it too.
---
diff --git a/dlls/xinput1_1/xinput1_1.spec b/dlls/xinput1_1/xinput1_1.spec
index 5a55370..2e3017a 100644
--- a/dlls/xinput1_1/xinput1_1.spec
+++ b/dlls/xinput1_1/xinput1_1.spec
@@ -3,3 +3,4 @@
 @ stdcall XInputGetDSoundAudioDeviceGuids(long ptr ptr)
 @ stdcall XInputSetState(long ptr)
 @ stdcall XInputGetState(long ptr)
+@ extern -private __wine_d2r_xinput
diff --git a/dlls/xinput1_2/xinput1_2.spec b/dlls/xinput1_2/xinput1_2.spec
index 5a55370..2e3017a 100644
--- a/dlls/xinput1_2/xinput1_2.spec
+++ b/dlls/xinput1_2/xinput1_2.spec
@@ -3,3 +3,4 @@
 @ stdcall XInputGetDSoundAudioDeviceGuids(long ptr ptr)
 @ stdcall XInputSetState(long ptr)
 @ stdcall XInputGetState(long ptr)
+@ extern -private __wine_d2r_xinput
diff --git a/dlls/xinput1_3/main.c b/dlls/xinput1_3/main.c
index 254bac0..66f521a 100644
--- a/dlls/xinput1_3/main.c
+++ b/dlls/xinput1_3/main.c
@@ -57,6 +57,13 @@ struct xinput_controller
     XINPUT_STATE state;
     XINPUT_GAMEPAD last_keystroke;
     XINPUT_VIBRATION vibration;
+    /* d2r: device I/O (issuing the next input read, sending rumble) happens under io_crit
+     * instead of crit, so XInputGetState never waits for a wineserver round trip. Lock order
+     * is crit, then io_crit. io_crit guards vibration, the output report buffer and the
+     * device's lifetime; enabled is written under both. */
+    CRITICAL_SECTION io_crit;
+    XINPUT_VIBRATION vibration_pending;  /* latest XInputSetState value, under crit */
+    BOOL rumble_pending;                 /* the update thread still has to send it, under crit */
     HANDLE device;
     WCHAR device_path[MAX_PATH];
     BOOL enabled;
@@ -122,6 +129,15 @@ static HMODULE xinput_instance;
 static HANDLE start_event;
 static HANDLE update_event;
 static HANDLE steam_overlay_event;
+static HANDLE rumble_event;
+
+/* Exported for FEX (fex-d2-reforged): XInputSetState returns at once and the update thread
+ * sends the rumble; input reads are issued outside the controller lock. */
+const ULONG __wine_d2r_xinput = 1;
+
+/* WINE_D2R_XINPUT=0: rumble sent from the calling thread and reads issued under the
+ * controller lock, as in stock Wine. */
+static BOOL d2r_xinput_stock;
 
 static void check_value_caps(struct xinput_controller *controller, USHORT usage, HIDP_VALUE_CAPS *caps)
 {
@@ -306,17 +322,22 @@ static void controller_disable(struct xinput_controller *controller)
     XINPUT_VIBRATION state = {0};
 
     if (!controller->enabled) return;
+    EnterCriticalSection(&controller->io_crit);
     HID_set_state(controller, &state);
+    controller->vibration_pending = state;
+    controller->rumble_pending = FALSE;
     controller->enabled = FALSE;
 
     CancelIoEx(controller->device, &controller->hid.read_ovl);
     WaitForSingleObject(controller->hid.read_ovl.hEvent, INFINITE);
+    LeaveCriticalSection(&controller->io_crit);
     SetEvent(update_event);
 }
 
 static void controller_destroy(struct xinput_controller *controller, BOOL already_removed)
 {
     EnterCriticalSection(&controller->crit);
+    EnterCriticalSection(&controller->io_crit);
 
     if (controller->device)
     {
@@ -333,6 +354,7 @@ static void controller_destroy(struct xinput_controller *controller, BOOL alread
         memset(&controller->hid, 0, sizeof(controller->hid));
     }
 
+    LeaveCriticalSection(&controller->io_crit);
     LeaveCriticalSection(&controller->crit);
 }
 
@@ -344,12 +366,14 @@ static void controller_enable(struct xinput_controller *controller)
     BOOL ret;
 
     if (controller->enabled) return;
+    EnterCriticalSection(&controller->io_crit);
     HID_set_state(controller, &state);
     controller->enabled = TRUE;
 
     memset(&controller->hid.read_ovl, 0, sizeof(controller->hid.read_ovl));
     controller->hid.read_ovl.hEvent = controller->hid.read_event;
     ret = ReadFile(controller->device, report_buf, report_len, NULL, &controller->hid.read_ovl);
+    LeaveCriticalSection(&controller->io_crit);
     if (!ret && GetLastError() != ERROR_IO_PENDING) controller_destroy(controller, TRUE);
     else SetEvent(update_event);
 }
@@ -373,6 +397,8 @@ static BOOL controller_init(struct xinput_controller *controller, PHIDP_PREPARSE
 
     memset(&controller->state, 0, sizeof(controller->state));
     memset(&controller->vibration, 0, sizeof(controller->vibration));
+    memset(&controller->vibration_pending, 0, sizeof(controller->vibration_pending));
+    controller->rumble_pending = FALSE;
     lstrcpynW(controller->device_path, device_path, MAX_PATH);
     controller->enabled = FALSE;
 
@@ -565,7 +591,7 @@ static void read_controller_state(struct xinput_controller *controller)
     NTSTATUS status;
     USAGE buttons[11];
     ULONG i, button_length, value;
-    BOOL ret;
+    BOOL ret, failed;
 
     if (!GetOverlappedResult(controller->device, &controller->hid.read_ovl, &read_len, TRUE))
     {
@@ -653,12 +679,49 @@ static void read_controller_state(struct xinput_controller *controller)
     {
         state.dwPacketNumber = controller->state.dwPacketNumber + 1;
         controller->state = state;
+    }
+    if (!d2r_xinput_stock) LeaveCriticalSection(&controller->crit);
+
+    /* the next read is a wineserver call: issue it without holding crit, so that
+     * XInputGetState() doesn't wait for it */
+    failed = FALSE;
+    EnterCriticalSection(&controller->io_crit);
+    if (controller->enabled && controller->device)
+    {
         memset(&controller->hid.read_ovl, 0, sizeof(controller->hid.read_ovl));
         controller->hid.read_ovl.hEvent = controller->hid.read_event;
         ret = ReadFile(controller->device, report_buf, report_len, NULL, &controller->hid.read_ovl);
-        if (!ret && GetLastError() != ERROR_IO_PENDING) controller_destroy(controller, TRUE);
+        failed = !ret && GetLastError() != ERROR_IO_PENDING;
+    }
+    LeaveCriticalSection(&controller->io_crit);
+    if (failed) controller_destroy(controller, TRUE);
+    if (d2r_xinput_stock) LeaveCriticalSection(&controller->crit);
+}
+
+/* d2r: send the rumble XInputSetState() left for the update thread */
+static void send_pending_rumble(void)
+{
+    struct xinput_controller *controller;
+    XINPUT_VIBRATION state;
+    BOOL send;
+    int i;
+
+    for (i = 0; i < XUSER_MAX_COUNT; i++)
+    {
+        controller = &controllers[i];
+        if (!controller->device) continue;
+
+        EnterCriticalSection(&controller->crit);
+        send = controller->rumble_pending;
+        state = controller->vibration_pending;
+        controller->rumble_pending = FALSE;
+        LeaveCriticalSection(&controller->crit);
+        if (!send) continue;
+
+        EnterCriticalSection(&controller->io_crit);
+        if (controller->device) HID_set_state(controller, &state);
+        LeaveCriticalSection(&controller->io_crit);
     }
-    LeaveCriticalSection(&controller->crit);
 }
 
 static LRESULT CALLBACK xinput_devnotify_wndproc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
@@ -675,9 +738,9 @@ static LRESULT CALLBACK xinput_devnotify_wndproc(HWND hwnd, UINT msg, WPARAM wpa
 
 static DWORD WINAPI hid_update_thread_proc(void *param)
 {
-    struct xinput_controller *devices[XUSER_MAX_COUNT + 1];
-    HANDLE events[XUSER_MAX_COUNT + 1];
-    DWORD i, count = 1, ret = WAIT_TIMEOUT;
+    struct xinput_controller *devices[XUSER_MAX_COUNT + 2];
+    HANDLE events[XUSER_MAX_COUNT + 2];
+    DWORD i, count = 1, ndev = 0, ret = WAIT_TIMEOUT;
     DEV_BROADCAST_DEVICEINTERFACE_W filter =
     {
         .dbcc_size = sizeof(DEV_BROADCAST_DEVICEINTERFACE_W),
@@ -709,7 +772,8 @@ static DWORD WINAPI hid_update_thread_proc(void *param)
     {
         if (ret == count) while (PeekMessageW(&msg, hwnd, 0, 0, PM_REMOVE)) DispatchMessageW(&msg);
         if (ret == WAIT_TIMEOUT) update_controller_list();
-        if (ret < count - 1) read_controller_state(devices[ret]);
+        if (ret < ndev) read_controller_state(devices[ret]);
+        if (ret == ndev && ndev < count - 1) send_pending_rumble();
 
         count = 0;
         for (i = 0; i < XUSER_MAX_COUNT; ++i)
@@ -724,6 +788,8 @@ static DWORD WINAPI hid_update_thread_proc(void *param)
             }
             LeaveCriticalSection(&controllers[i].crit);
         }
+        ndev = count;
+        events[count++] = rumble_event;
         events[count++] = update_event;
     }
     while ((ret = MsgWaitForMultipleObjectsEx(count, events, 2000, QS_ALLINPUT, MWMO_ALERTABLE)) <= count ||
@@ -748,6 +814,20 @@ static BOOL WINAPI start_update_thread_once( INIT_ONCE *once, void *param, void
 
     steam_overlay_event = CreateEventA(NULL, TRUE, FALSE, "__wine_steamclient_GameOverlayActivated");
 
+    {
+        WCHAR env[8];
+        int i;
+
+        for (i = 0; i < XUSER_MAX_COUNT; i++) InitializeCriticalSection(&controllers[i].io_crit);
+        if (GetEnvironmentVariableW(L"WINE_D2R_XINPUT", env, ARRAY_SIZE(env)) && env[0] == '0')
+        {
+            ERR("d2r: xinput as in stock Wine (WINE_D2R_XINPUT=0).\n");
+            d2r_xinput_stock = TRUE;
+        }
+    }
+    rumble_event = CreateEventA(NULL, FALSE, FALSE, NULL);
+    if (!rumble_event) ERR("failed to create rumble event, error %lu\n", GetLastError());
+
     start_event = CreateEventA(NULL, FALSE, FALSE, NULL);
     if (!start_event) ERR("failed to create start event, error %lu\n", GetLastError());
 
@@ -835,7 +915,30 @@ DWORD WINAPI DECLSPEC_HOTPATCH XInputSetState(DWORD index, XINPUT_VIBRATION *vib
     if (!controller_lock(&controllers[index])) return ERROR_DEVICE_NOT_CONNECTED;
 
     if (WaitForSingleObject(steam_overlay_event, 0) == WAIT_OBJECT_0) ret = ERROR_SUCCESS;
-    else ret = HID_set_state(&controllers[index], vibration);
+    else if (d2r_xinput_stock)
+    {
+        EnterCriticalSection(&controllers[index].io_crit);
+        ret = HID_set_state(&controllers[index], vibration);
+        LeaveCriticalSection(&controllers[index].io_crit);
+    }
+    else
+    {
+        /* d2r: the update thread sends it (a wineserver and winedevice round trip); only the
+         * latest value counts */
+        struct xinput_controller *controller = &controllers[index];
+
+        if (controller->vibration_pending.wLeftMotorSpeed != vibration->wLeftMotorSpeed ||
+            controller->vibration_pending.wRightMotorSpeed != vibration->wRightMotorSpeed)
+        {
+            controller->vibration_pending = *vibration;
+            if (!controller->rumble_pending)
+            {
+                controller->rumble_pending = TRUE;
+                SetEvent(rumble_event);
+            }
+        }
+        ret = ERROR_SUCCESS;
+    }
 
     controller_unlock(&controllers[index]);
 
