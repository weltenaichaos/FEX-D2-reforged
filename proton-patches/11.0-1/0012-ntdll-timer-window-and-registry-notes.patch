 /* the number of request types in this build, so the build can check the name table it ships */
diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
index a355e39..e7080f3 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -1237,7 +1237,7 @@ static HANDLE d2r_ev_take( BOOL manual )
  * close_handle every time. A timer that NtCreateTimer made with an access that can set and
  * wait (TIMER_MODIFY_STATE and SYNCHRONIZE) and the plain attributes of d2r_ev_plain is noted
  * in the table of fresh events. NtClose keeps it open in a small pool only when nothing can
- * still happen to it: closed by the thread that made it within D2R_TM_LIFE_NS; never set with
+ * still happen to it: closed by the thread that made it within d2r_tm_life_ns; never set with
  * an APC or a period, never set again before its last setting was seen to fire, and every
  * setting seen to fire by a wait of that thread; never duplicated, given new handle flags,
  * cancelled, or set, waited on or queried by another thread. Then no timeout or APC is pending
@@ -1251,7 +1251,10 @@ static HANDLE d2r_ev_take( BOOL manual )
  * first. The server acts on the first marker of each reuse only. WINE_D2R_TIMER_REUSE=0 turns
  * it off. */
 #define D2R_TM_POOL    16                 /* kept timers per type */
-#define D2R_TM_LIFE_NS (100 * (ULONG64)1000000)
+/* patch 0012: 10 s instead of 100 ms (d2r9). In b159 ~10 timers a second that met every
+ * other rule were closed later than 100 ms after they were made (tm_too_old); the window
+ * only keeps handles that live long out of the pool, the other rules decide what is safe */
+static ULONG64 d2r_tm_life_ns = 10000 * (ULONG64)1000000;
 #define D2R_TM_UNSET   32                 /* reused timers the program hasn't set yet */
 /* set_timer marker: the high half of the argument of a request without APC (an argument the
  * server never uses then; the same value is in server/timer.c); bits 1-31 hold the reuse number,
@@ -1304,6 +1307,12 @@ static BOOL d2r_tm_on(void)
             on = 0;
         }
         else on = 1;
+        /* patch 0012: the reuse window, WINE_D2R_TIMER_LIFE_MS (1 to 3,600,000; d2r9 had 100) */
+        if ((env = getenv( "WINE_D2R_TIMER_LIFE_MS" )))
+        {
+            unsigned long ms = strtoul( env, NULL, 10 );
+            if (ms >= 1 && ms <= 3600000) d2r_tm_life_ns = ms * (ULONG64)1000000;
+        }
     }
     return on;
 }
@@ -1551,7 +1560,7 @@ static BOOL d2r_tm_keep( HANDLE handle, struct d2r_ev_slot *slot )
     }
     if (slot->tid != d2r_ev_tid()) counter = D2R_TM_OTHER_THREAD;
     else if (slot->armed) counter = D2R_TM_ARMED;
-    else if (d2r_ev_now() - slot->born_ns >= D2R_TM_LIFE_NS) counter = D2R_TM_TOO_OLD;
+    else if (d2r_ev_now() - slot->born_ns >= d2r_tm_life_ns) counter = D2R_TM_TOO_OLD;
     else if (d2r_tm_pooled[slot->manual] >= D2R_TM_POOL) counter = D2R_TM_POOL_FULL;
     else
     {
diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
index 9823330..50f62ae 100644
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -151,6 +151,18 @@ extern struct d2r_server_calls *d2r_server_calls;
  * each request type and what the completion port waits in the process did. On with the
  * request counts (WINE_D2R_CALL_COUNTS). Version 1 layout; later patches only append, and
  * size says how much this build writes (0 in patch 0009's build: 2,112 bytes). */
+/* patch 0012: one registry call; a reader takes seq (even), copies, and checks seq again */
+struct d2r_reg_note
+{
+    ULONG   seq;              /* odd while being written, +2 per write */
+    ULONG   tid;              /* Windows thread id of the caller */
+    ULONG   status;           /* NTSTATUS of the call */
+    ULONG   name_len;         /* length of the whole name in characters */
+    ULONG64 parent;           /* NtOpenKeyEx: root directory handle; NtQueryValueKey: key handle */
+    ULONG64 result;           /* NtOpenKeyEx: the key handle it returned; 0 for value reads */
+    char    name[96];         /* key path relative to parent / value name: ASCII, '?' for others, cut to 95 */
+};
+
 struct d2r_server_calls_ext
 {
     ULONG   version;          /* 1 once the unix side writes here */
@@ -171,12 +183,18 @@ struct d2r_server_calls_ext
     ULONG64 tm_armed;         /* closed while a setting wasn't seen to fire (maybe pending): really closed */
     ULONG64 tm_shared;        /* left out: APC or period, set again before it fired, cancelled, duplicated, other thread */
     ULONG64 tm_other_thread;  /* closed by another thread than the one that made it */
-    ULONG64 tm_too_old;       /* closed later than 100 ms after it was made */
+    ULONG64 tm_too_old;       /* closed later than the reuse window after it was made (100 ms in d2r9, 10 s since 0012) */
     ULONG64 tm_pool_full;     /* closed while the pool for its type was full (tm_kept..tm_pool_full in this order) */
+    /* patch 0012: the latest registry keys opened (NtOpenKeyEx) and values read
+     * (NtQueryValueKey), at byte 2176 */
+    ULONG64 reg_open_next;    /* opens noted so far; the latest is reg_open[(reg_open_next - 1) % 8] */
+    ULONG64 reg_value_next;   /* value reads noted so far; the latest is reg_value[(reg_value_next - 1) % 4] */
+    struct d2r_reg_note reg_open[8];
+    struct d2r_reg_note reg_value[4];
 };
 
 extern struct d2r_server_calls_ext *d2r_server_calls_ext;
-#define D2R_SERVER_CALLS_EXT_U64 272  /* size of __wine_d2r_server_calls_ext in ULONG64 */
+#define D2R_SERVER_CALLS_EXT_U64 466  /* size of __wine_d2r_server_calls_ext in ULONG64 (272 in d2r9) */
 
