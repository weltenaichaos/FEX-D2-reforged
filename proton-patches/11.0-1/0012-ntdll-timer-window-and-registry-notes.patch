 C_ASSERT( offsetof(struct d2r_server_calls_ext, tm_kept) == 2112 );
 C_ASSERT( offsetof(struct d2r_server_calls_ext, tm_pool_full) == offsetof(struct d2r_server_calls_ext, tm_kept) + 7 * sizeof(ULONG64) );
+C_ASSERT( sizeof(struct d2r_reg_note) == 128 );  /* patch 0012 */
