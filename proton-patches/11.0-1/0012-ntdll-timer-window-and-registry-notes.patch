-DECLSPEC_ALIGN(64) ULONG64 __wine_d2r_server_calls_ext[272];  /* 272 since patch 0010 */
+DECLSPEC_ALIGN(64) ULONG64 __wine_d2r_server_calls_ext[466];  /* 272 since patch 0010, 466 since 0012 */
 
 /* d2r (patch 0011): where the wineserver's thread table for this process is mapped
  * (struct d2r_threads_info in unix/unix_private.h), read by FEX's helpers */
diff --git a/dlls/ntdll/unix/registry.c b/dlls/ntdll/unix/registry.c
index d1df93f..678e743 100644
--- a/dlls/ntdll/unix/registry.c
+++ b/dlls/ntdll/unix/registry.c
@@ -375,6 +375,51 @@ NTSTATUS WINAPI NtCreateKeyTransacted( HANDLE *key, ACCESS_MASK access, const OB
 }
 
 
+/* d2r (fex-d2-reforged, patch 0012): note the latest registry keys opened and values read in
+ * __wine_d2r_server_calls_ext for FEX. In b159 one unnamed thread (tid 784) did open_key ~80
+ * and get_key_value ~60 times a second; these notes say which key and value. On with the
+ * request counts (WINE_D2R_CALL_COUNTS). */
+static void DECLSPEC_NOINLINE d2r_reg_note( BOOL value, HANDLE parent, const UNICODE_STRING *name, HANDLE result,
+                                            NTSTATUS status )
+{
+    struct d2r_server_calls_ext *ext = d2r_server_calls_ext;
+    struct d2r_reg_note *note;
+    ULONG seq, i, len;
+    ULONG64 n;
+
+    if (!ext) return;
+    if (value)
+    {
+        n = __atomic_fetch_add( &ext->reg_value_next, 1, __ATOMIC_RELAXED );
+        note = &ext->reg_value[n % ARRAY_SIZE(ext->reg_value)];
+    }
+    else
+    {
+        n = __atomic_fetch_add( &ext->reg_open_next, 1, __ATOMIC_RELAXED );
+        note = &ext->reg_open[n % ARRAY_SIZE(ext->reg_open)];
+    }
+    seq = __atomic_load_n( &note->seq, __ATOMIC_RELAXED );
+    /* another thread writing this note: leave it to that one */
+    if ((seq & 1) || !__atomic_compare_exchange_n( &note->seq, &seq, seq + 1, FALSE,
+                                                    __ATOMIC_RELAXED, __ATOMIC_RELAXED ))
+        return;
+    __atomic_thread_fence( __ATOMIC_RELEASE );
+    len = name ? name->Length / sizeof(WCHAR) : 0;
+    for (i = 0; i < len && i < sizeof(note->name) - 1; i++)
+    {
+        WCHAR c = name->Buffer[i];
+        note->name[i] = (c >= 0x20 && c <= 0x7e) ? (char)c : '?';
+    }
+    memset( note->name + i, 0, sizeof(note->name) - i );
+    note->tid      = HandleToULong( NtCurrentTeb()->ClientId.UniqueThread );
+    note->status   = status;
+    note->name_len = len;
+    note->parent   = (ULONG_PTR)parent;
+    note->result   = (ULONG_PTR)result;
+    __atomic_store_n( &note->seq, seq + 2, __ATOMIC_RELEASE );
+}
+
+
 /******************************************************************************
  *              NtOpenKeyEx  (NTDLL.@)
  */
@@ -403,6 +448,7 @@ NTSTATUS WINAPI NtOpenKeyEx( HANDLE *key, ACCESS_MASK access, const OBJECT_ATTRI
         *key = wine_server_ptr_handle( reply->hkey );
     }
     SERVER_END_REQ;
+    d2r_reg_note( FALSE, attr->RootDirectory, attr->ObjectName, *key, ret );  /* d2r (patch 0012) */
     TRACE("<- %p\n", *key);
     return ret;
 }
@@ -801,6 +847,7 @@ NTSTATUS WINAPI NtQueryValueKey( HANDLE handle, const UNICODE_STRING *name,
         }
     }
     SERVER_END_REQ;
+    d2r_reg_note( TRUE, handle, name, 0, ret );  /* d2r (patch 0012) */
     return ret;
 }
 
