 }
 
+/* FEX link (fex3, TU_FEX_MODE_DEPTH_CLEAR_3D): can attachment a's clear at the
+ * start of this subpass be a 3D draw (tu_fex_clear_depth_3d) instead of a 2D
+ * engine fill? Only the subpass's own single-sampled depth/stencil attachment
+ * (no separate stencil plane), one layer, and nothing that changes how a draw
+ * covers the render area: no multiview, per-layer areas, fragment density
+ * maps, predication, custom resolves or unresolves. */
+static bool
+tu_fex_depth_clear_3d_ok(const struct tu_cmd_buffer *cmd, uint32_t a)
+{
+   if (!(cmd->state.fex.mode & TU_FEX_MODE_DEPTH_CLEAR_3D))
+      return false;
+
+   const struct tu_subpass *subpass = cmd->state.subpass;
+   const struct tu_render_pass_attachment *att = &cmd->state.pass->attachments[a];
+   if (subpass->depth_stencil_attachment.attachment != a)
+      return false;
+
+   switch (att->format) {
+   case VK_FORMAT_D16_UNORM:
+   case VK_FORMAT_X8_D24_UNORM_PACK32:
+   case VK_FORMAT_D24_UNORM_S8_UINT:
+   case VK_FORMAT_D32_SFLOAT:
+      break;
+   default:
+      return false;
+   }
+
+   /* tu_pass.cc: COLOR_BIT for depth-only formats, DEPTH/STENCIL bits for
+    * D24S8; tu_fex_clear_depth_3d maps it back. */
+   if (!att->clear_mask)
+      return false;
+
+   return att->samples <= 1 && subpass->samples <= 1 &&
+          !subpass->multiview_mask && !subpass->custom_resolve &&
+          !subpass->unresolve_count && !cmd->state.pass->num_views &&
+          cmd->state.framebuffer->layers == 1 &&
+          !cmd->state.per_layer_render_area && !cmd->state.fdm_enabled &&
+          !cmd->state.predication_active &&
+          cmd->state.render_areas[0].extent.width &&
+          cmd->state.render_areas[0].extent.height;
+}
+
 /* Emits sysmem clears that are first used in this subpass. */
 template <chip CHIP>
 static void
@@ -7000,8 +7042,22 @@ tu_emit_subpass_begin_sysmem(struct tu_cmd_buffer *cmd)
 
    for (uint32_t i = 0; i < cmd->state.pass->attachment_count; ++i) {
       struct tu_render_pass_attachment *att = &cmd->state.pass->attachments[i];
-      if (att->clear_mask && att->first_subpass_idx == subpass_idx)
+      if (att->clear_mask && att->first_subpass_idx == subpass_idx) {
+         /* FEX link: depth clears either wait for the 3D path (emitted by
+          * tu_emit_subpass_begin once the subpass state is set) or go to the
+          * 2D engine as before; both are counted. */
+         if (cmd->device->fex && vk_format_is_depth_or_stencil(att->format)) {
+            const bool draw = tu_fex_depth_clear_3d_ok(cmd, i);
+            const VkExtent2D ext = cmd->state.render_areas[0].extent;
+            tu_fex_count_depth_clear(cmd->device, draw,
+                                     (uint64_t)ext.width * ext.height);
+            if (draw) {
+               cmd->state.fex.depth_clear_3d = i + 1;
+               continue;
+            }
+         }
          tu_clear_sysmem_attachment<CHIP>(cmd, cs, i);
+      }
    }
 
    if (!subpass->custom_resolve)
@@ -7208,6 +7264,14 @@ tu_emit_subpass_begin(struct tu_cmd_buffer *cmd)
 
    vk_cmd_set_cb_attachment_count(&cmd->vk, cmd->state.subpass->color_count);
 
+   /* FEX link (fex3): the depth clear tu_emit_subpass_begin_sysmem left for
+    * the 3D path, now that the depth buffer state is emitted. */
+   if (cmd->state.fex.depth_clear_3d) {
+      const uint32_t a = cmd->state.fex.depth_clear_3d - 1;
+      cmd->state.fex.depth_clear_3d = 0;
+      tu_fex_clear_depth_3d<CHIP>(cmd, a);
+   }
+
    cmd->state.dirty |= TU_CMD_DIRTY_SUBPASS;
 }
 
