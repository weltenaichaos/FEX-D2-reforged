+/* FEX link (fex3): the start-of-pass clear of a depth/stencil attachment as a
+ * 3D draw, the way vkCmdClearAttachments clears inside a direct pass: depth
+ * test ALWAYS with depth (and stencil) writes through the depth unit and its
+ * cache, so no CCU color -> depth flush and no wait for idle are needed after
+ * it. LRZ is left alone: the pass already cleared it to the same value. Only
+ * runs in direct (sysmem) mode; tiled passes clear in GMEM as before.
+ */
+template <chip CHIP>
+void
+tu_fex_clear_depth_3d(struct tu_cmd_buffer *cmd, uint32_t a)
+{
+   const struct tu_render_pass_attachment *att = &cmd->state.pass->attachments[a];
+   VkClearAttachment clear = {};
+   /* tu_pass.cc keeps COLOR_BIT ("the whole attachment") for depth-only
+    * formats and DEPTH/STENCIL bits for D24S8. */
+   clear.aspectMask = att->format == VK_FORMAT_D24_UNORM_S8_UINT ?
+      att->clear_mask & (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT) :
+      VK_IMAGE_ASPECT_DEPTH_BIT;
+   clear.clearValue = cmd->state.clear_values[a];
+   VkClearRect rect = {};
+   rect.rect = cmd->state.render_areas[0];
+   rect.baseArrayLayer = 0;
+   rect.layerCount = 1;
+
+   struct tu_cs *cs = &cmd->draw_cs;
+
+   /* Like a draw: pending flushes first, outside the condition (as in
+    * tu_clear_attachments). */
+   tu_emit_cache_flush_renderpass<CHIP>(cmd);
+
+   tu_cond_exec_start(cs, CP_COND_EXEC_0_RENDER_MODE_SYSMEM);
+   tu_clear_sysmem_attachments<CHIP>(cmd, 1, &clear, 1, &rect);
+   tu_cond_exec_end(cs);
+}
+TU_GENX(tu_fex_clear_depth_3d);
+
