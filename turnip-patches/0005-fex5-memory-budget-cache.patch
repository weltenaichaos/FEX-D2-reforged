+/* fex5: the channel for the memory budget query, which runs on a physical
+ * device, maybe before any device exists: looked up once. */
+static struct tu_fex_channel *
+tu_fex_budget_channel(void)
+{
+   static int state; /* 0 not looked up yet, 1 none, 2 found */
+   static struct tu_fex_channel *found;
+   const int s = __atomic_load_n(&state, __ATOMIC_ACQUIRE);
+   if (s == 2)
+      return __atomic_load_n(&found, __ATOMIC_RELAXED);
+   if (s == 1)
+      return NULL;
+   struct tu_fex_channel *chan = tu_fex_find_channel();
+   if (chan)
+      __atomic_fetch_or(&chan->status, TU_FEX_STATUS_BUDGET_CACHE, __ATOMIC_RELEASE);
+   __atomic_store_n(&found, chan, __ATOMIC_RELAXED);
+   __atomic_store_n(&state, chan ? 2 : 1, __ATOMIC_RELEASE);
+   return chan;
+}
+
+bool
+tu_fex_available_memory(uint64_t *available)
+{
+   struct tu_fex_channel *chan = tu_fex_budget_channel();
+   if (!chan)
+      return os_get_available_system_memory(available);
+
+   /* MemAvailable moves with the file cache and other apps, a budget is a
+    * rough estimate anyway: one read every 250 ms is plenty. */
+   static simple_mtx_t lock = SIMPLE_MTX_INITIALIZER;
+   static uint64_t cached;
+   static int64_t cached_at;
+   static bool have;
+
+   const int64_t start = os_time_get_nano();
+   const bool cache = __atomic_load_n(&chan->mode, __ATOMIC_RELAXED) & TU_FEX_MODE_BUDGET_CACHE;
+   bool ok;
+   simple_mtx_lock(&lock);
+   if (cache && have && start - cached_at < 250000000ll) {
+      *available = cached;
+      ok = true;
+   } else {
+      uint64_t value = 0;
+      ok = os_get_available_system_memory(&value);
+      __atomic_fetch_add(&chan->budget_reads, 1, __ATOMIC_RELAXED);
+      if (ok) {
+         cached = value;
+         cached_at = start;
+         have = true;
+         *available = value;
+      } else if (cache && have) {
+         *available = cached;
+         ok = true;
+      }
+   }
+   simple_mtx_unlock(&lock);
+   __atomic_fetch_add(&chan->budget_queries, 1, __ATOMIC_RELAXED);
+   __atomic_fetch_add(&chan->budget_ns, (uint64_t)(os_time_get_nano() - start), __ATOMIC_RELAXED);
+   return ok;
+}
+
