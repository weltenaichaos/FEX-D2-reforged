+ * waits for the GPU to be idle before and after (two waits). */
+uint64_t
+tu_fex_dispatch_begin(struct tu_cmd_buffer *cmd, struct tu_cs *cs,
+                      const uint32_t groups[3], const uint16_t local_size[3],
+                      uint32_t instrs, bool alt)
+{
+   struct tu_device *dev = cmd->device;
+   struct tu_fex_device *fex = dev->fex;
+   if (!fex || !fex->ring_map || !fex->cs_stats || !fex->sample_min_draws)
+      return 0;
