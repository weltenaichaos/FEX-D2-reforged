+   if (!(mesa_shader_stage_is_compute(stage) ||
+         compiler->info->props.has_getfiberid)) {
+      options.subgroup_size = 1;
+      options.lower_vote_trivial = true;
+   }
+   return options;
+}
+
+/* Atomics on buffers in memory only: atomics on workgroup shared memory are
+ * not serialized at the L2 cache, and the reduction may cost more than
+ * it saves there. */
+static bool
+ir3_nir_fex_memory_atomic(const nir_instr *instr, const void *data)
+{
+   (void)data;
+   switch (nir_instr_as_intrinsic(instr)->intrinsic) {
+   case nir_intrinsic_ssbo_atomic:
+   case nir_intrinsic_global_atomic:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static unsigned
+ir3_nir_fex_count_elects(nir_shader *s)
+{
+   unsigned n = 0;
+   nir_foreach_function_impl (impl, s) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block) {
+            if (instr->type == nir_instr_type_intrinsic &&
+                nir_instr_as_intrinsic(instr)->intrinsic == nir_intrinsic_elect)
+               n++;
+         }
+      }
+   }
+   return n;
+}
+
+/* FEX (fex16): atomics whose address is the same for the whole wave become
+ * one atomic per wave (ir3_shader_key::fex_uniform_atomics). D2R's ground
+ * clutter compute shader (1152x1152 cells, ~1.2 ms a frame on a740) bumps one
+ * append counter per placed item; every lane's atomic goes to the same L2
+ * address one after another (atomics on buffers in memory only, not on
+ * workgroup shared memory). nir_opt_uniform_atomics adds the active lanes'
+ * values with a ballot count, lets one elected lane do the atomic, and gives
+ * every lane the returned value plus its place among the active lanes. The
+ * subgroup operations it makes are lowered here like the shader's own were
+ * in ir3_nir_post_finalize (elect, ballot, read-first and getfiberid are ir3
+ * instructions). Returns the atomics changed.
+ */
+static unsigned
+ir3_nir_fex_uniform_atomics(struct ir3_shader_variant *so, nir_shader *s)
+{
+   if (!mesa_shader_stage_is_compute(s->info.stage))
+      return 0;
+
+   const unsigned before = ir3_nir_fex_count_elects(s);
+   bool progress = false;
+   NIR_PASS(progress, s, nir_opt_uniform_atomics_filtered, false,
+            ir3_nir_fex_memory_atomic, NULL);
+   if (!progress)
+      return 0;
+
+   const unsigned made = ir3_nir_fex_count_elects(s) - before;
+   const nir_lower_subgroups_options options =
+      ir3_nir_subgroups_options(so->compiler, &so->shader_options,
+                                s->info.stage);
+   NIR_PASS(_, s, nir_opt_uniform_subgroup, &options);
+   NIR_PASS(_, s, nir_lower_subgroups, &options);
+   return made;
+}
