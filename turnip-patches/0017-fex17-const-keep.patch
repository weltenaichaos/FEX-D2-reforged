+/* One fex9 range's load from the pushed descriptor: source address, const
+ * file offset and size (vec4). False when the load is left out (range past
+ * the UBO's size, null descriptor, set not the push set). */
+static bool
+tu_fex_cp_range(const struct ir3_ubo_range *range, unsigned constlen,
+                const struct tu_descriptor_state *descriptors,
+                uint64_t *src, uint32_t *dst, uint32_t *num)
+{
+   const struct tu_descriptor_set *push = &descriptors->push_set;
+   const unsigned set = range->ubo.bindless_base;
+   if (set >= MAX_SETS || descriptors->sets[set] != push ||
+       !push->layout || !push->mapped_ptr)
+      return false;
+   const uint32_t desc_dw = range->ubo.block * FDL6_TEX_CONST_DWORDS;
+   if ((desc_dw + 2) * 4 > push->layout->size)
+      return false;
+
+   const uint32_t *desc = push->mapped_ptr + desc_dw;
+   const uint64_t va =
+      desc[0] | ((uint64_t)(desc[1] & A6XX_UBO_1_BASE_HI__MASK) << 32);
+   const uint32_t size_vec4 =
+      (desc[1] & A6XX_UBO_1_SIZE__MASK) >> A6XX_UBO_1_SIZE__SHIFT;
+   const uint32_t start_vec4 = range->start / 16;
+   const uint32_t dst_vec4 = range->offset / 16;
+   if (!va || start_vec4 >= size_vec4 || dst_vec4 >= constlen)
+      return false;
+
+   *src = va + range->start;
+   *dst = dst_vec4;
+   *num = MIN3((range->end - range->start) / 16, size_vec4 - start_vec4,
+               constlen - dst_vec4);
+   return true;
+}
