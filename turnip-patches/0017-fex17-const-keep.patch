+   struct tu_fex_cmd_state *f = &cmd->state.fex;
+   tu_cs_emit(cs, CP_SET_DRAW_STATE__0_COUNT(f->keep_size) |
+                  CP_SET_DRAW_STATE__0_GMEM | CP_SET_DRAW_STATE__0_SYSMEM |
+                  CP_SET_DRAW_STATE__0_BINNING |
