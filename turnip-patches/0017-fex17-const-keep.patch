+/* Sorts this build's fex9 ranges into the kept group and the CONST group:
+ * a range stays kept while its source address is the one the kept group
+ * loads; a UBO block whose address changed moves to the CONST group for the
+ * rest of the command buffer, and the kept group is made again without it
+ * (so the latest copies of the two groups never load the same constants,
+ * whatever order the command processor runs them in, e.g. when a tiled
+ * pass skips draws). Returns the vec4s the kept group loads if it is set
+ * again, else 0; *kept_vec4 = vec4s left in place. */
+static uint32_t
+tu_fex_keep_update(struct tu_cmd_buffer *cmd,
+                   const struct tu_descriptor_state *descriptors,
+                   uint32_t *kept_vec4)
+{
+   struct tu_fex_cmd_state *f = &cmd->state.fex;
+   struct tu_fex_cmd_state::tu_fex_keep_range want[TU_FEX_KEEP_MAX];
+   uint32_t n = 0, vec4 = 0;
+   uint32_t mask[TU_FEX_KEEP_STAGES] = {};
+   bool known = !f->keep_force;
+
+   for (uint32_t type = MESA_SHADER_VERTEX; type <= MESA_SHADER_FRAGMENT; type++) {
+      const struct tu_program_descriptor_linkage *link =
+         &cmd->state.program.link[type];
+      const struct ir3_ubo_analysis_state *ubo_state =
+         &link->const_state.ubo_state;
+      for (uint32_t i = 0; i < ubo_state->num_enabled && i < 32; i++) {
+         const struct ir3_ubo_range *range = &ubo_state->range[i];
+         if (!range->fex_cp)
+            continue;
+         const uint32_t block = range->ubo.block;
+         if (block >= 32 || (f->keep_dyn[type] & BITFIELD_BIT(block)) ||
+             n == TU_FEX_KEEP_MAX)
+            continue;
+         uint64_t src;
+         uint32_t dst, num;
+         if (!tu_fex_cp_range(range, link->constlen, descriptors, &src, &dst,
+                              &num))
+            continue;
+         if (known) {
+            const struct tu_fex_cmd_state::tu_fex_keep_range *old = NULL;
+            for (uint32_t k = 0; k < f->keep_n; k++) {
+               if (f->keep[k].stage == type && f->keep[k].dst == dst) {
+                  old = &f->keep[k];
+                  break;
+               }
+            }
+            if (old && (old->src != src || old->num != num)) {
+               f->keep_dyn[type] |= BITFIELD_BIT(block);
+               f->keep_moves++;
+               continue;
+            }
+         }
+         want[n].src = src;
+         want[n].dst = (uint16_t)dst;
+         want[n].num = (uint16_t)num;
+         want[n].stage = (uint8_t)type;
+         want[n].block = (uint8_t)block;
+         n++;
+         vec4 += num;
+         mask[type] |= BITFIELD_BIT(i);
+      }
+   }
+   memcpy(f->keep_mask, mask, sizeof(mask));
+
+   bool same = known && n == f->keep_n;
+   for (uint32_t k = 0; same && k < n; k++) {
+      same = want[k].src == f->keep[k].src && want[k].dst == f->keep[k].dst &&
+             want[k].num == f->keep[k].num &&
+             want[k].stage == f->keep[k].stage;
+   }
+   /* Nothing kept before or now (e.g. shaders without driver-loaded
+    * ranges): no group to set. */
+   if (!n && !f->keep_n && !f->keep_size)
+      same = true;
+   if (same) {
+      f->keep_force = false;
+      *kept_vec4 = vec4;
+      return 0;
+   }
+
+   /* Set the group again: new content, or forced. */
+   if (f->keep_force)
+      f->keep_forced++;
+   f->keep_force = false;
+   f->keep_runs++;
+   memcpy(f->keep, want, n * sizeof(want[0]));
+   f->keep_n = n;
+   f->keep_pending = true;
+   *kept_vec4 = 0;
+   if (!n) {
+      f->keep_iova = 0;
+      f->keep_size = 0;
+      return 0;
+   }
+   struct tu_cs cs;
+   tu_cs_begin_sub_stream(&cmd->sub_cs, 4 * n, &cs);
+   for (uint32_t k = 0; k < n; k++)
+      tu_fex_emit_cp_range(&cs, (mesa_shader_stage)want[k].stage, want[k].src,
+                           want[k].dst, want[k].num);
+   struct tu_draw_state st = tu_cs_end_draw_state(&cmd->sub_cs, &cs);
+   f->keep_iova = st.iova;
+   f->keep_size = st.size;
+   return vec4;
+}
