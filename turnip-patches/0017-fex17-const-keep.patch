+/* FEX link, fex17 (TU_FEX_MODE_CONST_KEEP): see tu_fex.h. */
+static inline bool
+tu_fex_keep_on(const struct tu_cmd_buffer *cmd)
+{
+   return cmd->device->fex && cmd->device->fex->const_keep &&
+          (cmd->state.fex.mode & TU_FEX_MODE_CONST_KEEP) &&
+          cmd->vk.level == VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+}
