+/* FEX link: a render pass that starts here begins with all descriptor caches
+ * invalidated (tu6_sysmem_render_begin), so changed-only tracking restarts
+ * from the sets bound now. A resumed pass continues GPU state this command
+ * buffer doesn't know: invalidate every set until the next pass. */
+static void
+tu_fex_render_pass_begin(struct tu_cmd_buffer *cmd, bool resuming)
+{
+   struct tu_fex_cmd_state *fex = &cmd->state.fex;
+   if (!(fex->mode & TU_FEX_MODE_CHANGED_ONLY))
+      return;
+   if (resuming) {
+      fex->desc_cum = 0xff;
+      return;
+   }
+   fex->desc_cum = 0;
+   memcpy(fex->desc_prev,
+          tu_get_descriptors_state(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS)->set_iova,
+          sizeof(fex->desc_prev));
+}
