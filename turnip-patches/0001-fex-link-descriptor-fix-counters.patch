+/* Copies a push descriptor set's contents into the command stream and points
+ * the set at the copy.
+ *
+ * FEX link, TU_FEX_MODE_PUSH_REUSE: a graphics push with the same bytes as the
+ * previous one keeps that copy, so the set's address doesn't change and
+ * TU_FEX_MODE_CHANGED_ONLY doesn't invalidate its descriptor cache.
+ */
+static bool
+tu_push_descriptor_set_place(struct tu_cmd_buffer *cmd,
+                             struct tu_descriptor_set *set,
+                             const struct tu_descriptor_set_layout *layout,
+                             VkPipelineBindPoint bind_point)
+{
+   struct tu_fex_cmd_state *fex = &cmd->state.fex;
+   const bool fex_graphics = bind_point == VK_PIPELINE_BIND_POINT_GRAPHICS &&
+                             cmd->device->fex;
+   if (fex_graphics && (fex->mode & TU_FEX_MODE_PUSH_REUSE) &&
+       fex->push_prev_map && fex->push_prev_size == layout->size &&
+       !memcmp(fex->push_prev_map, set->mapped_ptr, layout->size)) {
+      set->va = fex->push_prev_iova;
+      tu_fex_count_push(cmd->device, fex->mode, true);
+      return true;
+   }
+
+   struct tu_cs_memory set_mem;
+   VkResult result = tu_cs_alloc(&cmd->sub_cs,
+                                 DIV_ROUND_UP(layout->size, FDL6_TEX_CONST_DWORDS * 4),
+                                 FDL6_TEX_CONST_DWORDS, &set_mem);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return false;
+   }
+
+   memcpy(set_mem.map, set->mapped_ptr, layout->size);
+   set->va = set_mem.iova;
+
+   if (fex_graphics) {
+      fex->push_prev_map = set_mem.map;
+      fex->push_prev_iova = set_mem.iova;
+      fex->push_prev_size = layout->size;
+      tu_fex_count_push(cmd->device, fex->mode, false);
+   }
+   return true;
+}
