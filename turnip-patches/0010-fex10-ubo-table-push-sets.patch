+/* FEX (fex10): the UBO table index of a driver-loaded UBO, -1 if it has none.
+ * The binning variant shares the draw variant's const state and only looks
+ * entries up.
+ */
+static int
+fex_ubo_table_idx(nir_shader *nir, struct ir3_shader_variant *v,
+                  const struct ir3_ubo_info *ubo)
+{
+   const struct ir3_const_state *const_state = ir3_const_state(v);
+
+   for (unsigned i = 0; i < const_state->num_fex_ubos; i++) {
+      if (const_state->fex_ubo[i].set == ubo->bindless_base &&
+          const_state->fex_ubo[i].block == ubo->block) {
+         nir->info.num_ubos =
+            MAX2(nir->info.num_ubos, const_state->fex_ubo[i].idx + 1);
+         return const_state->fex_ubo[i].idx;
+      }
+   }
+
+   if (v->binning_pass || ubo->block > UINT16_MAX)
+      return -1;
+
+   struct ir3_const_state *mut = ir3_const_state_mut(v);
+   if (mut->num_fex_ubos >= IR3_FEX_MAX_UBOS)
+      return -1;
+
+   /* Like ir3_get_driver_ubo: UBO 0 stays free. */
+   unsigned idx = MAX2(nir->info.num_ubos, 1);
+   if (idx >= IR3_FEX_UBO_IDX_LIMIT)
+      return -1;
+   nir->info.num_ubos = idx + 1;
+
+   mut->fex_ubo[mut->num_fex_ubos].idx = idx;
+   mut->fex_ubo[mut->num_fex_ubos].set = ubo->bindless_base;
+   mut->fex_ubo[mut->num_fex_ubos].block = ubo->block;
+   mut->num_fex_ubos++;
+   return idx;
+}
+
+/* FEX (fex10): after ir3_nir_lower_ubo_loads, loads from driver-loaded UBOs
+ * (ir3_shader_options::fex_cp_ubo_sets) that are still UBO loads have no
+ * known range, like D3D12 skinning shaders' dynamically indexed bone
+ * matrices. They read through the bindless descriptor, so the draw still
+ * needs the push set rebound for every root constant buffer change. Read
+ * them through the shader's own UBO table instead: the driver writes the
+ * entry from the pushed descriptor before each draw (tu_fex_emit_cp_ubos),
+ * and the shader no longer reads the push set through descriptors.
+ */
+bool
+ir3_nir_fex_ubo_table(nir_shader *nir, struct ir3_shader_variant *v)
+{
+   if (!v->shader_options.fex_ubo_table || !v->shader_options.fex_cp_ubo_sets)
+      return false;
+
+   bool progress = false;
+   nir_foreach_function_impl (impl, nir) {
+      bool impl_progress = false;
+      nir_builder b = nir_builder_create(impl);
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic != nir_intrinsic_load_ubo)
+               continue;
+
+            struct ir3_ubo_info ubo = {};
+            if (!get_ubo_info(intr, &ubo) || !fex_cp_ubo(v, &ubo))
+               continue;
+
+            int idx = fex_ubo_table_idx(nir, v, &ubo);
+            if (idx < 0)
+               continue;
+
+            b.cursor = nir_before_instr(instr);
+            nir_src_rewrite(&intr->src[0], nir_imm_int(&b, idx));
+            impl_progress = true;
+         }
+      }
+      progress |= nir_progress(impl_progress, impl, nir_metadata_control_flow);
+   }
+
+   return progress;
+}
