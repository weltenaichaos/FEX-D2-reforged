+void
+tu_fex_count_noalias(struct tu_device *dev,
+                     const struct tu_fex_noalias_stats *main_bin,
+                     const struct tu_fex_noalias_stats *alt_bin)
+{
+   struct tu_fex_device *fex = dev->fex;
+   if (!fex || !fex->na_stats)
+      return;
+   struct tu_fex_channel *c = fex->chan;
+   const struct tu_fex_noalias_stats *b[2] = { main_bin, alt_bin };
+   __atomic_fetch_add(&c->na_shaders, 1, __ATOMIC_RELAXED);
+   for (unsigned i = 0; i < 2; i++) {
+      __atomic_fetch_add(&c->na_instr[i], b[i]->instr, __ATOMIC_RELAXED);
+      __atomic_fetch_add(&c->na_nops[i], b[i]->nops, __ATOMIC_RELAXED);
+      __atomic_fetch_add(&c->na_alias[i], b[i]->alias, __ATOMIC_RELAXED);
+      __atomic_fetch_add(&c->na_movs[i], b[i]->movs, __ATOMIC_RELAXED);
+      __atomic_fetch_add(&c->na_regs[i], b[i]->regs, __ATOMIC_RELAXED);
+      __atomic_fetch_add(&c->na_ss_stall[i], b[i]->ss_stall, __ATOMIC_RELAXED);
+      __atomic_fetch_add(&c->na_sy_stall[i], b[i]->sy_stall, __ATOMIC_RELAXED);
+   }
+}
+
+void
+tu_fex_count_noalias_refused(struct tu_device *dev)
+{
+   struct tu_fex_device *fex = dev->fex;
+   if (!fex || !fex->na_stats)
+      return;
+   __atomic_fetch_add(&fex->chan->na_refused, 1, __ATOMIC_RELAXED);
+}
+
+void
+tu_fex_count_noalias_pipeline(struct tu_device *dev, bool usable)
+{
+   struct tu_fex_device *fex = dev->fex;
+   if (!fex || !fex->na_stats)
+      return;
+   __atomic_fetch_add(&fex->chan->na_pipes[usable ? 0 : 1], 1, __ATOMIC_RELAXED);
+}
