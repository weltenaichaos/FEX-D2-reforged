+
+/* FEX link, fex11 (TU_FEX_MODE_SWITCH): follows the draw state groups set in
+ * draw_cs in recording order, so a pipeline switch can tell which groups the
+ * GPU already has. exec[] holds the groups as of the last draw; a group set
+ * again to the address it had then is skipped by the command processor
+ * (the stock path relies on that for a pipeline bound twice). The tracking
+ * runs in both modes on a7xx (for the statistics); only TU_FEX_MODE_SWITCH
+ * changes what is emitted.
+ */
+static inline bool
+tu_fex_sw_tracking(const struct tu_cmd_buffer *cmd)
+{
+   return cmd->device->fex && cmd->device->fex->desc_patch;
+}
+
+static_assert(TU_DRAW_STATE_COUNT <= 32, "fex11 tracks groups in a 32-bit mask");
+
+static inline void
+tu_fex_sw_note(struct tu_cmd_buffer *cmd, uint32_t id, struct tu_draw_state st)
+{
+   if (!tu_fex_sw_tracking(cmd) || id >= 32)
+      return;
+   struct tu_fex_cmd_state *f = &cmd->state.fex;
+   f->sw_set[id].iova = (st.size && st.iova) ? st.iova : 0;
+   f->sw_set[id].size = (st.size && st.iova) ? st.size : 0;
+   f->sw_set[id].map = (st.size && st.iova && !st.writeable) ? st.fex_map : NULL;
+   f->sw_pending |= 1u << id;
+}
+
+/* A group set while its bytes are still to be written (tu_cmd_dynamic_state). */
+static inline void
+tu_fex_sw_note_unknown(struct tu_cmd_buffer *cmd, uint32_t id, struct tu_draw_state st)
+{
+   st.fex_map = NULL;
+   tu_fex_sw_note(cmd, id, st);
+}
+
+/* Draw states disabled or changed behind the tracking (blits, secondaries):
+ * nothing is known until the next full emit. */
+void
+tu_fex_sw_forget(struct tu_cmd_buffer *cmd)
+{
+   struct tu_fex_cmd_state *f = &cmd->state.fex;
+   f->sw_known = 0;
+   f->sw_pending = 0;
+   f->sw_inval = 0;
+   f->sw_stock_pending = false;
+}
+
+/* A draw: what was set is what the GPU has now. */
+static inline void
+tu_fex_sw_drawn(struct tu_cmd_buffer *cmd)
+{
+   struct tu_fex_cmd_state *f = &cmd->state.fex;
+   if (!f->sw_pending && !f->sw_inval && !f->sw_stock_pending)
+      return;
+   u_foreach_bit (id, f->sw_pending)
+      f->sw_exec[id] = f->sw_set[id];
+   f->sw_known |= f->sw_pending;
+   f->sw_pending = 0;
+   f->sw_inval = 0;
+   f->sw_stock_pending = false;
+}
+
+/* Only register writes (no state loads, no conditions): such a group can be
+ * skipped when the GPU already ran the same bytes, whatever was reset since. */
+static bool
+tu_fex_regs_only(const uint32_t *p, uint32_t n)
+{
+   uint32_t i = 0;
+   while (i < n) {
+      const uint32_t hdr = p[i];
+      uint32_t len;
+      if (pkt_is_type4(hdr)) {
+         len = type4_pkt_size(hdr);
+      } else if (pkt_is_type7(hdr)) {
+         const uint32_t op = cp_type7_opcode(hdr);
+         if (op != CP_CONTEXT_REG_BUNCH && op != CP_NOP)
+            return false;
+         len = type7_pkt_size(hdr);
+      } else {
+         return false;
+      }
+      i += 1 + len;
+   }
+   return i == n;
+}
+
+/* Whether setting group id to st makes the command processor run it (as far
+ * as the tracking knows): a new address, or not known. */
+static inline bool
+tu_fex_sw_runs(const struct tu_cmd_buffer *cmd, uint32_t id,
+               struct tu_draw_state st, bool dirty)
+{
+   const struct tu_fex_cmd_state *f = &cmd->state.fex;
+   if (dirty || !(f->sw_known & (1u << id)))
+      return st.size && st.iova;
+   return st.size && st.iova && f->sw_exec[id].iova != st.iova;
+}
+
+/* With TU_FEX_MODE_SWITCH: the state to set for group id - the copy the GPU
+ * has as of the last draw when its bytes are the same. */
+static inline struct tu_draw_state
+tu_fex_sw_pick(const struct tu_cmd_buffer *cmd, uint32_t id,
+               struct tu_draw_state st)
+{
+   const struct tu_fex_cmd_state *f = &cmd->state.fex;
+   if (!(f->mode & TU_FEX_MODE_SWITCH) || !(f->sw_known & (1u << id)) ||
+       !st.size || !st.iova || st.writeable || !st.fex_map)
+      return st;
+   const auto *e = &f->sw_exec[id];
+   if (!e->map || e->size != st.size || e->iova == st.iova)
+      return st;
+   if (memcmp(st.fex_map, e->map, st.size * sizeof(uint32_t)) ||
+       !tu_fex_regs_only(st.fex_map, st.size))
+      return st;
+   st.iova = e->iova;
+   st.fex_map = e->map;
+   return st;
+}
+
+/* A bind's group: picked, emitted, noted, counted. */
+static inline void
+tu_fex_sw_emit_bind(struct tu_cmd_buffer *cmd, struct tu_cs *cs, uint32_t id,
+                    struct tu_draw_state st, int dirty)
+{
+   if (dirty <= 0)
+      st = tu_fex_sw_pick(cmd, id, st);
+   if (tu_fex_sw_tracking(cmd)) {
+      const bool d = dirty > 0 ||
+         (dirty < 0 && (id == TU_DRAW_STATE_VS || id == TU_DRAW_STATE_VS_BINNING ||
+                        id == TU_DRAW_STATE_HS || id == TU_DRAW_STATE_DS ||
+                        id == TU_DRAW_STATE_GS || id == TU_DRAW_STATE_GS_BINNING ||
+                        id == TU_DRAW_STATE_FS || st.writeable));
+      if (tu_fex_sw_runs(cmd, id, st, d))
+         cmd->state.fex.sw_groups_run++;
+      else if (st.size && st.iova)
+         cmd->state.fex.sw_groups_kept++;
+   }
+   tu_cs_emit_draw_state_dirty(cs, id, st, dirty);
+   tu_fex_sw_note(cmd, id, st);
+}
+
+/* A group re-made at a draw (dynamic state, depth plane): picked, noted,
+ * counted. */
+static inline struct tu_draw_state
+tu_fex_sw_draw_group(struct tu_cmd_buffer *cmd, uint32_t id,
+                     struct tu_draw_state st)
+{
+   if (!tu_fex_sw_tracking(cmd))
+      return st;
+   st = tu_fex_sw_pick(cmd, id, st);
+   if (tu_fex_sw_runs(cmd, id, st, st.writeable))
+      cmd->state.fex.sw_draw_run++;
+   else if (st.size && st.iova)
+      cmd->state.fex.sw_draw_kept++;
+   tu_fex_sw_note(cmd, id, st);
+   return st;
+}
+
+/* With TU_FEX_MODE_SWITCH, a graphics pipeline bind that only sends what
+ * changed. Returns false to take the stock path (which then notes its groups).
+ * a7xx only (tu_fex_device::desc_patch). */
+static bool
+tu_fex_sw_bind(struct tu_cmd_buffer *cmd, struct tu_cs *cs,
+               const struct tu_pipeline *pipeline, uint32_t set_state_mask)
+{
+   struct tu_fex_cmd_state *f = &cmd->state.fex;
+   if (!tu_fex_sw_tracking(cmd))
+      return false;
+   f->sw_binds++;
+   if (!(f->mode & TU_FEX_MODE_SWITCH))
+      return false;
+
+   const struct tu_program_state *prog = &pipeline->program;
+   const uint32_t geom = BIT(TU_DRAW_STATE_HS) | BIT(TU_DRAW_STATE_DS) |
+                         BIT(TU_DRAW_STATE_GS) | BIT(TU_DRAW_STATE_GS_BINNING);
+   const uint32_t geom_reset = A7XX_SP_UPDATE_CNTL_HS_STATE |
+                               A7XX_SP_UPDATE_CNTL_DS_STATE |
+                               A7XX_SP_UPDATE_CNTL_GS_STATE;
+   /* The empty tessellation/geometry stages must be what the GPU has. */
+   if (!prog->fex_simple || f->sw_stock_pending ||
+       (f->sw_known & geom) != geom || (f->sw_inval & geom_reset) ||
+       f->sw_exec[TU_DRAW_STATE_HS].iova != (prog->hs_state.size ? prog->hs_state.iova : 0) ||
+       f->sw_exec[TU_DRAW_STATE_DS].iova != (prog->ds_state.size ? prog->ds_state.iova : 0) ||
+       f->sw_exec[TU_DRAW_STATE_GS].iova != (prog->gs_state.size ? prog->gs_state.iova : 0) ||
+       f->sw_exec[TU_DRAW_STATE_GS_BINNING].iova !=
+          (prog->gs_binning_state.size ? prog->gs_binning_state.iova : 0)) {
+      f->sw_stock++;
+      return false;
+   }
+
+   const uint32_t vsb = BIT(TU_DRAW_STATE_VS) | BIT(TU_DRAW_STATE_VS_BINNING);
+   const bool vs_same =
+      (f->sw_known & vsb) == vsb &&
+      !(f->sw_inval & A7XX_SP_UPDATE_CNTL_VS_STATE) &&
+      f->sw_exec[TU_DRAW_STATE_VS].iova ==
+         (prog->vs_state.size ? prog->vs_state.iova : 0) &&
+      f->sw_exec[TU_DRAW_STATE_VS_BINNING].iova ==
+         (prog->vs_binning_state.size ? prog->vs_binning_state.iova : 0);
+   const bool fs_same =
+      (f->sw_known & BIT(TU_DRAW_STATE_FS)) &&
+      !(f->sw_inval & A7XX_SP_UPDATE_CNTL_FS_STATE) &&
+      f->sw_exec[TU_DRAW_STATE_FS].iova ==
+         (prog->fs_state.size ? prog->fs_state.iova : 0);
+
+   /* Reset the changed stages before their config registers are written
+    * (the order of the stock program config), and before the draw that
+    * runs their groups again. */
+   if (!vs_same || !fs_same) {
+      tu_cs_emit_regs(cs, SP_UPDATE_CNTL(A7XX, .vs_state = !vs_same,
+                                         .fs_state = !fs_same,
+                                         .gfx_uav = true));
+      f->sw_inval |= (vs_same ? 0 : A7XX_SP_UPDATE_CNTL_VS_STATE) |
+                     (fs_same ? 0 : A7XX_SP_UPDATE_CNTL_FS_STATE);
+      f->sw_stage_resets += !vs_same + !fs_same;
+   }
+   f->sw_stages_kept += vs_same + fs_same;
+   for (unsigned i = 0; i < 2; i++) {
+      if (i == 0 ? vs_same : fs_same)
+         continue;
+      const struct tu_draw_state *c = &prog->fex_stage_config[i];
+      tu_cs_reserve(cs, c->size);
+      tu_cs_emit_array(cs, c->fex_map, c->size);
+   }
+
+   tu_cs_emit_pkt7(cs, CP_SET_DRAW_STATE, 3 * (10 + util_bitcount(set_state_mask)));
+   tu_fex_sw_emit_bind(cmd, cs, TU_DRAW_STATE_PROGRAM_CONFIG, prog->fex_common_config, 0);
+   tu_fex_sw_emit_bind(cmd, cs, TU_DRAW_STATE_VS, prog->vs_state, !vs_same);
+   tu_fex_sw_emit_bind(cmd, cs, TU_DRAW_STATE_VS_BINNING, prog->vs_binning_state, !vs_same);
+   tu_fex_sw_emit_bind(cmd, cs, TU_DRAW_STATE_HS, prog->hs_state, 0);
+   tu_fex_sw_emit_bind(cmd, cs, TU_DRAW_STATE_DS, prog->ds_state, 0);
+   tu_fex_sw_emit_bind(cmd, cs, TU_DRAW_STATE_GS, prog->gs_state, 0);
+   tu_fex_sw_emit_bind(cmd, cs, TU_DRAW_STATE_GS_BINNING, prog->gs_binning_state, 0);
+   tu_fex_sw_emit_bind(cmd, cs, TU_DRAW_STATE_FS, prog->fs_state, !fs_same);
+   tu_fex_sw_emit_bind(cmd, cs, TU_DRAW_STATE_VPC, prog->vpc_state, 0);
+   tu_fex_sw_emit_bind(cmd, cs, TU_DRAW_STATE_PRIM_MODE_GMEM, pipeline->prim_order.state_gmem, 0);
+   u_foreach_bit(i, set_state_mask)
+      tu_fex_sw_emit_bind(cmd, cs, TU_DRAW_STATE_DYNAMIC + i, pipeline->dynamic_state[i], 0);
+   return true;
+}
