+   if (loads_left || !ctx->preamble_waited) {
+      /* With no register loads at all there is no wait to come first. */
+      bool any_load = loads_left;
+      foreach_instr (instr, &ctx->block->instr_list) {
+         if (is_sy_producer(instr)) {
+            any_load = true;
+            break;
