+/* FEX (fex6): store each preamble value once.
+ *
+ * nir_opt_preamble gives every moved definition its own const slot. When the
+ * main shader computes the same uniform value in several places that do not
+ * dominate each other (for example once per unrolled light), the preamble
+ * ends up storing one value to several slots: the D2R lighting shader writes
+ * many values four times. After CSE those stores share a source, so keep the
+ * first store and point the other slots' loads at it. Only 32-bit and 1-bit
+ * values: 16-bit slots may be promoted to float per slot when lowered.
+ */
+bool
+ir3_nir_fex_dedupe_preamble_stores(nir_shader *nir)
+{
+   nir_function_impl *main = nir_shader_get_entrypoint(nir);
+   if (!main->preamble)
+      return false;
+
+   nir_function_impl *preamble = main->preamble->impl;
+
+   /* Equal values must share a definition. */
+   nir_opt_cse(nir);
+
+   unsigned slots = 0;
+   nir_foreach_block (block, preamble) {
+      nir_foreach_instr (instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+         if (intrin->intrinsic != nir_intrinsic_store_preamble)
+            continue;
+         slots = MAX2(slots, nir_intrinsic_base(intrin) +
+                                intrin->src[0].ssa->num_components *
+                                   DIV_ROUND_UP(intrin->src[0].ssa->bit_size, 32));
+      }
+   }
+   if (slots == 0)
+      return false;
+
+   int *remap = malloc(slots * sizeof(int));
+   if (!remap)
+      return false;
+   for (unsigned i = 0; i < slots; i++)
+      remap[i] = -1;
+
+   struct hash_table *first = _mesa_pointer_hash_table_create(NULL);
+   bool progress = false;
+
+   nir_foreach_block (block, preamble) {
+      nir_foreach_instr_safe (instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+         if (intrin->intrinsic != nir_intrinsic_store_preamble)
+            continue;
+
+         nir_def *src = intrin->src[0].ssa;
+         if (src->bit_size != 32 && src->bit_size != 1)
+            continue;
+
+         struct hash_entry *entry = _mesa_hash_table_search(first, src);
+         if (!entry) {
+            _mesa_hash_table_insert(first, src, intrin);
+            continue;
+         }
+
+         nir_intrinsic_instr *kept = entry->data;
+         remap[nir_intrinsic_base(intrin)] = nir_intrinsic_base(kept);
+         nir_instr_remove(instr);
+         progress = true;
+      }
+   }
+
+   if (progress) {
+      nir_foreach_block (block, main) {
+         nir_foreach_instr (instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+            if (intrin->intrinsic != nir_intrinsic_load_preamble)
+               continue;
+            unsigned base = nir_intrinsic_base(intrin);
+            if (base < slots && remap[base] >= 0)
+               nir_intrinsic_set_base(intrin, remap[base]);
+         }
+      }
+   }
+
+   _mesa_hash_table_destroy(first, NULL);
+   free(remap);
+
+   nir_progress(progress, preamble, nir_metadata_control_flow);
+   return nir_progress(progress, main, nir_metadata_control_flow);
+}
