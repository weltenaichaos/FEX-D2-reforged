+
+   bool loads_left = false;
+   foreach_sched_node (n, &ctx->dag->heads) {
+      if (!is_sy_producer(n->instr))
+         continue;
+      loads_left = true;
+      /* Not when it would cost nops or a sync of its own here. */
+      if (!ctx->preamble_hoist_regs || n->delay ||
+          (n->instr->flags & (IR3_INSTR_SS | IR3_INSTR_SY)))
+         continue;
+      if (!chosen || chosen->max_delay < n->max_delay)
+         chosen = n;
+   }
+   if (chosen)
+      return chosen;
+
+   /* Register loads still waiting on something: let them come first. */
+   if (!loads_left) {
+      foreach_instr (instr, &ctx->unscheduled_list) {
+         if (is_sy_producer(instr)) {
+            loads_left = true;
+            break;
+         }
+      }
+   }
