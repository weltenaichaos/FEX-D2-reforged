+      if (is_sy_producer(instr)) {
+         if (!ctx->preamble_hoist_regs)
+            continue;
+         int live = live_effect(instr);
+         if (live > 0 && ctx->live_regs + live > FEX_PREAMBLE_LIVE_BUDGET)
+            continue;
+      }
+
+      if (!check_instr(ctx, notes, instr))
+         continue;
