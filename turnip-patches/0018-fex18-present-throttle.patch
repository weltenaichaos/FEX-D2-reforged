+/* fex18: the present hook (wsi_device::fex_present_mode/_done). The WSI
+ * belongs to the physical device, so it uses the process's channel like
+ * the memory budget query does. */
+static struct tu_fex_channel *tu_fex_present_chan;
+
+static uint32_t
+tu_fex_present_mode(void)
+{
+   const uint32_t mode =
+      __atomic_load_n(&tu_fex_present_chan->mode, __ATOMIC_RELAXED);
+   return (mode & TU_FEX_MODE_PRESENT_NO_THROTTLE) ? WSI_FEX_PRESENT_NO_THROTTLE : 0;
+}
+
+static void
+tu_fex_store_max(volatile uint32_t *slot, uint64_t ns)
+{
+   const uint64_t us64 = ns / 1000;
+   const uint32_t us = us64 > UINT32_MAX ? UINT32_MAX : (uint32_t)us64;
+   uint32_t cur = __atomic_load_n(slot, __ATOMIC_RELAXED);
+   while (us > cur &&
+          !__atomic_compare_exchange_n(slot, &cur, us, true, __ATOMIC_RELAXED,
+                                       __ATOMIC_RELAXED)) {
+   }
+}
+
+static void
+tu_fex_present_done(const struct wsi_fex_present *p)
+{
+   struct tu_fex_channel *c = tu_fex_present_chan;
+   const unsigned k = (p->mode & WSI_FEX_PRESENT_NO_THROTTLE) ? 1 : 0;
+   __atomic_fetch_add(&c->pr_calls[k], 1, __ATOMIC_RELAXED);
+   if (p->pending)
+      __atomic_fetch_add(&c->pr_pending[k], p->pending, __ATOMIC_RELAXED);
+   if (p->skipped)
+      __atomic_fetch_add(&c->pr_skipped, p->skipped, __ATOMIC_RELAXED);
+   if (p->stock_path)
+      __atomic_fetch_add(&c->pr_stock_path, p->stock_path, __ATOMIC_RELAXED);
+   __atomic_fetch_add(&c->pr_gap[k], p->gap, __ATOMIC_RELAXED);
+   __atomic_fetch_add(&c->pr_throttle_ns[k], p->throttle_ns, __ATOMIC_RELAXED);
+   if (p->wait_ns) {
+      __atomic_fetch_add(&c->pr_wait_ns[k], p->wait_ns, __ATOMIC_RELAXED);
+      tu_fex_store_max(&c->pr_wait_max_us[k], p->wait_ns);
+   }
+   __atomic_fetch_add(&c->pr_submit_ns[k], p->submit_ns, __ATOMIC_RELAXED);
+   __atomic_fetch_add(&c->pr_queue_ns[k], p->queue_ns, __ATOMIC_RELAXED);
+   __atomic_fetch_add(&c->pr_total_ns[k], p->total_ns, __ATOMIC_RELAXED);
+   tu_fex_store_max(&c->pr_total_max_us[k], p->total_ns);
+}
+
+void
+tu_fex_wsi_init(struct wsi_device *wsi)
+{
+   struct tu_fex_channel *chan = tu_fex_budget_channel();
+   if (!chan || chan->ext_size < TU_FEX_CHANNEL_PRESENT_SIZE ||
+       !tu_fex_readable(chan, TU_FEX_CHANNEL_PRESENT_SIZE))
+      return;
+   const char *pr = getenv("TU_FEX_PRESENT");
+   if (pr && !strcmp(pr, "0"))
+      return;
+   tu_fex_present_chan = chan;
+   wsi->fex_present_mode = tu_fex_present_mode;
+   wsi->fex_present_done = tu_fex_present_done;
+   __atomic_fetch_or(&chan->status2, TU_FEX_STATUS2_PRESENT, __ATOMIC_RELEASE);
+}
