+   cmd->state.fex.clear_fs_disable =
+      CHIP >= A7XX && (cmd->state.fex.mode & TU_FEX_MODE_DEPTH_CLEAR_FASTZ);
    tu_clear_sysmem_attachments<CHIP>(cmd, 1, &clear, 1, &rect);
+   cmd->state.fex.clear_fs_disable = false;
    tu_cond_exec_end(cs);
 }
 TU_GENX(tu_fex_clear_depth_3d);
