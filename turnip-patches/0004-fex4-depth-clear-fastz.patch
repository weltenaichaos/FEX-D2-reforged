+      tu_cs_emit_regs(cs, RB_RENDER_CNTL(CHIP,
+            .fs_disable = true,
+            .raster_mode = TYPE_TILED,
+            .raster_direction = LR_TB));
+      tu_cs_emit_regs(cs, GRAS_SU_RENDER_CNTL(CHIP, .fs_disable = true));
+      tu_cs_emit_regs(cs, SP_RENDER_CNTL(CHIP, .fs_disable = true));
+   }
+
    unsigned num_rts = util_bitcount(clear_rts);
    uint32_t packed_clear_value[MAX_RTS][4];
 
@@ -5407,6 +5421,9 @@ TU_GENX(tu_clear_sysmem_attachment);
  * cache, so no CCU color -> depth flush and no wait for idle are needed after
