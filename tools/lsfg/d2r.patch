+    // Copy the game's present chain into a deferred job. False when it holds
+    // a kind this copy doesn't know (that frame then presents inline).
+    bool copyPresentChain(const void* pNext, LsContext::DeferJob& job) {
+        for (const auto* node = static_cast<const VkBaseInStructure*>(pNext);
+                node != nullptr; node = node->pNext) {
+            switch (node->sType) {
+            case VK_STRUCTURE_TYPE_PRESENT_ID_KHR: {
+                const auto* ids = reinterpret_cast<const VkPresentIdKHR*>(node);
+                if (ids->swapchainCount != 1) return false;
+                job.hasId = ids->pPresentIds != nullptr;
+                job.presentId = ids->pPresentIds ? *ids->pPresentIds : 0;
+                break;
+            }
+            case VK_STRUCTURE_TYPE_SWAPCHAIN_PRESENT_MODE_INFO_EXT: {
+                const auto* modes = reinterpret_cast<const VkSwapchainPresentModeInfoEXT*>(node);
+                if (modes->swapchainCount != 1 || !modes->pPresentModes) return false;
+                job.hasMode = true;
+                job.mode = *modes->pPresentModes;
+                break;
+            }
+            case VK_STRUCTURE_TYPE_SWAPCHAIN_PRESENT_FENCE_INFO_EXT: {
+                const auto* fences = reinterpret_cast<const VkSwapchainPresentFenceInfoEXT*>(node);
+                if (fences->swapchainCount != 1 || !fences->pFences) return false;
+                job.hasFence = true;
+                job.fence = *fences->pFences;
+                break;
+            }
+            default:
+                return false;
+            }
+        }
+        return true;
+    }
