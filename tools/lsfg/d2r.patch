+    // readyNs: when the thread could start waiting for the job's slot (0:
+    // now, after a generated frame's drawn wait).
+    JobTimes runDeferJob(const LsContext::DeferJob& job, bool flush, int64_t readyNs = 0) {
+        JobTimes t{};
