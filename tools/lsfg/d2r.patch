+            chain = &fenceInfo;
+        }
+        if (job.hasMode) {
+            modeInfo = VkSwapchainPresentModeInfoEXT{
+                .sType = VK_STRUCTURE_TYPE_SWAPCHAIN_PRESENT_MODE_INFO_EXT,
+                .pNext = chain,
+                .swapchainCount = 1,
+                .pPresentModes = &job.mode,
