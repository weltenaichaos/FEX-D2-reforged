+    u.cmdBindSets(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, u.pipeLayout, 0, 1, &set, 0, nullptr);
+    u.cmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, u.maskPipeline);
+    u.cmdPushConstants(cmd, u.pipeLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push), &push);
+    u.cmdDispatch(cmd, u.words, (this->extent.height + 7) / 8, 1);
+    const VkMemoryBarrier between{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_SHADER_READ_BIT
+    };
+    Layer::ovkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &between, 0, nullptr, 0, nullptr);
+    u.cmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, u.motionPipeline);
+    u.cmdDispatch(cmd, u.tilesX, u.tilesY, 1);
