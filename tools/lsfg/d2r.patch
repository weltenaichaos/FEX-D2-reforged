+            s.frames++;
+            if (t.startNs > job.dueNs)
+                s.lateNs += static_cast<uint64_t>(t.startNs - job.dueNs);
+            s.presentNs += static_cast<uint64_t>(t.endNs - t.startNs);
+        }
+        if (t.res < 0)
+            s.errors++;
+        s.result = worseResult(s.result, t.res);
+    }
