+                << errno << ")\n";
+        std::unique_lock<std::mutex> lk(s.lock);
+        for (;;) {
+            s.cv.wait(lk, [&] { return s.jobNext < s.jobCount || s.stop; });
+            if (s.jobNext >= s.jobCount)
+                break;
+            const LsContext::DeferJob job = s.jobs.at(s.jobNext);
