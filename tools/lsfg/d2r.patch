+    VkResult presentDeferJob(const LsContext::DeferJob& job) {
+        VkSwapchainPresentFenceInfoEXT fenceInfo{};
+        VkSwapchainPresentModeInfoEXT modeInfo{};
+        VkPresentIdKHR idInfo{};
+        const void* chain = nullptr;
+        if (job.hasFence) {
+            fenceInfo = VkSwapchainPresentFenceInfoEXT{
+                .sType = VK_STRUCTURE_TYPE_SWAPCHAIN_PRESENT_FENCE_INFO_EXT,
+                .pNext = chain,
+                .swapchainCount = 1,
+                .pFences = &job.fence,
+            };
+            chain = &fenceInfo;
+        }
+        if (job.hasMode) {
+            modeInfo = VkSwapchainPresentModeInfoEXT{
+                .sType = VK_STRUCTURE_TYPE_SWAPCHAIN_PRESENT_MODE_INFO_EXT,
+                .pNext = chain,
+                .swapchainCount = 1,
+                .pPresentModes = &job.mode,
+            };
+            chain = &modeInfo;
+        }
+        if (job.hasId) {
+            idInfo = VkPresentIdKHR{
+                .sType = VK_STRUCTURE_TYPE_PRESENT_ID_KHR,
+                .pNext = chain,
+                .swapchainCount = 1,
+                .pPresentIds = &job.presentId,
+            };
+            chain = &idInfo;
+        }
+        const VkPresentInfoKHR info{
+            .sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR,
+            .pNext = chain,
+            .waitSemaphoreCount = job.waitCount,
+            .pWaitSemaphores = job.waits.data(),
+            .swapchainCount = 1,
+            .pSwapchains = &job.swapchain,
+            .pImageIndices = &job.imageIdx,
+        };
+        // the game's submits take this lock too (layer.cpp), not VKD3D's own
+        const std::lock_guard<std::recursive_mutex> qlock(Layer::layerQueueMutex());
+        return Layer::ovkQueuePresentKHR(job.queue, &info);
+    }
