+VkResult LsContext::takeDeferred(bool fromAcquire) {
+#ifdef __ANDROID__
+    if (!this->defer)
+        return VK_SUCCESS;
+    DeferState& s = *this->defer;
+    std::unique_lock<std::mutex> lk(s.lock);
+    if (s.jobNext < s.jobCount) {
+        const int64_t startNs = nowNs();
+        s.cv.wait(lk, [&] { return s.jobNext >= s.jobCount || s.done; });
+        const auto waited = static_cast<uint64_t>(nowNs() - startNs);
+        if (fromAcquire)
+            s.acquireWaitNs += waited;
+        else
+            s.waitNs += waited;
+    }
+    const VkResult res = s.result;
+    s.result = VK_SUCCESS;
+    return res;
+#else
+    (void)fromAcquire;
+    return VK_SUCCESS;
+#endif
+}
+
+#ifdef __ANDROID__
+LsContext::~LsContext() {
+    if (!this->defer)
+        return;
+    const std::shared_ptr<DeferState> state = this->defer;
+    std::unique_lock<std::mutex> lk(state->lock);
+    state->stop = true;
+    state->cv.notify_all();
+    if (state->started
+            && !state->cv.wait_for(lk, std::chrono::seconds(1), [&] { return state->done; }))
+        std::cerr << "lsfg-vk: present thread didn't end within 1 s\n";
+}
+#endif
