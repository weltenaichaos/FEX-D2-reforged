+void LsContext::dropEarly(std::vector<VkSemaphore>& semaphores) {
+#ifdef __ANDROID__
+    if (!this->early.ready)
+        return;
+    this->early.ready = false;
+    auto& pass = this->passInfos.at(this->early.frameIdx % 8);
+    for (auto& sem : semaphores)
+        if (sem == this->early.gameSemaphore)
+            sem = pass.preCopySemaphores.at(0).handle();
+    // its generated frames hold swapchain images: out with them now
+    for (uint32_t j = 0; j < this->early.genCount; j++)
+        runDeferJob(this->early.genJobs.at(j), true);
+    this->statsEarlyDropped++;
+    this->frameIdx++;
+#else
+    (void)semaphores;
+#endif
+}
