+    JobTimes runDeferJob(const LsContext::DeferJob& job, bool flush) {
+        JobTimes t{};
+        if (job.hasDrawn) {
+            t.drawnTimeout = job.drawn.wait(100'000'000ull) != VK_SUCCESS;
+            t.drawnNs = nowNs();
+        }
+        if (!flush)
+            sleepUntilNs(job.dueNs);
+        t.startNs = nowNs();
+        t.res = presentDeferJob(job);
+        t.endNs = nowNs();
+        return t;
+    }
