+    inline void cpuRelax() {
+#if defined(__aarch64__)
+        asm volatile("yield" ::: "memory");
+#endif
+    }
+
+    // Waits until dueNs: sleeps until presentEarlyNs() before it (from
+    // sleepFromNs on, when the thread was ready for the job), then waits the
+    // rest on the CPU.
+    struct PreciseWait {
+        int64_t wokeLateNs{-1}; // the thread was ready to wait on the CPU this long after it should have been (-1: not ready in time to sleep)
+        int64_t spinNs{0};      // time waited on the CPU
+    };
+
+    PreciseWait waitUntilPrecise(int64_t dueNs, int64_t readyNs) {
+        PreciseWait w;
+        const int64_t early = presentEarlyNs();
+        const int64_t wakeNs = dueNs - early;
+        if (readyNs < wakeNs) {
+            sleepUntilNs(wakeNs);
+            w.wokeLateNs = std::max<int64_t>(0, nowNs() - wakeNs);
+        }
+        if (early > 0) {
+            const int64_t spinStartNs = nowNs();
+            while (nowNs() < dueNs)
+                cpuRelax();
+            w.spinNs = std::max<int64_t>(0, nowNs() - spinStartNs);
+        }
+        return w;
+    }
