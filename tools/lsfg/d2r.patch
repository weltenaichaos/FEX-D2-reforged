diff --git a/shaders/ui_cand.comp b/shaders/ui_cand.comp
new file mode 100644
index 0000000..33ccfa8
--- /dev/null
+++ b/shaders/ui_cand.comp
@@ -0,0 +1,94 @@
+#version 450
+// D2R layer 13: each 16 x 16 tile's candidate moves for ui_compose.comp, one
+// thread per tile (layer 12 had one thread of every compose workgroup do this
+// while the other 255 waited). The shifts d of the matched tiles up to 2 tiles
+// away (nearest first, each once with its best match), without those only one
+// tile has (often a still map line matched along itself), plus no shift.
+// Word 0: candidate count | 256 UI up to 2 tiles away | 512 a candidate with a
+// shift; words 1-16: dx + 128 | (dy + 128) << 8 | best unmatched bits << 16.
+// Built with: glslangValidator -V --target-env vulkan1.1 -o ui_cand.spv ui_cand.comp
+//             xxd -i ui_cand.spv > ../src/extract/ui_cand_spv.h
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+layout(set = 0, binding = 6, std430) readonly buffer Tiles {
+    uint info[];
+} tiles;
+layout(set = 0, binding = 7, std430) writeonly buffer Cands {
+    uint words[]; // 17 per tile
+} cands;
+
+layout(push_constant) uniform Push {
+    ivec2 size;
+    float tol;
+    uint count;
+    int radius;
+    uint prevValid;
+    uint words;
+    uint pad;
+} pc;
+
+const uint STATE_MATCHED = 1u;
+const uint MAXCAND = 16u;
+const uint CAND_WORDS = 17u;
+const uint FLAG_NEAR = 256u;
+const uint FLAG_MOVING = 512u;
+
+void main() {
+    const ivec2 tilesN = ivec2((pc.size + 15) / 16);
+    const uint idx = gl_GlobalInvocationID.x;
+    if (idx >= uint(tilesN.x * tilesN.y))
+        return;
+    const ivec2 tile = ivec2(int(idx) % tilesN.x, int(idx) / tilesN.x);
+
+    ivec2 candD[MAXCAND];
+    uint candMis[MAXCAND];
+    uint candCount[MAXCAND];
+    uint cn = 0u;
+    bool near = false;
+    for (int k = 0; k < 9 + 25; k++) {
+        // k 0-8: the tile and its neighbours, then the ring 2 tiles away
+        const ivec2 o = k < 9 ? ivec2(k % 3 - 1, k / 3 - 1) : ivec2((k - 9) % 5 - 2, (k - 9) / 5 - 2);
+        if (k >= 9 && abs(o.x) < 2 && abs(o.y) < 2)
+            continue;
+        const ivec2 t = tile + o;
+        if (t.x < 0 || t.y < 0 || t.x >= tilesN.x || t.y >= tilesN.y)
+            continue;
+        const uint info = tiles.info[uint(t.y * tilesN.x + t.x)];
+        if (((info >> 16) & 3u) != 0u)
+            near = true;
+        if (((info >> 16) & 3u) != STATE_MATCHED)
+            continue;
+        const ivec2 dv = ivec2(int(info & 0xFFu) - 128, int((info >> 8) & 0xFFu) - 128);
+        const uint mis = (info >> 18) & 1023u;
+        bool seen = false;
+        for (uint c = 0u; c < cn; c++)
+            if (candD[c] == dv) {
+                candMis[c] = min(candMis[c], mis);
+                candCount[c]++;
+                seen = true;
+            }
+        if (!seen && cn < MAXCAND - 1u) {
+            candD[cn] = dv;
+            candMis[cn] = mis;
+            candCount[cn] = 1u;
+            cn++;
+        }
+    }
+    // shifts of a lone tile drop out
+    uint kept = 0u;
+    bool still = false;
+    bool moving = false;
+    const uint base = idx * CAND_WORDS;
+    for (uint c = 0u; c < cn; c++)
+        if (candCount[c] >= 2u || candD[c] == ivec2(0)) {
+            cands.words[base + 1u + kept] = uint(candD[c].x + 128) | (uint(candD[c].y + 128) << 8) | (candMis[c] << 16);
+            still = still || candD[c] == ivec2(0);
+            moving = moving || candD[c] != ivec2(0);
+            kept++;
+        }
+    if (!still) {
+        cands.words[base + 1u + kept] = 128u | (128u << 8) | (1023u << 16);
+        kept++;
+    }
+    cands.words[base] = kept | (near ? FLAG_NEAR : 0u) | (moving ? FLAG_MOVING : 0u);
+}
diff --git a/shaders/ui_compose.comp b/shaders/ui_compose.comp
new file mode 100644
index 0000000..c62deac
--- /dev/null
+++ b/shaders/ui_compose.comp
@@ -0,0 +1,290 @@
+#version 450
+// D2R layer 11/12: puts the game's UI back on a generated frame. Frame
+// generation ran on frames without the UI layer (VKD3D's hand-over image).
+// radius 0 (layer 11): every pixel where the real frame differs from its frame
+// without the UI layer by more than tol is taken from the real frame, so the
+// UI only moves with the real frames.
+// radius > 0 (layer 12): the UI is drawn halfway along its motion since the
+// frame before (ui_motion.comp, per 16 x 16 tile). The shifts d of the tiles
+// up to 2 tiles away that at least 2 of them share (a lone tile's shift is
+// often a still map line matched along itself), and no shift, are candidates
+// for each pixel p: the
+// real frame's pixel q = p + d / 2 is taken when there is UI at q in this
+// frame and at q - d in the frame before, and when the bits around q fit the
+// move better than staying, or as well while the tile holding q moved by d and
+// p has UI in one of the two frames (no copies of a still map line along which
+// a label moves). Among those, the one whose UI and detail bits (ui_mask.comp)
+// agree best around q and q - d wins, then staying, then the one the tile
+// holding q moved by, then the one from the better matched tile.
+// UI left without a match stays where it is in the real frame (changing text,
+// new labels) unless a candidate move explains it (the part of a moving label
+// that left that place).
+// Layer 13: the candidates come per tile from ui_cand.comp; a tile without UI
+// up to 2 tiles away does nothing, and one whose only candidate is no shift
+// takes its UI from the real frame as it is (what the search gives there),
+// without the bit window.
+// Built with: glslangValidator -V --target-env vulkan1.1 -o ui_compose.spv ui_compose.comp
+//             xxd -i ui_compose.spv > ../src/extract/ui_compose_spv.h
+layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
+
+layout(set = 0, binding = 0, rgba16f) uniform image2D genImg;            // generated frame (out_n)
+layout(set = 0, binding = 1, rgba16f) uniform readonly image2D sceneImg; // this frame without the UI layer
+layout(set = 0, binding = 2, rgba16f) uniform readonly image2D realImg;  // this frame as shown
+layout(set = 0, binding = 3, std430) buffer Stats {
+    // pixels: differing at all, taken, differing by 16/255 or more, all;
+    // tiles (ui_motion.comp): with UI, moved, still, not matched, sum of
+    // moved |dx| + |dy|; pixels: placed moved, placed still, left in place;
+    // tiles without a frame before
+    uint counts[16];
+} stats;
+layout(set = 0, binding = 4, std430) readonly buffer CurMask {
+    uint bits[];
+} curMask;
+layout(set = 0, binding = 5, std430) readonly buffer PrevMask {
+    uint bits[];
+} prevMask;
+layout(set = 0, binding = 6, std430) readonly buffer Tiles {
+    uint info[];
+} tiles;
+layout(set = 0, binding = 7, std430) readonly buffer Cands {
+    uint words[]; // ui_cand.comp: 17 per tile
+} cands;
+
+layout(push_constant) uniform Push {
+    ivec2 size;
+    float tol;
+    uint count;     // nonzero: add this frame's pixels to the counters (1 frame in 4)
+    int radius;     // 0: layer 11 (UI from the real frame as it is)
+    uint prevValid;
+    uint words;     // mask words per row
+    uint pad;
+} pc;
+
+const uint STATE_MATCHED = 1u;
+
+// both bit planes of this frame (0) and the frame before (1) around the tile:
+// rows y0 - 35 to y0 + 50, 4 words from word wb (shifts up to 32 pixels, and 3
+// around)
+const int WR = 86;
+const int WW = 4;
+shared uint sWin[2 * 2 * WR * WW];
+shared uint sTile9[9];
+const uint CAND_WORDS = 17u;
+const uint FLAG_NEAR = 256u;
+const uint FLAG_MOVING = 512u;
+shared uint sCand[CAND_WORDS]; // count and flags, then dx + 128 | (dy + 128) << 8 | mis << 16
+shared uint sAny;
+shared uint sTaken;
+shared uint sStrong;
+shared uint sAll;
+shared uint sMoved;
+shared uint sStill;
+shared uint sLeft;
+
+bool inside(ivec2 q) {
+    return q.x >= 0 && q.y >= 0 && q.x < pc.size.x && q.y < pc.size.y;
+}
+
+int gWy0;
+int gWb;
+
+bool bitAt(uint f, uint pl, ivec2 q) {
+    const int r = q.y - gWy0;
+    const int w = (q.x >> 5) - gWb;
+    if (r < 0 || r >= WR || w < 0 || w >= WW)
+        return false;
+    return ((sWin[((f * 2u + pl) * uint(WR) + uint(r)) * uint(WW) + uint(w)] >> uint(q.x & 31)) & 1u) != 0u;
+}
+
+// how well the frame before around n fits this frame around q (at q and 1 and
+// 3 pixels left, right, up and down): UI bits only in the frame before don't
+// count (UI that left or uncovered something), detail bits count both ways
+const ivec2 kAround[9] = ivec2[](ivec2(0), ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1),
+    ivec2(3, 0), ivec2(-3, 0), ivec2(0, 3), ivec2(0, -3));
+
+ivec2 candD(uint c) {
+    const uint w = sCand[1u + c];
+    return ivec2(int(w & 0xFFu) - 128, int((w >> 8) & 0xFFu) - 128);
+}
+
+uint candMis(uint c) {
+    return sCand[1u + c] >> 16;
+}
+
+int agreement(ivec2 q, ivec2 n) {
+    int s = 0;
+    for (int k = 0; k < 9; k++) {
+        const ivec2 o = kAround[k];
+        s += int(!bitAt(0u, 0u, q + o) || bitAt(1u, 0u, n + o));
+        s += int(bitAt(0u, 1u, q + o) == bitAt(1u, 1u, n + o));
+    }
+    return s;
+}
+
+void main() {
+    const uint tid = gl_LocalInvocationIndex;
+    if (tid == 0u) {
+        sAny = 0u;
+        sTaken = 0u;
+        sStrong = 0u;
+        sAll = 0u;
+        sMoved = 0u;
+        sStill = 0u;
+        sLeft = 0u;
+    }
+    const ivec2 tile = ivec2(gl_WorkGroupID.xy);
+    const ivec2 tilesN = ivec2((pc.size + 15) / 16);
+    gWy0 = tile.y * 16 - 35;
+    gWb = (tile.x * 16 - 35) >> 5;
+    if (pc.radius > 0) {
+        const uint tileIdx = uint(tile.y * tilesN.x + tile.x);
+        if (tid < CAND_WORDS) {
+            sCand[tid] = cands.words[tileIdx * CAND_WORDS + tid];
+        } else if (tid >= 32u && tid < 41u) {
+            // the tile and its neighbours (k = 0-8)
+            const uint k = tid - 32u;
+            const ivec2 t = tile + ivec2(int(k % 3u) - 1, int(k / 3u) - 1);
+            sTile9[k] = (t.x < 0 || t.y < 0 || t.x >= tilesN.x || t.y >= tilesN.y)
+                ? 0x8080u : tiles.info[uint(t.y * tilesN.x + t.x)];
+        }
+    }
+    barrier();
+    const uint candN = pc.radius > 0 ? (sCand[0] & 255u) : 0u;
+    const bool near = pc.radius > 0 && (sCand[0] & FLAG_NEAR) != 0u;
+    const bool moving = near && (sCand[0] & FLAG_MOVING) != 0u;
+    if (moving) {
+        const uint plane = pc.words * uint(pc.size.y);
+        for (uint i = tid; i < uint(2 * 2 * WR * WW); i += 256u) {
+            const uint w = i % uint(WW);
+            const uint r = (i / uint(WW)) % uint(WR);
+            const uint pl = (i / uint(WW * WR)) % 2u;
+            const uint f = i / uint(2 * WW * WR);
+            const int y = gWy0 + int(r);
+            const int x = gWb + int(w);
+            uint v = 0u;
+            if (y >= 0 && y < pc.size.y && x >= 0 && x < int(pc.words)) {
+                const uint at = pl * plane + uint(y) * pc.words + uint(x);
+                v = f == 0u ? curMask.bits[at] : prevMask.bits[at];
+            }
+            sWin[i] = v;
+        }
+    }
+    barrier();
+
+    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (inside(p)) {
+        const vec4 f = imageLoad(realImg, p);
+        const vec3 d = abs(f.rgb - imageLoad(sceneImg, p).rgb);
+        const float m = max(d.r, max(d.g, d.b));
+        const bool here = m > pc.tol;
+        uint kind = 0u; // 0 nothing, 1 placed moved, 2 placed still, 3 left in place, 4 layer 11
+        if (pc.radius <= 0) {
+            if (here) {
+                imageStore(genImg, p, f);
+                kind = 4u;
+            }
+        } else if (moving) {
+            // best candidate: agreement first, then the better matched tile
+            uint best = 0u;
+            ivec2 bq = p;
+            bool bMoved = false;
+            for (uint c = 0u; c < candN; c++) {
+                const ivec2 dv = candD(c);
+                const ivec2 q = p + (dv >> 1);
+                const ivec2 n = q - dv;
+                if (!inside(q) || !inside(n))
+                    continue;
+                if (!bitAt(0u, 0u, q) || !bitAt(1u, 0u, n))
+                    continue;
+                if (dv == ivec2(0) && pc.prevValid == 0u)
+                    continue;
+                const int agree = agreement(q, n);
+                // the tile holding q (in this frame) moved by d
+                const ivec2 tq = (q >> 4) - tile + ivec2(1);
+                const uint info = sTile9[tq.y * 3 + tq.x];
+                const bool tileMoved = ((info >> 16) & 3u) == STATE_MATCHED
+                    && ivec2(int(info & 0xFFu) - 128, int((info >> 8) & 0xFFu) - 128) == dv;
+                // a move must explain q better than staying, or as well
+                // when the tile holding q moved by d and p has UI in one of
+                // the two frames
+                if (dv != ivec2(0)) {
+                    const int stayQ = agreement(q, q);
+                    if (agree < stayQ || (agree == stayQ && !(tileMoved && (here || bitAt(1u, 0u, p)))))
+                        continue;
+                }
+                const uint key = (uint(agree) << 13) | (dv == ivec2(0) ? 4096u : 0u)
+                    | (tileMoved ? 2048u : 0u) | ((1023u - candMis(c)) << 1) | 1u;
+                if (key > best) {
+                    best = key;
+                    bq = q;
+                    bMoved = dv != ivec2(0);
+                }
+            }
+            if (best != 0u) {
+                imageStore(genImg, p, bq == p ? f : imageLoad(realImg, bq));
+                kind = bMoved ? 1u : 2u;
+            } else if (here) {
+                // left in place unless a move explains this pixel's UI
+                bool moved = false;
+                const int stay = pc.prevValid != 0u ? agreement(p, p) : 0;
+                for (uint c = 0u; c < candN && !moved; c++) {
+                    const ivec2 dv = candD(c);
+                    const ivec2 n = p - dv;
+                    if (dv == ivec2(0) || !inside(n) || !bitAt(1u, 0u, n))
+                        continue;
+                    const uint info = sTile9[4];
+                    const bool tileMoved = ((info >> 16) & 3u) == STATE_MATCHED
+                        && ivec2(int(info & 0xFFu) - 128, int((info >> 8) & 0xFFu) - 128) == dv;
+                    moved = tileMoved || agreement(p, n) > stay;
+                }
+                if (!moved) {
+                    imageStore(genImg, p, f);
+                    kind = 3u;
+                }
+            }
+        } else if (near && here) {
+            // no shift is the only candidate: the UI as in the real frame
+            // (placed still where the frame before had UI too)
+            imageStore(genImg, p, f);
+            kind = 3u;
+            if (pc.count != 0u && pc.prevValid != 0u) {
+                const uint at = uint(p.y) * pc.words + uint(p.x >> 5);
+                if (((prevMask.bits[at] >> uint(p.x & 31)) & 1u) != 0u)
+                    kind = 2u;
+            }
+        }
+        if (pc.count != 0u) {
+            atomicAdd(sAll, 1u);
+            if (m > 0.0)
+                atomicAdd(sAny, 1u);
+            if (kind != 0u)
+                atomicAdd(sTaken, 1u);
+            if (m >= 16.0 / 255.0)
+                atomicAdd(sStrong, 1u);
+            if (kind == 1u)
+                atomicAdd(sMoved, 1u);
+            else if (kind == 2u)
+                atomicAdd(sStill, 1u);
+            else if (kind == 3u)
+                atomicAdd(sLeft, 1u);
+        }
+    }
+    barrier();
+
+    if (pc.count != 0u && tid == 0u) {
+        if (sAny != 0u)
+            atomicAdd(stats.counts[0], sAny);
+        if (sTaken != 0u)
+            atomicAdd(stats.counts[1], sTaken);
+        if (sStrong != 0u)
+            atomicAdd(stats.counts[2], sStrong);
+        if (sAll != 0u)
+            atomicAdd(stats.counts[3], sAll);
+        if (sMoved != 0u)
+            atomicAdd(stats.counts[9], sMoved);
+        if (sStill != 0u)
+            atomicAdd(stats.counts[10], sStill);
+        if (sLeft != 0u)
+            atomicAdd(stats.counts[11], sLeft);
+    }
+}
diff --git a/shaders/ui_mask.comp b/shaders/ui_mask.comp
new file mode 100644
index 0000000..1a40c46
--- /dev/null
+++ b/shaders/ui_mask.comp
@@ -0,0 +1,63 @@
+#version 450
+// D2R layer 12: two bit planes of this frame's UI. Plane 0: pixels where the
+// real frame differs from its frame without the UI layer (the game's UI is
+// there). Plane 1: those of them the UI made brighter by 64/255 or more (the
+// text inside a label's box, whose plane 0 bits are a plain rectangle; the
+// darkened world under a see-through box or line doesn't count, as it moves
+// with the world, not with the UI). Bit x & 31 of word
+// plane * words * height + y * words + x / 32. The next frame's motion step
+// compares both planes with these to find how each part of the UI moved.
+// Built with: glslangValidator -V --target-env vulkan1.1 -o ui_mask.spv ui_mask.comp
+//             xxd -i ui_mask.spv > ../src/extract/ui_mask_spv.h
+layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;
+
+layout(set = 0, binding = 1, rgba16f) uniform readonly image2D sceneImg; // this frame without the UI layer
+layout(set = 0, binding = 2, rgba16f) uniform readonly image2D realImg;  // this frame as shown
+layout(set = 0, binding = 4, std430) writeonly buffer CurMask {
+    uint bits[];
+} curMask;
+
+layout(push_constant) uniform Push {
+    ivec2 size;
+    float tol;
+    uint count;
+    int radius;
+    uint prevValid;
+    uint words; // mask words per row
+    uint pad;
+} pc;
+
+shared uint sRow[8];
+shared uint sDetail[8];
+
+float luma(vec3 c) {
+    return dot(c, vec3(0.299, 0.587, 0.114));
+}
+
+void main() {
+    const uvec2 l = gl_LocalInvocationID.xy;
+    if (l.x == 0u) {
+        sRow[l.y] = 0u;
+        sDetail[l.y] = 0u;
+    }
+    barrier();
+
+    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (p.x < pc.size.x && p.y < pc.size.y) {
+        const vec3 f = imageLoad(realImg, p).rgb;
+        const vec3 s = imageLoad(sceneImg, p).rgb;
+        const vec3 d = abs(f - s);
+        if (max(d.r, max(d.g, d.b)) > pc.tol) {
+            atomicOr(sRow[l.y], 1u << l.x);
+            if (luma(f) - luma(s) >= 64.0 / 255.0)
+                atomicOr(sDetail[l.y], 1u << l.x);
+        }
+    }
+    barrier();
+
+    if (l.x == 0u && p.y < pc.size.y) {
+        const uint at = uint(p.y) * pc.words + gl_WorkGroupID.x;
+        curMask.bits[at] = sRow[l.y];
+        curMask.bits[pc.words * uint(pc.size.y) + at] = sDetail[l.y];
+    }
+}
diff --git a/shaders/ui_motion.comp b/shaders/ui_motion.comp
new file mode 100644
index 0000000..1eb75a6
--- /dev/null
+++ b/shaders/ui_motion.comp
@@ -0,0 +1,236 @@
+#version 450
+// D2R layer 12: how the UI in each 16 x 16 tile of this frame moved since the
+// frame before. The tile's UI bits and detail bits (ui_mask.comp) are compared
+// with the frame before's at every shift up to radius pixels; the shift that
+// leaves the fewest of this tile's bits without a bit in the frame before wins
+// (ties: the shortest). Bits only in the frame before don't count: UI that
+// left or uncovered (a label that moved off a map line) says nothing about how
+// what is there now moved. Labels on the ground move with the
+// world, the map overlay stays or scrolls, the HUD stays.
+// Layer 13: a tile whose bits all sit at the same place in the frame before is
+// still without the search (the search would pick that shift too: nothing
+// unmatched, shortest), and the frame before's rows around a tile are read
+// once into shared memory instead of 4 loads per window entry.
+// Tile word: bits 0-7 dx + 128, 8-15 dy + 128, 16-17 state (0 no UI, 1 matched,
+// 2 not matched, 3 no frame before), 18-27 bits without a match at the best shift.
+// Built with: glslangValidator -V --target-env vulkan1.1 -o ui_motion.spv ui_motion.comp
+//             xxd -i ui_motion.spv > ../src/extract/ui_motion_spv.h
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(set = 0, binding = 3, std430) buffer Stats {
+    uint counts[16];
+} stats;
+layout(set = 0, binding = 4, std430) readonly buffer CurMask {
+    uint bits[];
+} curMask;
+layout(set = 0, binding = 5, std430) readonly buffer PrevMask {
+    uint bits[];
+} prevMask;
+layout(set = 0, binding = 6, std430) writeonly buffer Tiles {
+    uint info[];
+} tiles;
+
+layout(push_constant) uniform Push {
+    ivec2 size;
+    float tol;
+    uint count;     // nonzero: add this frame's tiles to the counters
+    int radius;     // largest shift searched, pixels (at most 32)
+    uint prevValid; // nonzero: the frame before's bits are there
+    uint words;     // mask words per row
+    uint pad;
+} pc;
+
+const int MAXR = 32;
+const int WROWS = 16 + 2 * MAXR;
+const int WCOLS = 2 * MAXR + 1;
+const uint STATE_EMPTY = 0u;
+const uint STATE_MATCHED = 1u;
+const uint STATE_NOMATCH = 2u;
+const uint STATE_NOPREV = 3u;
+
+// the frame before's 16 UI bits (low half) and 16 detail bits (high half) of
+// window row r at shift column k: sWin[r * cols + k]
+shared uint sWin[WROWS * WCOLS];
+shared uint sCur[16];
+shared uint sBest;
+// the frame before's mask words around the tile: plane, row (y0 - R on), 4 words
+// from word sW0 (0 outside the frame)
+const int CW = 4;
+shared uint sRows[2 * WROWS * CW];
+shared uint sStillMis;
+
+uint pack(int dx, int dy, uint state, uint mis) {
+    return uint(dx + 128) | (uint(dy + 128) << 8) | (state << 16) | (min(mis, 1023u) << 18);
+}
+
+// 16 bits of a mask row of a plane from pixel xs on; 0 outside the frame
+uint prevBits16(int xs, int y, uint plane) {
+    if (y < 0 || y >= pc.size.y)
+        return 0u;
+    const int w = xs >> 5;
+    const int s = xs & 31;
+    const int W = int(pc.words);
+    const uint base = plane * pc.words * uint(pc.size.y) + uint(y) * pc.words;
+    const uint lo = (w >= 0 && w < W) ? prevMask.bits[base + uint(w)] : 0u;
+    const uint hi = (w + 1 >= 0 && w + 1 < W) ? prevMask.bits[base + uint(w + 1)] : 0u;
+    const uint v = s == 0 ? lo : ((lo >> uint(s)) | (hi << uint(32 - s)));
+    return v & 0xFFFFu;
+}
+
+// 16 bits of a row of the frame before from pixel xs on, from sRows
+uint cachedBits16(int xs, int r, int w0, uint plane) {
+    const int w = (xs >> 5) - w0;
+    const int s = xs & 31;
+    const uint base = (plane * uint(WROWS) + uint(r)) * uint(CW);
+    const uint lo = (w >= 0 && w < CW) ? sRows[base + uint(w)] : 0u;
+    const uint hi = (w + 1 >= 0 && w + 1 < CW) ? sRows[base + uint(w + 1)] : 0u;
+    const uint v = s == 0 ? lo : ((lo >> uint(s)) | (hi << uint(32 - s)));
+    return v & 0xFFFFu;
+}
+
+void main() {
+    const uint tid = gl_LocalInvocationIndex;
+    const int x0 = int(gl_WorkGroupID.x) * 16;
+    const int y0 = int(gl_WorkGroupID.y) * 16;
+    const uint tileIdx = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
+
+    if (tid < 16u) {
+        const int y = y0 + int(tid);
+        uint v = 0u;
+        if (y < pc.size.y) {
+            // x0 is a multiple of 16: the tile's bits are in one word
+            const uint at = uint(y) * pc.words + uint(x0 >> 5);
+            const uint word = curMask.bits[at];
+            const uint detail = curMask.bits[pc.words * uint(pc.size.y) + at];
+            v = ((word >> uint(x0 & 31)) & 0xFFFFu) | (((detail >> uint(x0 & 31)) & 0xFFFFu) << 16);
+        }
+        sCur[tid] = v;
+    }
+    if (tid == 0u) {
+        sBest = 0xFFFFFFFFu;
+        sStillMis = 0u;
+    }
+    barrier();
+
+    uint n = 0u;     // UI and detail bits
+    uint ui = 0u;    // UI bits
+    for (int k = 0; k < 16; k++) {
+        n += uint(bitCount(sCur[k]));
+        ui += uint(bitCount(sCur[k] & 0xFFFFu));
+    }
+    if (ui == 0u) {
+        if (tid == 0u)
+            tiles.info[tileIdx] = pack(0, 0, STATE_EMPTY, 0u);
+        return;
+    }
+    const int R = clamp(pc.radius, 1, MAXR);
+    if (pc.prevValid == 0u) {
+        if (tid == 0u) {
+            tiles.info[tileIdx] = pack(0, 0, STATE_NOPREV, 0u);
+            if (pc.count != 0u) {
+                atomicAdd(stats.counts[4], 1u);
+                atomicAdd(stats.counts[12], 1u);
+            }
+        }
+        return;
+    }
+
+    // still: every bit of the tile is at the same place in the frame before
+    // (no shift leaves fewer unmatched, and none is shorter)
+    if (tid < 32u) {
+        const uint j = tid & 15u;
+        const uint plane = tid >> 4;
+        const uint cur16 = (sCur[j] >> (plane * 16u)) & 0xFFFFu;
+        const uint m = uint(bitCount(cur16 & ~prevBits16(x0, y0 + int(j), plane)));
+        if (m != 0u)
+            atomicAdd(sStillMis, m);
+    }
+    barrier();
+    if (sStillMis == 0u) {
+        if (tid == 0u) {
+            const bool matched = ui >= 4u;
+            tiles.info[tileIdx] = pack(0, 0, matched ? STATE_MATCHED : STATE_NOMATCH, 0u);
+            if (pc.count != 0u) {
+                atomicAdd(stats.counts[4], 1u);
+                if (!matched)
+                    atomicAdd(stats.counts[7], 1u);
+                else
+                    atomicAdd(stats.counts[6], 1u);
+            }
+        }
+        return;
+    }
+
+    // the frame before's rows around the tile, once
+    const int cols = 2 * R + 1;
+    const int rows = 16 + 2 * R;
+    const int w0 = (x0 - R) >> 5;
+    const int W = int(pc.words);
+    for (int idx = int(tid); idx < 2 * rows * CW; idx += 256) {
+        const int w = idx % CW;
+        const int r = (idx / CW) % rows;
+        const int plane = idx / (CW * rows);
+        const int y = y0 - R + r;
+        const int x = w0 + w;
+        uint v = 0u;
+        if (y >= 0 && y < pc.size.y && x >= 0 && x < W)
+            v = prevMask.bits[uint(plane) * pc.words * uint(pc.size.y) + uint(y) * pc.words + uint(x)];
+        sRows[(uint(plane) * uint(WROWS) + uint(r)) * uint(CW) + uint(w)] = v;
+    }
+    barrier();
+    // its bits at every shift
+    for (int idx = int(tid); idx < rows * cols; idx += 256) {
+        const int r = idx / cols;
+        const int k = idx - r * cols;
+        const int xs = x0 - (k - R);
+        sWin[r * cols + k] = cachedBits16(xs, r, w0, 0u) | (cachedBits16(xs, r, w0, 1u) << 16);
+    }
+    barrier();
+
+    uint cur[16];
+    for (int j = 0; j < 16; j++)
+        cur[j] = sCur[j];
+
+    // shift (dx, dy): this frame's pixel (x, y) was at (x - dx, y - dy)
+    uint best = 0xFFFFFFFFu;
+    for (int c = int(tid); c < cols * cols; c += 256) {
+        const int dyI = c / cols;
+        const int dxI = c - dyI * cols;
+        const int base = 2 * R - dyI; // window row of tile row 0
+        uint mis = 0u;
+        for (int j = 0; j < 16; j++)
+            mis += uint(bitCount(cur[j] & ~sWin[(base + j) * cols + dxI]));
+        const uint dist = uint(abs(dxI - R) + abs(dyI - R));
+        best = min(best, (mis << 20) | (dist << 13) | uint(c));
+    }
+    atomicMin(sBest, best);
+    barrier();
+
+    if (tid == 0u) {
+        const uint key = sBest;
+        const int c = int(key & 0x1FFFu);
+        const uint mis = key >> 20;
+        int dy = c / cols;
+        int dx = c - dy * cols - R;
+        dy -= R;
+        // matched: at most a quarter of the tile's UI and detail bits (plus
+        // 2) have none in the frame before
+        const bool matched = ui >= 4u && mis * 4u <= n + 8u;
+        if (!matched) {
+            dx = 0;
+            dy = 0;
+        }
+        tiles.info[tileIdx] = pack(dx, dy, matched ? STATE_MATCHED : STATE_NOMATCH, mis);
+        if (pc.count != 0u) {
+            atomicAdd(stats.counts[4], 1u);
+            if (!matched)
+                atomicAdd(stats.counts[7], 1u);
+            else if (dx == 0 && dy == 0)
+                atomicAdd(stats.counts[6], 1u);
+            else {
+                atomicAdd(stats.counts[5], 1u);
+                atomicAdd(stats.counts[8], uint(abs(dx) + abs(dy)));
+            }
+        }
+    }
+}
