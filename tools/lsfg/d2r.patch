+
+bool LsContext::prepareEarly(const Hooks::DeviceInfo& info, VkQueue queue,
+        VkSemaphore gameSemaphore, uint32_t imageIdx) {
+#ifdef __ANDROID__
+    const auto& conf = Config::activeConf;
+    if (this->early.ready || this->earlyOff || this->forceDisabled || !earlyEnabled()
+            || !deferEnabled() || !genDrawnEnabled() || conf.multiplier != 2
+            || queue != info.queue.second || imageIdx >= this->swapchainImages.size()
+            || this->isStale())
+        return false;
+    if (this->defer) {
+        DeferState& s = *this->defer;
+        const std::lock_guard<std::mutex> lk(s.lock);
+        if (s.jobNext < s.jobCount)
+            return false;
+    }
+    const int64_t startNs = nowNs();
+    startWatchdog();
+    const std::vector<VkSemaphore> sems{ gameSemaphore };
+    bool started = false;
+    bool framegen = false;
+    try {
+        // the copy of the frame before finished long ago; don't wait for it
+        // here, where the game holds its queue
+        framegen = this->startFrameWork(info, queue, sems, imageIdx, 0, false, started);
+    } catch (const std::exception& e) {
+        setStage("idle");
+        std::cerr << "lsfg-vk: early frame start: " << e.what() << '\n';
+    }
+    if (!started)
+        return false;
+
+    EarlyFrame& e = this->early;
+    e = EarlyFrame{};
+    e.ready = true;
+    e.presentIdx = imageIdx;
+    e.gameSemaphore = gameSemaphore;
+    e.frameIdx = this->frameIdx;
+    auto& pass = this->passInfos.at(this->frameIdx % 8);
+    if (framegen && this->gapSkip) {
+        // layer 10: only the real frame, at the generated frame's slot
+        e.gapSkipped = true;
+        g_gapSkipTotal.fetch_add(1, std::memory_order_relaxed);
+    } else if (framegen) {
+        try {
+            for (size_t i = 0; i < static_cast<size_t>(conf.multiplier - 1); i++) {
+                pass.acquireSemaphores.at(i) = Mini::Semaphore(info.device);
+                uint32_t genIdx{};
+                setStage("early gen acquire");
+                const auto res = Layer::ovkAcquireNextImageKHR(info.device, this->swapchain,
+                    kEarlyAcquireTimeoutNs, pass.acquireSemaphores.at(i).handle(),
+                    VK_NULL_HANDLE, &genIdx);
+                setStage("idle");
+                if (res == VK_TIMEOUT || res == VK_NOT_READY) {
+                    // parked, as in present()
+                    this->retiredSemaphores.emplace_back(
+                        std::move(pass.acquireSemaphores.at(i)));
+                    this->statsGenSkips++;
+                    this->statsEarlyNoImage++;
+                    continue;
+                }
+                if (res != VK_SUCCESS && res != VK_SUBOPTIMAL_KHR)
+                    throw LSFG::vulkan_error(res, "Failed to acquire next swapchain image");
+                if (this->statsSeq.size() < 200)
+                    this->statsSeq += 'a' + static_cast<char>(genIdx % 26);
+                this->recordGenCopy(info, i, genIdx, imageIdx);
+                // presented once drawn, as in present() (its fence is from 8
+                // frames ago; still busy: presented without that wait)
+                const bool drawn = pass.genDrawnFence.wait(0) == VK_SUCCESS;
+                if (drawn)
+                    pass.genDrawnFence.reset();
+                pass.postCopyBufs.at(i).submit(info.queue.second,
+                    { pass.acquireSemaphores.at(i).handle() },
+                    { pass.postCopySemaphores.at(i).handle(),
+                      pass.prevPostCopySemaphores.at(i).handle() },
+                    drawn ? pass.genDrawnFence.handle() : VK_NULL_HANDLE);
+                DeferJob job{
+                    .queue = queue,
+                    .swapchain = this->swapchain,
+                    .imageIdx = genIdx,
+                    .waitCount = 1,
+                };
+                job.waits.at(0) = pass.postCopySemaphores.at(i).handle();
+                job.gen = true;
+                job.hasDrawn = drawn;
+                if (drawn)
+                    job.drawn = pass.genDrawnFence;
+                e.genIndex.at(e.genCount) = static_cast<uint32_t>(i);
+                e.genJobs.at(e.genCount++) = job;
+                e.lastPresentedGen = static_cast<int>(i);
+            }
+        } catch (const std::exception& ex) {
+            setStage("idle");
+            std::cerr << "lsfg-vk: early frame start, generated frame: " << ex.what() << '\n';
+        }
+    }
+    e.preparedNs = nowNs();
+    this->statsEarlyWorkNs += static_cast<uint64_t>(e.preparedNs - startNs);
+    return true;
+#else
+    (void)info; (void)queue; (void)gameSemaphore; (void)imageIdx;
+    return false;
+#endif
+}
