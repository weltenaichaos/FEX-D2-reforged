 namespace {
     // Every GPU wait is bounded so an incompatible sync path degrades to
@@ -60,6 +69,16 @@ namespace {
         return static_cast<int64_t>(ts.tv_sec) * 1'000'000'000LL + ts.tv_nsec;
     }
 
+    // Layer 9: presents late after their slot by 1 ms or more / 4 ms or more,
+    // counted since the game started (swapchains come and go), real and
+    // generated: the stats file has the totals, FEX takes differences.
+    std::atomic<uint64_t> g_lateTotals[4]{};
