+        if (!flush)
+            t.wait = waitUntilPrecise(job.dueNs, job.hasDrawn || readyNs == 0 ? nowNs() : readyNs);
+        t.cpu = sched_getcpu();
+        t.startNs = nowNs();
+        t.res = presentDeferJob(job);
+        t.endNs = nowNs();
+        return t;
+    }
+
+    void noteDeferJob(LsContext::DeferState& s, const LsContext::DeferJob& job, const JobTimes& t) {
+        const int64_t late = std::max<int64_t>(0, t.startNs - job.dueNs);
+        const int kind = job.gen ? 1 : 0;
+        if (job.gen) {
+            s.genFrames++;
+            s.genLateNs += static_cast<uint64_t>(late);
+            s.genLateMaxNs = std::max(s.genLateMaxNs, late);
+            s.genPresentNs += static_cast<uint64_t>(t.endNs - t.startNs);
+            if (t.drawnTimeout)
+                s.genTimeouts++;
+        } else {
+            s.frames++;
+            s.lateNs += static_cast<uint64_t>(late);
+            s.lateMaxNs = std::max(s.lateMaxNs, late);
+            s.presentNs += static_cast<uint64_t>(t.endNs - t.startNs);
+        }
+        g_presentTotals[kind].fetch_add(1, std::memory_order_relaxed);
+        if (late >= 1'000'000)
+            g_lateTotals[kind * 2].fetch_add(1, std::memory_order_relaxed);
+        if (late >= 4'000'000)
+            g_lateTotals[kind * 2 + 1].fetch_add(1, std::memory_order_relaxed);
+        if (t.wait.wokeLateNs >= 0) {
+            s.wokeCount++;
+            s.wokeLateNs += static_cast<uint64_t>(t.wait.wokeLateNs);
+            s.wokeLateMaxNs = std::max(s.wokeLateMaxNs, t.wait.wokeLateNs);
+        }
+        s.spinNs += static_cast<uint64_t>(t.wait.spinNs);
+        if (t.cpu >= 0 && t.cpu < static_cast<int>(s.cpus.size()))
+            s.cpus.at(static_cast<size_t>(t.cpu))++;
+        if (t.res < 0)
+            s.errors++;
+        s.result = worseResult(s.result, t.res);
+    }
+
+    void deferThreadMain(const std::shared_ptr<LsContext::DeferState>& state) {
+        LsContext::DeferState& s = *state;
+        pthread_setname_np(pthread_self(), "lsfg-present");
+        // layer 9: the sleeps end on time (default slack 50 us)
+        prctl(PR_SET_TIMERSLACK, 1UL, 0UL, 0UL, 0UL);
+        const int nice = deferNice();
+        if (nice != 0 && setpriority(PRIO_PROCESS, static_cast<id_t>(gettid()), nice) != 0)
+            std::cerr << "lsfg-vk: present thread: nice " << nice << " refused (errno "
+                << errno << ")\n";
+        errno = 0;
+        const int niceNow = getpriority(PRIO_PROCESS, static_cast<id_t>(gettid()));
+        std::unique_lock<std::mutex> lk(s.lock);
+        s.presentNice = errno == 0 ? niceNow : -100;
+        for (;;) {
+            s.cv.wait(lk, [&] { return s.jobNext < s.jobCount || s.stop; });
+            if (s.jobNext >= s.jobCount)
+                break;
+            const LsContext::DeferJob job = s.jobs.at(s.jobNext);
+            const int64_t readyNs = nowNs();
+            // A real frame sleeps until 1 ms before its slot on the condition
+            // variable (a context going away wakes it and the frame goes out
+            // at once), the rest like the inline path (layer 9: from
+            // presentEarlyNs() before the slot on the CPU, so the condition
+            // variable ends 1 ms before that).
+            const int64_t cvEndNs = job.dueNs - presentEarlyNs() - 1'000'000;
+            if (!job.hasDrawn && !s.stop && cvEndNs > nowNs()) {
+                const auto until = std::chrono::steady_clock::time_point(
+                    std::chrono::nanoseconds(cvEndNs));
+                s.cv.wait_until(lk, until, [&] { return s.stop; });
+            }
+            const bool flush = s.stop;
+            lk.unlock();
+            const int64_t runNs = nowNs();
+            const JobTimes t = runDeferJob(job, flush, readyNs);
+            lk.lock();
+            if (job.hasDrawn)
+                s.genWaitNs += static_cast<uint64_t>(t.drawnNs - runNs);
+            noteDeferJob(s, job, t);
+            if (++s.jobNext >= s.jobCount)
+                s.jobNext = s.jobCount = 0;
+            s.cv.notify_all();
+        }
+        s.done = true;
+        s.cv.notify_all();
+    }
+}
+#endif
+
+VkResult LsContext::takeDeferred(bool fromAcquire) {
+#ifdef __ANDROID__
+    if (!this->defer)
+        return VK_SUCCESS;
+    DeferState& s = *this->defer;
+    std::unique_lock<std::mutex> lk(s.lock);
+    if (s.jobNext < s.jobCount) {
+        const int64_t startNs = nowNs();
+        s.cv.wait(lk, [&] { return s.jobNext >= s.jobCount || s.done; });
+        const auto waited = static_cast<uint64_t>(nowNs() - startNs);
+        if (fromAcquire)
+            s.acquireWaitNs += waited;
+        else
+            s.waitNs += waited;
+    }
+    const VkResult res = s.result;
+    s.result = VK_SUCCESS;
+    return res;
+#else
+    (void)fromAcquire;
+    return VK_SUCCESS;
+#endif
+}
+
+#ifdef __ANDROID__
+// Layer 11-13: the compute steps that put the game's UI back on a generated
+// frame: ui_mask.comp (this frame's UI bits), ui_motion.comp (how the UI of
+// each 16 x 16 tile moved since the frame before), ui_cand.comp (each tile's
+// candidate moves, layer 13) and ui_compose.comp, with their views, buffers,
+// descriptor sets and counters.
+struct LsContext::UiCompose {
+    VkDevice device{};
+    PFN_vkDestroyImageView destroyImageView{};
+    PFN_vkDestroyShaderModule destroyShaderModule{};
+    PFN_vkDestroyPipeline destroyPipeline{};
+    PFN_vkDestroyPipelineLayout destroyPipelineLayout{};
+    PFN_vkDestroyDescriptorSetLayout destroySetLayout{};
+    PFN_vkDestroyDescriptorPool destroyPool{};
+    PFN_vkCmdBindPipeline cmdBindPipeline{};
+    PFN_vkCmdBindDescriptorSets cmdBindSets{};
+    PFN_vkCmdPushConstants cmdPushConstants{};
+    PFN_vkCmdDispatch cmdDispatch{};
+    std::array<VkShaderModule, 4> modules{};
+    VkDescriptorSetLayout setLayout{};
+    VkPipelineLayout pipeLayout{};
+    VkPipeline pipeline{};       // ui_compose.comp
+    VkPipeline maskPipeline{};   // ui_mask.comp
+    VkPipeline motionPipeline{}; // ui_motion.comp
+    VkPipeline candPipeline{};   // ui_cand.comp
+    VkDescriptorPool pool{};
+    std::vector<VkImageView> views;
+    std::vector<VkDescriptorSet> sets; // [input image (frameIdx % 2) * outCount + generated frame]
+    size_t outCount{0};
+    uint32_t words{0};  // mask words per row
+    uint32_t tilesX{0}, tilesY{0};
+    // device-local buffers: UI bits of the frames by frameIdx % 2 (2 planes
+    // each), tile motions by frameIdx % 2
+    std::vector<VkBuffer> buffers;
+    std::vector<VkDeviceMemory> memories;
+    std::array<VkBuffer, 2> masks{};
+    std::array<VkBuffer, 2> tiles{};
+    std::array<VkBuffer, 2> cands{}; // candidate moves per tile, by frameIdx % 2
+    VkBuffer statsBuffer{};
+    VkDeviceMemory statsMemory{};
+    // any, taken, strong, all; tiles: with UI, moved, still, not matched,
+    // moved |dx| + |dy|; pixels: moved, still, left in place; tiles without a
+    // frame before (totals, wrap around)
+    volatile uint32_t* counts{nullptr};
+
+    UiCompose() = default;
+    UiCompose(const UiCompose&) = delete;
+    UiCompose& operator=(const UiCompose&) = delete;
+    UiCompose(UiCompose&&) = delete;
+    UiCompose& operator=(UiCompose&&) = delete;
+    ~UiCompose() {
+        if (!this->device)
+            return;
+        if (this->counts)
+            Layer::ovkUnmapMemory(this->device, this->statsMemory);
+        if (this->statsBuffer)
+            Layer::ovkDestroyBuffer(this->device, this->statsBuffer, nullptr);
+        if (this->statsMemory)
+            Layer::ovkFreeMemory(this->device, this->statsMemory, nullptr);
+        for (const VkBuffer b : this->buffers)
+            if (b)
+                Layer::ovkDestroyBuffer(this->device, b, nullptr);
+        for (const VkDeviceMemory m : this->memories)
+            if (m)
+                Layer::ovkFreeMemory(this->device, m, nullptr);
+        for (const VkPipeline p : { this->pipeline, this->maskPipeline, this->motionPipeline, this->candPipeline })
+            if (p && this->destroyPipeline)
+                this->destroyPipeline(this->device, p, nullptr);
+        if (this->pool && this->destroyPool)
+            this->destroyPool(this->device, this->pool, nullptr);
+        if (this->pipeLayout && this->destroyPipelineLayout)
+            this->destroyPipelineLayout(this->device, this->pipeLayout, nullptr);
+        if (this->setLayout && this->destroySetLayout)
+            this->destroySetLayout(this->device, this->setLayout, nullptr);
+        for (const VkShaderModule m : this->modules)
+            if (m && this->destroyShaderModule)
+                this->destroyShaderModule(this->device, m, nullptr);
+        for (const VkImageView view : this->views)
+            if (view && this->destroyImageView)
+                this->destroyImageView(this->device, view, nullptr);
+    }
+};
+
+namespace {
+    template <typename T>
+    T deviceProc(VkDevice device, const char* name) {
+        return reinterpret_cast<T>(Layer::ovkGetDeviceProcAddr(device, name));
+    }
+
+    void uiCheck(VkResult res, const char* what) {
+        if (res != VK_SUCCESS)
+            throw LSFG::vulkan_error(res, std::string("UI step: ") + what);
+    }
+
+    // the push constants of the three UI shaders
+    struct UiPush {
+        int32_t width, height;
+        float tol;
+        uint32_t count;     // nonzero: add this frame to the counters
+        int32_t radius;     // 0: layer 11 (no UI motion)
+        uint32_t prevValid; // the frame before's UI bits are there
+        uint32_t words;     // mask words per row
+        uint32_t pad;
+    };
+    static_assert(sizeof(UiPush) == 32);
+}
+
+// Layer 11/12: views of frame_0/frame_1 (this frame without the UI layer),
+// out_n (the generated frames) and uiFrame (this frame as shown), the three
+// pipelines, the UI bit and tile buffers, one descriptor set per input image
+// and generated frame, and a host-visible buffer for the counters. Throws on
+// failure (this->ui stays null).
+void LsContext::makeUiCompose(const Hooks::DeviceInfo& info) {
+    const VkDevice device = info.device;
+    auto u = std::make_shared<UiCompose>();
+    u->device = device;
+    u->destroyImageView = deviceProc<PFN_vkDestroyImageView>(device, "vkDestroyImageView");
+    u->destroyShaderModule = deviceProc<PFN_vkDestroyShaderModule>(device, "vkDestroyShaderModule");
+    u->destroyPipeline = deviceProc<PFN_vkDestroyPipeline>(device, "vkDestroyPipeline");
+    u->destroyPipelineLayout = deviceProc<PFN_vkDestroyPipelineLayout>(device, "vkDestroyPipelineLayout");
+    u->destroySetLayout = deviceProc<PFN_vkDestroyDescriptorSetLayout>(device, "vkDestroyDescriptorSetLayout");
+    u->destroyPool = deviceProc<PFN_vkDestroyDescriptorPool>(device, "vkDestroyDescriptorPool");
+    u->cmdBindPipeline = deviceProc<PFN_vkCmdBindPipeline>(device, "vkCmdBindPipeline");
+    u->cmdBindSets = deviceProc<PFN_vkCmdBindDescriptorSets>(device, "vkCmdBindDescriptorSets");
+    u->cmdPushConstants = deviceProc<PFN_vkCmdPushConstants>(device, "vkCmdPushConstants");
+    u->cmdDispatch = deviceProc<PFN_vkCmdDispatch>(device, "vkCmdDispatch");
+    auto createImageView = deviceProc<PFN_vkCreateImageView>(device, "vkCreateImageView");
+    auto createShaderModule = deviceProc<PFN_vkCreateShaderModule>(device, "vkCreateShaderModule");
+    auto createSetLayout = deviceProc<PFN_vkCreateDescriptorSetLayout>(device, "vkCreateDescriptorSetLayout");
+    auto createPipelineLayout = deviceProc<PFN_vkCreatePipelineLayout>(device, "vkCreatePipelineLayout");
+    auto createComputePipelines = deviceProc<PFN_vkCreateComputePipelines>(device, "vkCreateComputePipelines");
+    auto createPool = deviceProc<PFN_vkCreateDescriptorPool>(device, "vkCreateDescriptorPool");
+    auto allocateSets = deviceProc<PFN_vkAllocateDescriptorSets>(device, "vkAllocateDescriptorSets");
+    auto updateSets = deviceProc<PFN_vkUpdateDescriptorSets>(device, "vkUpdateDescriptorSets");
+    if (!u->destroyImageView || !u->destroyShaderModule || !u->destroyPipeline
+            || !u->destroyPipelineLayout || !u->destroySetLayout || !u->destroyPool
+            || !u->cmdBindPipeline || !u->cmdBindSets || !u->cmdPushConstants || !u->cmdDispatch
+            || !createImageView || !createShaderModule || !createSetLayout || !createPipelineLayout
+            || !createComputePipelines || !createPool || !allocateSets || !updateSets)
+        throw LSFG::vulkan_error(VK_ERROR_INITIALIZATION_FAILED, "UI step: device functions missing");
+
+    const auto makeView = [&](VkImage image) {
+        const VkImageViewCreateInfo viewInfo{
+            .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+            .image = image,
+            .viewType = VK_IMAGE_VIEW_TYPE_2D,
+            .format = VK_FORMAT_R16G16B16A16_SFLOAT,
+            .subresourceRange = {
+                .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+                .levelCount = 1,
+                .layerCount = 1
+            }
+        };
+        VkImageView view{};
+        uiCheck(createImageView(device, &viewInfo, nullptr, &view), "image view");
+        u->views.push_back(view);
+        return view;
+    };
+    const std::array<VkImageView, 2> inputViews{
+        makeView(this->frame_0.handle()), makeView(this->frame_1.handle()) };
+    const VkImageView realView = makeView(this->uiFrame.handle());
+    std::vector<VkImageView> outViews;
+    for (const auto& out : this->out_n)
+        outViews.push_back(makeView(out.handle()));
+    u->outCount = outViews.size();
+    if (u->outCount == 0)
+        throw LSFG::vulkan_error(VK_ERROR_INITIALIZATION_FAILED, "UI step: no generated frames");
+
+    // one set layout for all four: 0 generated frame, 1 this frame without
+    // the UI layer, 2 this frame as shown, 3 counters, 4 this frame's UI bits,
+    // 5 the frame before's, 6 tile motions, 7 candidate moves per tile
+    std::array<VkDescriptorSetLayoutBinding, 8> bindings{};
+    for (uint32_t b = 0; b < bindings.size(); b++)
+        bindings.at(b) = VkDescriptorSetLayoutBinding{
+            .binding = b,
+            .descriptorType = b >= 3 ? VK_DESCRIPTOR_TYPE_STORAGE_BUFFER : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+            .descriptorCount = 1,
+            .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT
+        };
+    const VkDescriptorSetLayoutCreateInfo setLayoutInfo{
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+        .bindingCount = static_cast<uint32_t>(bindings.size()),
+        .pBindings = bindings.data()
+    };
+    uiCheck(createSetLayout(device, &setLayoutInfo, nullptr, &u->setLayout), "descriptor set layout");
+    const VkPushConstantRange pushRange{
+        .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+        .offset = 0,
+        .size = sizeof(UiPush)
+    };
+    const VkPipelineLayoutCreateInfo pipeLayoutInfo{
+        .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+        .setLayoutCount = 1,
+        .pSetLayouts = &u->setLayout,
+        .pushConstantRangeCount = 1,
+        .pPushConstantRanges = &pushRange
+    };
+    uiCheck(createPipelineLayout(device, &pipeLayoutInfo, nullptr, &u->pipeLayout), "pipeline layout");
+    const auto makePipeline = [&](size_t slot, const unsigned char* spv, unsigned int len, const char* what) {
+        std::vector<uint32_t> code(len / 4);
+        std::memcpy(code.data(), static_cast<const void*>(spv), code.size() * 4);
+        const VkShaderModuleCreateInfo moduleInfo{
+            .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+            .codeSize = code.size() * 4,
+            .pCode = code.data()
+        };
+        uiCheck(createShaderModule(device, &moduleInfo, nullptr, &u->modules.at(slot)), what);
+        const VkComputePipelineCreateInfo pipeInfo{
+            .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+            .stage = {
+                .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+                .module = u->modules.at(slot),
+                .pName = "main"
+            },
+            .layout = u->pipeLayout
+        };
+        VkPipeline pipe{};
+        uiCheck(createComputePipelines(device, VK_NULL_HANDLE, 1, &pipeInfo, nullptr, &pipe), what);
+        return pipe;
+    };
+    u->pipeline = makePipeline(0, ui_compose_spv, ui_compose_spv_len, "compose pipeline");
+    u->maskPipeline = makePipeline(1, ui_mask_spv, ui_mask_spv_len, "mask pipeline");
+    u->motionPipeline = makePipeline(2, ui_motion_spv, ui_motion_spv_len, "motion pipeline");
+    u->candPipeline = makePipeline(3, ui_cand_spv, ui_cand_spv_len, "candidate pipeline");
+
+    VkPhysicalDeviceMemoryProperties memProps{};
+    Layer::ovkGetPhysicalDeviceMemoryProperties(info.physicalDevice, &memProps);
+    const auto makeBuffer = [&](VkDeviceSize size, VkMemoryPropertyFlags flags, VkDeviceMemory* memOut,
+            const char* what) {
+        const VkBufferCreateInfo bufferInfo{
+            .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+            .size = size,
+            .usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+            .sharingMode = VK_SHARING_MODE_EXCLUSIVE
+        };
+        VkBuffer buffer{};
+        uiCheck(Layer::ovkCreateBuffer(device, &bufferInfo, nullptr, &buffer), what);
+        VkMemoryRequirements req{};
+        Layer::ovkGetBufferMemoryRequirements(device, buffer, &req);
+        uint32_t memType = UINT32_MAX;
+        for (uint32_t t = 0; t < memProps.memoryTypeCount; t++)
+            if ((req.memoryTypeBits & (1U << t)) != 0
+                    && (memProps.memoryTypes[t].propertyFlags & flags) == flags) {
+                memType = t;
+                break;
+            }
+        if (memType == UINT32_MAX) {
+            Layer::ovkDestroyBuffer(device, buffer, nullptr);
+            throw LSFG::vulkan_error(VK_ERROR_FEATURE_NOT_PRESENT, std::string("UI step: no memory for ") + what);
+        }
+        const VkMemoryAllocateInfo allocInfo{
+            .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+            .allocationSize = req.size,
+            .memoryTypeIndex = memType
+        };
+        VkDeviceMemory memory{};
+        const VkResult res = Layer::ovkAllocateMemory(device, &allocInfo, nullptr, &memory);
+        if (res != VK_SUCCESS) {
+            Layer::ovkDestroyBuffer(device, buffer, nullptr);
+            uiCheck(res, what);
+        }
+        const VkResult bindRes = Layer::ovkBindBufferMemory(device, buffer, memory, 0);
+        if (bindRes != VK_SUCCESS) {
+            Layer::ovkDestroyBuffer(device, buffer, nullptr);
+            Layer::ovkFreeMemory(device, memory, nullptr);
+            uiCheck(bindRes, what);
+        }
+        *memOut = memory;
+        return buffer;
+    };
+
+    // the counters: host-visible, read by the stats window without a wait
+    u->statsBuffer = makeBuffer(16 * sizeof(uint32_t),
+        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
+        &u->statsMemory, "counter buffer");
+    void* mapped{};
+    uiCheck(Layer::ovkMapMemory(device, u->statsMemory, 0, VK_WHOLE_SIZE, 0, &mapped), "counter map");
+    u->counts = static_cast<volatile uint32_t*>(mapped);
+    for (size_t k = 0; k < 16; k++)
+        u->counts[k] = 0;
+
+    // layer 12: UI bits (2 planes) and tile motions, two of each; layer 13:
+    // candidate moves per tile (a count word and 16 moves), two
+    u->words = (this->extent.width + 31) / 32;
+    u->tilesX = (this->extent.width + 15) / 16;
+    u->tilesY = (this->extent.height + 15) / 16;
+    const VkDeviceSize maskSize = VkDeviceSize{2} * u->words * this->extent.height * sizeof(uint32_t);
+    const VkDeviceSize tileSize = VkDeviceSize{u->tilesX} * u->tilesY * sizeof(uint32_t);
+    for (size_t k = 0; k < 2; k++) {
+        VkDeviceMemory mem{};
+        u->masks.at(k) = makeBuffer(maskSize, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, &mem, "UI bit buffer");
+        u->buffers.push_back(u->masks.at(k));
+        u->memories.push_back(mem);
+        u->tiles.at(k) = makeBuffer(tileSize, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, &mem, "tile buffer");
+        u->buffers.push_back(u->tiles.at(k));
+        u->memories.push_back(mem);
+        u->cands.at(k) = makeBuffer(tileSize * 17, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, &mem, "candidate buffer");
+        u->buffers.push_back(u->cands.at(k));
+        u->memories.push_back(mem);
     }
+
+    const auto setCount = static_cast<uint32_t>(2 * u->outCount);
+    const std::array<VkDescriptorPoolSize, 2> poolSizes{{
+        { .type = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, .descriptorCount = 3 * setCount },
+        { .type = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, .descriptorCount = 5 * setCount }
+    }};
+    const VkDescriptorPoolCreateInfo poolInfo{
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+        .maxSets = setCount,
+        .poolSizeCount = static_cast<uint32_t>(poolSizes.size()),
+        .pPoolSizes = poolSizes.data()
+    };
+    uiCheck(createPool(device, &poolInfo, nullptr, &u->pool), "descriptor pool");
+    const std::vector<VkDescriptorSetLayout> layouts(setCount, u->setLayout);
+    u->sets.resize(setCount);
+    const VkDescriptorSetAllocateInfo setInfo{
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+        .descriptorPool = u->pool,
+        .descriptorSetCount = setCount,
+        .pSetLayouts = layouts.data()
+    };
+    uiCheck(allocateSets(device, &setInfo, u->sets.data()), "descriptor sets");
+    for (size_t parity = 0; parity < 2; parity++)
+        for (size_t i = 0; i < u->outCount; i++) {
+            const VkDescriptorSet set = u->sets.at(parity * u->outCount + i);
+            const std::array<VkDescriptorImageInfo, 3> images{{
+                { .imageView = outViews.at(i), .imageLayout = VK_IMAGE_LAYOUT_GENERAL },
+                { .imageView = inputViews.at(parity), .imageLayout = VK_IMAGE_LAYOUT_GENERAL },
+                { .imageView = realView, .imageLayout = VK_IMAGE_LAYOUT_GENERAL }
+            }};
+            const std::array<VkDescriptorBufferInfo, 5> buffers{{
+                { .buffer = u->statsBuffer, .offset = 0, .range = VK_WHOLE_SIZE },
+                { .buffer = u->masks.at(parity), .offset = 0, .range = VK_WHOLE_SIZE },
+                { .buffer = u->masks.at(1 - parity), .offset = 0, .range = VK_WHOLE_SIZE },
+                { .buffer = u->tiles.at(parity), .offset = 0, .range = VK_WHOLE_SIZE },
+                { .buffer = u->cands.at(parity), .offset = 0, .range = VK_WHOLE_SIZE }
+            }};
+            std::array<VkWriteDescriptorSet, 8> writes{};
+            for (uint32_t b = 0; b < writes.size(); b++)
+                writes.at(b) = VkWriteDescriptorSet{
+                    .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+                    .dstSet = set,
+                    .dstBinding = b,
+                    .descriptorCount = 1,
+                    .descriptorType = b >= 3 ? VK_DESCRIPTOR_TYPE_STORAGE_BUFFER
+                        : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+                    .pImageInfo = b >= 3 ? nullptr : &images.at(b),
+                    .pBufferInfo = b >= 3 ? &buffers.at(b - 3) : nullptr
+                };
+            updateSets(device, static_cast<uint32_t>(writes.size()), writes.data(), 0, nullptr);
+        }
+    this->ui = u;
+}
+
+// Layer 12: this frame's UI bits and how its UI moved since the frame
+// before, recorded after the copies that fill frame_0/frame_1 and uiFrame
+// (both already in GENERAL for compute reads).
