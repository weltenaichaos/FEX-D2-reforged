+        const VkResult deferred = pPresentInfo->swapchainCount > 0
+            ? takeDeferredLocked(*pPresentInfo->pSwapchains, false) : VK_SUCCESS;
+        if (deferred < 0) {
+            // the game recreates the swapchain; this frame only goes through
+            Layer::ovkQueuePresentKHR(queue, pPresentInfo);
+            return deferred;
