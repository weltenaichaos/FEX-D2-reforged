+    VkResult worseResult(VkResult a, VkResult b) {
+        if (a < 0) return a;
+        if (b < 0) return b;
+        if (a == VK_SUBOPTIMAL_KHR || b == VK_SUBOPTIMAL_KHR) return VK_SUBOPTIMAL_KHR;
+        return VK_SUCCESS;
+    }
