+namespace {
+    VkResult layer_vkEnumeratePhysicalDevices(VkInstance instance,
+            uint32_t* pCount, VkPhysicalDevice* pDevices) {
+        auto fn = reinterpret_cast<PFN_vkEnumeratePhysicalDevices>(
+            next_vkGetInstanceProcAddr(instance, "vkEnumeratePhysicalDevices"));
+        if (!fn) return VK_ERROR_INITIALIZATION_FAILED;
+        auto res = fn(instance, pCount, pDevices);
+        if ((res == VK_SUCCESS || res == VK_INCOMPLETE) && pDevices) {
+            const std::lock_guard<std::mutex> lock(g_instanceMutex);
+            for (uint32_t i = 0; i < *pCount; i++)
+                g_physToInstance[pDevices[i]] = instance;
+        }
+        return res;
+    }
+
+    VkResult layer_vkEnumeratePhysicalDeviceGroups(VkInstance instance,
+            uint32_t* pCount, VkPhysicalDeviceGroupProperties* pGroups) {
+        auto fn = reinterpret_cast<PFN_vkEnumeratePhysicalDeviceGroups>(
+            next_vkGetInstanceProcAddr(instance, "vkEnumeratePhysicalDeviceGroups"));
+        if (!fn) fn = reinterpret_cast<PFN_vkEnumeratePhysicalDeviceGroups>(
+            next_vkGetInstanceProcAddr(instance, "vkEnumeratePhysicalDeviceGroupsKHR"));
+        if (!fn) return VK_ERROR_INITIALIZATION_FAILED;
+        auto res = fn(instance, pCount, pGroups);
+        if ((res == VK_SUCCESS || res == VK_INCOMPLETE) && pGroups) {
+            const std::lock_guard<std::mutex> lock(g_instanceMutex);
+            for (uint32_t i = 0; i < *pCount; i++)
+                for (uint32_t j = 0; j < pGroups[i].physicalDeviceCount; j++)
+                    g_physToInstance[pGroups[i].physicalDevices[j]] = instance;
+        }
+        return res;
+    }
+
+    void layer_vkDestroyInstance(VkInstance instance, const VkAllocationCallbacks* pAllocator) {
+        auto fn = reinterpret_cast<PFN_vkDestroyInstance>(
+            next_vkGetInstanceProcAddr(instance, "vkDestroyInstance"));
+        {
+            const std::lock_guard<std::mutex> lock(g_instanceMutex);
+            g_liveInstances.erase(instance);
+            std::erase_if(g_physToInstance,
+                [instance](const auto& p) { return p.second == instance; });
+            if (g_instanceHandle == instance)
+                g_instanceHandle = g_liveInstances.empty() ? VK_NULL_HANDLE : *g_liveInstances.begin();
+        }
+        std::cerr << "lsfg-vk: [dbg] instance destroyed " << static_cast<void*>(instance) << "\n";
+        if (fn) fn(instance, pAllocator);
+    }
+}
