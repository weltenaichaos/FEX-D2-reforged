--- a/libs/vkd3d/fex_draw_probe.c
+++ b/libs/vkd3d/fex_draw_probe.c
@@ -1,75 +1,81 @@
 /*
- * FEX draw probe (VKD3D fex23-fex26): times on the GPU how long small draws take when they are recorded in different
- * ways, and puts the result in a '#' note of the gpu report (FEX's stats log). It answers whether D2R's draws are slow
- * on Adreno because of what changes before every draw (new push constants and new root constant buffers, which Turnip
- * turns into new register values for every draw) or because of the draws themselves, and whether drawing many objects
- * with one call (each finding its data by its draw index) avoids it.
+ * FEX draw probe (VKD3D fex23-fex27): times on the GPU how long draws take when they are recorded in different ways,
+ * and puts the result in a '#' note of the gpu report (FEX's stats log). It answers whether drawing D2R's objects in
+ * batches (each draw finding its data in a buffer, so nothing is set between draws) would make its busy passes
+ * cheaper than D2R's way (new push constants and new root constant buffers before every draw, which Turnip turns into
+ * new register values for every draw).
  *
- * Every test is one render pass of 1000 draws of an 8-pixel triangle into a 2048x2048 RGBA8 target (loaded and stored,
- * so Turnip draws it straight to memory as it does D2R's big passes), timed by timestamps around the pass (the GPU
- * finishes everything before each of them), 3 times in a row; per test the fastest round counts, less the empty pass's
- * own time, divided by 1000.
+ * fex27: draws the size of D2R's. fex26 timed 8-pixel triangles, which the GPU finishes so fast that what happens
+ * between draws shows less than it would in the game (0.4-1.6 us a draw against 2-6 us in D2R's passes). Now every
+ * test is 1000 draws of a 220-triangle mesh (440 vertices, 660 indices: 10 x 11 quads, about the triangles and
+ * vertices of a D2R main pass draw), each in its own cell of a 40 x 25 grid, so the draws cover the target once:
+ * - main: 1280x720 R11G11B10F + RGBA8 + D24S8 (the formats of D2R's main pass), ~920 pixels a draw (D2R's main pass:
+ *   ~940 pixel shader runs a draw), a lit pixel shader (2 texture reads from an array of 8, 8 lights);
+ * - shadow: the same meshes into a 2048x2048 D16 map (~4,200 pixels a draw), depth only with an alpha-test pixel
+ *   shader (D2R's shadow passes have a pixel shader too).
+ * Every pass loads and stores its targets (Turnip then draws straight to memory as for D2R's big passes; covering the
+ * target only once keeps its autotuner on that choice). Ways of drawing, per kind:
+ * - no changes: nothing set between draws, only the index range moves (the lower bound);
+ * - like D2R: new push constants (13 dwords) and 2 new root constant buffers (push descriptors) before every draw;
+ * - first instance: nothing set between draws, each draw finds its block in a buffer by its instance index;
+ * - one multi-draw call: all 1000 in one vkCmdDrawIndexedIndirect, each finding its block by its draw index.
+ * The two batched ways read their material, lights and texture index per pixel from that buffer (a batched D2R
+ * would have to), the others get them from constant buffers and push constants the driver loads once per draw.
+ * Each test is one render pass per round, timed by timestamps around the pass (the GPU finishes everything before
+ * each of them), 3 rounds in a row; per test the fastest round counts, less its kind's empty pass, divided by 1000.
  *
- * fex24: fex23 ran the probe inside device creation, on the game's own Vulkan device, in one submission, and D2R
- * crashed at start (the log ends a second after the probe recorded its draws). Now the probe runs on a thread of its
- * own, 2 s after the device is made (VKD3D_FEX_DRAW_PROBE_DELAY, seconds), on a Vulkan device of its own (the same
- * GPU, so a GPU fault in the probe loses only that device, not the game's), one test per submission, each named
- * in the log 1.5 s before it is sent to the GPU (a '  draw probe:' line in the gpu report), so a crash shows which
- * test it was. A test that fails stops the probe; the note then gives the tests done so far and where it stopped.
+ * fex24: the probe runs on a thread of its own, 2 s after the game's device is made (VKD3D_FEX_DRAW_PROBE_DELAY,
+ * seconds), on a Vulkan device of its own (the same GPU, so a GPU fault in the probe loses only that device), one test
+ * per submission, each named in the log 1.5 s before it is sent to the GPU (a '  draw probe:' line in the gpu report),
+ * so a crash shows which test it was. A test that fails stops the probe; the note then gives the tests done so far
+ * and where it stopped.
  * fex25: the probe's device also enables VK_KHR_swapchain, which GameNative's frame cap layer needs from every device
- * (see fex_probe_create_device); fex24 crashed the game's next present without it.
- * fex26: off unless asked for (VKD3D_FEX_DRAW_PROBE=1), as with the layer off fex24 ran 11 tests and the game ended
- * during the 12th ('lit, one multi-draw call'); that test runs only with VKD3D_FEX_DRAW_PROBE=2. The results so far go
- * into the log after every test, so a crash in a later test keeps them.
- * Runs only with VKD3D_FEX_DRAW_PROBE=1 or 2, and only while the pass meter runs (VKD3D_FEX_PASSES).
+ * (see fex_probe_create_device).
+ * fex26: off unless asked for (VKD3D_FEX_DRAW_PROBE=1); the results so far go into the log after every test.
+ * fex27: the probe never destroys anything it made, its device included: with fex24 and fex26 the game died right
+ * after the last test, when the probe tore its device down. Its objects (~35 MB of GPU memory) stay until the game
+ * ends.
+ * Runs only with VKD3D_FEX_DRAW_PROBE=1 (or higher), and only while the pass meter runs (VKD3D_FEX_PASSES).
  *
  * The shaders (fex_draw_probe_spv.h, glslangValidator -V --target-env vulkan1.1):
  *
- * simple.vert:
- *   layout(set = 0, binding = 0) uniform Cam { vec4 scale; } cam;
- *   layout(set = 0, binding = 1) uniform Obj { vec4 pos; } obj;
- *   layout(push_constant) uniform PC { uint idx; uint pad[12]; } pc;
+ * real.vert (main and shadow, like D2R's draws: the object's data in root constant buffers):
+ *   layout(set = 0, binding = 0, std140) uniform Cam { mat4 viewproj; vec4 eye; } cam;
+ *   layout(set = 0, binding = 1, std140) uniform Obj { mat4 world; vec4 tint; } obj;
+ *   layout(push_constant) uniform PC { uint tex; float scale; uint pad[11]; } pc;
+ *   layout(location = 0) in vec3 in_pos; layout(location = 1) in vec2 in_uv; layout(location = 2) in vec4 in_nrm;
+ *   layout(location = 0) out vec2 o_uv; layout(location = 1) out vec3 o_wpos; layout(location = 2) out vec3 o_nrm;
+ *   layout(location = 3) out vec4 o_tint;
  *   void main() {
- *       vec2 v = vec2(gl_VertexIndex == 1 ? 1.0 : 0.0, gl_VertexIndex == 2 ? 1.0 : 0.0);
- *       gl_Position = vec4(obj.pos.xy + v * cam.scale.xy + vec2(float(pc.idx) * cam.scale.z), 0.0, 1.0); }
- * simple.frag:
- *   layout(set = 0, binding = 2) uniform Mat { vec4 color; vec4 lights[32]; } mat;
- *   layout(location = 0) out vec4 o;
- *   void main() { o = mat.color; }
- * lit.frag (a lit-like pixel shader; its 32 lights are the same for the whole draw, so Turnip loads them once per
- * draw ahead of the pixels):
- *   layout(set = 0, binding = 2) uniform Mat { vec4 color; vec4 lights[32]; } mat;
- *   layout(location = 0) out vec4 o;
+ *       vec4 w = obj.world * vec4(in_pos, 1.0); gl_Position = cam.viewproj * w;
+ *       o_uv = in_uv; o_wpos = w.xyz; o_nrm = mat3(obj.world) * (in_nrm.xyz * 2.0 - 1.0); o_tint = obj.tint * pc.scale; }
+ * real.frag (main, lit):
+ *   layout(set = 0, binding = 2, std140) uniform Mat { vec4 color; vec4 params; vec4 lights[16]; vec4 lcolors[16]; } mat;
+ *   layout(set = 1, binding = 0) uniform sampler2D texs[8];
+ *   (pc as above; inputs as real.vert's outputs) layout(location = 0) out vec4 o0; layout(location = 1) out vec4 o1;
  *   void main() {
- *       vec4 c = mat.color; vec2 p = gl_FragCoord.xy * 0.001;
- *       for (int i = 0; i < 32; i++) c += mat.lights[i] * max(0.0, dot(p, mat.lights[i].xy));
- *       o = c; }
- * batch.vert (GL_ARB_shader_draw_parameters; the draw's data by its draw index, or by its instance index):
+ *       vec4 a = texture(texs[pc.tex & 7u], uv); vec4 b = texture(texs[(pc.tex + 1u) & 7u], uv * 2.0);
+ *       vec3 n = normalize(nrm); vec3 c = mat.params.xyz;
+ *       for (int i = 0; i < 8; i++) {
+ *           vec3 l = mat.lights[i].xyz - wpos; float d = max(dot(l, l), 1e-4);
+ *           c += mat.lcolors[i].rgb * (max(dot(n, l), 0.0) * inversesqrt(d) / (1.0 + d * mat.lights[i].w)); }
+ *       o0 = vec4(c * a.rgb * mat.color.rgb * tint.rgb, 1.0); o1 = vec4(b.rgb * tint.a, a.a * mat.color.a); }
+ * depth.frag (shadow): if (texture(texs[pc.tex & 7u], uv).a * mat.color.a < 0.01) discard;
+ * batch.vert (GL_ARB_shader_draw_parameters; the draw's block by its draw index, or by its instance index):
  *   layout(constant_id = 0) const int USE_INSTANCE = 0;
- *   layout(set = 0, binding = 0) uniform Cam { vec4 scale; } cam;
- *   layout(set = 0, binding = 3, std430) readonly buffer Objs { vec4 pos[]; } objs;
- *   layout(set = 0, binding = 4, std430) readonly buffer Mats { vec4 color[]; } mats;
- *   layout(location = 0) flat out vec4 col;
- *   layout(location = 1) flat out uint id;
+ *   struct Block { mat4 world; vec4 tint; uvec4 meta; vec4 pad0[10];
+ *                  vec4 color; vec4 params; vec4 lights[16]; vec4 lcolors[16]; vec4 pad1[14]; };   (1024 bytes)
+ *   layout(set = 0, binding = 3, std430) readonly buffer Blocks { Block b[]; } blocks;
+ *   (outputs as real.vert's, plus) layout(location = 4) flat out uint o_id;
  *   void main() {
  *       uint i = USE_INSTANCE != 0 ? uint(gl_InstanceIndex) : uint(gl_DrawIDARB);
- *       vec2 v = vec2(gl_VertexIndex == 1 ? 1.0 : 0.0, gl_VertexIndex == 2 ? 1.0 : 0.0);
- *       gl_Position = vec4(objs.pos[i].xy + v * cam.scale.xy, 0.0, 1.0);
- *       col = mats.color[i]; id = i; }
- * batch.frag:
- *   layout(location = 0) flat in vec4 col;
- *   layout(location = 0) out vec4 o;
- *   void main() { o = col; }
- * lit_batch.frag (lit.frag for batched draws: the lights come from the draw's block, found by its index, so they are
- * read by the pixels themselves):
- *   struct Mat { vec4 color; vec4 lights[32]; vec4 pad[31]; };
- *   layout(set = 0, binding = 5, std430) readonly buffer LitMats { Mat m[]; } mats;
- *   layout(location = 1) flat in uint id;
- *   layout(location = 0) out vec4 o;
- *   void main() {
- *       vec4 c = mats.m[id].color; vec2 p = gl_FragCoord.xy * 0.001;
- *       for (int i = 0; i < 32; i++) c += mats.m[id].lights[i] * max(0.0, dot(p, mats.m[id].lights[i].xy));
- *       o = c; }
+ *       mat4 world = blocks.b[i].world; vec4 w = world * vec4(in_pos, 1.0); gl_Position = cam.viewproj * w;
+ *       o_uv = in_uv; o_wpos = w.xyz; o_nrm = mat3(world) * (in_nrm.xyz * 2.0 - 1.0); o_tint = blocks.b[i].tint;
+ *       o_id = i; }
+ * batch.frag (main; GL_EXT_nonuniform_qualifier): real.frag with mat.x -> blocks.b[id].x and the texture index
+ *   t = blocks.b[id].meta.x read per pixel: texs[nonuniformEXT(t & 7u)], texs[nonuniformEXT((t + 1u) & 7u)].
+ * depth_batch.frag (shadow):
+ *   if (texture(texs[nonuniformEXT(blocks.b[id].meta.x & 7u)], uv).a * blocks.b[id].color.a < 0.01) discard;
