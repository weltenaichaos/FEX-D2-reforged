+static bool fex_probe_begin(struct fex_probe *p)
+{
+    VkCommandBufferBeginInfo begin_info;
+
+    if (PVK(vkResetCommandBuffer)(p->cmd, 0) != VK_SUCCESS)
+        return false;
+    memset(&begin_info, 0, sizeof(begin_info));
+    begin_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+    begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    return PVK(vkBeginCommandBuffer)(p->cmd, &begin_info) == VK_SUCCESS;
+}
+
+/* Submits the recorded command buffer and waits for it. VK_TIMEOUT: the GPU may still be on it. */
+static VkResult fex_probe_submit(struct fex_probe *p, const char **call)
+{
+    VkCommandBufferSubmitInfo cmd_info;
+    VkSubmitInfo2 submit;
+    VkResult vr;
+
+    memset(&cmd_info, 0, sizeof(cmd_info));
+    cmd_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO;
+    cmd_info.commandBuffer = p->cmd;
+    memset(&submit, 0, sizeof(submit));
+    submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO_2;
+    submit.commandBufferInfoCount = 1;
+    submit.pCommandBufferInfos = &cmd_info;
+
+    *call = "vkQueueSubmit2";
+    if ((vr = PVK(vkQueueSubmit2)(p->vk_queue, 1, &submit, p->fence)) != VK_SUCCESS)
+        return vr;
+    *call = "vkWaitForFences";
+    if ((vr = PVK(vkWaitForFences)(p->vk_device, 1, &p->fence, VK_TRUE, FEX_PROBE_WAIT_NS)) != VK_SUCCESS)
+        return vr;
+    *call = "vkResetFences";
+    return PVK(vkResetFences)(p->vk_device, 1, &p->fence);
+}
