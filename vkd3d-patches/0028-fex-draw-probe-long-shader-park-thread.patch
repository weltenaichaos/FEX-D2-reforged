+ *   vec4 a = texture(texs[t & 7u], uv); vec4 nm = texture(texs[(t + 1u) & 7u], uv * 2.0);
+ *   vec4 sp = texture(texs[(t + 2u) & 7u], uv * 3.0); vec3 n = normalize(nrm + nm.xyz - 0.5); vec3 c = M.params.xyz;
+ *   uint nl = min(floatBitsToUint(M.lcolors[15].x), 15u); uint nd = min(floatBitsToUint(M.lcolors[15].y), 8u);
