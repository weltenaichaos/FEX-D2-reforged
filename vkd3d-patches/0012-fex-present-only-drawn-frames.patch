+void vkd3d_fex_timeline_handoff(bool unfinished, bool waited, uint64_t wait_ns, bool gave_up)
+{
+    if (!vkd3d_fex_timeline_on)
+        return;
+    spinlock_acquire(&fex_timeline.lock);
+    fex_timeline.handoff_presents++;
+    if (unfinished)
+        fex_timeline.handoff_unfinished++;
+    if (waited)
+    {
+        fex_timeline.handoff_waited++;
+        fex_timeline_add(&fex_timeline.handoff_wait, wait_ns);
+    }
+    if (gave_up)
+        fex_timeline.handoff_gave_up++;
+    spinlock_release(&fex_timeline.lock);
+}
