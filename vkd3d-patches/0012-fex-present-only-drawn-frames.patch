 #define VKD3D_FEX_REPORT_FLAG_HOST_FRAME_DONE 0x200u /* present report: frame done signalled from the CPU after a fence */
 #define VKD3D_FEX_REPORT_FLAG_SKIP_FRESH_CLEARS 0x400u /* gpu report: zero fills of never-used chunk pages skipped */
+#define VKD3D_FEX_REPORT_FLAG_PRESENT_DRAWN 0x800u /* present report: frames go to the window system only once drawn */
 #define VKD3D_FEX_REPORT_FLAG_DEVICE 0x80000000u /* a D3D12 device was created */
 struct vkd3d_fex_report
 {
@@ -3133,6 +3134,10 @@ extern bool vkd3d_fex_present_presleep_on;
 /* Frame done signal from the CPU (VKD3D_FEX_HOST_FRAME_DONE, on unless 0, swapchain.c): a thread waits for each
  * present's copy fence and signals the frame done timeline with vkSignalSemaphore instead of an empty queue submit. */
 extern bool vkd3d_fex_host_frame_done_on;
+/* Drawn frames only (VKD3D_FEX_PRESENT_DRAWN=1, VKD3D fex12, swapchain.c): vkQueuePresentKHR is only called once the
+ * GPU has finished the frame's copy into the swapchain image. GameNative's window system shows an image from the moment
+ * its present arrives, without waiting for the GPU, so an image handed over earlier showed what it held before. */
+extern bool vkd3d_fex_present_drawn_on;
 void vkd3d_fex_timeline_init(void);
 uint32_t vkd3d_fex_timeline_queue_slot(D3D12_COMMAND_LIST_TYPE type);
 void vkd3d_fex_timeline_queue_free_slot(uint32_t slot);
@@ -3152,6 +3157,10 @@ void vkd3d_fex_timeline_cap(bool presleep, bool held_long, bool not_held, bool a
         uint64_t guard_ns);
 uint64_t vkd3d_fex_timeline_last_release(void);
 void vkd3d_fex_timeline_config(const char *text);
+/* One present's handoff to the window system (VKD3D fex12): whether the GPU had the frame's copy done when the queue
+ * thread was ready to call vkQueuePresentKHR, and how long it then waited for it (gave_up: stopped waiting at the
+ * ceiling). */
+void vkd3d_fex_timeline_handoff(bool unfinished, bool waited, uint64_t wait_ns, bool gave_up);
 void vkd3d_fex_timeline_tick(uint64_t now_ns);
 
 /* FEX pass meter (fex_pass_meter.c): GPU time per render pass and command list, reported to FEX's stats log. */
