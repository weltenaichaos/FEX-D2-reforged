 }
 
+/* Drawn frames only (VKD3D fex12): the most a present waits for the GPU to finish its frame before it goes anyway. */
+#define FEX_DRAWN_MAX_WAIT_MS 200u
+
+/* Drawn frames only: waits until the GPU has finished this frame's copy into the swapchain image, without holding the
+ * VkQueue, and returns how long it waited.
+ *
+ * GameNative's window system takes no fence with a present: its Vulkan wrapper's X11 WSI sends the image to the X
+ * server as soon as vkQueuePresentKHR has submitted (only MAILBOX waits for the GPU first), and the X server draws the
+ * window from that AHardwareBuffer on its next frame without waiting either. KGSL has no implicit sync between the two
+ * processes. An image handed over before the GPU got to the frame's copy was shown with what it held before: the
+ * frame from 4 presents earlier, or part of it. In the build 65 log fights handed every frame over ~0.5 ms after the
+ * game's Present() and the GPU finished it ~41-44 ms later; calm scenes, where the cap held the present, had the GPU
+ * ~5 ms ahead. The picture jumping back to an older frame and forward again looks like rubber banding.
+ *
+ * The frame done thread sees the copy's fence signalled (it waits for it from its submit) and wakes this wait.
+ * Queue thread only (tracked_blit_value). */
+static uint64_t dxgi_vk_swap_chain_fex_wait_drawn(struct dxgi_vk_swap_chain *chain, uint64_t blit_value)
+{
+    bool unfinished, waited = false, gave_up = false;
+    uint64_t start_ns = 0, wait_ns = 0;
+#ifdef _WIN32
+    uint64_t now_ns, end_ns;
+#endif
+
+    if (!blit_value || !chain->fex_done.enable || blit_value > chain->fex_done.tracked_blit_value)
+        return 0;
+
+    pthread_mutex_lock(&chain->fex_done.lock);
+    unfinished = chain->fex_done.completed_blit < blit_value;
+    if (unfinished && vkd3d_fex_present_drawn_on)
+    {
+        waited = true;
+        start_ns = vkd3d_get_current_time_ns();
+#ifdef _WIN32
+        end_ns = start_ns + FEX_DRAWN_MAX_WAIT_MS * 1000000ull;
+        while (chain->fex_done.completed_blit < blit_value && !chain->fex_done.stop)
+        {
+            now_ns = vkd3d_get_current_time_ns();
+            if (now_ns >= end_ns)
+            {
+                gave_up = true;
+                break;
+            }
+            SleepConditionVariableSRW(&chain->fex_done.cond.cond, &chain->fex_done.lock.lock,
+                    (DWORD)((end_ns - now_ns + 999999ull) / 1000000ull), 0);
+        }
+#else
+        while (chain->fex_done.completed_blit < blit_value && !chain->fex_done.stop)
+            pthread_cond_wait(&chain->fex_done.cond, &chain->fex_done.lock);
+#endif
+        wait_ns = vkd3d_get_current_time_ns() - start_ns;
+    }
+    pthread_mutex_unlock(&chain->fex_done.lock);
+
+    vkd3d_fex_timeline_handoff(unfinished, waited, wait_ns, gave_up);
+    return wait_ns;
+}
+
 static void dxgi_vk_swap_chain_present_iteration(struct dxgi_vk_swap_chain *chain, uint64_t present_count, unsigned int retry_counter)
 {
     const struct vkd3d_vk_device_procs *vk_procs = &chain->queue->device->vk_procs;
@@ -3075,6 +3137,9 @@ static void dxgi_vk_swap_chain_present_iteration(struct dxgi_vk_swap_chain *chai
 
     chain->present.fex.hold_start_ns = vkd3d_get_current_time_ns();
     fex_presleep_slept = vkd3d_fex_present_presleep_on && dxgi_vk_swap_chain_fex_presleep(chain);
+    /* After the cap pre-sleep, which a frame the GPU still works on spends anyway; the cap's own sleep in
+     * vkQueuePresentKHR aims at a due time, so a wait that ends before it costs nothing. */
+    chain->present.fex.handoff_wait_ns = dxgi_vk_swap_chain_fex_wait_drawn(chain, chain->present.fex.blit_value);
 
     if (vkd3d_fex_timeline_on)
         fex_t0 = vkd3d_get_current_time_ns();
@@ -3678,7 +3743,7 @@ static void dxgi_vk_swap_chain_fex_start_frame_done(struct dxgi_vk_swap_chain *c
 {
     int64_t queue_wait, held, gpu_ahead, spare = 0, natural, lowest, target = 0, aim = 0, delay, step, margin, gpu_busy;
     int64_t present_room, max_step, low[FEX_START_BUSY_RANK], v;
-    uint64_t gpu_done_ns = 0, release_ns, now_ns, base_ns, hold_start_ns, gpu_frame_ns = 0;
+    uint64_t gpu_done_ns = 0, release_ns, now_ns, base_ns, hold_start_ns, gpu_frame_ns = 0, qp_end_ns;
     bool late = false, caused = false, measured = false, held_back, gpu_noted = false, busy = false, unseen = false;
     bool gpu_bound = false;
     uint32_t slot, i, k, busy_frames, low_count;
@@ -3699,16 +3764,22 @@ static void dxgi_vk_swap_chain_fex_start_frame_done(struct dxgi_vk_swap_chain *c
     delay = (int64_t)chain->fex_start.delay_ns;
     margin = (int64_t)chain->fex_start.margin_ns;
     hold_start_ns = fex->hold_start_ns ? fex->hold_start_ns : fex->qp_start_ns;
+    /* Drawn frames only (VKD3D fex12): the present waited for the GPU between the cap pre-sleep and vkQueuePresentKHR.
+     * Everything below measures against when the present would have returned without that wait, as before: a frame
+     * the GPU finished late is still late, not a frame a cap held back. */
+    qp_end_ns = fex->qp_end_ns;
+    if (fex->handoff_wait_ns && qp_end_ns >= hold_start_ns + fex->handoff_wait_ns)
+        qp_end_ns -= fex->handoff_wait_ns;
 
-    if (fex->call_ns && fex->pickup_ns && hold_start_ns && fex->qp_end_ns >= hold_start_ns && gpu_done_ns)
+    if (fex->call_ns && fex->pickup_ns && hold_start_ns && qp_end_ns >= hold_start_ns && gpu_done_ns)
     {
         measured = true;
         /* The present waited this long for the queue thread (busy with the frame before), */
         queue_wait = fex->pickup_ns > fex->call_ns ? (int64_t)(fex->pickup_ns - fex->call_ns) : 0;
         /* and a frame cap held it this long (sleeping in vkQueuePresentKHR, or before it in the cap pre-sleep), which
          * a later frame would only have saved as far as the GPU had the frame done before vkQueuePresentKHR returned. */
-        held = (int64_t)(fex->qp_end_ns - hold_start_ns);
-        gpu_ahead = (int64_t)fex->qp_end_ns - (int64_t)gpu_done_ns;
+        held = (int64_t)(qp_end_ns - hold_start_ns);
+        gpu_ahead = (int64_t)qp_end_ns - (int64_t)gpu_done_ns;
         spare = queue_wait + min(held, gpu_ahead);
         /* Busy GPU (fights): the GPU was still on the frame before when the game called Present(), so this frame's
          * command lists, all given before Present(), waited for the GPU anyway and would have reached it just as early
@@ -3725,7 +3796,7 @@ static void dxgi_vk_swap_chain_fex_start_frame_done(struct dxgi_vk_swap_chain *c
              * frame's GPU time. */
             if (gpu_busy > 0 && gpu_noted && gpu_done_ns > chain->fex_start.prev_gpu_done_ns)
                 gpu_frame_ns = gpu_done_ns - chain->fex_start.prev_gpu_done_ns;
-            present_room = queue_wait + held + max((int64_t)gpu_done_ns - (int64_t)fex->qp_end_ns, (int64_t)0);
+            present_room = queue_wait + held + max((int64_t)gpu_done_ns - (int64_t)qp_end_ns, (int64_t)0);
             gpu_busy = min(gpu_busy, present_room);
             if (gpu_busy > spare)
             {
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index be4ddb3..7d0678a 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -3074,6 +3074,7 @@ struct vkd3d_timestamp_profiler_submitted_work;
