+/* FEX frame done: hands this present to the frame done thread instead of signalling the frame done timeline with an
+ * empty submit. Its copies were added at their submit; the last one signals the present once seen done. A present
+ * without a copy (the swapchain was lost) gets an entry of its own. Queue thread. */
+static void dxgi_vk_swap_chain_fex_done_push(struct dxgi_vk_swap_chain *chain, uint64_t present_count)
+{
+    uint32_t slot, i;
+
+    pthread_mutex_lock(&chain->fex_done.lock);
+    if (chain->fex_done.unpushed)
+    {
+        /* Not ready, so the thread can't have removed them: they are the newest entries. */
+        assert(chain->fex_done.unpushed <= chain->fex_done.count);
+        for (i = 0; i < chain->fex_done.unpushed; i++)
+        {
+            slot = (chain->fex_done.head + chain->fex_done.count - 1 - i) % ARRAY_SIZE(chain->fex_done.fences);
+            chain->fex_done.present_count[slot] = i ? 0 : present_count;
+            chain->fex_done.ready[slot] = true;
+        }
+    }
+    else
+    {
+        while (chain->fex_done.count == ARRAY_SIZE(chain->fex_done.fences))
+            pthread_cond_wait(&chain->fex_done.cond, &chain->fex_done.lock);
+        slot = (chain->fex_done.head + chain->fex_done.count) % ARRAY_SIZE(chain->fex_done.fences);
+        chain->fex_done.has_fence[slot] = false;
+        chain->fex_done.blit_value[slot] = 0;
+        chain->fex_done.present_count[slot] = present_count;
+        chain->fex_done.ready[slot] = true;
+        chain->fex_done.seen[slot] = true;
+        chain->fex_done.count++;
+    }
+    pthread_cond_broadcast(&chain->fex_done.cond);
+    pthread_mutex_unlock(&chain->fex_done.lock);
+
+    chain->fex_done.unpushed = 0;
