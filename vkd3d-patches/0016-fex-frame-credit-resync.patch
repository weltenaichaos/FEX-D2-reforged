         const struct fex_timeline_queue *q = &queues[i];
diff --git a/libs/vkd3d/swapchain.c b/libs/vkd3d/swapchain.c
index 682c280..8a14f34 100644
--- a/libs/vkd3d/swapchain.c
+++ b/libs/vkd3d/swapchain.c
@@ -392,6 +392,30 @@ struct dxgi_vk_swap_chain
         uint32_t unpushed;         /* copies added since the last present was handed over */
         uint64_t tracked_blit_value; /* highest fenced blit value added */
     } fex_done;
+
+    /* FEX frame credit resync (VKD3D_FEX_LATENCY_RESYNC; VKD3D fex16). The game's frame latency handle is a semaphore
+     * holding the credits for frames the game may start: SetMaximumFrameLatency(N) makes N, the game takes one before
+     * each frame and vkd3d gives one back once that frame's present is done. A frame the game starts without taking one
+     * (its wait timed out, or it presented before it began to wait) leaves one credit too many for good: the game then
+     * runs a frame further ahead than it asked for, each frame takes a frame longer from input to screen, and only
+     * vkd3d's own latency limit in Present() holds it (D2R logs b74 and b77: a 1 s timeout of the wait at startup, then
+     * ~100 ms from frame start to screen where 2 frames give ~67). Each hand-out compares the game's Present() calls
+     * with the credits it took (handed out minus the count left), and once frames ran without one, the next hand-outs
+     * are held back by as many. */
+    struct
+    {
+        pthread_mutex_t lock;
+        bool lock_initialized;
+        uint64_t given;            /* credits put on the handle: its first count, SetMaximumFrameLatency, hand-outs */
+        uint32_t taken_back;       /* hand-outs held back in all */
+        uint32_t owed;             /* hand-outs still to hold back */
+        uint32_t window;           /* hand-outs looked at in this window */
+        int64_t ahead_min, ahead_max; /* frames the game was ahead of its latency at the hand-outs of this window */
+        uint64_t window_acquired;  /* credits the game had taken at the window's start */
+        uint32_t actions;          /* times hand-outs were held back */
+        uint64_t action_ns[8];     /* when the last 8 of them were decided */
+        bool stopped;              /* held back 8 times in 60 s: the game doesn't take one credit per frame */
+    } fex_resync;
 };
 
 static void dxgi_vk_swap_chain_drain_internal_blit_semaphore(struct dxgi_vk_swap_chain *chain, uint64_t value);
@@ -759,6 +783,11 @@ static void dxgi_vk_swap_chain_cleanup_surface(struct dxgi_vk_swap_chain *chain)
 
 static void dxgi_vk_swap_chain_cleanup_sync_objects(struct dxgi_vk_swap_chain *chain)
 {
+    if (chain->fex_resync.lock_initialized)
+    {
+        pthread_mutex_destroy(&chain->fex_resync.lock);
+        chain->fex_resync.lock_initialized = false;
+    }
     vkd3d_native_sync_handle_destroy(chain->frame_latency_event);
     vkd3d_native_sync_handle_destroy(chain->frame_latency_event_internal);
 
@@ -1148,7 +1177,12 @@ static HRESULT STDMETHODCALLTYPE dxgi_vk_swap_chain_SetFrameLatency(IDXGIVkSwapC
      * the application's responsibility to reduce the semaphore value
      * in case the latency gets reduced. */
     if (MaxLatency > chain->frame_latency)
-        vkd3d_native_sync_handle_release(chain->frame_latency_event, MaxLatency - chain->frame_latency);
+    {
+        pthread_mutex_lock(&chain->fex_resync.lock);
+        if (vkd3d_native_sync_handle_release(chain->frame_latency_event, MaxLatency - chain->frame_latency) >= 0)
+            chain->fex_resync.given += MaxLatency - chain->frame_latency;
+        pthread_mutex_unlock(&chain->fex_resync.lock);
+    }
 
     chain->frame_latency = MaxLatency;
     return S_OK;
@@ -1695,10 +1729,14 @@ static HRESULT dxgi_vk_swap_chain_init_sync_objects(struct dxgi_vk_swap_chain *c
     char env[8];
     HRESULT hr;
 
+    pthread_mutex_init(&chain->fex_resync.lock, NULL);
+    chain->fex_resync.lock_initialized = true;
+
     if (chain->desc.Flags & DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT)
     {
         INFO("Enabling frame latency handles.\n");
         chain->frame_latency = 1;
+        chain->fex_resync.given = chain->frame_latency;
 
         if (FAILED(hr = vkd3d_native_sync_handle_create(chain->frame_latency,
                 VKD3D_NATIVE_SYNC_HANDLE_TYPE_SEMAPHORE, &chain->frame_latency_event)))
@@ -2159,6 +2197,7 @@ static void fex_timeline_note_swapchain(struct dxgi_vk_swap_chain *chain, const
     snprintf(text, sizeof(text), "swapchain %ux%u, %u images (asked %u, game BufferCount %u), mode %s%s%s,"
             " SyncInterval %u, present wait %s, game latency handle %s (max latency %u), internal latency %u,"
             " vkd3d limiter %.1f fps, frame start pacing %s, cap pre-sleep %s, frame done signal %s, drawn frames only %s,"
+            " frame credit resync %s,"
             " VkQueues: graphics family %u x%u,"
             " compute family %u x%u,"
             " copy family %u x%u",
@@ -2178,6 +2217,8 @@ static void fex_timeline_note_swapchain(struct dxgi_vk_swap_chain *chain, const
             !vkd3d_fex_present_drawn_on ? "off" : chain->fex_done.enable ?
                     "on (vkQueuePresentKHR only once the GPU finished the frame's copy: VKD3D fex12)" :
                     "off (needs the frame done thread)",
+            vkd3d_fex_latency_resync_on ? "on (hand-outs held back when the game runs frames ahead of its latency:"
+                    " VKD3D fex16)" : "off",
             families[VKD3D_QUEUE_FAMILY_GRAPHICS]->vk_family_index, families[VKD3D_QUEUE_FAMILY_GRAPHICS]->queue_count,
             families[VKD3D_QUEUE_FAMILY_COMPUTE]->vk_family_index, families[VKD3D_QUEUE_FAMILY_COMPUTE]->queue_count,
             families[VKD3D_QUEUE_FAMILY_TRANSFER]->vk_family_index, families[VKD3D_QUEUE_FAMILY_TRANSFER]->queue_count);
@@ -3455,14 +3496,99 @@ static void dxgi_vk_swap_chain_delay_next_frame(struct dxgi_vk_swap_chain *chain
     vkd3d_fex_timeline_step(VKD3D_FEX_STEP_LIMITER, current_time_ns - fex_sleep_start_ns);
 }
 
+#define FEX_RESYNC_WINDOW 32u
+
+/* FEX frame credit resync, under fex_resync.lock: one hand-out's look at the game. ahead = the game's Present() calls
+ * (read before the hand-out) minus the credits it took minus the hand-outs held back so far. A frame between its credit
+ * and its Present() counts one less, so a game exactly at its latency shows -1 or 0 and one a frame ahead 0 or 1. */
+static void dxgi_vk_swap_chain_fex_resync_note(struct dxgi_vk_swap_chain *chain, int64_t ahead, uint64_t acquired)
+{
+    uint64_t now_ns, oldest_ns;
+    uint32_t owe;
+
+    if (!chain->fex_resync.window)
+    {
+        chain->fex_resync.window_acquired = acquired;
+        chain->fex_resync.ahead_min = ahead;
+        chain->fex_resync.ahead_max = ahead;
+    }
+    else
+    {
+        chain->fex_resync.ahead_min = min(chain->fex_resync.ahead_min, ahead);
+        chain->fex_resync.ahead_max = max(chain->fex_resync.ahead_max, ahead);
+    }
+    if (++chain->fex_resync.window < FEX_RESYNC_WINDOW)
+        return;
+    chain->fex_resync.window = 0;
+    vkd3d_fex_timeline_resync(chain->fex_resync.ahead_min, chain->fex_resync.ahead_max, false,
+            chain->fex_resync.taken_back, chain->fex_resync.stopped);
+
+    /* Act only on a game that took a credit for (nearly) every frame in the window, and whose looks agree with taking
+     * exactly one before each frame (all within one of each other). */
+    if (chain->fex_resync.stopped || chain->fex_resync.ahead_max < 1 ||
+            chain->fex_resync.ahead_min < chain->fex_resync.ahead_max - 1 ||
+            acquired - chain->fex_resync.window_acquired < FEX_RESYNC_WINDOW * 3 / 4)
+        return;
+
+    now_ns = vkd3d_get_current_time_ns();
+    oldest_ns = chain->fex_resync.action_ns[chain->fex_resync.actions % ARRAY_SIZE(chain->fex_resync.action_ns)];
+    if (chain->fex_resync.actions >= ARRAY_SIZE(chain->fex_resync.action_ns) && now_ns - oldest_ns < 60000000000ull)
+    {
+        chain->fex_resync.stopped = true;
+        INFO("FEX frame credit resync: held back hand-outs %u times in the last 60 s, the game doesn't take one credit "
+                "per frame; stopped.\n", (unsigned int)ARRAY_SIZE(chain->fex_resync.action_ns));
+        vkd3d_fex_timeline_resync(chain->fex_resync.ahead_min, chain->fex_resync.ahead_max, false,
+                chain->fex_resync.taken_back, true);
+        return;
+    }
+    chain->fex_resync.action_ns[chain->fex_resync.actions % ARRAY_SIZE(chain->fex_resync.action_ns)] = now_ns;
+    chain->fex_resync.actions++;
+    owe = (uint32_t)min(chain->fex_resync.ahead_max, (int64_t)DXGI_MAX_SWAP_CHAIN_BUFFERS);
+    chain->fex_resync.owed = owe;
+    INFO("FEX frame credit resync: the game is %u frame%s ahead of its frame latency %u (seen %"PRId64" to %"PRId64
+            " in the last %u hand-outs); holding back the next %u.\n", owe, owe == 1 ? "" : "s", chain->frame_latency,
+            chain->fex_resync.ahead_min, chain->fex_resync.ahead_max, FEX_RESYNC_WINDOW, owe);
+}
+
 static void dxgi_vk_swap_chain_release_frame_latency_event(struct dxgi_vk_swap_chain *chain)
 {
+    uint64_t presents = 0, acquired;
     int previous_semaphore;
 
     if (!vkd3d_native_sync_handle_is_valid(chain->frame_latency_event))
         return;
 
-    if ((previous_semaphore = vkd3d_native_sync_handle_release(chain->frame_latency_event, 1)) >= 0)
+    if (vkd3d_fex_latency_resync_on)
+    {
+        pthread_mutex_lock(&chain->fex_resync.lock);
+        if (chain->fex_resync.owed)
+        {
+            chain->fex_resync.owed--;
+            chain->fex_resync.taken_back++;
+            vkd3d_fex_timeline_resync(0, 0, true, chain->fex_resync.taken_back, chain->fex_resync.stopped);
+            pthread_mutex_unlock(&chain->fex_resync.lock);
+            return;
+        }
+        /* Read before the hand-out: the game takes a frame's credit before that frame's Present(), so every Present()
+         * counted here has its credit in the count the hand-out returns. */
+        presents = vkd3d_atomic_uint64_load_explicit(&chain->user.present_count, vkd3d_memory_order_acquire);
+    }
+
+    previous_semaphore = vkd3d_native_sync_handle_release(chain->frame_latency_event, 1);
+
+    if (vkd3d_fex_latency_resync_on)
+    {
+        if (previous_semaphore >= 0)
+        {
+            acquired = chain->fex_resync.given - (uint64_t)previous_semaphore;
+            chain->fex_resync.given++;
+            dxgi_vk_swap_chain_fex_resync_note(chain,
+                    (int64_t)presents - (int64_t)acquired - (int64_t)chain->fex_resync.taken_back, acquired);
+        }
+        pthread_mutex_unlock(&chain->fex_resync.lock);
+    }
+
+    if (previous_semaphore >= 0)
     {
         /* Some applications can keep using MaxLatency of 1,
          * but just avoid acquiring the semaphore a few times to achieve higher latency.
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index 1e3299c..185749a 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -3075,6 +3075,7 @@ struct vkd3d_timestamp_profiler_submitted_work;
 #define VKD3D_FEX_REPORT_FLAG_HOST_FRAME_DONE 0x200u /* present report: frame done signalled from the CPU after a fence */
 #define VKD3D_FEX_REPORT_FLAG_SKIP_FRESH_CLEARS 0x400u /* gpu report: zero fills of never-used chunk pages skipped */
 #define VKD3D_FEX_REPORT_FLAG_PRESENT_DRAWN 0x800u /* present report: frames go to the window system only once drawn */
+#define VKD3D_FEX_REPORT_FLAG_LATENCY_RESYNC 0x1000u /* present report: frame credit resync is on (VKD3D fex16) */
 #define VKD3D_FEX_REPORT_FLAG_DEVICE 0x80000000u /* a D3D12 device was created */
