  * its present arrives, without waiting for the GPU, so an image handed over earlier showed what it held before. */
 extern bool vkd3d_fex_present_drawn_on;
+/* Frame credit resync (VKD3D_FEX_LATENCY_RESYNC, VKD3D fex16, swapchain.c; on unless 0 while frame start pacing is on,
+ * else only with 1): when the game runs frames ahead of the frame latency it set (a frame started without taking a
+ * credit from its frame latency handle), hold back that many of vkd3d's hand-outs on the handle. */
+extern bool vkd3d_fex_latency_resync_on;
 void vkd3d_fex_timeline_init(void);
 uint32_t vkd3d_fex_timeline_queue_slot(D3D12_COMMAND_LIST_TYPE type);
 void vkd3d_fex_timeline_queue_free_slot(uint32_t slot);
@@ -3207,6 +3212,9 @@ void vkd3d_fex_timeline_config(const char *text);
  * thread was ready to call vkQueuePresentKHR, and how long it then waited for it (gave_up: stopped waiting at the
