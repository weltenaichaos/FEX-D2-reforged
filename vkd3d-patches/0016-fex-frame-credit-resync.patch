+        if (resync_windows)
+            len = vkd3d_fex_report_append(text, sizeof(text), len,
+                    " game frames ahead of its latency %"PRId64" to %"PRId64" (-1 or 0 = as set, 0 or 1 = one ahead) |",
+                    resync_ahead_min, resync_ahead_max);
+        len = vkd3d_fex_report_append(text, sizeof(text), len, " hand-outs held back %u this second, %u in all%s\n",
