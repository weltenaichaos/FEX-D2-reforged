     spinlock_release(&fex_timeline.lock);
 
     if (config[0])
@@ -539,6 +587,17 @@ static void fex_timeline_publish(double seconds)
                     " | handed over anyway (drawn frames only is off): the screen may show an older image for those\n");
     }
 
+    if (vkd3d_fex_latency_resync_on && (resync_windows || resync_held || resync_taken_back))
+    {
