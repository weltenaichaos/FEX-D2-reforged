 }
 
 uint32_t vkd3d_fex_timeline_queue_slot(D3D12_COMMAND_LIST_TYPE type)
@@ -285,6 +302,26 @@ void vkd3d_fex_timeline_handoff(bool unfinished, bool waited, uint64_t wait_ns,
     spinlock_release(&fex_timeline.lock);
 }
 
+void vkd3d_fex_timeline_resync(int64_t ahead_min, int64_t ahead_max, bool held, uint32_t taken_back, bool stopped)
+{
+    if (!vkd3d_fex_timeline_on)
+        return;
+    spinlock_acquire(&fex_timeline.lock);
+    if (held)
+        fex_timeline.resync_held++;
+    else
+    {
+        if (!fex_timeline.resync_windows || ahead_min < fex_timeline.resync_ahead_min)
+            fex_timeline.resync_ahead_min = ahead_min;
+        if (!fex_timeline.resync_windows || ahead_max > fex_timeline.resync_ahead_max)
+            fex_timeline.resync_ahead_max = ahead_max;
+        fex_timeline.resync_windows++;
+    }
+    fex_timeline.resync_taken_back = taken_back;
+    fex_timeline.resync_stopped = stopped;
+    spinlock_release(&fex_timeline.lock);
+}
