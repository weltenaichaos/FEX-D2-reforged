+/* FEX (VKD3D fex11): marks the chunk pages the allocation covers as used; true when none of them was used before.
+ * Pages stay marked when the allocation is freed. Called with the allocator mutex held. */
+static bool vkd3d_memory_chunk_fex_mark_used(struct vkd3d_memory_chunk *chunk,
+        const struct vkd3d_memory_allocation *allocation)
+{
+    VkDeviceSize start, first, last, page;
+    bool fresh = true;
+    uint64_t bit;
+
+    if (!allocation->resource.size)
+        return false;
+
+    start = allocation->offset - chunk->allocation.offset;
+    first = start >> VKD3D_FEX_CHUNK_PAGE_BITS;
+    last = (start + allocation->resource.size - 1) >> VKD3D_FEX_CHUNK_PAGE_BITS;
+    if (last >= VKD3D_FEX_CHUNK_PAGES)
+    {
+        /* Not tracked that far: never fresh. */
+        fresh = false;
+        last = VKD3D_FEX_CHUNK_PAGES - 1;
+    }
+
+    for (page = first; page <= last; page++)
+    {
+        bit = 1ull << (page & 63);
+        if (chunk->fex_used[page >> 6] & bit)
+            fresh = false;
+        chunk->fex_used[page >> 6] |= bit;
+    }
+    return fresh;
+}
