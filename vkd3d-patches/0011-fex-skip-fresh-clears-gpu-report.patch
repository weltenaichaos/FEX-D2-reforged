+ * timestamps are written by now (never waits on the GPU). A pair is reset from the CPU once read, so a pair that is
+ * used again can't show its old results before the GPU wrote the new ones. */
+void vkd3d_memory_transfer_queue_fex_collect(struct vkd3d_memory_transfer_queue *queue,
+        struct vkd3d_fex_transfer_totals *t)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &queue->device->vk_procs;
+    const bool host_reset = queue->device->device_info.vulkan_1_2_features.hostQueryReset;
+    struct vkd3d_fex_transfer_record rec;
+    uint64_t seq, data[4], now;
+    VkQueryPool pool;
+    uint32_t pair;
+    bool ready;
+    VkResult vr;
+
+    pthread_mutex_lock(&queue->mutex);
+    t->submits += queue->fex_submits;
+    t->dropped += queue->fex_dropped;
+    t->cpu_ns += queue->fex_cpu_ns;
+    t->wait_ns += queue->fex_wait_ns;
+    t->queue_ns += queue->fex_queue_ns;
+    if (queue->fex_max_cpu_ns > t->max_cpu_ns)
+        t->max_cpu_ns = queue->fex_max_cpu_ns;
+    queue->fex_submits = queue->fex_dropped = 0;
+    queue->fex_cpu_ns = queue->fex_wait_ns = queue->fex_queue_ns = queue->fex_max_cpu_ns = 0;
+    pool = queue->fex_pool;
+    pthread_mutex_unlock(&queue->mutex);
+
+    if (!pool)
+        return;
+
+    now = vkd3d_get_current_time_ns();
+    for (;;)
+    {
+        pthread_mutex_lock(&queue->mutex);
+        if (queue->fex_tail == queue->fex_head)
+        {
+            pthread_mutex_unlock(&queue->mutex);
+            break;
+        }
+        seq = queue->fex_tail;
+        pair = (uint32_t)(seq % VKD3D_FEX_TRANSFER_PAIRS);
+        rec = queue->fex_records[pair];
+        pthread_mutex_unlock(&queue->mutex);
+
+        vr = VK_CALL(vkGetQueryPoolResults(queue->device->vk_device, pool, 2 * pair, 2, sizeof(data), data,
+                2 * sizeof(uint64_t), VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT));
+        ready = vr >= 0 && data[1] && data[3];
+        if (!ready && now - rec.submit_ns < 2000000000ull)
+            break;
+
+        pthread_mutex_lock(&queue->mutex);
+        if (queue->fex_tail != seq)
+        {
+            /* Given up by a flush meanwhile: the pair may hold the next submission's timestamps already. */
+            pthread_mutex_unlock(&queue->mutex);
+            continue;
+        }
+        queue->fex_tail++;
+        if (host_reset)
+            VK_CALL(vkResetQueryPool(queue->device->vk_device, pool, 2 * pair, 2));
+        pthread_mutex_unlock(&queue->mutex);
+
+        if (ready && data[2] >= data[0])
+        {
+            t->resolved++;
+            t->fills += rec.fills;
+            t->writes += rec.writes;
+            t->other += rec.other;
+            t->fill_bytes += rec.fill_bytes;
+            t->write_bytes += rec.write_bytes;
+            t->gpu_ticks += data[2] - data[0];
+            if (data[2] - data[0] > t->max_ticks)
+                t->max_ticks = data[2] - data[0];
+        }
+        else
+            t->lost++;
+    }
+}
