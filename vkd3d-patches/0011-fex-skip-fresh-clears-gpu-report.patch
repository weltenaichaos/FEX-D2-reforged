@@ -13725,6 +13757,7 @@ static void STDMETHODCALLTYPE d3d12_command_list_ClearUnorderedAccessViewFloat(d
 
     TRACE("iface %p, gpu_handle %#"PRIx64", cpu_handle %lx, resource %p, values %p, rect_count %u, rects %p.\n",
             iface, gpu_handle.ptr, cpu_handle.ptr, resource, values, rect_count, rects);
+    vkd3d_fex_outside(list, VKD3D_FEX_OUTSIDE_CLEAR_UAV, 0);
 
     if (list->is_inside_render_pass)
         d3d12_command_list_mark_as_invalid(list, "ClearUnorderedAccessViewFloat called within a render pass.\n");
@@ -13825,6 +13858,7 @@ static void STDMETHODCALLTYPE d3d12_command_list_DiscardResource(d3d12_command_l
     bool full_discard;
 
     TRACE("iface %p, resource %p, region %p.\n", iface, resource, region);
+    vkd3d_fex_outside(list, VKD3D_FEX_OUTSIDE_DISCARD, 0);
 
     if (list->is_inside_render_pass)
         d3d12_command_list_mark_as_invalid(list, "DiscardResource called within a render pass.\n");
@@ -14295,6 +14329,7 @@ static void STDMETHODCALLTYPE d3d12_command_list_ResolveQueryData(d3d12_command_
             "dst_buffer %p, aligned_dst_buffer_offset %#"PRIx64".\n",
             iface, heap, type, start_index, query_count,
             dst_buffer, aligned_dst_buffer_offset);
+    vkd3d_fex_outside(list, VKD3D_FEX_OUTSIDE_QUERY, 0);
 
     if (list->is_inside_render_pass)
         d3d12_command_list_mark_as_invalid(list, "ResolveQueryData called within a render pass.\n");
@@ -15344,6 +15379,9 @@ static void STDMETHODCALLTYPE d3d12_command_list_ExecuteIndirect(d3d12_command_l
             "arg_buffer_offset %#"PRIx64", count_buffer %p, count_buffer_offset %#"PRIx64".\n",
             iface, command_signature, max_command_count, arg_buffer, arg_buffer_offset,
             count_buffer, count_buffer_offset);
+    /* Indirect draws run inside render passes: only dispatches count as work outside them. */
+    if (sig_impl->pipeline_type == VKD3D_PIPELINE_TYPE_COMPUTE)
+        vkd3d_fex_outside(list, VKD3D_FEX_OUTSIDE_INDIRECT, 0);
 
     if (!max_command_count)
         return;
@@ -16376,6 +16414,7 @@ static void STDMETHODCALLTYPE d3d12_command_list_ResolveSubresourceRegion(d3d12_
             "src_rect %p, format %#x, mode %#x!\n",
             iface, dst, dst_sub_resource_idx, dst_x, dst_y,
             src, src_sub_resource_idx, src_rect, format, mode);
+    vkd3d_fex_outside(list, VKD3D_FEX_OUTSIDE_RESOLVE, 0);
 
     if (list->is_inside_render_pass)
         d3d12_command_list_mark_as_invalid(list, "ResolveSubresourceRegion called within a render pass.\n");
@@ -16575,6 +16614,7 @@ static void STDMETHODCALLTYPE d3d12_command_list_WriteBufferImmediate(d3d12_comm
     unsigned int i;
 
     TRACE("iface %p, count %u, parameters %p, modes %p.\n", iface, count, parameters, modes);
+    vkd3d_fex_outside(list, VKD3D_FEX_OUTSIDE_OTHER, 0);
 
     /* Always flush WBI batch if we're outside a render pass instance, since
      * otherwise we're only calling end_wbi_batch in end_current_render_pass. */
@@ -18491,6 +18531,7 @@ static void STDMETHODCALLTYPE d3d12_command_list_Barrier(d3d12_command_list_ifac
 
     TRACE("iface %p, NumBarrierGroups %u, D3D12_BARRIER_GROUP %p\n",
             iface, NumBarrierGroups, pBarrierGroups);
+    vkd3d_fex_outside(list, VKD3D_FEX_OUTSIDE_BARRIER, 0);
 
     d3d12_command_list_end_current_render_pass(list, false);
     d3d12_command_list_end_transfer_batch(list);
diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 04e887e..40d4c01 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -9993,6 +9993,12 @@ static HRESULT d3d12_device_init(struct d3d12_device *device,
     if (FAILED(hr = vkd3d_private_store_init(&device->private_store)))
         goto out_free_vk_resources;
 
+    /* Before any memory is allocated: chunks are made with it in mind (VKD3D fex11). */
+    device->fex_skip_fresh_clears = vkd3d_fex_skip_fresh_clears_enabled(device);
+    vkd3d_atomic_uint32_or((uint32_t *)&vkd3d_fex_gpu_report.flags, VKD3D_FEX_REPORT_FLAG_DEVICE |
+            (device->fex_skip_fresh_clears ? VKD3D_FEX_REPORT_FLAG_SKIP_FRESH_CLEARS : 0), vkd3d_memory_order_release);
+    INFO("FEX: zero fills of never-used memory chunk pages %s.\n", device->fex_skip_fresh_clears ? "skipped" : "made");
+
     if (FAILED(hr = vkd3d_memory_transfer_queue_init(&device->memory_transfers, device)))
         goto out_free_private_store;
 
diff --git a/libs/vkd3d/fex_pass_meter.c b/libs/vkd3d/fex_pass_meter.c
index 62b7ba5..3b604b5 100644
--- a/libs/vkd3d/fex_pass_meter.c
+++ b/libs/vkd3d/fex_pass_meter.c
@@ -30,6 +30,14 @@
  * the command lists begun in 1 frame in 8 get timers (the frame count goes up at the game's Present()); with
  * VKD3D_FEX_PASSES=2 every frame does, as before fex10. The report's figures cover the measured frames only.
  *
+ * Outside passes (VKD3D fex11), in the measured frames: every stretch of a command list between render passes (a
+ * "gap", from a pass's end or the list's start to the next pass or the list's end) gets a timestamp pair too, labelled
+ * with what the game recorded in it (copies, dispatches, barriers, ...). Right after a list's start timestamp (top of
+ * pipe) an all-commands one shows how long the GPU was still busy with the work before the list. The gpu report
+ * (vkd3d_fex_gpu_report) adds what new memory needed (zero fills, memory.c) and the GPU time of vkd3d's own transfer
+ * submissions. Results are reset from the CPU once read (when the driver can): a pair used again can't show the
+ * timestamps of its earlier use before the GPU wrote the new ones (before fex11 it could, once the pool wrapped).
+ *
  * This library is free software; you can redistribute it and/or
  * modify it under the terms of the GNU Lesser General Public
  * License as published by the Free Software Foundation; either
@@ -122,6 +130,15 @@ struct fex_draw_norm
 
 /* Read by FEX (found by export name in d3d12core.dll). */
 struct vkd3d_fex_report vkd3d_fex_pass_report = { 0x50584546u /* 'FEXP' */, 1u, 0u, 0u, { 0 } };
+struct vkd3d_fex_report vkd3d_fex_gpu_report = { 0x47584546u /* 'FEXG' */, 1u, 0u, 0u, { 0 } };
+
+#define FEX_GAP_KINDS 64u
+
+struct fex_gap_stats
+{
+    uint32_t mask;
+    uint64_t count, ticks, max_ticks, cmds, bytes;
+};
 
 struct fex_pass_sig
 {
@@ -218,6 +235,15 @@ struct vkd3d_fex_pass_meter
     uint32_t draw_arm_sig;
     double draw_arm_avg_ms;             /* the sampled kind's average pass time the second before */
     bool draw_names_sent;               /* the driver's statistic names went out once */
+
+    /* VKD3D fex11 */
+    bool host_reset;                    /* results are reset from the CPU once read */
+    struct fex_gap_stats gaps[FEX_GAP_KINDS];
+    uint32_t gap_kinds;
+    uint64_t gap_count, gap_ticks, gaps_unlisted;
+    uint64_t list_waits, list_wait_ticks, list_wait_max;
+    struct vkd3d_fex_transfer_totals xfer;
+    uint32_t gpu_publishes;
 };
 
 static const char *fex_pass_op_name(uint8_t op)
@@ -381,6 +407,38 @@ static void fex_pass_add_record(struct d3d12_command_list *list, const struct vk
 
 /* Draw timing (VKD3D fex9). The sample's pipelines hold an internal reference so their VkPipelines still exist when the
  * meter thread asks the driver for their shader statistics. */
+/* VKD3D fex11: gaps between render passes. Must be called outside a render pass. */
+static void fex_pass_open_gap(struct d3d12_command_list *list)
+{
+    list->fex_pass.gap_pair = fex_pass_alloc_pair(list);
+    fex_pass_write_begin(list, list->fex_pass.gap_pair);
+    list->fex_pass.gap_open = true;
+}
+
+static void fex_pass_close_gap(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_record rec;
+
+    if (!list->fex_pass.gap_open)
+        return;
+
+    fex_pass_write_end(list, list->fex_pass.gap_pair);
+    memset(&rec, 0, sizeof(rec));
+    rec.pair = list->fex_pass.gap_pair;
+    rec.sig = 0xffff;
+    rec.kind = VKD3D_FEX_PASS_KIND_GAP;
+    rec.draws = list->fex_pass.gap_cmds;
+    rec.pipelines = list->fex_pass.gap_mask;
+    rec.vertices = list->fex_pass.gap_bytes;
+    rec.inside_pair = VKD3D_FEX_PASS_NO_QUERY;
+    rec.stats_slot = VKD3D_FEX_PASS_NO_QUERY;
+    fex_pass_add_record(list, &rec);
+    list->fex_pass.gap_open = false;
+    list->fex_pass.gap_mask = 0;
+    list->fex_pass.gap_cmds = 0;
+    list->fex_pass.gap_bytes = 0;
+}
+
 static void fex_draw_release(struct vkd3d_fex_draw_sample *s)
 {
     uint32_t i;
@@ -524,6 +582,11 @@ void vkd3d_fex_pass_meter_begin_list(struct d3d12_command_list *list)
     list->fex_pass.binds = 0;
     list->fex_pass.stats_active = false;
     list->fex_pass.measured = false;
+    list->fex_pass.gap_open = false;
+    list->fex_pass.gap_mask = 0;
+    list->fex_pass.gap_cmds = 0;
+    list->fex_pass.gap_bytes = 0;
+    list->fex_pass.wait_pair = VKD3D_FEX_PASS_NO_QUERY;
     if (list->fex_pass.draw)
         fex_draw_abandon(list);
     if (!meter || !(list->vk_queue_flags & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)))
@@ -536,6 +599,16 @@ void vkd3d_fex_pass_meter_begin_list(struct d3d12_command_list *list)
     list->fex_pass.list_pair = fex_pass_alloc_pair(list);
     list->fex_pass.list_active = true;
     fex_pass_write_begin(list, list->fex_pass.list_pair);
+
+    /* VKD3D fex11: when the GPU is done with the work before this list (this timestamp waits for idle). */
+    list->fex_pass.wait_pair = fex_pass_alloc_pair(list);
+    {
+        const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+
+        VK_CALL(vkCmdWriteTimestamp2(list->cmd.vk_command_buffer, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+                meter->pool, 2 * list->fex_pass.wait_pair));
+    }
+    fex_pass_open_gap(list);
 }
 
 void vkd3d_fex_pass_meter_close_list(struct d3d12_command_list *list)
@@ -546,11 +619,14 @@ void vkd3d_fex_pass_meter_close_list(struct d3d12_command_list *list)
         return;
 
     fex_pass_end_stats(list);
+    fex_pass_close_gap(list);
     fex_pass_write_end(list, list->fex_pass.list_pair);
     memset(&rec, 0, sizeof(rec));
     rec.pair = list->fex_pass.list_pair;
     rec.sig = 0xffff;
     rec.kind = VKD3D_FEX_PASS_KIND_LIST;
+    rec.inside_pair = list->fex_pass.wait_pair;
+    rec.stats_slot = VKD3D_FEX_PASS_NO_QUERY;
     fex_pass_add_record(list, &rec);
     list->fex_pass.list_active = false;
 }
@@ -572,6 +648,7 @@ void vkd3d_fex_pass_meter_begin_pass(struct d3d12_command_list *list, const VkRe
     /* Callers end the previous pass first; a stale one (no end timestamp) is dropped. */
     fex_pass_end_stats(list);
     list->fex_pass.pass_active = false;
+    fex_pass_close_gap(list);
 
     memset(&sig, 0, sizeof(sig));
     sig.width = info->renderArea.extent.width;
@@ -724,6 +801,16 @@ void vkd3d_fex_pass_meter_end_pass(struct d3d12_command_list *list, unsigned int
     list->fex_pass.current.end_line = line > 0xffff ? 0xffff : line;
     fex_pass_add_record(list, &list->fex_pass.current);
     list->fex_pass.pass_active = false;
+    if (list->fex_pass.list_active)
+        fex_pass_open_gap(list);
+}
+
+void vkd3d_fex_pass_meter_outside(struct d3d12_command_list *list, uint32_t type, uint64_t bytes)
+{
+    /* While a pass still runs, this counts for the gap its end opens: the command ends the pass first. */
+    list->fex_pass.gap_mask |= type;
+    list->fex_pass.gap_cmds++;
+    list->fex_pass.gap_bytes += bytes;
 }
 
 void vkd3d_fex_pass_meter_submit_list(struct d3d12_command_list *list)
@@ -799,6 +886,40 @@ static void fex_pass_note_line(struct vkd3d_fex_pass_meter *meter, uint32_t line
     }
 }
 
+static void fex_pass_note_gap(struct vkd3d_fex_pass_meter *meter, const struct vkd3d_fex_pass_record *rec, uint64_t ticks)
+{
+    struct fex_gap_stats *g = NULL;
+    uint32_t i;
+
+    meter->gap_count++;
+    meter->gap_ticks += ticks;
+    for (i = 0; i < meter->gap_kinds; i++)
+    {
+        if (meter->gaps[i].mask == rec->pipelines)
+        {
+            g = &meter->gaps[i];
+            break;
+        }
+    }
+    if (!g)
+    {
+        if (meter->gap_kinds == FEX_GAP_KINDS)
+        {
+            meter->gaps_unlisted += ticks;
+            return;
+        }
+        g = &meter->gaps[meter->gap_kinds++];
+        memset(g, 0, sizeof(*g));
+        g->mask = rec->pipelines;
+    }
+    g->count++;
+    g->ticks += ticks;
+    if (ticks > g->max_ticks)
+        g->max_ticks = ticks;
+    g->cmds += rec->draws;
+    g->bytes += rec->vertices;
+}
+
 /* inside_ticks: begin to the after-begin timestamp, or -1 when there is none; stats: NULL when not sampled. */
 static void fex_pass_account(struct vkd3d_fex_pass_meter *meter, const struct vkd3d_fex_pass_record *rec, uint64_t ticks,
         int64_t inside_ticks, const uint64_t *stats)
@@ -812,6 +933,19 @@ static void fex_pass_account(struct vkd3d_fex_pass_meter *meter, const struct vk
     {
         meter->lists++;
         meter->list_ticks += ticks;
+        if (inside_ticks >= 0)
+        {
+            meter->list_waits++;
