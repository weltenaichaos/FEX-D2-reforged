+        else if (copy_info.batch_type == VKD3D_BATCH_TYPE_COPY_IMAGE_TO_BUFFER)
+            vkd3d_fex_outside(list, VKD3D_FEX_OUTSIDE_COPY_I2B, copy_info.buffer_footprint_size);
+        else
+            vkd3d_fex_outside(list, VKD3D_FEX_OUTSIDE_COPY_I2I, d3d12_command_list_fex_region_bytes(
+                    copy_info.dst_format, copy_info.copy.image.extent));
+    }
+
     d3d12_command_list_ensure_transfer_batch(list, copy_info.batch_type);
 
     list->cmd.estimated_cost += VKD3D_COMMAND_COST_LOW;
@@ -9439,6 +9465,8 @@ static void STDMETHODCALLTYPE d3d12_command_list_CopyResource(d3d12_command_list
     unsigned int i, j;
 
