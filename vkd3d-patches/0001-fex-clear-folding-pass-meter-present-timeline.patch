+/* FEX clear folding, see struct vkd3d_fex_pending_clear. Only full clears of a whole 2D view (all of its aspects) wait;
+ * anything else that may touch a waiting clear's image first emits it as the render pass it would have been. */
+static bool d3d12_command_list_fex_can_defer_clear(struct d3d12_command_list *list, const struct d3d12_resource *resource,
+        const struct vkd3d_view *view, VkImageAspectFlags clear_aspects, UINT rect_count, VkAttachmentLoadOp load_op)
+{
+    unsigned int i;
+
+    if (!list->device->fex_fold_clears || load_op != VK_ATTACHMENT_LOAD_OP_CLEAR || rect_count)
+        return false;
+    /* Only between render passes; a suspended pass must resume next with nothing in between. */
+    if (list->rendering_info.state_flags & (VKD3D_RENDERING_ACTIVE | VKD3D_RENDERING_SUSPENDED))
+        return false;
+    if (resource->desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D ||
+            (resource->flags & VKD3D_RESOURCE_LINEAR_STAGING_COPY) ||
+            clear_aspects != view->format->vk_aspect_mask)
+        return false;
+
+    for (i = 0; i < list->fex_clears.count; i++)
+    {
+        if (list->fex_clears.entries[i].resource == resource)
+            return list->fex_clears.entries[i].view == view;
+    }
+
+    return list->fex_clears.count < VKD3D_FEX_MAX_PENDING_CLEARS;
+}
+
+static void d3d12_command_list_fex_defer_clear(struct d3d12_command_list *list, struct d3d12_resource *resource,
+        struct vkd3d_view *view, VkImageAspectFlags clear_aspects, const VkClearValue *clear_value, VkImageLayout layout)
+{
+    struct vkd3d_fex_pending_clear *clear = NULL;
+    unsigned int i;
+
+    for (i = 0; i < list->fex_clears.count; i++)
+    {
+        if (list->fex_clears.entries[i].view == view)
+            clear = &list->fex_clears.entries[i];
+    }
+    if (!clear)
+        clear = &list->fex_clears.entries[list->fex_clears.count++];
+
+    clear->resource = resource;
+    clear->view = view;
+    clear->aspects = clear_aspects;
+    clear->layout = layout;
+    clear->value = *clear_value;
+}
+
+/* The render pass load_attachment() would have recorded for this clear. Its barriers already ran at clear time. */
+static void d3d12_command_list_fex_emit_clear_pass(struct d3d12_command_list *list,
+        const struct vkd3d_fex_pending_clear *clear)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    VkRenderingAttachmentInfo attachment_info;
+    VkRenderingInfo rendering_info;
+    VkExtent3D view_extent;
+
+    memset(&attachment_info, 0, sizeof(attachment_info));
+    attachment_info.sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO;
+    attachment_info.imageView = clear->view->vk_image_view;
+    attachment_info.imageLayout = clear->layout;
+    attachment_info.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+    attachment_info.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    attachment_info.clearValue = clear->value;
+
+    view_extent = d3d12_resource_get_view_subresource_extent(clear->resource, clear->view);
+
+    memset(&rendering_info, 0, sizeof(rendering_info));
+    rendering_info.sType = VK_STRUCTURE_TYPE_RENDERING_INFO;
+    rendering_info.renderArea.extent.width = view_extent.width;
+    rendering_info.renderArea.extent.height = view_extent.height;
+    rendering_info.layerCount = clear->view->info.texture.layer_count;
+
+    if (clear->aspects & VK_IMAGE_ASPECT_COLOR_BIT)
+    {
+        rendering_info.colorAttachmentCount = 1;
+        rendering_info.pColorAttachments = &attachment_info;
+    }
+    if (clear->aspects & VK_IMAGE_ASPECT_DEPTH_BIT)
+        rendering_info.pDepthAttachment = &attachment_info;
+    if (clear->aspects & VK_IMAGE_ASPECT_STENCIL_BIT)
+        rendering_info.pStencilAttachment = &attachment_info;
+
+    d3d12_command_list_debug_mark_begin_region(list, "Clear");
+
+    if (list->device->fex_pass_meter)
+    {
+        const struct vkd3d_format *fex_color_formats[1] = { clear->view->format };
+        bool fex_color = !!(clear->aspects & VK_IMAGE_ASPECT_COLOR_BIT);
+
+        vkd3d_fex_pass_meter_begin_pass(list, &rendering_info, fex_color_formats,
+                clear->resource->desc.SampleDesc.Count, fex_color ? NULL : clear->view->format, VKD3D_FEX_PASS_KIND_CLEAR);
+    }
+
+    VK_CALL(vkCmdBeginRendering(list->cmd.vk_command_buffer, &rendering_info));
+    VK_CALL(vkCmdEndRendering(list->cmd.vk_command_buffer));
+    vkd3d_fex_pass_meter_end_pass(list, __LINE__);
+    d3d12_command_list_sync_tiler_renderpass_writes(list, &rendering_info);
+
+    d3d12_command_list_debug_mark_end_region(list);
+}
