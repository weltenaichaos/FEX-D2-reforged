+/* Emits every waiting clear as its own render pass, in the order they were made. No render pass may be active. */
+static void d3d12_command_list_fex_flush_clears(struct d3d12_command_list *list)
+{
+    uint32_t i, count = list->fex_clears.count;
+
+    list->fex_clears.count = 0;
+    for (i = 0; i < count; i++)
+        d3d12_command_list_fex_emit_clear_pass(list, &list->fex_clears.entries[i]);
+    vkd3d_fex_pass_meter_count_clears(list->device, 0, count);
+}
