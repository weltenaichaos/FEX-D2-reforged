+static bool d3d12_command_list_fex_clears_touch(const struct d3d12_command_list *list, const struct d3d12_resource *resource)
+{
+    unsigned int i;
+
+    for (i = 0; i < list->fex_clears.count; i++)
+    {
+        if (list->fex_clears.entries[i].resource == resource)
+            return true;
+    }
+    return false;
+}
