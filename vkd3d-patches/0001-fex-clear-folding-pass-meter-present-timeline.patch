+            {
+                ri->dsv.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+                ri->dsv.clearValue = clear->value;
+                *ds = true;
+                fits = true;
+            }
+        }
+
+        if (fits)
+        {
+            folded++;
+        }
+        else
+        {
+            d3d12_command_list_fex_emit_clear_pass(list, clear);
+            own_pass++;
+        }
+    }
+
+    list->fex_clears.count = 0;
+    vkd3d_fex_pass_meter_count_clears(list->device, folded, own_pass);
+}
