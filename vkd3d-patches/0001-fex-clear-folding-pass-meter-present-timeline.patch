+/* Reports FEX's stats log reads from d3d12core.dll (found by export name). seq is odd while text is being written.
+ * Lines starting with '#' are notes; FEX prints each distinct note once, so a note may repeat in every report. */
+#define VKD3D_FEX_REPORT_SIZE 4096u
+#define VKD3D_FEX_REPORT_FLAG_ON 0x1u          /* the report's feature is switched on */
+#define VKD3D_FEX_REPORT_FLAG_FOLD_CLEARS 0x2u /* pass report: clear folding is on */
+#define VKD3D_FEX_REPORT_FLAG_DEVICE 0x80000000u /* a D3D12 device was created */
+struct vkd3d_fex_report
+{
+    uint32_t magic;
+    uint32_t version;
+    volatile uint32_t seq;
+    volatile uint32_t flags;
+    char text[VKD3D_FEX_REPORT_SIZE];
+};
+extern struct vkd3d_fex_report vkd3d_fex_pass_report;    /* magic 'FEXP' */
+extern struct vkd3d_fex_report vkd3d_fex_present_report; /* magic 'FEXT' */
+void vkd3d_fex_report_publish(struct vkd3d_fex_report *report, const char *text, size_t len);
+size_t vkd3d_fex_report_append(char *buf, size_t size, size_t len, const char *fmt, ...);
+
+/* FEX timeline (fex_timeline.c, VKD3D_FEX_TIMELINE=1): where each frame's time goes between the game's Present() and
+ * the image going to the window system, and what every queue thread spends its time on. */
+enum vkd3d_fex_present_step
+{
