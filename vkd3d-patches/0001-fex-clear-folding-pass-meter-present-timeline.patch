+/* Called right before a render pass begins: a waiting clear whose view is an attachment of this pass, and which the
+ * pass covers whole and in the same layout, becomes that attachment's load op (restored by the caller after
+ * vkCmdBeginRendering). Every other waiting clear is emitted now, before the pass, as it would have been. */
+static void d3d12_command_list_fex_fold_clears(struct d3d12_command_list *list, uint32_t *rt_mask, bool *ds)
+{
+    struct vkd3d_rendering_info *ri = &list->rendering_info;
+    uint32_t i, j, folded = 0, own_pass = 0;
+    VkExtent3D extent;
+    bool fits;
+
+    *rt_mask = 0;
+    *ds = false;
+
+    for (i = 0; i < list->fex_clears.count; i++)
+    {
+        const struct vkd3d_fex_pending_clear *clear = &list->fex_clears.entries[i];
+
+        fits = false;
+        extent = d3d12_resource_get_view_subresource_extent(clear->resource, clear->view);
+
+        if (!ri->info.viewMask && !ri->info.renderArea.offset.x && !ri->info.renderArea.offset.y &&
+                ri->info.renderArea.extent.width == extent.width &&
+                ri->info.renderArea.extent.height == extent.height &&
+                ri->info.layerCount == clear->view->info.texture.layer_count)
+        {
+            if (clear->aspects & VK_IMAGE_ASPECT_COLOR_BIT)
+            {
+                for (j = 0; j < ri->info.colorAttachmentCount && j < D3D12_SIMULTANEOUS_RENDER_TARGET_COUNT; j++)
+                {
