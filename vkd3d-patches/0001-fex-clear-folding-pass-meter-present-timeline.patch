diff --git a/libs/vkd3d/fex_pass_meter.c b/libs/vkd3d/fex_pass_meter.c
new file mode 100644
index 0000000..dc02e02
--- /dev/null
+++ b/libs/vkd3d/fex_pass_meter.c
@@ -0,0 +1,783 @@
+/*
+ * FEX pass meter: measures how long the GPU spends in each Vulkan render pass and in each command list, and which
+ * attachments every pass loads, clears and stores. Once a second it formats a short report into an exported buffer
+ * (vkd3d_fex_pass_report) that FEX's stats log picks up. Off unless VKD3D_FEX_PASSES=1.
+ *
+ * Every pass gets a pair of timestamp queries written outside the pass (top of pipe before vkCmdBeginRendering, all
+ * commands after vkCmdEndRendering); command lists get a pair around their whole recording. Results are read back by a
+ * thread without waiting on the GPU.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+
+#include "vkd3d_private.h"
+#include "vkd3d_threads.h"
+#include <stdio.h>
+#include <string.h>
+#include <inttypes.h>
+
+#define FEX_PASS_QUERY_PAIRS 65536u
+#define FEX_PASS_BLOCK_PAIRS 32u /* pairs a command list takes at once, reset with one command */
+#define FEX_PASS_PENDING 65536u
+#define FEX_PASS_MAX_SIGS 1024u
+#define FEX_PASS_MAX_LINES 256u
+
+/* Read by FEX (found by export name in d3d12core.dll). */
+struct vkd3d_fex_report vkd3d_fex_pass_report = { 0x50584546u /* 'FEXP' */, 1u, 0u, 0u, { 0 } };
+
+struct fex_pass_sig
+{
+    uint32_t hash;
+    uint32_t width, height, layers;
+    uint32_t kind; /* VKD3D_FEX_PASS_KIND_* */
+    uint32_t color_count;
+    uint32_t color_dxgi[D3D12_SIMULTANEOUS_RENDER_TARGET_COUNT];
+    uint32_t color_bytes[D3D12_SIMULTANEOUS_RENDER_TARGET_COUNT];
+    uint8_t color_load[D3D12_SIMULTANEOUS_RENDER_TARGET_COUNT];
+    uint8_t color_store[D3D12_SIMULTANEOUS_RENDER_TARGET_COUNT];
+    uint32_t ds_dxgi, ds_bytes;
+    uint8_t has_depth, has_stencil, depth_load, depth_store, stencil_load, stencil_store, samples, pad;
+};
+
+struct fex_pass_sig_stats
+{
+    uint64_t count, gpu_ticks, draws;
+    uint32_t last_end_line;
+};
+
+struct fex_pass_line_stats
+{
+    uint32_t line;
+    uint64_t count, gpu_ticks;
+};
+
+struct fex_pass_pending
+{
+    struct vkd3d_fex_pass_record rec;
+    uint64_t submit_ns;
+};
+
+struct vkd3d_fex_pass_meter
+{
+    struct d3d12_device *device;
+    VkQueryPool pool;
+    double ns_per_tick;
+    uint32_t next_block;
+
+    pthread_mutex_t sig_lock;
+    struct fex_pass_sig sigs[FEX_PASS_MAX_SIGS];
+    uint32_t sig_count;
+
+    pthread_mutex_t pending_lock;
+    struct fex_pass_pending *pending;
+    uint64_t pending_head, pending_tail; /* tail = next to resolve */
+    uint64_t dropped;
+
+    pthread_t thread;
+    uint32_t dead;
+
+    /* Owned by the thread. */
+    struct fex_pass_sig_stats sig_stats[FEX_PASS_MAX_SIGS];
+    struct fex_pass_line_stats line_stats[FEX_PASS_MAX_LINES];
+    uint32_t line_count;
+    uint64_t lists, list_ticks, passes, pass_ticks, draws, clears, clear_ticks, lost, unordered;
+    uint64_t load_bytes, store_bytes, clear_bytes, loads, stores, cleared;
+    uint64_t window_start_ns;
+
+    /* Counted by recording threads. */
+    uint32_t clears_folded, clears_own_pass;
+};
+
+static const char *fex_pass_op_name(uint8_t op)
+{
+    switch (op)
+    {
+        case VK_ATTACHMENT_LOAD_OP_LOAD: return "L";
+        case VK_ATTACHMENT_LOAD_OP_CLEAR: return "C";
+        case VK_ATTACHMENT_LOAD_OP_DONT_CARE: return "D";
+        default: return "N";
+    }
+}
+
+static const char *fex_pass_store_name(uint8_t op)
+{
+    switch (op)
+    {
+        case VK_ATTACHMENT_STORE_OP_STORE: return "S";
+        case VK_ATTACHMENT_STORE_OP_DONT_CARE: return "D";
+        default: return "N";
+    }
+}
+
+/* VkAttachmentStoreOp NONE is 1000301000; squeeze ops into a byte. */
+static uint8_t fex_pass_pack_load(VkAttachmentLoadOp op)
+{
+    return op <= VK_ATTACHMENT_LOAD_OP_DONT_CARE ? (uint8_t)op : 3;
+}
+
+static uint8_t fex_pass_pack_store(VkAttachmentStoreOp op)
+{
+    return op <= VK_ATTACHMENT_STORE_OP_DONT_CARE ? (uint8_t)op : 2;
+}
+
+static uint32_t fex_pass_hash(const struct fex_pass_sig *sig)
+{
+    const uint8_t *p = (const uint8_t *)sig + sizeof(sig->hash);
+    size_t n = sizeof(*sig) - sizeof(sig->hash);
+    uint32_t h = 2166136261u;
+    size_t i;
+
+    for (i = 0; i < n; i++)
+        h = (h ^ p[i]) * 16777619u;
+    return h;
+}
+
+static uint16_t fex_pass_intern_sig(struct vkd3d_fex_pass_meter *meter, struct fex_pass_sig *sig)
+{
+    uint32_t i;
+    uint16_t index = 0xffff;
+
+    sig->hash = fex_pass_hash(sig);
+
+    pthread_mutex_lock(&meter->sig_lock);
+    for (i = 0; i < meter->sig_count; i++)
+    {
+        if (meter->sigs[i].hash == sig->hash && !memcmp(&meter->sigs[i], sig, sizeof(*sig)))
+        {
+            index = i;
+            break;
+        }
+    }
+    if (index == 0xffff && meter->sig_count < FEX_PASS_MAX_SIGS)
+    {
+        meter->sigs[meter->sig_count] = *sig;
+        index = meter->sig_count++;
+    }
+    pthread_mutex_unlock(&meter->sig_lock);
+    return index;
+}
+
+/* Must be called outside a render pass: taking a new block resets its queries in the command buffer. */
+static uint32_t fex_pass_alloc_pair(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    uint32_t base;
+
+    if (list->fex_pass.block_next == list->fex_pass.block_end)
+    {
+        base = vkd3d_atomic_uint32_increment(&meter->next_block, vkd3d_memory_order_relaxed) - 1;
+        base = (base * FEX_PASS_BLOCK_PAIRS) % FEX_PASS_QUERY_PAIRS;
+        VK_CALL(vkCmdResetQueryPool(list->cmd.vk_command_buffer, meter->pool, 2 * base, 2 * FEX_PASS_BLOCK_PAIRS));
+        list->fex_pass.block_next = base;
+        list->fex_pass.block_end = base + FEX_PASS_BLOCK_PAIRS;
+    }
+    return list->fex_pass.block_next++;
+}
+
+static void fex_pass_write_begin(struct d3d12_command_list *list, uint32_t pair)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+
+    VK_CALL(vkCmdWriteTimestamp2(list->cmd.vk_command_buffer, VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT,
+            meter->pool, 2 * pair));
+}
+
+static void fex_pass_write_end(struct d3d12_command_list *list, uint32_t pair)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+
+    VK_CALL(vkCmdWriteTimestamp2(list->cmd.vk_command_buffer, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+            meter->pool, 2 * pair + 1));
+}
+
+static void fex_pass_add_record(struct d3d12_command_list *list, const struct vkd3d_fex_pass_record *rec)
+{
+    if (!vkd3d_array_reserve((void **)&list->fex_pass.records, &list->fex_pass.records_size,
+            list->fex_pass.records_count + 1, sizeof(*list->fex_pass.records)))
+        return;
+    list->fex_pass.records[list->fex_pass.records_count++] = *rec;
+}
+
+void vkd3d_fex_pass_meter_begin_list(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+
+    list->fex_pass.records_count = 0;
+    list->fex_pass.pass_active = false;
+    list->fex_pass.list_active = false;
+    list->fex_pass.block_next = list->fex_pass.block_end = 0;
+    if (!meter || !(list->vk_queue_flags & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)))
+        return;
+
+    list->fex_pass.list_pair = fex_pass_alloc_pair(list);
+    list->fex_pass.list_active = true;
+    fex_pass_write_begin(list, list->fex_pass.list_pair);
+}
+
+void vkd3d_fex_pass_meter_close_list(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_record rec;
+
+    if (!list->device->fex_pass_meter || !list->fex_pass.list_active)
+        return;
+
+    fex_pass_write_end(list, list->fex_pass.list_pair);
+    memset(&rec, 0, sizeof(rec));
+    rec.pair = list->fex_pass.list_pair;
+    rec.sig = 0xffff;
+    rec.kind = VKD3D_FEX_PASS_KIND_LIST;
+    fex_pass_add_record(list, &rec);
+    list->fex_pass.list_active = false;
+}
+
+void vkd3d_fex_pass_meter_begin_pass(struct d3d12_command_list *list, const VkRenderingInfo *info,
+        const struct vkd3d_format *const *color_formats, VkSampleCountFlagBits samples,
+        const struct vkd3d_format *ds_format, uint32_t kind)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    struct fex_pass_sig sig;
+    unsigned int i;
+
+    if (!meter)
+        return;
+
+    /* Callers end the previous pass first; a stale one (no end timestamp) is dropped. */
+    list->fex_pass.pass_active = false;
+
+    memset(&sig, 0, sizeof(sig));
+    sig.width = info->renderArea.extent.width;
+    sig.height = info->renderArea.extent.height;
+    sig.layers = info->layerCount;
+    sig.kind = kind;
+    sig.samples = (uint8_t)samples;
+    for (i = 0; i < info->colorAttachmentCount && i < D3D12_SIMULTANEOUS_RENDER_TARGET_COUNT; i++)
+    {
+        if (!info->pColorAttachments[i].imageView || !color_formats[i])
+            continue;
+        sig.color_count = i + 1;
+        sig.color_dxgi[i] = color_formats[i]->dxgi_format;
+        sig.color_bytes[i] = color_formats[i]->byte_count;
+        sig.color_load[i] = fex_pass_pack_load(info->pColorAttachments[i].loadOp);
+        sig.color_store[i] = fex_pass_pack_store(info->pColorAttachments[i].storeOp);
+    }
+    if (ds_format && ((info->pDepthAttachment && info->pDepthAttachment->imageView) ||
+            (info->pStencilAttachment && info->pStencilAttachment->imageView)))
+    {
+        sig.ds_dxgi = ds_format->dxgi_format;
+        sig.ds_bytes = ds_format->byte_count;
+        if (info->pDepthAttachment && info->pDepthAttachment->imageView)
+        {
+            sig.has_depth = 1;
+            sig.depth_load = fex_pass_pack_load(info->pDepthAttachment->loadOp);
+            sig.depth_store = fex_pass_pack_store(info->pDepthAttachment->storeOp);
+        }
+        if (info->pStencilAttachment && info->pStencilAttachment->imageView)
+        {
+            sig.has_stencil = 1;
+            sig.stencil_load = fex_pass_pack_load(info->pStencilAttachment->loadOp);
+            sig.stencil_store = fex_pass_pack_store(info->pStencilAttachment->storeOp);
+        }
+    }
+
+    memset(&list->fex_pass.current, 0, sizeof(list->fex_pass.current));
+    list->fex_pass.current.pair = fex_pass_alloc_pair(list);
+    list->fex_pass.current.sig = fex_pass_intern_sig(meter, &sig);
+    list->fex_pass.current.kind = kind;
+    list->fex_pass.current.draws = kind == VKD3D_FEX_PASS_KIND_CLEAR ? 0 : 1;
+    list->fex_pass.pass_active = true;
+    fex_pass_write_begin(list, list->fex_pass.current.pair);
+}
+
+void vkd3d_fex_pass_meter_draw(struct d3d12_command_list *list)
+{
+    if (list->fex_pass.pass_active)
+        list->fex_pass.current.draws++;
+}
+
+void vkd3d_fex_pass_meter_end_pass(struct d3d12_command_list *list, unsigned int line)
+{
+    if (!list->device->fex_pass_meter || !list->fex_pass.pass_active)
+        return;
+
+    fex_pass_write_end(list, list->fex_pass.current.pair);
+    list->fex_pass.current.end_line = line > 0xffff ? 0xffff : line;
+    fex_pass_add_record(list, &list->fex_pass.current);
+    list->fex_pass.pass_active = false;
+}
+
+void vkd3d_fex_pass_meter_submit_list(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    uint64_t now;
+    size_t i;
+
+    if (!meter || !list->fex_pass.records_count)
+        return;
+
+    now = vkd3d_get_current_time_ns();
+    pthread_mutex_lock(&meter->pending_lock);
+    for (i = 0; i < list->fex_pass.records_count; i++)
+    {
+        struct fex_pass_pending *p;
+
+        if (meter->pending_head - meter->pending_tail >= FEX_PASS_PENDING)
+        {
+            meter->dropped += list->fex_pass.records_count - i;
+            break;
+        }
+        p = &meter->pending[meter->pending_head++ % FEX_PASS_PENDING];
+        p->rec = list->fex_pass.records[i];
+        p->submit_ns = now;
+    }
+    pthread_mutex_unlock(&meter->pending_lock);
+}
+
+void vkd3d_fex_pass_meter_free_list(struct d3d12_command_list *list)
+{
+    vkd3d_free(list->fex_pass.records);
+    list->fex_pass.records = NULL;
+    list->fex_pass.records_size = 0;
+    list->fex_pass.records_count = 0;
+}
+
+static void fex_pass_note_line(struct vkd3d_fex_pass_meter *meter, uint32_t line, uint64_t ticks)
+{
+    uint32_t i;
+
+    for (i = 0; i < meter->line_count; i++)
+    {
+        if (meter->line_stats[i].line == line)
+        {
+            meter->line_stats[i].count++;
+            meter->line_stats[i].gpu_ticks += ticks;
+            return;
+        }
+    }
+    if (meter->line_count < FEX_PASS_MAX_LINES)
+    {
+        meter->line_stats[meter->line_count].line = line;
+        meter->line_stats[meter->line_count].count = 1;
+        meter->line_stats[meter->line_count].gpu_ticks = ticks;
+        meter->line_count++;
+    }
+}
+
+static void fex_pass_account(struct vkd3d_fex_pass_meter *meter, const struct vkd3d_fex_pass_record *rec, uint64_t ticks)
+{
+    const struct fex_pass_sig *sig;
+    uint64_t area;
+    unsigned int i;
+
+    if (rec->kind == VKD3D_FEX_PASS_KIND_LIST)
+    {
+        meter->lists++;
+        meter->list_ticks += ticks;
+        return;
+    }
+
+    if (rec->kind == VKD3D_FEX_PASS_KIND_CLEAR)
+    {
+        meter->clears++;
+        meter->clear_ticks += ticks;
+    }
+    else
+    {
+        meter->passes++;
+        meter->pass_ticks += ticks;
+        meter->draws += rec->draws;
+    }
+
+    fex_pass_note_line(meter, rec->end_line, ticks);
+
+    if (rec->sig >= FEX_PASS_MAX_SIGS)
+        return;
+
+    /* Signatures are only appended, never changed, so reading below sig_count without the lock is fine. */
+    sig = &meter->sigs[rec->sig];
+    meter->sig_stats[rec->sig].count++;
+    meter->sig_stats[rec->sig].gpu_ticks += ticks;
+    meter->sig_stats[rec->sig].draws += rec->draws;
+    meter->sig_stats[rec->sig].last_end_line = rec->end_line;
+
+    area = (uint64_t)sig->width * sig->height * (sig->layers ? sig->layers : 1) * (sig->samples ? sig->samples : 1);
+    for (i = 0; i < sig->color_count; i++)
+    {
+        if (!sig->color_bytes[i])
+            continue;
+        if (sig->color_load[i] == VK_ATTACHMENT_LOAD_OP_LOAD)
+        {
+            meter->loads++;
+            meter->load_bytes += area * sig->color_bytes[i];
+        }
+        else if (sig->color_load[i] == VK_ATTACHMENT_LOAD_OP_CLEAR)
+        {
+            meter->cleared++;
+            meter->clear_bytes += area * sig->color_bytes[i];
+        }
+        if (sig->color_store[i] == VK_ATTACHMENT_STORE_OP_STORE)
+        {
+            meter->stores++;
+            meter->store_bytes += area * sig->color_bytes[i];
+        }
+    }
+    if (sig->has_depth || sig->has_stencil)
+    {
+        uint8_t load = sig->has_depth ? sig->depth_load : sig->stencil_load;
+        uint8_t store = sig->has_depth ? sig->depth_store : sig->stencil_store;
+
+        if (load == VK_ATTACHMENT_LOAD_OP_LOAD)
+        {
+            meter->loads++;
+            meter->load_bytes += area * sig->ds_bytes;
+        }
+        else if (load == VK_ATTACHMENT_LOAD_OP_CLEAR)
+        {
+            meter->cleared++;
+            meter->clear_bytes += area * sig->ds_bytes;
+        }
+        if (store == VK_ATTACHMENT_STORE_OP_STORE)
+        {
+            meter->stores++;
+            meter->store_bytes += area * sig->ds_bytes;
+        }
+    }
+}
+
+size_t vkd3d_fex_report_append(char *buf, size_t size, size_t len, const char *fmt, ...)
+{
+    va_list args;
+    int n;
+
+    if (len >= size)
+        return len;
+    va_start(args, fmt);
+    n = vsnprintf(buf + len, size - len, fmt, args);
+    va_end(args);
+    if (n < 0)
+        return len;
+    return (size_t)n >= size - len ? size - 1 : len + (size_t)n;
+}
+
+static size_t fex_pass_describe_sig(const struct fex_pass_sig *sig, char *buf, size_t size, size_t len)
+{
+    unsigned int i;
+    bool first = true;
+
+    len = vkd3d_fex_report_append(buf, size, len, "%ux%u", sig->width, sig->height);
+    if (sig->layers > 1)
+        len = vkd3d_fex_report_append(buf, size, len, "x%u", sig->layers);
+    if (sig->samples > 1)
+        len = vkd3d_fex_report_append(buf, size, len, " %uxMS", sig->samples);
+    if (sig->kind == VKD3D_FEX_PASS_KIND_CLEAR)
+        len = vkd3d_fex_report_append(buf, size, len, " clear-pass");
+    else if (sig->kind == VKD3D_FEX_PASS_KIND_RESUMED)
+        len = vkd3d_fex_report_append(buf, size, len, " resumed");
+    for (i = 0; i < sig->color_count; i++)
+    {
+        if (!sig->color_bytes[i])
+            continue;
+        len = vkd3d_fex_report_append(buf, size, len, "%sc%u:fmt%u/%uB %s%s", first ? " " : " + ", i, sig->color_dxgi[i],
+                sig->color_bytes[i], fex_pass_op_name(sig->color_load[i]), fex_pass_store_name(sig->color_store[i]));
+        first = false;
+    }
+    if (sig->has_depth || sig->has_stencil)
+    {
+        len = vkd3d_fex_report_append(buf, size, len, "%sds:fmt%u/%uB", first ? " " : " + ", sig->ds_dxgi, sig->ds_bytes);
+        if (sig->has_depth)
+            len = vkd3d_fex_report_append(buf, size, len, " d%s%s", fex_pass_op_name(sig->depth_load),
+                    fex_pass_store_name(sig->depth_store));
+        if (sig->has_stencil)
+            len = vkd3d_fex_report_append(buf, size, len, " s%s%s", fex_pass_op_name(sig->stencil_load),
+                    fex_pass_store_name(sig->stencil_store));
+    }
+    return len;
+}
+
+void vkd3d_fex_report_publish(struct vkd3d_fex_report *report, const char *text, size_t len)
+{
+    if (len >= VKD3D_FEX_REPORT_SIZE)
+        len = VKD3D_FEX_REPORT_SIZE - 1;
+
+    /* Seqlock: seq is odd while the text changes. */
+    vkd3d_atomic_uint32_increment((uint32_t *)&report->seq, vkd3d_memory_order_seq_cst);
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    memcpy(report->text, text, len);
+    report->text[len] = '\0';
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    vkd3d_atomic_uint32_increment((uint32_t *)&report->seq, vkd3d_memory_order_seq_cst);
+}
+
+bool vkd3d_fex_fold_clears_enabled(void)
+{
+    char env[16];
+
+    return vkd3d_get_env_var("VKD3D_FEX_FOLD_CLEARS", env, sizeof(env)) && !strcmp(env, "1");
+}
+
+void vkd3d_fex_pass_meter_count_clears(struct d3d12_device *device, uint32_t folded, uint32_t own_pass)
+{
+    struct vkd3d_fex_pass_meter *meter = device->fex_pass_meter;
+
+    if (!meter)
+        return;
+    if (folded)
+        vkd3d_atomic_uint32_add(&meter->clears_folded, folded, vkd3d_memory_order_relaxed);
+    if (own_pass)
+        vkd3d_atomic_uint32_add(&meter->clears_own_pass, own_pass, vkd3d_memory_order_relaxed);
+}
+
+static void fex_pass_publish(struct vkd3d_fex_pass_meter *meter, double seconds)
+{
+    static char text[VKD3D_FEX_REPORT_SIZE];
+    uint32_t clears_folded, clears_own_pass;
+    const double ms = meter->ns_per_tick / 1e6;
+    uint32_t top_sigs[8], top_lines[12];
+    unsigned int top_sig_count = 0, top_line_count = 0;
+    uint32_t i, j, sig_count;
+    size_t len = 0;
+
+    {
+        const VkPhysicalDeviceVulkan12Properties *props = &meter->device->device_info.vulkan_1_2_properties;
+
+        len = vkd3d_fex_report_append(text, sizeof(text), len,
+                "# gpu passes: driver %s (%s), id %u, timestamp tick %.2f ns, clear folding %s; command.c lines are from"
+                " vkd3d-proton 3.0b + FEX patches\n",
+                props->driverName, props->driverInfo, props->driverID, meter->ns_per_tick,
+                meter->device->fex_fold_clears ? "on" : "off");
+    }
+
+    clears_folded = vkd3d_atomic_uint32_exchange_explicit(&meter->clears_folded, 0, vkd3d_memory_order_relaxed);
+    clears_own_pass = vkd3d_atomic_uint32_exchange_explicit(&meter->clears_own_pass, 0, vkd3d_memory_order_relaxed);
+
+    len = vkd3d_fex_report_append(text, sizeof(text), len,
+            "  gpu lists=%"PRIu64" gpu=%.1fms | passes=%"PRIu64" gpu=%.1fms draws=%"PRIu64" | clear passes=%"PRIu64" gpu=%.1fms"
+            " | clears folded=%u own pass=%u | attachments loaded=%"PRIu64" %.0fMB cleared=%"PRIu64" stored=%"PRIu64" %.0fMB"
+            " | lost=%"PRIu64" dropped=%"PRIu64" over %.2fs\n",
+            meter->lists, meter->list_ticks * ms, meter->passes, meter->pass_ticks * ms, meter->draws,
+            meter->clears, meter->clear_ticks * ms, clears_folded, clears_own_pass, meter->loads,
+            meter->load_bytes / 1048576.0, meter->cleared, meter->stores, meter->store_bytes / 1048576.0, meter->lost,
+            meter->dropped, seconds);
+
+    /* Top passes by GPU time. */
+    sig_count = vkd3d_atomic_uint32_load_explicit(&meter->sig_count, vkd3d_memory_order_acquire);
+    for (i = 0; i < sig_count; i++)
+    {
+        if (!meter->sig_stats[i].count)
+            continue;
+        for (j = top_sig_count; j > 0 && meter->sig_stats[top_sigs[j - 1]].gpu_ticks < meter->sig_stats[i].gpu_ticks; j--)
+        {
+            if (j < ARRAY_SIZE(top_sigs))
+                top_sigs[j] = top_sigs[j - 1];
+        }
+        if (j < ARRAY_SIZE(top_sigs))
+        {
+            top_sigs[j] = i;
+            if (top_sig_count < ARRAY_SIZE(top_sigs))
+                top_sig_count++;
+        }
+    }
+    if (top_sig_count)
+        len = vkd3d_fex_report_append(text, sizeof(text), len, "  gpu top passes (gpu ms, count, draws, size, attachments: fmt=DXGI format/bytes per pixel, load L/C/D + store S/D, ended at command.c line):\n");
+    for (i = 0; i < top_sig_count; i++)
+    {
+        const struct fex_pass_sig_stats *st = &meter->sig_stats[top_sigs[i]];
+        len = vkd3d_fex_report_append(text, sizeof(text), len, "    %.2fms n=%"PRIu64" draws=%"PRIu64" ", st->gpu_ticks * ms, st->count,
+                st->draws);
+        len = fex_pass_describe_sig(&meter->sigs[top_sigs[i]], text, sizeof(text), len);
+        len = vkd3d_fex_report_append(text, sizeof(text), len, " end@%u\n", st->last_end_line);
+    }
+
+    /* What ended the passes. */
+    for (i = 0; i < meter->line_count; i++)
+    {
+        for (j = top_line_count; j > 0 && meter->line_stats[top_lines[j - 1]].count < meter->line_stats[i].count; j--)
+        {
+            if (j < ARRAY_SIZE(top_lines))
+                top_lines[j] = top_lines[j - 1];
+        }
+        if (j < ARRAY_SIZE(top_lines))
+        {
+            top_lines[j] = i;
+            if (top_line_count < ARRAY_SIZE(top_lines))
+                top_line_count++;
+        }
+    }
+    if (top_line_count)
+    {
+        len = vkd3d_fex_report_append(text, sizeof(text), len, "  gpu pass ends (command.c line xcount gpu ms):");
+        for (i = 0; i < top_line_count; i++)
+        {
+            const struct fex_pass_line_stats *st = &meter->line_stats[top_lines[i]];
+            len = vkd3d_fex_report_append(text, sizeof(text), len, " %u x%"PRIu64" %.1fms;", st->line, st->count, st->gpu_ticks * ms);
+        }
+        len = vkd3d_fex_report_append(text, sizeof(text), len, "\n");
+    }
+
+    vkd3d_fex_report_publish(&vkd3d_fex_pass_report, text, len);
+
+    memset(meter->sig_stats, 0, sizeof(meter->sig_stats));
+    meter->line_count = 0;
+    meter->lists = meter->list_ticks = meter->passes = meter->pass_ticks = meter->draws = 0;
+    meter->clears = meter->clear_ticks = meter->lost = meter->unordered = 0;
+    meter->load_bytes = meter->store_bytes = meter->clear_bytes = meter->loads = meter->stores = meter->cleared = 0;
+    pthread_mutex_lock(&meter->pending_lock);
+    meter->dropped = 0;
+    pthread_mutex_unlock(&meter->pending_lock);
+}
+
+/* Reads the results of up to 64 pending records at a time. Returns false when the oldest record isn't ready yet. */
+static bool fex_pass_resolve_some(struct vkd3d_fex_pass_meter *meter)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &meter->device->vk_procs;
+    struct fex_pass_pending batch[64];
+    uint64_t head, tail, now;
+    size_t count, i, done;
+
+    pthread_mutex_lock(&meter->pending_lock);
+    head = meter->pending_head;
+    tail = meter->pending_tail;
+    count = head - tail < ARRAY_SIZE(batch) ? (size_t)(head - tail) : ARRAY_SIZE(batch);
+    for (i = 0; i < count; i++)
+        batch[i] = meter->pending[(tail + i) % FEX_PASS_PENDING];
+    pthread_mutex_unlock(&meter->pending_lock);
+
+    if (!count)
+        return false;
+
+    now = vkd3d_get_current_time_ns();
+    for (done = 0; done < count; done++)
+    {
+        uint64_t data[4];
+        VkResult vr;
+
+        vr = VK_CALL(vkGetQueryPoolResults(meter->device->vk_device, meter->pool, 2 * batch[done].rec.pair, 2,
+                sizeof(data), data, 2 * sizeof(uint64_t), VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT));
+        if (vr >= 0 && data[1] && data[3])
+        {
+            if (data[2] >= data[0])
+                fex_pass_account(meter, &batch[done].rec, data[2] - data[0]);
+            else
+                meter->unordered++;
+        }
+        else if (now - batch[done].submit_ns > 2000000000ull)
+            meter->lost++;
+        else
+            break;
+    }
+
+    pthread_mutex_lock(&meter->pending_lock);
+    meter->pending_tail += done;
+    pthread_mutex_unlock(&meter->pending_lock);
+    return done == count;
+}
+
+static void *fex_pass_meter_thread(void *arg)
+{
+    struct vkd3d_fex_pass_meter *meter = arg;
+    uint64_t now;
+
+    vkd3d_set_thread_name("vkd3d-fex-passes");
+    meter->window_start_ns = vkd3d_get_current_time_ns();
+
+    while (!vkd3d_atomic_uint32_load_explicit(&meter->dead, vkd3d_memory_order_acquire))
+    {
+#ifdef _WIN32
+        Sleep(50);
+#else
+        struct timespec dur = { 0, 50000000 };
+        nanosleep(&dur, NULL);
+#endif
+
+        while (fex_pass_resolve_some(meter))
+            ;
+
+        now = vkd3d_get_current_time_ns();
+        if (now - meter->window_start_ns >= 1000000000ull)
+        {
+            fex_pass_publish(meter, (now - meter->window_start_ns) / 1e9);
+            meter->window_start_ns = now;
+        }
+    }
+
+    return NULL;
+}
+
+struct vkd3d_fex_pass_meter *vkd3d_fex_pass_meter_init(struct d3d12_device *device)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    struct vkd3d_fex_pass_meter *meter;
+    VkQueryPoolCreateInfo pool_info;
+    char env[16];
+
+    vkd3d_atomic_uint32_store_explicit((uint32_t *)&vkd3d_fex_pass_report.flags, VKD3D_FEX_REPORT_FLAG_DEVICE |
+            (device->fex_fold_clears ? VKD3D_FEX_REPORT_FLAG_FOLD_CLEARS : 0), vkd3d_memory_order_release);
+
+    if (!vkd3d_get_env_var("VKD3D_FEX_PASSES", env, sizeof(env)) || strcmp(env, "1"))
+        return NULL;
+
+    if (!(meter = vkd3d_calloc(1, sizeof(*meter))))
+        return NULL;
+    if (!(meter->pending = vkd3d_calloc(FEX_PASS_PENDING, sizeof(*meter->pending))))
+    {
+        vkd3d_free(meter);
+        return NULL;
+    }
+
+    meter->device = device;
+    meter->ns_per_tick = device->device_info.properties2.properties.limits.timestampPeriod;
+
+    memset(&pool_info, 0, sizeof(pool_info));
+    pool_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    pool_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    pool_info.queryCount = 2 * FEX_PASS_QUERY_PAIRS;
+    if (VK_CALL(vkCreateQueryPool(device->vk_device, &pool_info, NULL, &meter->pool)) != VK_SUCCESS)
+    {
+        ERR("FEX pass meter: failed to create timestamp query pool.\n");
+        vkd3d_free(meter->pending);
+        vkd3d_free(meter);
+        return NULL;
+    }
+
+    pthread_mutex_init(&meter->sig_lock, NULL);
+    pthread_mutex_init(&meter->pending_lock, NULL);
+
+    if (pthread_create(&meter->thread, NULL, fex_pass_meter_thread, meter))
+    {
+        VK_CALL(vkDestroyQueryPool(device->vk_device, meter->pool, NULL));
+        pthread_mutex_destroy(&meter->sig_lock);
+        pthread_mutex_destroy(&meter->pending_lock);
+        vkd3d_free(meter->pending);
+        vkd3d_free(meter);
+        return NULL;
+    }
+
+    vkd3d_atomic_uint32_or((uint32_t *)&vkd3d_fex_pass_report.flags, VKD3D_FEX_REPORT_FLAG_ON, vkd3d_memory_order_release);
+    INFO("FEX pass meter on.\n");
+    return meter;
+}
+
+void vkd3d_fex_pass_meter_deinit(struct vkd3d_fex_pass_meter *meter)
+{
+    const struct vkd3d_vk_device_procs *vk_procs;
+
+    if (!meter)
+        return;
+
+    vk_procs = &meter->device->vk_procs;
+    vkd3d_atomic_uint32_store_explicit(&meter->dead, 1, vkd3d_memory_order_release);
+    pthread_join(meter->thread, NULL);
+
+    VK_CALL(vkDestroyQueryPool(meter->device->vk_device, meter->pool, NULL));
+    pthread_mutex_destroy(&meter->sig_lock);
+    pthread_mutex_destroy(&meter->pending_lock);
+    vkd3d_free(meter->pending);
+    vkd3d_free(meter);
+}
diff --git a/libs/vkd3d/fex_timeline.c b/libs/vkd3d/fex_timeline.c
new file mode 100644
index 0000000..7a92722
--- /dev/null
+++ b/libs/vkd3d/fex_timeline.c
@@ -0,0 +1,292 @@
+/*
+ * FEX timeline: where each frame's time goes between the game's Present() and the image going to the window system,
+ * and what every queue thread spends its time on (submitting, waiting on fences, presenting, idle), plus how long
+ * ExecuteCommandLists work sat in the queue before the queue thread got to it. Once a second the numbers go into an
+ * exported buffer (vkd3d_fex_present_report) that FEX's stats log picks up. Off unless VKD3D_FEX_TIMELINE=1.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+
+#include "vkd3d_private.h"
+#include <stdio.h>
+#include <string.h>
+#include <inttypes.h>
+
+#define FEX_TIMELINE_MAX_QUEUES 8u
+#define FEX_TIMELINE_CONFIG_SIZE 512u
+
+/* Read by FEX (found by export name in d3d12core.dll). */
+struct vkd3d_fex_report vkd3d_fex_present_report = { 0x54584546u /* 'FEXT' */, 1u, 0u, 0u, { 0 } };
+
+bool vkd3d_fex_timeline_on;
+
+struct fex_timeline_stat
+{
+    uint32_t count;
+    uint64_t sum_ns, max_ns;
+};
+
+struct fex_timeline_queue
+{
+    bool used;
+    D3D12_COMMAND_LIST_TYPE type;
+    struct fex_timeline_stat ops[VKD3D_FEX_QOP_COUNT];
+    struct fex_timeline_stat lag;
+    uint32_t max_depth;
+};
+
+static struct
+{
+    spinlock_t lock;
+    struct fex_timeline_stat steps[VKD3D_FEX_STEP_COUNT];
+    struct fex_timeline_queue queues[FEX_TIMELINE_MAX_QUEUES];
+    uint32_t presents, last_sync_interval, max_queued;
+    char config[FEX_TIMELINE_CONFIG_SIZE];
+} fex_timeline;
+
+static UINT64 fex_timeline_last_publish_ns;
+static UINT64 fex_timeline_last_release_ns;
+static uint32_t fex_timeline_init_done;
+
+static const char *const fex_step_names[VKD3D_FEX_STEP_COUNT] =
+{
+    "in Present()",
+    "Present->queue",
+    "acquire",
+    "blit",
+    "QueuePresent",
+    "acquire ahead",
+    "limiter",
+    "Present->gpu done",
+    "release->next Present",
+};
+
+static const char *const fex_op_names[VKD3D_FEX_QOP_COUNT] =
+{
+    "execute",
+    "fence wait",
+    "signal",
+    "present",
+    "other",
+    "idle",
+};
+
+static void fex_timeline_add(struct fex_timeline_stat *stat, uint64_t ns)
+{
+    stat->count++;
+    stat->sum_ns += ns;
+    if (ns > stat->max_ns)
+        stat->max_ns = ns;
+}
+
+void vkd3d_fex_timeline_init(void)
+{
+    char env[16];
+
+    if (vkd3d_atomic_uint32_exchange_explicit(&fex_timeline_init_done, 1, vkd3d_memory_order_acq_rel))
+        return;
+
+    spinlock_init(&fex_timeline.lock);
+    vkd3d_fex_timeline_on = vkd3d_get_env_var("VKD3D_FEX_TIMELINE", env, sizeof(env)) && !strcmp(env, "1");
+    vkd3d_atomic_uint32_store_explicit((uint32_t *)&vkd3d_fex_present_report.flags, VKD3D_FEX_REPORT_FLAG_DEVICE |
+            (vkd3d_fex_timeline_on ? VKD3D_FEX_REPORT_FLAG_ON : 0), vkd3d_memory_order_release);
+    vkd3d_atomic_uint64_store_explicit(&fex_timeline_last_publish_ns, vkd3d_get_current_time_ns(),
+            vkd3d_memory_order_relaxed);
+    if (vkd3d_fex_timeline_on)
+        INFO("FEX timeline on.\n");
+}
+
+uint32_t vkd3d_fex_timeline_queue_slot(D3D12_COMMAND_LIST_TYPE type)
+{
+    uint32_t i, slot = VKD3D_FEX_NO_SLOT;
+
+    if (!vkd3d_fex_timeline_on)
+        return VKD3D_FEX_NO_SLOT;
+
+    spinlock_acquire(&fex_timeline.lock);
+    for (i = 0; i < FEX_TIMELINE_MAX_QUEUES; i++)
+    {
+        if (!fex_timeline.queues[i].used)
+        {
+            memset(&fex_timeline.queues[i], 0, sizeof(fex_timeline.queues[i]));
+            fex_timeline.queues[i].used = true;
+            fex_timeline.queues[i].type = type;
+            slot = i;
+            break;
+        }
+    }
+    spinlock_release(&fex_timeline.lock);
+    return slot;
+}
+
+void vkd3d_fex_timeline_queue_free_slot(uint32_t slot)
+{
+    if (slot >= FEX_TIMELINE_MAX_QUEUES)
+        return;
+    spinlock_acquire(&fex_timeline.lock);
+    fex_timeline.queues[slot].used = false;
+    spinlock_release(&fex_timeline.lock);
+}
+
+void vkd3d_fex_timeline_queue_op(uint32_t slot, enum vkd3d_fex_queue_op op, uint64_t ns)
+{
+    if (slot >= FEX_TIMELINE_MAX_QUEUES)
+        return;
+    spinlock_acquire(&fex_timeline.lock);
+    fex_timeline_add(&fex_timeline.queues[slot].ops[op], ns);
+    spinlock_release(&fex_timeline.lock);
+}
+
+void vkd3d_fex_timeline_queue_lag(uint32_t slot, uint64_t ns, uint32_t depth)
+{
+    if (slot >= FEX_TIMELINE_MAX_QUEUES)
+        return;
+    spinlock_acquire(&fex_timeline.lock);
+    fex_timeline_add(&fex_timeline.queues[slot].lag, ns);
+    if (depth > fex_timeline.queues[slot].max_depth)
+        fex_timeline.queues[slot].max_depth = depth;
+    spinlock_release(&fex_timeline.lock);
+}
+
+void vkd3d_fex_timeline_step(enum vkd3d_fex_present_step step, uint64_t ns)
+{
+    if (!vkd3d_fex_timeline_on)
+        return;
+    spinlock_acquire(&fex_timeline.lock);
+    fex_timeline_add(&fex_timeline.steps[step], ns);
+    spinlock_release(&fex_timeline.lock);
+}
+
+void vkd3d_fex_timeline_present(uint32_t sync_interval, uint32_t queued)
+{
+    if (!vkd3d_fex_timeline_on)
+        return;
+    spinlock_acquire(&fex_timeline.lock);
+    fex_timeline.presents++;
+    fex_timeline.last_sync_interval = sync_interval;
+    if (queued > fex_timeline.max_queued)
+        fex_timeline.max_queued = queued;
+    spinlock_release(&fex_timeline.lock);
+}
+
+void vkd3d_fex_timeline_release(uint64_t now_ns)
+{
+    vkd3d_atomic_uint64_store_explicit(&fex_timeline_last_release_ns, now_ns, vkd3d_memory_order_relaxed);
+}
+
+uint64_t vkd3d_fex_timeline_last_release(void)
+{
+    return vkd3d_atomic_uint64_load_explicit(&fex_timeline_last_release_ns, vkd3d_memory_order_relaxed);
+}
+
+void vkd3d_fex_timeline_config(const char *text)
+{
+    if (!vkd3d_fex_timeline_on)
+        return;
+    spinlock_acquire(&fex_timeline.lock);
+    snprintf(fex_timeline.config, sizeof(fex_timeline.config), "%s", text);
+    spinlock_release(&fex_timeline.lock);
+}
+
+static size_t fex_timeline_format_stat(char *buf, size_t size, size_t len, const char *name,
+        const struct fex_timeline_stat *stat)
+{
+    if (!stat->count)
+        return vkd3d_fex_report_append(buf, size, len, " | %s -", name);
+    return vkd3d_fex_report_append(buf, size, len, " | %s %.1f/%.1f", name,
+            stat->sum_ns / 1e6 / stat->count, stat->max_ns / 1e6);
+}
+
+static const char *fex_timeline_queue_name(D3D12_COMMAND_LIST_TYPE type)
+{
+    switch (type)
+    {
+        case D3D12_COMMAND_LIST_TYPE_DIRECT: return "direct";
+        case D3D12_COMMAND_LIST_TYPE_COMPUTE: return "compute";
+        case D3D12_COMMAND_LIST_TYPE_COPY: return "copy";
+        default: return "other";
+    }
+}
+
+static void fex_timeline_publish(double seconds)
+{
+    static char text[VKD3D_FEX_REPORT_SIZE];
+    struct fex_timeline_stat steps[VKD3D_FEX_STEP_COUNT];
+    struct fex_timeline_queue queues[FEX_TIMELINE_MAX_QUEUES];
+    char config[FEX_TIMELINE_CONFIG_SIZE];
+    uint32_t presents, sync_interval, max_queued;
+    size_t len = 0;
+    uint32_t i, j;
+
+    spinlock_acquire(&fex_timeline.lock);
+    memcpy(steps, fex_timeline.steps, sizeof(steps));
+    memcpy(queues, fex_timeline.queues, sizeof(queues));
+    memcpy(config, fex_timeline.config, sizeof(config));
+    presents = fex_timeline.presents;
+    sync_interval = fex_timeline.last_sync_interval;
+    max_queued = fex_timeline.max_queued;
+    memset(fex_timeline.steps, 0, sizeof(fex_timeline.steps));
+    for (i = 0; i < FEX_TIMELINE_MAX_QUEUES; i++)
+    {
+        memset(fex_timeline.queues[i].ops, 0, sizeof(fex_timeline.queues[i].ops));
+        memset(&fex_timeline.queues[i].lag, 0, sizeof(fex_timeline.queues[i].lag));
+        fex_timeline.queues[i].max_depth = 0;
+    }
+    fex_timeline.presents = 0;
+    fex_timeline.max_queued = 0;
+    spinlock_release(&fex_timeline.lock);
+
+    if (config[0])
+        len = vkd3d_fex_report_append(text, sizeof(text), len, "# present: %s\n", config);
+
+    len = vkd3d_fex_report_append(text, sizeof(text), len, "  present n=%u sync=%u waits queued<=%u (ms avg/max)",
+            presents, sync_interval, max_queued);
+    for (i = 0; i < VKD3D_FEX_STEP_COUNT; i++)
+        len = fex_timeline_format_stat(text, sizeof(text), len, fex_step_names[i], &steps[i]);
+    len = vkd3d_fex_report_append(text, sizeof(text), len, " over %.2fs\n", seconds);
+
+    for (i = 0; i < FEX_TIMELINE_MAX_QUEUES; i++)
+    {
+        const struct fex_timeline_queue *q = &queues[i];
+
+        if (!q->used)
+            continue;
+        len = vkd3d_fex_report_append(text, sizeof(text), len, "  queue %u %s (ms/s n):", i,
+                fex_timeline_queue_name(q->type));
+        for (j = 0; j < VKD3D_FEX_QOP_COUNT; j++)
+        {
+            if (q->ops[j].count)
+                len = vkd3d_fex_report_append(text, sizeof(text), len, " %s %.0f x%u max %.1f;", fex_op_names[j],
+                        q->ops[j].sum_ns / 1e6 / seconds, q->ops[j].count, q->ops[j].max_ns / 1e6);
+        }
+        if (q->lag.count)
+            len = vkd3d_fex_report_append(text, sizeof(text), len,
+                    " | lists waited in queue avg %.1f max %.1f ms, depth<=%u", q->lag.sum_ns / 1e6 / q->lag.count,
+                    q->lag.max_ns / 1e6, q->max_depth);
+        len = vkd3d_fex_report_append(text, sizeof(text), len, "\n");
+    }
+
+    vkd3d_fex_report_publish(&vkd3d_fex_present_report, text, len);
+}
+
+void vkd3d_fex_timeline_tick(uint64_t now_ns)
+{
+    uint64_t last;
+
+    if (!vkd3d_fex_timeline_on)
+        return;
+
+    last = vkd3d_atomic_uint64_load_explicit(&fex_timeline_last_publish_ns, vkd3d_memory_order_relaxed);
+    if (now_ns - last < 1000000000ull)
+        return;
+    /* One thread publishes; the others see the new time and skip. */
+    if (vkd3d_atomic_uint64_compare_exchange(&fex_timeline_last_publish_ns, last, now_ns,
+            vkd3d_memory_order_acq_rel, vkd3d_memory_order_relaxed) != last)
+        return;
+    fex_timeline_publish((now_ns - last) / 1e9);
+}
