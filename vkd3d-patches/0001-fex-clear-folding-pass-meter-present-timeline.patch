+            vkd3d_fex_timeline_queue_op(queue->fex_timeline_slot, VKD3D_FEX_QOP_IDLE, fex_t1 - fex_t0);
+            if (submission.type == VKD3D_SUBMISSION_EXECUTE && submission.fex_enqueue_ns &&
+                    fex_t1 > submission.fex_enqueue_ns)
+                vkd3d_fex_timeline_queue_lag(queue->fex_timeline_slot, fex_t1 - submission.fex_enqueue_ns, fex_depth);
+            fex_t0 = fex_t1;
+        }
+
         if (submission.type != VKD3D_SUBMISSION_BIND_SPARSE)
             d3d12_command_queue_flush_bind_sparse(queue);
 
@@ -21282,9 +21578,26 @@ static void *d3d12_command_queue_submission_worker_main(void *userdata)
         }
 
         vkd3d_queue_timeline_trace_complete_execute(&queue->device->queue_timeline_trace, &queue->fence_worker, cookie);
+
+        if (queue->fex_timeline_slot != VKD3D_FEX_NO_SLOT)
+        {
+            switch (submission.type)
+            {
+                case VKD3D_SUBMISSION_EXECUTE: fex_op = VKD3D_FEX_QOP_EXECUTE; break;
+                case VKD3D_SUBMISSION_WAIT: fex_op = VKD3D_FEX_QOP_WAIT; break;
+                case VKD3D_SUBMISSION_SIGNAL: fex_op = VKD3D_FEX_QOP_SIGNAL; break;
+                case VKD3D_SUBMISSION_QUEUE_USING_CALLBACK: fex_op = VKD3D_FEX_QOP_PRESENT; break;
+                default: fex_op = VKD3D_FEX_QOP_OTHER; break;
+            }
+            fex_t1 = vkd3d_get_current_time_ns();
+            vkd3d_fex_timeline_queue_op(queue->fex_timeline_slot, fex_op, fex_t1 - fex_t0);
