@@ -308,6 +445,7 @@ void vkd3d_fex_pass_meter_end_pass(struct d3d12_command_list *list, unsigned int
     if (!list->device->fex_pass_meter || !list->fex_pass.pass_active)
         return;
 
+    fex_pass_end_stats(list);
     fex_pass_write_end(list, list->fex_pass.current.pair);
     list->fex_pass.current.end_line = line > 0xffff ? 0xffff : line;
     fex_pass_add_record(list, &list->fex_pass.current);
@@ -371,8 +509,11 @@ static void fex_pass_note_line(struct vkd3d_fex_pass_meter *meter, uint32_t line
     }
 }
 
-static void fex_pass_account(struct vkd3d_fex_pass_meter *meter, const struct vkd3d_fex_pass_record *rec, uint64_t ticks)
+/* inside_ticks: begin to the after-begin timestamp, or -1 when there is none; stats: NULL when not sampled. */
+static void fex_pass_account(struct vkd3d_fex_pass_meter *meter, const struct vkd3d_fex_pass_record *rec, uint64_t ticks,
+        int64_t inside_ticks, const uint64_t *stats)
 {
+    struct fex_pass_sig_stats *st;
     const struct fex_pass_sig *sig;
     uint64_t area;
     unsigned int i;
@@ -394,6 +535,10 @@ static void fex_pass_account(struct vkd3d_fex_pass_meter *meter, const struct vk
         meter->passes++;
         meter->pass_ticks += ticks;
         meter->draws += rec->draws;
+        meter->vertices += rec->vertices;
+        meter->pipelines += rec->pipelines;
+        if (stats)
