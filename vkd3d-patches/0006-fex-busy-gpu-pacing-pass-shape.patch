     for (i = 0; i < sig->color_count; i++)
@@ -475,6 +636,53 @@ size_t vkd3d_fex_report_append(char *buf, size_t size, size_t len, const char *f
     return (size_t)n >= size - len ? size - 1 : len + (size_t)n;
 }
 
+/* 950, 12.3k, 4.56M */
+static size_t fex_pass_append_count(char *buf, size_t size, size_t len, double value)
+{
+    if (value < 1000.0)
+        return vkd3d_fex_report_append(buf, size, len, "%.0f", value);
+    if (value < 1000000.0)
+        return vkd3d_fex_report_append(buf, size, len, "%.1fk", value / 1000.0);
+    return vkd3d_fex_report_append(buf, size, len, "%.2fM", value / 1000000.0);
+}
+
+/* Per pass averages of the pass shape, after the pass's description. */
+static size_t fex_pass_describe_shape(const struct fex_pass_sig *sig, const struct fex_pass_sig_stats *st,
+        double ms, char *buf, size_t size, size_t len)
+{
+    double pixels = (double)sig->width * sig->height * (sig->layers ? sig->layers : 1);
+    double pass_ms = st->gpu_ticks * ms / st->count;
+
+    if (st->inside_count)
+    {
+        double inside_ms = st->inside_ticks * ms / st->inside_count;
+
+        len = vkd3d_fex_report_append(buf, size, len, " | last tile began %.0f%% (%.2f of %.2f ms)",
+                pass_ms > 0.0 ? 100.0 * inside_ms / pass_ms : 0.0, inside_ms, pass_ms);
+    }
+    len = vkd3d_fex_report_append(buf, size, len, " | vtx ");
+    len = fex_pass_append_count(buf, size, len, (double)st->vertices / st->count);
+    len = vkd3d_fex_report_append(buf, size, len, " (%.0f direct draws)", (double)st->direct_draws / st->count);
+    if (st->stats_count)
+    {
+        double n = (double)st->stats_count;
+
+        len = vkd3d_fex_report_append(buf, size, len, " | gpu vtx ");
+        len = fex_pass_append_count(buf, size, len, st->stats[0] / n);
+        if (st->stats_vertices)
+            len = vkd3d_fex_report_append(buf, size, len, " = %.1fx", (double)st->stats[0] / st->stats_vertices);
+        len = vkd3d_fex_report_append(buf, size, len, ", vs ");
+        len = fex_pass_append_count(buf, size, len, st->stats[1] / n);
+        len = vkd3d_fex_report_append(buf, size, len, ", prims ");
+        len = fex_pass_append_count(buf, size, len, st->stats[2] / n);
+        len = vkd3d_fex_report_append(buf, size, len, ", fs ");
+        len = fex_pass_append_count(buf, size, len, st->stats[3] / n);
+        len = vkd3d_fex_report_append(buf, size, len, " = %.1f/px (%"PRIu64" sampled)",
+                pixels > 0.0 ? st->stats[3] / n / pixels : 0.0, st->stats_count);
+    }
+    return vkd3d_fex_report_append(buf, size, len, " | pso %.0f", (double)st->pipelines / st->count);
+}
+
 static size_t fex_pass_describe_sig(const struct fex_pass_sig *sig, char *buf, size_t size, size_t len)
 {
     unsigned int i;
