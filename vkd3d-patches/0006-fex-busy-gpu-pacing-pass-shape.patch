diff --git a/libs/vkd3d/fex_pass_meter.c b/libs/vkd3d/fex_pass_meter.c
index 8b0c550..8c1cd0a 100644
--- a/libs/vkd3d/fex_pass_meter.c
+++ b/libs/vkd3d/fex_pass_meter.c
@@ -7,6 +7,16 @@
  * commands after vkCmdEndRendering); command lists get a pair around their whole recording. Results are read back by a
  * thread without waiting on the GPU.
  *
+ * Pass shape (VKD3D fex6), to tell what a costly pass spends its GPU time on:
+ * - a third timestamp right after vkCmdBeginRendering (top of pipe, no wait). A tiling GPU replays a pass's commands
+ *   once per screen tile, so this timestamp is written once per tile and ends up as the time the last tile began; a
+ *   pass drawn straight to memory writes it once, right at the start.
+ * - vertices: the vertex (index) counts of the pass's direct draws, counted on the CPU.
+ * - every few passes, a pipeline statistics query around the pass: vertices the GPU assembled (counts each tile's
+ *   replay, so divided by the CPU count it says how often the geometry went through), vertex shader runs, primitives
+ *   left after clipping and fragment shader runs.
+ * - graphics pipeline binds.
+ *
  * This library is free software; you can redistribute it and/or
  * modify it under the terms of the GNU Lesser General Public
  * License as published by the Free Software Foundation; either
@@ -26,6 +36,11 @@
 #define FEX_PASS_PENDING 65536u
 #define FEX_PASS_MAX_SIGS 1024u
 #define FEX_PASS_MAX_LINES 256u
+#define FEX_PASS_STATS_SLOTS 16384u
+#define FEX_PASS_STATS_BLOCK 16u   /* statistics queries a command list takes at once, reset with one command */
+#define FEX_PASS_STATS_EVERY 4u    /* one pass in this many gets a statistics query */
+#define FEX_PASS_STATS_VALUES 4u   /* input assembly vertices, vertex shader runs, primitives after clipping, fragment
+                                    * shader runs (in this order: the order of their bits) */
 
 /* Read by FEX (found by export name in d3d12core.dll). */
 struct vkd3d_fex_report vkd3d_fex_pass_report = { 0x50584546u /* 'FEXP' */, 1u, 0u, 0u, { 0 } };
@@ -48,6 +63,9 @@ struct fex_pass_sig_stats
 {
     uint64_t count, gpu_ticks, draws;
     uint32_t last_end_line;
+    uint64_t inside_count, inside_ticks;     /* passes with the after-begin timestamp, time from begin to it */
+    uint64_t vertices, direct_draws, pipelines;
+    uint64_t stats_count, stats_vertices, stats[FEX_PASS_STATS_VALUES]; /* sampled passes: CPU vertices, GPU counts */
 };
 
 struct fex_pass_line_stats
@@ -81,6 +99,12 @@ struct vkd3d_fex_pass_meter
     pthread_t thread;
     uint32_t dead;
 
+    bool shape;              /* pass shape on (VKD3D_FEX_PASS_SHAPE isn't '0') */
+    VkQueryPool stats_pool;  /* VK_NULL_HANDLE: no pipeline statistics */
+    uint32_t next_stats_block;
+    uint32_t stats_blocked;  /* the game made a pipeline statistics query heap: leave the query type to it */
+    uint32_t sig_seen[FEX_PASS_MAX_SIGS]; /* passes begun per signature: every FEX_PASS_STATS_EVERY-th gets statistics */
+
     /* Owned by the thread. */
     struct fex_pass_sig_stats sig_stats[FEX_PASS_MAX_SIGS];
     struct fex_pass_line_stats line_stats[FEX_PASS_MAX_LINES];
@@ -88,6 +112,7 @@ struct vkd3d_fex_pass_meter
     uint64_t lists, list_ticks, passes, pass_ticks, draws, clears, clear_ticks, lost, unordered;
     uint64_t load_bytes, store_bytes, clear_bytes, loads, stores, cleared;
     uint64_t ds_kept, ds_kept_bytes, ds_half_kept; /* read-only depth-stencil not written back (STORE_OP_NONE) */
+    uint64_t vertices, pipelines, sampled;         /* pass shape totals */
     uint64_t window_start_ns;
 
     /* Counted by recording threads. */
@@ -181,6 +206,52 @@ static uint32_t fex_pass_alloc_pair(struct d3d12_command_list *list)
     return list->fex_pass.block_next++;
 }
 
+/* Same as fex_pass_alloc_pair for the pipeline statistics pool. */
+static uint32_t fex_pass_alloc_stats(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    uint32_t base;
+
+    if (list->fex_pass.stats_next == list->fex_pass.stats_end)
+    {
+        base = vkd3d_atomic_uint32_increment(&meter->next_stats_block, vkd3d_memory_order_relaxed) - 1;
+        base = (base * FEX_PASS_STATS_BLOCK) % FEX_PASS_STATS_SLOTS;
+        VK_CALL(vkCmdResetQueryPool(list->cmd.vk_command_buffer, meter->stats_pool, base, FEX_PASS_STATS_BLOCK));
+        list->fex_pass.stats_next = base;
+        list->fex_pass.stats_end = base + FEX_PASS_STATS_BLOCK;
+    }
+    return list->fex_pass.stats_next++;
+}
+
+/* Our statistics query is begun before vkCmdBeginRendering, so it has to end outside the pass too. */
+static void fex_pass_end_stats(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+
+    if (!list->fex_pass.stats_active)
+        return;
+    VK_CALL(vkCmdEndQuery(list->cmd.vk_command_buffer, meter->stats_pool, list->fex_pass.current.stats_slot));
+    list->fex_pass.stats_active = false;
+}
+
+/* Only one query of a type may run at a time: leave pipeline statistics to the game once it uses them. */
+static bool fex_pass_stats_allowed(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    size_t i;
+
+    if (!meter->stats_pool || vkd3d_atomic_uint32_load_explicit(&meter->stats_blocked, vkd3d_memory_order_relaxed))
+        return false;
+    for (i = 0; i < list->active_queries_count; i++)
+    {
+        if (list->active_queries[i].type == D3D12_QUERY_TYPE_PIPELINE_STATISTICS)
+            return false;
+    }
+    return true;
+}
+
 static void fex_pass_write_begin(struct d3d12_command_list *list, uint32_t pair)
 {
     struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
@@ -215,6 +286,9 @@ void vkd3d_fex_pass_meter_begin_list(struct d3d12_command_list *list)
     list->fex_pass.pass_active = false;
     list->fex_pass.list_active = false;
     list->fex_pass.block_next = list->fex_pass.block_end = 0;
+    list->fex_pass.stats_next = list->fex_pass.stats_end = 0;
+    list->fex_pass.binds = 0;
+    list->fex_pass.stats_active = false;
     if (!meter || !(list->vk_queue_flags & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)))
         return;
 
@@ -230,6 +304,7 @@ void vkd3d_fex_pass_meter_close_list(struct d3d12_command_list *list)
     if (!list->device->fex_pass_meter || !list->fex_pass.list_active)
         return;
 
+    fex_pass_end_stats(list);
     fex_pass_write_end(list, list->fex_pass.list_pair);
     memset(&rec, 0, sizeof(rec));
     rec.pair = list->fex_pass.list_pair;
@@ -244,13 +319,17 @@ void vkd3d_fex_pass_meter_begin_pass(struct d3d12_command_list *list, const VkRe
         const struct vkd3d_format *ds_format, uint32_t kind)
 {
     struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    struct vkd3d_fex_pass_record *current = &list->fex_pass.current;
     struct fex_pass_sig sig;
+    uint32_t pipelines;
     unsigned int i;
 
     if (!meter)
         return;
 
     /* Callers end the previous pass first; a stale one (no end timestamp) is dropped. */
+    fex_pass_end_stats(list);
     list->fex_pass.pass_active = false;
 
     memset(&sig, 0, sizeof(sig));
@@ -288,13 +367,71 @@ void vkd3d_fex_pass_meter_begin_pass(struct d3d12_command_list *list, const VkRe
         }
     }
 
-    memset(&list->fex_pass.current, 0, sizeof(list->fex_pass.current));
-    list->fex_pass.current.pair = fex_pass_alloc_pair(list);
-    list->fex_pass.current.sig = fex_pass_intern_sig(meter, &sig);
-    list->fex_pass.current.kind = kind;
-    list->fex_pass.current.draws = kind == VKD3D_FEX_PASS_KIND_CLEAR ? 0 : 1;
+    /* Pipelines bound since the last pass are bound for this one. */
+    pipelines = list->fex_pass.binds;
+    list->fex_pass.binds = 0;
+
+    memset(current, 0, sizeof(*current));
+    current->pair = fex_pass_alloc_pair(list);
+    current->sig = fex_pass_intern_sig(meter, &sig);
+    current->kind = kind;
+    current->draws = kind == VKD3D_FEX_PASS_KIND_CLEAR ? 0 : 1;
+    current->pipelines = pipelines;
+    current->inside_pair = VKD3D_FEX_PASS_NO_QUERY;
+    current->stats_slot = VKD3D_FEX_PASS_NO_QUERY;
+    if (meter->shape && kind != VKD3D_FEX_PASS_KIND_CLEAR)
+    {
+        current->inside_pair = fex_pass_alloc_pair(list);
+        /* Per signature, so a pass that comes once a frame is sampled too, whatever the passes per frame. */
+        if (current->sig < FEX_PASS_MAX_SIGS && fex_pass_stats_allowed(list) &&
+                !((vkd3d_atomic_uint32_increment(&meter->sig_seen[current->sig], vkd3d_memory_order_relaxed) - 1) %
+                FEX_PASS_STATS_EVERY))
+        {
+            current->stats_slot = fex_pass_alloc_stats(list);
+            VK_CALL(vkCmdBeginQuery(list->cmd.vk_command_buffer, meter->stats_pool, current->stats_slot, 0));
+            list->fex_pass.stats_active = true;
+        }
+    }
     list->fex_pass.pass_active = true;
-    fex_pass_write_begin(list, list->fex_pass.current.pair);
+    fex_pass_write_begin(list, current->pair);
+}
+
+/* Right after vkCmdBeginRendering. */
+void vkd3d_fex_pass_meter_inside_pass(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+
+    if (!meter || !list->fex_pass.pass_active || list->fex_pass.current.inside_pair == VKD3D_FEX_PASS_NO_QUERY)
+        return;
+    VK_CALL(vkCmdWriteTimestamp2(list->cmd.vk_command_buffer, VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT,
+            meter->pool, 2 * list->fex_pass.current.inside_pair));
+}
+
+void vkd3d_fex_pass_meter_vertices(struct d3d12_command_list *list, uint64_t vertices)
+{
+    if (!list->fex_pass.pass_active)
+        return;
+    list->fex_pass.current.vertices += vertices;
+    list->fex_pass.current.direct_draws++;
+}
+
+void vkd3d_fex_pass_meter_pipeline_bind(struct d3d12_command_list *list)
+{
+    if (list->fex_pass.pass_active)
+        list->fex_pass.current.pipelines++;
+    else
+        list->fex_pass.binds++;
+}
+
+void vkd3d_fex_pass_meter_game_query_heap(struct d3d12_device *device, D3D12_QUERY_HEAP_TYPE type)
+{
+    struct vkd3d_fex_pass_meter *meter = device->fex_pass_meter;
+
+    if (meter && type == D3D12_QUERY_HEAP_TYPE_PIPELINE_STATISTICS &&
+            !vkd3d_atomic_uint32_exchange_explicit(&meter->stats_blocked, 1, vkd3d_memory_order_relaxed) &&
+            meter->stats_pool)
+        INFO("FEX pass meter: the game uses pipeline statistics, not sampling them any more.\n");
 }
 
