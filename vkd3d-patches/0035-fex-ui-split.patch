diff --git a/libs/vkd3d/fex_ui_split.c b/libs/vkd3d/fex_ui_split.c
new file mode 100644
index 0000000..e4d74a3
--- /dev/null
+++ b/libs/vkd3d/fex_ui_split.c
@@ -0,0 +1,284 @@
+/*
+ * FEX UI split (VKD3D fex35, VKD3D_FEX_UI_SPLIT): each swapchain frame also handed over without the game's UI layer,
+ * for FEX's frame generation layer (see struct vkd3d_fex_ui_frame in vkd3d_private.h). The command list side (finding
+ * the UI layer and the composite draw, the copy and the second draw) is in command.c, the hand-over in swapchain.c.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+
+#include "vkd3d_private.h"
+#include <string.h>
+
+void vkd3d_fex_ui_init(struct d3d12_device *device)
+{
+    struct vkd3d_fex_ui *ui;
+    char env[16];
+
+    device->fex_ui = NULL;
+
+    /* Off unless FEX asks for it: only FEX's frame generation layer uses the hand-over image. */
+    if (!vkd3d_get_env_var("VKD3D_FEX_UI_SPLIT", env, sizeof(env)) || !strcmp(env, "0"))
+        return;
+
+    if (!(ui = vkd3d_calloc(1, sizeof(*ui))))
+        return;
+    if (pthread_mutex_init(&ui->mutex, NULL))
+    {
+        vkd3d_free(ui);
+        return;
+    }
+    device->fex_ui = ui;
+    INFO("FEX: each frame is also handed over without the game's UI layer (VKD3D_FEX_UI_SPLIT).\n");
+}
+
+void vkd3d_fex_ui_cleanup(struct d3d12_device *device)
+{
+    struct vkd3d_fex_ui *ui = device->fex_ui;
+
+    if (!ui)
+        return;
+    if (ui->save_image)
+        vkd3d_fex_ui_destroy_image(device, ui->save_image, VK_NULL_HANDLE, &ui->save_memory);
+    pthread_mutex_destroy(&ui->mutex);
+    vkd3d_free(ui);
+    device->fex_ui = NULL;
+}
+
+void vkd3d_fex_ui_event(struct d3d12_device *device, enum vkd3d_fex_ui_event event)
+{
+    if (device->fex_ui)
+        vkd3d_atomic_uint32_increment(&device->fex_ui->events[event], vkd3d_memory_order_relaxed);
+}
+
+HRESULT vkd3d_fex_ui_create_image(struct d3d12_device *device, uint32_t width, uint32_t height, VkFormat format,
+        bool hand_over, VkImage *image, VkImageView *view, struct vkd3d_device_memory_allocation *memory)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    VkImageFormatListCreateInfo format_list;
+    VkMemoryRequirements requirements;
+    VkImageViewCreateInfo view_info;
+    VkImageCreateInfo image_info;
+    VkBindImageMemoryInfo bind;
+    VkResult vr;
+    HRESULT hr;
+
+    *image = VK_NULL_HANDLE;
+    if (view)
+        *view = VK_NULL_HANDLE;
+    memset(memory, 0, sizeof(*memory));
+
+    memset(&image_info, 0, sizeof(image_info));
+    image_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+    image_info.imageType = VK_IMAGE_TYPE_2D;
+    image_info.format = format;
+    image_info.extent.width = width;
+    image_info.extent.height = height;
+    image_info.extent.depth = 1;
+    image_info.mipLevels = 1;
+    image_info.arrayLayers = 1;
+    image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+    image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (hand_over)
+    {
+        /* Exactly transfer source + destination with a format list of the image's own format: no D3D12 resource is
+         * made like that, so FEX's frame generation layer knows this image by it. */
+        image_info.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+        memset(&format_list, 0, sizeof(format_list));
+        format_list.sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO;
+        format_list.viewFormatCount = 1;
+        format_list.pViewFormats = &format;
+        image_info.pNext = &format_list;
+    }
+    else
+    {
+        image_info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+                VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    }
+
+    if ((vr = VK_CALL(vkCreateImage(device->vk_device, &image_info, NULL, image))) < 0)
+    {
+        *image = VK_NULL_HANDLE;
+        return hresult_from_vk_result(vr);
+    }
+
+    VK_CALL(vkGetImageMemoryRequirements(device->vk_device, *image, &requirements));
+    if (FAILED(hr = vkd3d_allocate_device_memory(device, requirements.size, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+            requirements.memoryTypeBits, NULL, false, memory)))
+    {
+        memset(memory, 0, sizeof(*memory));
+        goto fail;
+    }
+
+    memset(&bind, 0, sizeof(bind));
+    bind.sType = VK_STRUCTURE_TYPE_BIND_IMAGE_MEMORY_INFO;
+    bind.image = *image;
+    bind.memory = memory->vk_memory;
+    if ((vr = VK_CALL(vkBindImageMemory2(device->vk_device, 1, &bind))) < 0)
+    {
+        hr = hresult_from_vk_result(vr);
+        goto fail;
+    }
+
+    if (view)
+    {
+        memset(&view_info, 0, sizeof(view_info));
+        view_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+        view_info.image = *image;
+        view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        view_info.format = format;
+        view_info.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+        view_info.subresourceRange.levelCount = 1;
+        view_info.subresourceRange.layerCount = 1;
+        if ((vr = VK_CALL(vkCreateImageView(device->vk_device, &view_info, NULL, view))) < 0)
+        {
+            *view = VK_NULL_HANDLE;
+            hr = hresult_from_vk_result(vr);
+            goto fail;
+        }
+    }
+    return S_OK;
+
+fail:
+    vkd3d_fex_ui_destroy_image(device, *image, VK_NULL_HANDLE, memory);
+    *image = VK_NULL_HANDLE;
+    return hr;
+}
+
+void vkd3d_fex_ui_destroy_image(struct d3d12_device *device, VkImage image, VkImageView view,
+        struct vkd3d_device_memory_allocation *memory)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+
+    if (view)
+        VK_CALL(vkDestroyImageView(device->vk_device, view, NULL));
+    if (image)
+        VK_CALL(vkDestroyImage(device->vk_device, image, NULL));
+    if (memory->vk_memory)
+        vkd3d_free_device_memory(device, memory);
+    memset(memory, 0, sizeof(*memory));
+}
+
+VkImage vkd3d_fex_ui_save_image(struct d3d12_device *device, VkFormat format, uint32_t width, uint32_t height)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    struct vkd3d_fex_ui *ui = device->fex_ui;
+    VkImageCreateInfo image_info;
+    VkMemoryRequirements requirements;
+    VkBindImageMemoryInfo bind;
+    VkImage image;
+
+    pthread_mutex_lock(&ui->mutex);
+    if (ui->save_image && ui->save_format == format && ui->save_width == width && ui->save_height == height)
+    {
+        image = ui->save_image;
+        pthread_mutex_unlock(&ui->mutex);
+        return image;
+    }
+    /* Another size or format: the old one may still be in use by command lists in flight, so it is kept (the UI
+     * layer doesn't change size during play; a resize makes one more). */
+    ui->save_image = VK_NULL_HANDLE;
+    memset(&ui->save_memory, 0, sizeof(ui->save_memory));
+
+    memset(&image_info, 0, sizeof(image_info));
+    image_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+    image_info.imageType = VK_IMAGE_TYPE_2D;
+    image_info.format = format;
+    image_info.extent.width = width;
+    image_info.extent.height = height;
+    image_info.extent.depth = 1;
+    image_info.mipLevels = 1;
+    image_info.arrayLayers = 1;
+    image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+    image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    image_info.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+            VK_IMAGE_USAGE_SAMPLED_BIT;
+    image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+
+    image = VK_NULL_HANDLE;
+    if (VK_CALL(vkCreateImage(device->vk_device, &image_info, NULL, &image)) >= 0)
+    {
+        VK_CALL(vkGetImageMemoryRequirements(device->vk_device, image, &requirements));
+        if (FAILED(vkd3d_allocate_device_memory(device, requirements.size, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+                requirements.memoryTypeBits, NULL, false, &ui->save_memory)))
+        {
+            memset(&ui->save_memory, 0, sizeof(ui->save_memory));
+            VK_CALL(vkDestroyImage(device->vk_device, image, NULL));
+            image = VK_NULL_HANDLE;
+        }
+        else
+        {
+            memset(&bind, 0, sizeof(bind));
+            bind.sType = VK_STRUCTURE_TYPE_BIND_IMAGE_MEMORY_INFO;
+            bind.image = image;
+            bind.memory = ui->save_memory.vk_memory;
+            if (VK_CALL(vkBindImageMemory2(device->vk_device, 1, &bind)) < 0)
+            {
+                vkd3d_fex_ui_destroy_image(device, image, VK_NULL_HANDLE, &ui->save_memory);
+                image = VK_NULL_HANDLE;
+            }
+        }
+    }
+    else
+    {
+        image = VK_NULL_HANDLE;
+    }
+
+    if (image)
+    {
+        ui->save_image = image;
+        ui->save_format = format;
+        ui->save_width = width;
+        ui->save_height = height;
+        INFO("FEX: UI layer save image %ux%u, format %u.\n", width, height, format);
+    }
+    pthread_mutex_unlock(&ui->mutex);
+    return image;
+}
+
+static const char *fex_ui_blend_factor_name(uint32_t factor)
+{
+    static const char *names[] =
+    {
+        "0", "1", "src", "1-src", "dst", "1-dst", "src.a", "1-src.a", "dst.a", "1-dst.a",
+        "const", "1-const", "const.a", "1-const.a", "src.a sat", "src1", "1-src1", "src1.a", "1-src1.a",
+    };
+    return factor < ARRAY_SIZE(names) ? names[factor] : "?";
+}
+
+size_t vkd3d_fex_ui_report(struct d3d12_device *device, char *text, size_t size, size_t len)
+{
+    struct vkd3d_fex_ui *ui = device->fex_ui;
+    uint32_t events[VKD3D_FEX_UI_EVENTS];
+    uint32_t blend, i;
+
+    if (!ui)
+        return len;
+    for (i = 0; i < VKD3D_FEX_UI_EVENTS; i++)
+        events[i] = vkd3d_atomic_uint32_exchange_explicit(&ui->events[i], 0, vkd3d_memory_order_relaxed);
+    blend = vkd3d_atomic_uint32_load_explicit(&ui->blend, vkd3d_memory_order_relaxed);
+
+    len = vkd3d_fex_report_append(text, size, len,
+            "  ui split (VKD3D fex35: each frame also handed to frame generation without the game's UI layer): presents"
+            " with it %u, as shown %u | made: copy before a composite that blends %u, composite drawn again with the UI"
+            " layer cleared %u | not made: no cleared full-size pass before the back buffer's %u, its first draw not"
+            " 3 vertices %u, no save image %u | composite blend ",
+            events[VKD3D_FEX_UI_PRESENT_SPLIT], events[VKD3D_FEX_UI_PRESENT_PLAIN],
+            events[VKD3D_FEX_UI_CAPTURE_COPY], events[VKD3D_FEX_UI_CAPTURE_REDRAW], events[VKD3D_FEX_UI_NO_UI],
+            events[VKD3D_FEX_UI_OTHER_DRAW], events[VKD3D_FEX_UI_NO_SAVE]);
+    if (!blend)
+        len = vkd3d_fex_report_append(text, size, len, "- (none seen)\n");
+    else if (!((blend - 1) & 1))
+        len = vkd3d_fex_report_append(text, size, len, "off\n");
+    else
+        len = vkd3d_fex_report_append(text, size, len, "on, color src*%s + dst*%s\n",
+                fex_ui_blend_factor_name(((blend - 1) >> 8) & 0xff), fex_ui_blend_factor_name(((blend - 1) >> 16) & 0xff));
+    return len;
+}
