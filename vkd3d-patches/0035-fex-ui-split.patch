+/* VKD3D fex35: the frame copies and the hand-over image go with the back buffers. */
+static void dxgi_vk_swap_chain_fex_ui_destroy(struct dxgi_vk_swap_chain *chain)
+{
+    struct d3d12_device *device = chain->queue->device;
+    unsigned int i;
+
+    for (i = 0; i < DXGI_MAX_SWAP_CHAIN_BUFFERS; i++)
+    {
+        struct vkd3d_fex_ui_frame *frame = &chain->user.fex_ui_frames[i];
+
+        if (chain->user.backbuffers[i] && chain->user.backbuffers[i]->fex_ui_frame == frame)
+            chain->user.backbuffers[i]->fex_ui_frame = NULL;
+        if (frame->vk_image)
+            vkd3d_fex_ui_destroy_image(device, frame->vk_image, frame->vk_view, &frame->memory);
+        memset(frame, 0, sizeof(*frame));
+    }
+    if (chain->user.fex_ui_out)
+        vkd3d_fex_ui_destroy_image(device, chain->user.fex_ui_out, VK_NULL_HANDLE, &chain->user.fex_ui_out_memory);
+    chain->user.fex_ui_out = VK_NULL_HANDLE;
+}
+
+static void dxgi_vk_swap_chain_fex_ui_create(struct dxgi_vk_swap_chain *chain)
+{
+    struct d3d12_device *device = chain->queue->device;
+    struct vkd3d_fex_ui_frame *frame;
+    struct d3d12_resource *resource;
+    unsigned int i;
+
+    if (!device->fex_ui || !chain->desc.BufferCount)
+        return;
+
+    resource = chain->user.backbuffers[0];
+    if (FAILED(vkd3d_fex_ui_create_image(device, chain->desc.Width, chain->desc.Height, resource->format->vk_format,
+            true, &chain->user.fex_ui_out, NULL, &chain->user.fex_ui_out_memory)))
+    {
+        WARN("FEX: no hand-over image, frames go to frame generation as shown.\n");
+        return;
+    }
+    chain->user.fex_ui_out_width = chain->desc.Width;
+    chain->user.fex_ui_out_height = chain->desc.Height;
+
+    for (i = 0; i < chain->desc.BufferCount; i++)
+    {
+        frame = &chain->user.fex_ui_frames[i];
+        resource = chain->user.backbuffers[i];
+        if (FAILED(vkd3d_fex_ui_create_image(device, chain->desc.Width, chain->desc.Height,
+                resource->format->vk_format, false, &frame->vk_image, &frame->vk_view, &frame->memory)))
+        {
+            WARN("FEX: no frame copy for back buffer %u, it goes to frame generation as shown.\n", i);
+            continue;
+        }
+        resource->fex_ui_frame = frame;
+    }
+
+    vkd3d_atomic_uint32_store_explicit(&device->fex_ui->width, chain->desc.Width, vkd3d_memory_order_relaxed);
+    vkd3d_atomic_uint32_store_explicit(&device->fex_ui->height, chain->desc.Height, vkd3d_memory_order_relaxed);
+    INFO("FEX: frames without the UI layer for %u back buffers of %ux%u.\n",
+            chain->desc.BufferCount, chain->desc.Width, chain->desc.Height);
+}
