From d7a368afd666cb15569168ddf4c7712af0df0af8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 30 Oct 2026 14:14:03 +0000
Subject: [PATCH] FEX: each frame also handed to frame generation without the
 game's UI layer

Frame generation guesses motion from the finished frame. D2R's map overlay
and HUD barely move while the world under them does, so the guess smears a
zone around them in every generated frame.

D2R draws its UI into a back-buffer-sized RGBA16F image that starts with a
clear, then mixes it into the back buffer with one 3-vertex draw. With
VKD3D_FEX_UI_SPLIT=1, the first draw of a back buffer's pass, if it is one
3-vertex draw, gets a copy of the back buffer made first, into an image of
its own per back buffer. If that draw doesn't blend over the back buffer,
it is also drawn into that copy with the list's last cleared single-target
pass of the back buffers' size (the UI layer) cleared again; the UI layer
is saved before and put back after. The pass is ended for that and begun
again with LOAD; bound state stays.

Present() notes whether that back buffer got its copy since its last
Present(); the swapchain blit then copies it, or the back buffer itself,
into one hand-over image made with transfer usage only and a one-format
list, which FEX's frame generation layer knows it by, left in GENERAL.

The pass meter report gets an 'ui split' line: presents with the copy and
without, copies made by kind, why none was made, and the composite's blend.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WZVGoVEaHJ78mpf2D3MiER
---
 libs/vkd3d/command.c        | 299 ++++++++++++++++++++++++++++++++++++
 libs/vkd3d/device.c         |   2 +
 libs/vkd3d/fex_pass_meter.c |   3 +
 libs/vkd3d/fex_ui_split.c   | 284 ++++++++++++++++++++++++++++++++++
 libs/vkd3d/meson.build      |   2 +-
 libs/vkd3d/swapchain.c      | 173 +++++++++++++++++++++
 libs/vkd3d/vkd3d_private.h  |  70 +++++++++
 7 files changed, 832 insertions(+), 1 deletion(-)
 create mode 100644 libs/vkd3d/fex_ui_split.c

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index 4cd839c..9186bdc 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -2123,6 +2123,8 @@ static HRESULT d3d12_command_list_begin_command_buffer(struct d3d12_command_list
     list->fex_clears.drawn_count = 0;
     list->fex_memo.count = 0;
     list->fex_memo.pending_count = 0;
+    list->fex_ui.ui_valid = false;
+    list->fex_ui.pending = NULL;
 
     return S_OK;
 }
@@ -5724,6 +5726,9 @@ void d3d12_command_list_end_current_render_pass_line(struct d3d12_command_list *
     if (list->fex_clears.count && !list->fex_clears.keep)
         d3d12_command_list_fex_flush_clears(list, VKD3D_FEX_BIG_CLEAR_MADE_AT_PASS_END, line);
 
+    /* VKD3D fex35: only a back buffer pass's first draw may be the composite. */
+    list->fex_ui.pending = NULL;
+
     d3d12_command_list_handle_active_queries(list, true);
 
 #ifdef VKD3D_ENABLE_PROFILING
@@ -8117,6 +8122,284 @@ static bool d3d12_command_list_fex_ds_store_ops(struct d3d12_command_list *list)
     return split;
 }
 
+/* VKD3D fex35 (VKD3D_FEX_UI_SPLIT, see struct vkd3d_fex_ui_frame): called before a render pass begins (not when a
+ * suspended one resumes). A back buffer pass waits for its first draw; a single-target pass of the back buffers' size
+ * that starts with a clear is taken as the game's UI layer for this list. */
+static void d3d12_command_list_fex_ui_pass_begin(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_ui *ui = list->device->fex_ui;
+    const struct d3d12_rtv_desc *rtv = &list->rtvs[0];
+    uint32_t width, height;
+
+    list->fex_ui.pending = NULL;
+    if (list->rendering_info.rtv_mask != 1u || !rtv->view || !rtv->resource ||
+            d3d12_command_list_has_depth_stencil_view(list) || rtv->sample_count != VK_SAMPLE_COUNT_1_BIT)
+        return;
+
+    if (rtv->resource->fex_ui_frame)
+    {
+        list->fex_ui.pending = rtv->resource;
+        return;
+    }
+
+    width = vkd3d_atomic_uint32_load_explicit(&ui->width, vkd3d_memory_order_relaxed);
+    height = vkd3d_atomic_uint32_load_explicit(&ui->height, vkd3d_memory_order_relaxed);
+    if (!width || rtv->width != width || rtv->height != height || rtv->layer_count != 1 ||
+            list->rendering_info.rtv[0].loadOp != VK_ATTACHMENT_LOAD_OP_CLEAR ||
+            !(rtv->view->format->vk_aspect_mask & VK_IMAGE_ASPECT_COLOR_BIT))
+        return;
+
+    list->fex_ui.ui_image = rtv->resource->res.vk_image;
+    list->fex_ui.ui_layout = d3d12_resource_pick_layout(rtv->resource, rtv->resource->common_layout);
+    list->fex_ui.ui_subresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    list->fex_ui.ui_subresource.mipLevel = rtv->view->info.texture.miplevel_idx;
+    list->fex_ui.ui_subresource.baseArrayLayer = rtv->view->info.texture.layer_idx;
+    list->fex_ui.ui_subresource.layerCount = 1;
+    list->fex_ui.ui_format = rtv->resource->format->vk_format;
+    list->fex_ui.ui_width = rtv->width;
+    list->fex_ui.ui_height = rtv->height;
+    list->fex_ui.ui_clear = list->rendering_info.rtv[0].clearValue.color;
+    list->fex_ui.ui_valid = true;
+}
+
+static void fex_ui_barrier(VkImageMemoryBarrier2 *barrier, VkImage image, const VkImageSubresourceLayers *layers,
+        VkPipelineStageFlags2 src_stage, VkAccessFlags2 src_access, VkPipelineStageFlags2 dst_stage,
+        VkAccessFlags2 dst_access, VkImageLayout old_layout, VkImageLayout new_layout)
+{
+    memset(barrier, 0, sizeof(*barrier));
+    barrier->sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2;
+    barrier->srcStageMask = src_stage;
+    barrier->srcAccessMask = src_access;
+    barrier->dstStageMask = dst_stage;
+    barrier->dstAccessMask = dst_access;
+    barrier->oldLayout = old_layout;
+    barrier->newLayout = new_layout;
+    barrier->srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier->dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier->image = image;
+    barrier->subresourceRange.aspectMask = layers->aspectMask;
+    barrier->subresourceRange.baseMipLevel = layers->mipLevel;
+    barrier->subresourceRange.levelCount = 1;
+    barrier->subresourceRange.baseArrayLayer = layers->baseArrayLayer;
+    barrier->subresourceRange.layerCount = layers->layerCount;
+}
+
+static void fex_ui_barriers(struct d3d12_command_list *list, const VkImageMemoryBarrier2 *barriers, uint32_t count)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    VkDependencyInfo dep_info;
+
+    memset(&dep_info, 0, sizeof(dep_info));
+    dep_info.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+    dep_info.imageMemoryBarrierCount = count;
+    dep_info.pImageMemoryBarriers = barriers;
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &dep_info));
+}
+
+static void fex_ui_copy(struct d3d12_command_list *list, VkImage src, const VkImageSubresourceLayers *src_layers,
+        VkImage dst, const VkImageSubresourceLayers *dst_layers, uint32_t width, uint32_t height)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    VkCopyImageInfo2 copy_info;
+    VkImageCopy2 region;
+
+    memset(&region, 0, sizeof(region));
+    region.sType = VK_STRUCTURE_TYPE_IMAGE_COPY_2;
+    region.srcSubresource = *src_layers;
+    region.dstSubresource = *dst_layers;
+    region.extent.width = width;
+    region.extent.height = height;
+    region.extent.depth = 1;
+
+    memset(&copy_info, 0, sizeof(copy_info));
+    copy_info.sType = VK_STRUCTURE_TYPE_COPY_IMAGE_INFO_2;
+    copy_info.srcImage = src;
+    copy_info.srcImageLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    copy_info.dstImage = dst;
+    copy_info.dstImageLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    copy_info.regionCount = 1;
+    copy_info.pRegions = &region;
+    VK_CALL(vkCmdCopyImage2(list->cmd.vk_command_buffer, &copy_info));
+}
+
+/* VKD3D fex35: the first draw of a back buffer pass, inside the pass, before its vkCmdDraw. If it is the composite
+ * (one 3-vertex draw), the back buffer goes into its frame copy first; if the draw doesn't blend over the back buffer,
+ * it is drawn into that copy too, with the UI layer cleared (saved before, put back after). The pass is ended for
+ * that and begun again with LOAD; bound state stays. */
+static void d3d12_command_list_fex_ui_composite(struct d3d12_command_list *list, uint32_t vertex_count,
+        uint32_t instance_count, uint32_t first_vertex, uint32_t first_instance)
+{
+    const VkPipelineStageFlags2 shader_stages = VK_PIPELINE_STAGE_2_VERTEX_SHADER_BIT |
+            VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT;
+    const VkAccessFlags2 attachment_access = VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT |
+            VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    struct d3d12_resource *backbuffer = list->fex_ui.pending;
+    struct vkd3d_fex_ui_frame *frame = backbuffer->fex_ui_frame;
+    struct d3d12_device *device = list->device;
+    const VkPipelineColorBlendAttachmentState *blend;
+    VkCommandBuffer cmd = list->cmd.vk_command_buffer;
+    VkImageSubresourceLayers whole, ui_layers;
+    VkRenderingAttachmentInfo attachment;
+    VkImageMemoryBarrier2 barriers[4];
+    VkImageLayout backbuffer_layout;
+    VkAttachmentLoadOp load_op;
+    VkRenderingInfo rendering;
+    VkClearColorValue clear;
+    VkImageSubresourceRange range;
+    VkImage save = VK_NULL_HANDLE;
+    uint32_t width, height;
+    bool redraw;
+
+    list->fex_ui.pending = NULL;
+    if (vertex_count != 3 || instance_count != 1 || list->predication.fallback_enabled ||
+            list->active_queries_count || list->xfb_buffer_count || !list->state ||
+            list->rendering_info.info.colorAttachmentCount < 1)
+    {
+        vkd3d_fex_ui_event(device, VKD3D_FEX_UI_OTHER_DRAW);
+        return;
+    }
+    blend = &list->state->graphics.blend_attachments[0];
+    vkd3d_atomic_uint32_store_explicit(&device->fex_ui->blend, 1u + ((blend->blendEnable ? 1u : 0u) |
+            ((uint32_t)blend->srcColorBlendFactor << 8) | ((uint32_t)blend->dstColorBlendFactor << 16)),
+            vkd3d_memory_order_relaxed);
+    /* Blending over what the back buffer holds: that is the frame without the UI layer. Else the draw is made again
+     * with the UI layer cleared, which needs to know the UI layer. */
+    redraw = !blend->blendEnable || blend->dstColorBlendFactor == VK_BLEND_FACTOR_ZERO;
+    if (redraw && !list->fex_ui.ui_valid)
+    {
+        vkd3d_fex_ui_event(device, VKD3D_FEX_UI_NO_UI);
+        return;
+    }
+
+    if (redraw && !(save = vkd3d_fex_ui_save_image(device, list->fex_ui.ui_format,
+            list->fex_ui.ui_width, list->fex_ui.ui_height)))
+    {
+        vkd3d_fex_ui_event(device, VKD3D_FEX_UI_NO_SAVE);
+        return;
+    }
+
+    width = backbuffer->desc.Width;
+    height = backbuffer->desc.Height;
+    backbuffer_layout = list->rendering_info.rtv[0].imageLayout;
+    whole.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    whole.mipLevel = 0;
+    whole.baseArrayLayer = 0;
+    whole.layerCount = 1;
+    ui_layers = list->fex_ui.ui_subresource;
+
+    VK_CALL(vkCmdEndRendering(cmd));
+
+    fex_ui_barrier(&barriers[0], backbuffer->res.vk_image, &whole,
+            VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT,
+            VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT,
+            backbuffer_layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    /* The last swapchain blit of this copy may still read it. */
+    fex_ui_barrier(&barriers[1], frame->vk_image, &whole,
+            VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, 0, VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+            VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    if (redraw)
+    {
+        fex_ui_barrier(&barriers[2], list->fex_ui.ui_image, &ui_layers,
+                VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, VK_ACCESS_2_MEMORY_WRITE_BIT,
+                VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT,
+                list->fex_ui.ui_layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+        fex_ui_barrier(&barriers[3], save, &whole,
+                VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, 0, VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    }
+    fex_ui_barriers(list, barriers, redraw ? 4 : 2);
+
+    fex_ui_copy(list, backbuffer->res.vk_image, &whole, frame->vk_image, &whole, width, height);
+
+    if (redraw)
+    {
+        fex_ui_copy(list, list->fex_ui.ui_image, &ui_layers, save, &whole,
+                list->fex_ui.ui_width, list->fex_ui.ui_height);
+
+        fex_ui_barrier(&barriers[0], list->fex_ui.ui_image, &ui_layers,
+                VK_PIPELINE_STAGE_2_COPY_BIT, 0, VK_PIPELINE_STAGE_2_CLEAR_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+        fex_ui_barrier(&barriers[1], frame->vk_image, &whole,
+                VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, attachment_access,
+                VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+        fex_ui_barriers(list, barriers, 2);
+
+        clear = list->fex_ui.ui_clear;
+        range.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+        range.baseMipLevel = ui_layers.mipLevel;
+        range.levelCount = 1;
+        range.baseArrayLayer = ui_layers.baseArrayLayer;
+        range.layerCount = 1;
+        VK_CALL(vkCmdClearColorImage(cmd, list->fex_ui.ui_image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                &clear, 1, &range));
+
+        fex_ui_barrier(&barriers[0], list->fex_ui.ui_image, &ui_layers,
+                VK_PIPELINE_STAGE_2_CLEAR_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                shader_stages, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT | VK_ACCESS_2_SHADER_STORAGE_READ_BIT,
+                VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, list->fex_ui.ui_layout);
+        fex_ui_barriers(list, barriers, 1);
+
+        memset(&attachment, 0, sizeof(attachment));
+        attachment.sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO;
+        attachment.imageView = frame->vk_view;
+        attachment.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        attachment.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        memset(&rendering, 0, sizeof(rendering));
+        rendering.sType = VK_STRUCTURE_TYPE_RENDERING_INFO;
+        rendering.renderArea = list->rendering_info.info.renderArea;
+        rendering.layerCount = 1;
+        rendering.colorAttachmentCount = 1;
+        rendering.pColorAttachments = &attachment;
+        VK_CALL(vkCmdBeginRendering(cmd, &rendering));
+        VK_CALL(vkCmdDraw(cmd, vertex_count, instance_count, first_vertex, first_instance));
+        VK_CALL(vkCmdEndRendering(cmd));
+
+        fex_ui_barrier(&barriers[0], frame->vk_image, &whole,
+                VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT,
+                VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT,
+                VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+        fex_ui_barrier(&barriers[1], list->fex_ui.ui_image, &ui_layers,
+                shader_stages, 0, VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                list->fex_ui.ui_layout, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+        fex_ui_barrier(&barriers[2], save, &whole,
+                VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT,
+                VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+        fex_ui_barriers(list, barriers, 3);
+
+        fex_ui_copy(list, save, &whole, list->fex_ui.ui_image, &ui_layers,
+                list->fex_ui.ui_width, list->fex_ui.ui_height);
+
+        fex_ui_barrier(&barriers[0], list->fex_ui.ui_image, &ui_layers,
+                VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT,
+                VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, list->fex_ui.ui_layout);
+    }
+    else
+    {
+        fex_ui_barrier(&barriers[0], frame->vk_image, &whole,
+                VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT,
+                VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    }
+    fex_ui_barrier(&barriers[1], backbuffer->res.vk_image, &whole,
+            VK_PIPELINE_STAGE_2_COPY_BIT, 0, VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, attachment_access,
+            VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, backbuffer_layout);
+    fex_ui_barriers(list, barriers, 2);
+
+    /* The game's pass again: what it held is in the image now. */
+    load_op = list->rendering_info.rtv[0].loadOp;
+    list->rendering_info.rtv[0].loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+    VK_CALL(vkCmdBeginRendering(cmd, &list->rendering_info.info));
+    list->rendering_info.rtv[0].loadOp = load_op;
+
+    vkd3d_atomic_uint32_store_explicit(&frame->captured, 1u, vkd3d_memory_order_release);
+    vkd3d_fex_ui_event(device, redraw ? VKD3D_FEX_UI_CAPTURE_REDRAW : VKD3D_FEX_UI_CAPTURE_COPY);
+}
+
 static bool d3d12_command_list_begin_render_pass(struct d3d12_command_list *list,
         enum vkd3d_pipeline_type pipeline_type)
 {
@@ -8199,6 +8482,10 @@ static bool d3d12_command_list_begin_render_pass(struct d3d12_command_list *list
             list->rendering_info.dsv.storeOp == VK_ATTACHMENT_STORE_OP_DONT_CARE))
         d3d12_command_list_fex_memo_dirty(list, list->dsv.resource);
 
+    /* VKD3D fex35: the UI layer's pass, or the back buffer's (its first draw may be the composite). */
+    if (list->device->fex_ui && fex_pass_kind != VKD3D_FEX_PASS_KIND_RESUMED)
+        d3d12_command_list_fex_ui_pass_begin(list);
+
     d3d12_command_list_debug_mark_begin_region(list, "RenderPass");
     VK_CALL(vkCmdBeginRendering(list->cmd.vk_command_buffer, &list->rendering_info.info));
     vkd3d_fex_pass_meter_inside_pass(list);
@@ -8528,6 +8815,11 @@ static void STDMETHODCALLTYPE d3d12_command_list_DrawInstanced(d3d12_command_lis
 
     list->cmd.estimated_cost += VKD3D_COMMAND_COST_HIGH;
 
+    /* VKD3D fex35: the back buffer pass's first draw may be the game's composite of scene and UI layer. */
+    if (list->fex_ui.pending)
+        d3d12_command_list_fex_ui_composite(list, vertex_count_per_instance, instance_count,
+                start_vertex_location, start_instance_location);
+
     if (!list->predication.fallback_enabled)
     {
         VK_CALL(vkCmdDraw(list->cmd.vk_command_buffer, vertex_count_per_instance,
@@ -8619,6 +8911,13 @@ static void STDMETHODCALLTYPE d3d12_command_list_DrawIndexedInstanced(d3d12_comm
 
     list->cmd.estimated_cost += VKD3D_COMMAND_COST_HIGH;
 
+    /* VKD3D fex35: the game's composite is one non-indexed draw. */
+    if (list->fex_ui.pending)
+    {
+        list->fex_ui.pending = NULL;
+        vkd3d_fex_ui_event(list->device, VKD3D_FEX_UI_OTHER_DRAW);
+    }
+
     d3d12_command_list_check_index_buffer_strip_cut_value(list);
 
     if (!list->predication.fallback_enabled)
diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index b8ac8b9..9d9c80a 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -4292,6 +4292,7 @@ static void d3d12_device_destroy(struct d3d12_device *device)
 #endif
     vkd3d_fex_pass_meter_deinit(device->fex_pass_meter);
     vkd3d_fex_clear_memo_cleanup(device);
+    vkd3d_fex_ui_cleanup(device);
 #ifdef VKD3D_ENABLE_BREADCRUMBS
