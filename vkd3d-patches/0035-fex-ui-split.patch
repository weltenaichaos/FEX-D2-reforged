+    if (chain->user.fex_ui_out_width != backbuffer->desc.Width ||
+            chain->user.fex_ui_out_height != backbuffer->desc.Height)
+        return;
+
+    split = chain->request.fex_ui_split && frame && frame->vk_image;
+    backbuffer_layout = d3d12_resource_pick_layout(backbuffer, backbuffer->common_layout);
+
+    memset(barriers, 0, sizeof(barriers));
+    for (i = 0; i < ARRAY_SIZE(barriers); i++)
+    {
+        barriers[i].sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2;
+        barriers[i].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        barriers[i].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        barriers[i].subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+        barriers[i].subresourceRange.levelCount = 1;
+        barriers[i].subresourceRange.layerCount = 1;
+    }
+    /* The game's command lists wrote the frame copy (or the back buffer) in earlier submits. */
+    barriers[0].srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    barriers[0].srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT;
+    barriers[0].dstStageMask = VK_PIPELINE_STAGE_2_COPY_BIT;
+    barriers[0].dstAccessMask = VK_ACCESS_2_TRANSFER_READ_BIT;
+    barriers[0].image = split ? frame->vk_image : backbuffer->res.vk_image;
+    barriers[0].oldLayout = split ? VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL : backbuffer_layout;
+    barriers[0].newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    /* The layer's last read of the hand-over image was in an earlier submit too. */
+    barriers[1].srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    barriers[1].dstStageMask = VK_PIPELINE_STAGE_2_COPY_BIT;
+    barriers[1].dstAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    barriers[1].image = chain->user.fex_ui_out;
+    barriers[1].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    barriers[1].newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+
+    memset(&dep_info, 0, sizeof(dep_info));
+    dep_info.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+    dep_info.imageMemoryBarrierCount = 2;
+    dep_info.pImageMemoryBarriers = barriers;
+    VK_CALL(vkCmdPipelineBarrier2(vk_cmd, &dep_info));
+
+    memset(&region, 0, sizeof(region));
+    region.sType = VK_STRUCTURE_TYPE_IMAGE_COPY_2;
+    region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.srcSubresource.layerCount = 1;
+    region.dstSubresource = region.srcSubresource;
+    region.extent.width = backbuffer->desc.Width;
+    region.extent.height = backbuffer->desc.Height;
+    region.extent.depth = 1;
+    memset(&copy_info, 0, sizeof(copy_info));
+    copy_info.sType = VK_STRUCTURE_TYPE_COPY_IMAGE_INFO_2;
+    copy_info.srcImage = barriers[0].image;
+    copy_info.srcImageLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    copy_info.dstImage = chain->user.fex_ui_out;
+    copy_info.dstImageLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    copy_info.regionCount = 1;
+    copy_info.pRegions = &region;
+    VK_CALL(vkCmdCopyImage2(vk_cmd, &copy_info));
+
+    /* The frame copy stays in TRANSFER_SRC (its next copy starts from UNDEFINED); the back buffer goes back. */
+    barriers[0].srcStageMask = VK_PIPELINE_STAGE_2_COPY_BIT;
+    barriers[0].srcAccessMask = 0;
+    barriers[0].dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    barriers[0].dstAccessMask = 0;
+    barriers[0].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    barriers[0].newLayout = split ? VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL : backbuffer_layout;
+    barriers[1].srcStageMask = VK_PIPELINE_STAGE_2_COPY_BIT;
+    barriers[1].srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    barriers[1].dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    barriers[1].dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT;
+    barriers[1].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    barriers[1].newLayout = VK_IMAGE_LAYOUT_GENERAL;
+    VK_CALL(vkCmdPipelineBarrier2(vk_cmd, &dep_info));
+
+    vkd3d_fex_ui_event(chain->queue->device, split ? VKD3D_FEX_UI_PRESENT_SPLIT : VKD3D_FEX_UI_PRESENT_PLAIN);
+}
