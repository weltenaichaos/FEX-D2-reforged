+/* VKD3D fex35: the hand-over image gets this Present()'s frame without the UI layer, or the back buffer itself when
+ * none was made, and is left in GENERAL. The frame generation layer reads it in its own submit after this one, which
+ * waits on this blit's release semaphore. */
+static void dxgi_vk_swap_chain_fex_ui_hand_over(struct dxgi_vk_swap_chain *chain, VkCommandBuffer vk_cmd,
