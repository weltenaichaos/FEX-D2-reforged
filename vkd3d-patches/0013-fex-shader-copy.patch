+/* FEX shader copy (fex_shader_copy.c, VKD3D fex13): VKD3D_FEX_SHADER_COPY lists pixel shaders by their D3D bytecode
+ * hash (16 hex digits, comma separated, costliest first). Their D3D bytecode, the PSO around them (vertex shader,
+ * targets, root signature) and, for the first VKD3D_FEX_SHADER_COPY_FULL of them, the SPIR-V and the driver's compiled
+ * code go into memory blocks FEX's stats log copies out (export vkd3d_fex_shader_copy). Nothing else changes. */
+#define VKD3D_FEX_SHADER_COPY_MAX 128u
+#define VKD3D_FEX_SHADER_COPY_FULL 4u
+enum vkd3d_fex_shader_copy_kind
+{
+    VKD3D_FEX_COPY_DEVICE = 1,   /* text: device, driver and descriptor model */
+    VKD3D_FEX_COPY_PS_DXBC = 2,  /* binary: the pixel shader's D3D bytecode */
+    VKD3D_FEX_COPY_STAGE_DXBC = 3, /* binary: another stage's D3D bytecode (other = its hash, stage = its stage) */
+    VKD3D_FEX_COPY_PS_SPIRV = 4, /* binary: the SPIR-V vkd3d gave the driver */
+    VKD3D_FEX_COPY_CODE = 5,     /* text: the driver's compiled code of one executable (stage = its stages; the first
+                                  * line names the executable and the representation) */
+    VKD3D_FEX_COPY_STATS = 6,    /* text: the driver's statistics of one executable (stage = its stages) */
+    VKD3D_FEX_COPY_PSO = 7,      /* text: vertex shader, targets, depth, blend, root signature mapping */
+    VKD3D_FEX_COPY_ROOT_SIG = 8, /* binary: the serialized D3D12 root signature (other = its compatibility hash) */
+    VKD3D_FEX_COPY_NOTE = 9,     /* text: why something could not be copied */
+};
+struct vkd3d_fex_shader_blob
+{
+    uint64_t hash;  /* pixel shader the entry belongs to, 0 for device info */
+    uint64_t other; /* see the kinds */
+    uint32_t kind;
+    uint32_t rank;  /* position in VKD3D_FEX_SHADER_COPY, 1 = first; 0 for device info */
+    uint32_t size;
+    uint32_t stage; /* VkShaderStageFlags the entry is about, 0 when not about one stage */
+    uint64_t data;  /* address of size bytes; never freed */
+};
