+    uint32_t listed;         /* how many hashes VKD3D_FEX_SHADER_COPY named */
+    uint32_t dropped;        /* entries not copied because the table or the byte budget was full */
+    struct vkd3d_fex_shader_blob blobs[VKD3D_FEX_SHADER_COPY_MAX];
+};
