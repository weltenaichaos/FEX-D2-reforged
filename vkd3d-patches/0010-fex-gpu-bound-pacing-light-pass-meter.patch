+    uint32_t frame;
+
+    if (!meter)
+        return VKD3D_FEX_PASS_FRAME_OFF;
+    /* The frame the command lists begun since the last Present() belong to. */
+    frame = vkd3d_atomic_uint32_increment(&meter->frame, vkd3d_memory_order_relaxed) - 1;
