+/* GPU-bound pacing (VKD3D fex10). When the GPU is what limits the frame rate (fights), most frames' spare time comes
+ * from the GPU still being busy with the frame before. A frame held back too long there doesn't miss a slot of a frame
+ * cap: the GPU waits for it about as long as it came late, and the frame is that much longer (2 ms late: 36 instead of
+ * 34 ms). Up to fex9 such a frame still halved the hold-back, added 3 ms margin and kept it from growing for 60 frames.
+ * In the fex9 log fights then held back 4 ms on average while their frames had 20-22 ms of spare time (11-16 ms at the
+ * least in each second), and took 62-76 ms from frame start to the screen. GPU-bound pacing aims at the 7th smallest
+ * spare time of the last 64 frames instead of the smallest (the smallest few are frames where the game itself took
+ * longer), takes off what a late frame came late by and 1 ms more, adds 1 ms margin, has no near-late rule and grows
+ * again after 15 frames by up to 0.5 ms per frame. Replayed on spare times like the fights', it holds back 4-5 ms more
+ * for a few hundredths of a ms more GPU waiting per frame. */
+#define FEX_START_BUSY_FRAMES 48u          /* of the last 64 frames with spare time from a busy GPU: GPU-bound */
+#define FEX_START_BUSY_RANK 7u             /* aim at this smallest spare time of the last 64 frames */
+#define FEX_START_BUSY_MARGIN_UP_NS 1000000ll
+#define FEX_START_BUSY_LATE_EXTRA_NS 1000000ll
+#define FEX_START_BUSY_CALM_FRAMES 15u
+#define FEX_START_BUSY_STEP_NS 500000ll
+
 /* Frame start pacing, run by the wait worker when a frame is done: works out how much later this frame could have
  * started without reaching the screen later, updates the hold-back and schedules the release of the frame latency
  * handle (the game's next frame start) after it. */
@@ -3656,10 +3677,11 @@ static void dxgi_vk_swap_chain_fex_start_frame_done(struct dxgi_vk_swap_chain *c
         const struct fex_frame_times *fex)
 {
