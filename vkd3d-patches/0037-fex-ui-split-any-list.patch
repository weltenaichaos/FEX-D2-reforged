From 3b32ae167f33adc42cdd5ecbd8337707b11df813 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 30 Oct 2026 16:01:01 +0000
Subject: [PATCH] FEX: UI split finds the UI layer pass in any command list

In the FEX build 123 run (VKD3D fex36) the composite was taken every
frame (blend off, so drawn again with the UI layer cleared) but its
command list never held the UI layer's pass: "no cleared full-size pass
before the back buffer's" 30 a second, so still no frame was made without
the UI layer.

The UI layer pass found by any list is now also kept for the device (under
the UI split mutex) and a composite whose own list has none uses it; the
record is dropped when its image is destroyed. Targets bound without a
view no longer count as other targets. The 'ui split' line counts every
back-buffer-sized pass: taken, or not taken by reason (other targets,
depth, multisampled, layers, no clear, not color, resumed), and the
captures whose UI layer came from another list.
---
 libs/vkd3d/command.c       | 103 +++++++++++++++++++++++--------------
 libs/vkd3d/fex_ui_split.c  |  52 ++++++++++++++++---
 libs/vkd3d/resource.c      |   4 ++
 libs/vkd3d/vkd3d_private.h |  34 +++++++++---
 4 files changed, 140 insertions(+), 53 deletions(-)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index c57db99..6fb2f43 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -8124,42 +8124,59 @@ static bool d3d12_command_list_fex_ds_store_ops(struct d3d12_command_list *list)
 
 /* VKD3D fex35 (VKD3D_FEX_UI_SPLIT, see struct vkd3d_fex_ui_frame): called before a render pass begins (not when a
  * suspended one resumes). A back buffer pass waits for its first draw; a single-target pass of the back buffers' size
- * that starts with a clear is taken as the game's UI layer for this list. */
-static void d3d12_command_list_fex_ui_pass_begin(struct d3d12_command_list *list)
+ * that starts with a clear is taken as the game's UI layer for this list. fex37: and for the device, since in the
+ * build 123 run the composite's list never held that pass (every frame "no cleared full-size pass before"); targets
+ * bound without a view no longer count, and each back-buffer-sized pass not taken counts under its reason. */
+static void d3d12_command_list_fex_ui_pass_begin(struct d3d12_command_list *list, bool resumed)
 {
     struct vkd3d_fex_ui *ui = list->device->fex_ui;
     const struct d3d12_rtv_desc *rtv = &list->rtvs[0];
-    uint32_t width, height;
+    enum vkd3d_fex_ui_event reason;
+    uint32_t width, height, i;
+    bool others = false;
 
     list->fex_ui.pending = NULL;
-    if (list->rendering_info.rtv_mask != 1u || !rtv->view || !rtv->resource ||
-            d3d12_command_list_has_depth_stencil_view(list) || rtv->sample_count != VK_SAMPLE_COUNT_1_BIT)
+    if (!(list->rendering_info.rtv_mask & 1u) || !rtv->view || !rtv->resource)
         return;
+    for (i = 1; i < D3D12_SIMULTANEOUS_RENDER_TARGET_COUNT; i++)
+        others |= (list->rendering_info.rtv_mask & (1u << i)) && list->rtvs[i].view;
 
     if (rtv->resource->fex_ui_frame)
     {
-        list->fex_ui.pending = rtv->resource;
+        if (!resumed && !others && !d3d12_command_list_has_depth_stencil_view(list) &&
+                rtv->sample_count == VK_SAMPLE_COUNT_1_BIT)
+            list->fex_ui.pending = rtv->resource;
         return;
     }
 
     width = vkd3d_atomic_uint32_load_explicit(&ui->width, vkd3d_memory_order_relaxed);
     height = vkd3d_atomic_uint32_load_explicit(&ui->height, vkd3d_memory_order_relaxed);
-    if (!width || rtv->width != width || rtv->height != height || rtv->layer_count != 1 ||
-            list->rendering_info.rtv[0].loadOp != VK_ATTACHMENT_LOAD_OP_CLEAR ||
-            !(rtv->view->format->vk_aspect_mask & VK_IMAGE_ASPECT_COLOR_BIT))
+    if (!width || rtv->width != width || rtv->height != height)
+        return;
+    reason = resumed ? VKD3D_FEX_UI_PASS_RESUMED :
+            others ? VKD3D_FEX_UI_PASS_TARGETS :
+            d3d12_command_list_has_depth_stencil_view(list) ? VKD3D_FEX_UI_PASS_DEPTH :
+            rtv->sample_count != VK_SAMPLE_COUNT_1_BIT ? VKD3D_FEX_UI_PASS_SAMPLES :
+            rtv->layer_count != 1 ? VKD3D_FEX_UI_PASS_LAYERS :
+            list->rendering_info.rtv[0].loadOp != VK_ATTACHMENT_LOAD_OP_CLEAR ? VKD3D_FEX_UI_PASS_NOT_CLEARED :
+            !(rtv->view->format->vk_aspect_mask & VK_IMAGE_ASPECT_COLOR_BIT) ? VKD3D_FEX_UI_PASS_FORMAT :
+            VKD3D_FEX_UI_PASS_TAKEN;
+    vkd3d_fex_ui_event(list->device, reason);
+    if (reason != VKD3D_FEX_UI_PASS_TAKEN)
         return;
 
-    list->fex_ui.ui_image = rtv->resource->res.vk_image;
-    list->fex_ui.ui_layout = d3d12_resource_pick_layout(rtv->resource, rtv->resource->common_layout);
-    list->fex_ui.ui_subresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
-    list->fex_ui.ui_subresource.mipLevel = rtv->view->info.texture.miplevel_idx;
-    list->fex_ui.ui_subresource.baseArrayLayer = rtv->view->info.texture.layer_idx;
-    list->fex_ui.ui_subresource.layerCount = 1;
-    list->fex_ui.ui_format = rtv->resource->format->vk_format;
-    list->fex_ui.ui_width = rtv->width;
-    list->fex_ui.ui_height = rtv->height;
-    list->fex_ui.ui_clear = list->rendering_info.rtv[0].clearValue.color;
+    list->fex_ui.ui.image = rtv->resource->res.vk_image;
+    list->fex_ui.ui.layout = d3d12_resource_pick_layout(rtv->resource, rtv->resource->common_layout);
+    list->fex_ui.ui.subresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    list->fex_ui.ui.subresource.mipLevel = rtv->view->info.texture.miplevel_idx;
+    list->fex_ui.ui.subresource.baseArrayLayer = rtv->view->info.texture.layer_idx;
+    list->fex_ui.ui.subresource.layerCount = 1;
+    list->fex_ui.ui.format = rtv->resource->format->vk_format;
+    list->fex_ui.ui.width = rtv->width;
+    list->fex_ui.ui.height = rtv->height;
+    list->fex_ui.ui.clear = list->rendering_info.rtv[0].clearValue.color;
     list->fex_ui.ui_valid = true;
+    vkd3d_fex_ui_layer_set(list->device, &list->fex_ui.ui);
 }
 
 static void fex_ui_barrier(VkImageMemoryBarrier2 *barrier, VkImage image, const VkImageSubresourceLayers *layers,
@@ -8250,7 +8267,7 @@ static void d3d12_command_list_fex_ui_composite(struct d3d12_command_list *list,
     VkImage save = VK_NULL_HANDLE;
     enum vkd3d_fex_ui_event other;
     uint32_t width, height;
-    bool redraw, queries;
+    bool redraw, queries, other_list;
 
     list->fex_ui.pending = NULL;
     /* fex36: in the build 122 run every back buffer pass's first draw (3 vertices or indices, one instance on the pass
@@ -8275,14 +8292,18 @@ static void d3d12_command_list_fex_ui_composite(struct d3d12_command_list *list,
