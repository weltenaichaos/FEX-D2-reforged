diff --git a/libs/vkd3d/fex_ui_split.c b/libs/vkd3d/fex_ui_split.c
index b9282af..342afc6 100644
--- a/libs/vkd3d/fex_ui_split.c
+++ b/libs/vkd3d/fex_ui_split.c
@@ -55,6 +55,40 @@ void vkd3d_fex_ui_event(struct d3d12_device *device, enum vkd3d_fex_ui_event eve
         vkd3d_atomic_uint32_increment(&device->fex_ui->events[event], vkd3d_memory_order_relaxed);
 }
 
+void vkd3d_fex_ui_layer_set(struct d3d12_device *device, const struct vkd3d_fex_ui_layer *layer)
+{
+    struct vkd3d_fex_ui *ui = device->fex_ui;
+
+    pthread_mutex_lock(&ui->mutex);
+    ui->layer = *layer;
+    pthread_mutex_unlock(&ui->mutex);
+}
+
+bool vkd3d_fex_ui_layer_get(struct d3d12_device *device, struct vkd3d_fex_ui_layer *layer)
+{
+    struct vkd3d_fex_ui *ui = device->fex_ui;
+    bool found;
+
+    pthread_mutex_lock(&ui->mutex);
+    found = ui->layer.image != VK_NULL_HANDLE;
+    if (found)
+        *layer = ui->layer;
+    pthread_mutex_unlock(&ui->mutex);
+    return found;
+}
+
+void vkd3d_fex_ui_forget_image(struct d3d12_device *device, VkImage image)
+{
+    struct vkd3d_fex_ui *ui = device->fex_ui;
+
+    if (!ui || image == VK_NULL_HANDLE)
+        return;
+    pthread_mutex_lock(&ui->mutex);
+    if (ui->layer.image == image)
+        memset(&ui->layer, 0, sizeof(ui->layer));
+    pthread_mutex_unlock(&ui->mutex);
+}
+
 HRESULT vkd3d_fex_ui_create_image(struct d3d12_device *device, uint32_t width, uint32_t height, VkFormat format,
         bool hand_over, VkImage *image, VkImageView *view, struct vkd3d_device_memory_allocation *memory)
 {
@@ -267,14 +301,20 @@ size_t vkd3d_fex_ui_report(struct d3d12_device *device, char *text, size_t size,
     other = vkd3d_atomic_uint32_load_explicit(&ui->other, vkd3d_memory_order_relaxed);
 
     len = vkd3d_fex_report_append(text, size, len,
-            "  ui split (VKD3D fex36: each frame also handed to frame generation without the game's UI layer): presents"
+            "  ui split (VKD3D fex37: each frame also handed to frame generation without the game's UI layer): presents"
             " with it %u, as shown %u | made: copy before a composite that blends %u, composite drawn again with the UI"
-            " layer cleared %u (indexed %u, with the game's queries paused %u) | not made: no cleared full-size pass"
-            " before the back buffer's %u, its first draw: not 3 vertices %u, instanced %u, predicated %u, stream"
-            " output %u, no pipeline or target %u, no save image %u",
+            " layer cleared %u (UI layer pass in another list %u, indexed %u, with the game's queries paused %u) |"
+            " back-buffer-sized passes: taken as the UI layer %u, not taken: other targets %u, depth %u,"
+            " multisampled %u, layers %u, no clear %u, not color %u, resumed %u | not made: no UI layer known %u,"
+            " its first draw: not 3 vertices %u, instanced %u, predicated %u, stream output %u, no pipeline or"
+            " target %u, no save image %u",
             events[VKD3D_FEX_UI_PRESENT_SPLIT], events[VKD3D_FEX_UI_PRESENT_PLAIN],
-            events[VKD3D_FEX_UI_CAPTURE_COPY], events[VKD3D_FEX_UI_CAPTURE_REDRAW], events[VKD3D_FEX_UI_CAPTURE_INDEXED],
-            events[VKD3D_FEX_UI_CAPTURE_QUERIES], events[VKD3D_FEX_UI_NO_UI], events[VKD3D_FEX_UI_OTHER_COUNT],
+            events[VKD3D_FEX_UI_CAPTURE_COPY], events[VKD3D_FEX_UI_CAPTURE_REDRAW],
+            events[VKD3D_FEX_UI_LAYER_OTHER_LIST], events[VKD3D_FEX_UI_CAPTURE_INDEXED],
+            events[VKD3D_FEX_UI_CAPTURE_QUERIES], events[VKD3D_FEX_UI_PASS_TAKEN], events[VKD3D_FEX_UI_PASS_TARGETS],
+            events[VKD3D_FEX_UI_PASS_DEPTH], events[VKD3D_FEX_UI_PASS_SAMPLES], events[VKD3D_FEX_UI_PASS_LAYERS],
+            events[VKD3D_FEX_UI_PASS_NOT_CLEARED], events[VKD3D_FEX_UI_PASS_FORMAT], events[VKD3D_FEX_UI_PASS_RESUMED],
+            events[VKD3D_FEX_UI_NO_UI], events[VKD3D_FEX_UI_OTHER_COUNT],
             events[VKD3D_FEX_UI_OTHER_INSTANCES], events[VKD3D_FEX_UI_OTHER_PREDICATED], events[VKD3D_FEX_UI_OTHER_XFB],
             events[VKD3D_FEX_UI_OTHER_STATE], events[VKD3D_FEX_UI_NO_SAVE]);
     if (other)
diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index 2711959..29411f2 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -3717,6 +3717,10 @@ static void d3d12_resource_destroy(struct d3d12_resource *resource, struct d3d12
             vkd3d_va_map_remove(&device->memory_allocator.va_map, &resource->res);
     }
 
+    /* VKD3D fex37: a UI layer remembered for the device must not outlive its image. */
+    if (d3d12_resource_is_texture(resource) && device->fex_ui)
+        vkd3d_fex_ui_forget_image(device, resource->res.vk_image);
+
     if (d3d12_resource_is_texture(resource))
         VK_CALL(vkDestroyImage(device->vk_device, resource->res.vk_image, NULL));
     else if (resource->flags & VKD3D_RESOURCE_RESERVED)
