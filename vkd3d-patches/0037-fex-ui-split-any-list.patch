-        d3d12_command_list_fex_ui_pass_begin(list);
+    if (list->device->fex_ui)
+        d3d12_command_list_fex_ui_pass_begin(list, fex_pass_kind == VKD3D_FEX_PASS_KIND_RESUMED);
 
