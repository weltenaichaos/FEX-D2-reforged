+            uint32_t anchor_left;   /* presents left without pre-sleep to measure the grid again */
+            uint64_t due_ns;        /* when the last present came out, or would have on the cap's grid */
+            uint64_t last_end_ns;
+            uint64_t step_ns;       /* the cap's period: median of the last intervals between held presents */
+            uint64_t intervals_ns[15];
+            uint32_t interval_pos;
+            uint32_t interval_count;
+        } fex_presleep;
     } present;
 
     struct dxgi_vk_swap_chain_present_request request, request_ring[DXGI_MAX_SWAP_CHAIN_BUFFERS];
@@ -257,6 +294,53 @@ struct dxgi_vk_swap_chain
         bool supports_present_wait;
         bool skip_waits;
     } wait_thread;
+
+    /* FEX frame start pacing (VKD3D_FEX_FRAME_START=1). When something after vkd3d holds each frame back (a frame
+     * limiter sleeping in vkQueuePresentKHR, a queue thread still busy with the last present), the game's frames wait
+     * for it after the game is done with them, and the game reads input that much earlier than needed. The wait
+     * worker measures per frame how much later the frame could have started without reaching the screen later (time
+     * its present waited for the queue thread, plus the smaller of the time vkQueuePresentKHR held it and the time
+     * the GPU finished the frame before vkQueuePresentKHR returned), and holds back the game's frame latency release
+     * by the smallest of that over the last frames minus a margin. A separate thread does the held-back releases, so
+     * the wait worker keeps timing presents. */
+    struct
+    {
+        bool enable;
+        bool thread_started;
+        pthread_t thread;
+        pthread_mutex_t lock;
+        pthread_cond_t cond;
+        bool locks_initialized;
+        uint64_t release_ns[16];   /* when to release */
+        uint64_t release_base_ns[16]; /* when the release would have happened without pacing */
+        uint32_t head;
+        uint32_t count;
+        bool stop;
+        uint64_t last_scheduled_ns;
+
+        /* GPU watcher thread: notes when each frame's copy into the swapchain image finished on the GPU. The wait
+         * worker only sees a frame after vkQueuePresentKHR returned, too late to tell how much earlier the GPU was done. */
+        bool gpu_thread_started;
+        pthread_t gpu_thread;
+        pthread_mutex_t gpu_lock;
+        pthread_cond_t gpu_cond;
+        uint64_t gpu_target;
+        bool gpu_stop;
+        uint64_t gpu_done_value[16];
+        uint64_t gpu_done_ns[16];
+
+        /* Wait worker only. */
+        uint64_t margin_ns;     /* kept free below the smallest spare time; grows when frames come late */
+        uint32_t quiet_frames;  /* frames since the last late one or the last margin shrink */
+        uint64_t delay_ns;
+        int64_t spare_ns[64];
+        uint32_t spare_pos;
+        uint32_t spare_count;
+        uint32_t calm_frames;
+
+        /* Written by the release thread, read in Present(). */
+        UINT64 last_release_delay_ns;
+    } fex_start;
 };
 
