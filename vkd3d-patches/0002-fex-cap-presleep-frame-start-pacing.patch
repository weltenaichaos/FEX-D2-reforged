+void vkd3d_fex_timeline_cap(bool presleep, bool held_long, bool not_held, bool anchored, bool active, uint64_t step_ns,
+        uint64_t guard_ns)
+{
+    if (!vkd3d_fex_timeline_on)
+        return;
+    spinlock_acquire(&fex_timeline.lock);
+    fex_timeline.cap_presents++;
+    if (presleep)
+        fex_timeline.cap_presleeps++;
+    if (held_long)
+        fex_timeline.cap_held_long++;
+    if (not_held)
+        fex_timeline.cap_not_held++;
+    if (anchored)
+        fex_timeline.cap_anchored++;
+    fex_timeline.cap_active = active;
+    fex_timeline.cap_step_ns = step_ns;
+    fex_timeline.cap_guard_ns = guard_ns;
+    spinlock_release(&fex_timeline.lock);
+}
+
+void vkd3d_fex_timeline_pacing(uint64_t delay_ns, uint64_t margin_ns, int64_t spare_ns, bool late)
+{
+    if (!vkd3d_fex_timeline_on)
+        return;
+    spinlock_acquire(&fex_timeline.lock);
+    if (!fex_timeline.pacing_frames || spare_ns < fex_timeline.pacing_spare_min_ns)
+        fex_timeline.pacing_spare_min_ns = spare_ns;
+    fex_timeline.pacing_frames++;
+    fex_timeline.pacing_delay_ns = delay_ns;
+    fex_timeline.pacing_margin_ns = margin_ns;
+    if (late)
+        fex_timeline.pacing_late++;
+    spinlock_release(&fex_timeline.lock);
+}
