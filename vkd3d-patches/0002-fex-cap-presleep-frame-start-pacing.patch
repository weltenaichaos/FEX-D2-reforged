+/* Frame start pacing, run by the wait worker when a frame is done: works out how much later this frame could have
+ * started without reaching the screen later, updates the hold-back and schedules the release of the frame latency
+ * handle (the game's next frame start) after it. */
+static void dxgi_vk_swap_chain_fex_start_frame_done(struct dxgi_vk_swap_chain *chain,
+        const struct fex_frame_times *fex)
+{
+    int64_t queue_wait, held, gpu_ahead, spare = 0, natural, lowest, target, delay, step, margin;
+    uint64_t gpu_done_ns = 0, release_ns, now_ns, base_ns, hold_start_ns;
+    bool late = false, measured = false, held_back;
+    uint32_t slot, i;
+
+    if (fex->blit_value)
+    {
+        slot = fex->blit_value % ARRAY_SIZE(chain->fex_start.gpu_done_value);
+        pthread_mutex_lock(&chain->fex_start.gpu_lock);
+        if (chain->fex_start.gpu_done_value[slot] == fex->blit_value)
+            gpu_done_ns = chain->fex_start.gpu_done_ns[slot];
+        pthread_mutex_unlock(&chain->fex_start.gpu_lock);
+        /* Not noted (yet): the frame is on screen, so the copy is done by now; count it as done just now. */
+        if (!gpu_done_ns)
+            gpu_done_ns = vkd3d_get_current_time_ns();
+    }
+
+    delay = (int64_t)chain->fex_start.delay_ns;
+    margin = (int64_t)chain->fex_start.margin_ns;
+    hold_start_ns = fex->hold_start_ns ? fex->hold_start_ns : fex->qp_start_ns;
+
+    if (fex->call_ns && fex->pickup_ns && hold_start_ns && fex->qp_end_ns >= hold_start_ns && gpu_done_ns)
+    {
+        measured = true;
+        /* The present waited this long for the queue thread (busy with the frame before), */
+        queue_wait = fex->pickup_ns > fex->call_ns ? (int64_t)(fex->pickup_ns - fex->call_ns) : 0;
+        /* and a frame cap held it this long (sleeping in vkQueuePresentKHR, or before it in the cap pre-sleep), which
+         * a later frame would only have saved as far as the GPU had the frame done before vkQueuePresentKHR returned. */
+        held = (int64_t)(fex->qp_end_ns - hold_start_ns);
+        gpu_ahead = (int64_t)fex->qp_end_ns - (int64_t)gpu_done_ns;
+        spare = queue_wait + min(held, gpu_ahead);
+        /* Without the hold-back on its start, the frame would have had this much spare time. */
+        natural = spare + (int64_t)fex->delay_ns;
+
