+#define FEX_PRESLEEP_GUARD_NS 4000000ull     /* wake this long before the cap's next due time */
+#define FEX_PRESLEEP_HELD_NS 300000ull       /* vkQueuePresentKHR took at least this long: the cap held the present */
+#define FEX_PRESLEEP_LONG_NS 3000000ull      /* the cap held the present this long: it came out at the cap's due time */
+#define FEX_PRESLEEP_START_COUNT 8u          /* long holds in a row before pre-sleeping starts */
+#define FEX_PRESLEEP_LATE_COUNT 4u           /* stop after this many presents in a row the cap didn't hold */
+#define FEX_PRESLEEP_ANCHOR_EVERY 150u       /* every this many presents, ... */
+#define FEX_PRESLEEP_ANCHOR_COUNT 2u         /* ... this many go without pre-sleep to measure the cap's grid again */
+
+/* Cap pre-sleep: sleeps, without holding the VkQueue, until shortly before the cap's next due time. Returns whether
+ * it slept. */
+static bool dxgi_vk_swap_chain_fex_presleep(struct dxgi_vk_swap_chain *chain)
+{
+    uint64_t now_ns, wake_ns;
+
+    if (!chain->present.fex_presleep.active || chain->present.fex_presleep.anchor_left)
+        return false;
+
+    wake_ns = chain->present.fex_presleep.due_ns + chain->present.fex_presleep.step_ns - FEX_PRESLEEP_GUARD_NS;
+    now_ns = vkd3d_get_current_time_ns();
+    if (wake_ns <= now_ns || wake_ns - now_ns >= chain->present.fex_presleep.step_ns)
+        return false;
+
+    dxgi_vk_swap_chain_platform_sleep_for_ns(&chain->frame_rate_limit.sleep_state, wake_ns - now_ns);
+    return true;
+}
+
+/* Cap pre-sleep: learns the cap's period and grid from presents it held long (those come out at the cap's due time
+ * plus the real present's own time). While pre-sleeping, the expected time only moves along that grid or earlier,
+ * never later, so waking late can't add up; every few seconds two presents go without pre-sleep to measure the grid
+ * again. */
+static void dxgi_vk_swap_chain_fex_presleep_note(struct dxgi_vk_swap_chain *chain, bool slept,
+        uint64_t start_ns, uint64_t end_ns)
+{
+    uint64_t held_ns = end_ns - start_ns, interval_ns, expected_ns, sorted[15], v;
+    bool held = held_ns >= FEX_PRESLEEP_HELD_NS, held_long = held_ns >= FEX_PRESLEEP_LONG_NS, anchored = false;
+    uint32_t i, j, n;
+
+    /* Two long holds in a row, neither pre-slept: the cap's period. A pre-slept present's end depends on when the
+     * pre-sleep woke, not only on the cap. */
+    if (held_long && !slept && chain->present.fex_presleep.last_held_long && chain->present.fex_presleep.last_end_ns)
+    {
+        interval_ns = end_ns - chain->present.fex_presleep.last_end_ns;
+        if (interval_ns >= 5000000ull && interval_ns <= 250000000ull)
+        {
+            chain->present.fex_presleep.intervals_ns[chain->present.fex_presleep.interval_pos] = interval_ns;
+            chain->present.fex_presleep.interval_pos = (chain->present.fex_presleep.interval_pos + 1) %
+                    ARRAY_SIZE(chain->present.fex_presleep.intervals_ns);
+            if (chain->present.fex_presleep.interval_count < ARRAY_SIZE(chain->present.fex_presleep.intervals_ns))
+                chain->present.fex_presleep.interval_count++;
+
+            n = chain->present.fex_presleep.interval_count;
+            if (n >= 5)
+            {
+                for (i = 0; i < n; i++)
+                {
+                    v = chain->present.fex_presleep.intervals_ns[i];
+                    for (j = i; j > 0 && sorted[j - 1] > v; j--)
+                        sorted[j] = sorted[j - 1];
+                    sorted[j] = v;
+                }
+                chain->present.fex_presleep.step_ns = sorted[n / 2];
+            }
+        }
+    }
+
+    if (!chain->present.fex_presleep.active)
+    {
+        if (held_long)
+        {
+            chain->present.fex_presleep.due_ns = end_ns;
+            anchored = true;
+            if (++chain->present.fex_presleep.start_count >= FEX_PRESLEEP_START_COUNT &&
+                    chain->present.fex_presleep.step_ns)
+            {
+                chain->present.fex_presleep.active = true;
+                chain->present.fex_presleep.late_count = 0;
+                chain->present.fex_presleep.since_anchor = 0;
+                chain->present.fex_presleep.anchor_left = 0;
+            }
+        }
+        else
+            chain->present.fex_presleep.start_count = 0;
+    }
+    else
+    {
+        expected_ns = chain->present.fex_presleep.due_ns + chain->present.fex_presleep.step_ns;
+        if (held_long && !slept)
+        {
+            /* Not pre-slept and held long: out at the cap's due time. */
+            chain->present.fex_presleep.due_ns = end_ns;
+            anchored = true;
+        }
+        else if (held)
+            chain->present.fex_presleep.due_ns = min(end_ns, expected_ns);
+        else
+            chain->present.fex_presleep.due_ns = expected_ns;
+
+        if (held)
+            chain->present.fex_presleep.late_count = 0;
+        else if (++chain->present.fex_presleep.late_count >= FEX_PRESLEEP_LATE_COUNT)
+        {
+            /* Frames slower than the cap, or nothing caps: wait for long holds again. */
+            chain->present.fex_presleep.active = false;
+            chain->present.fex_presleep.start_count = 0;
+        }
+
+        if (chain->present.fex_presleep.anchor_left)
+            chain->present.fex_presleep.anchor_left--;
+        else if (++chain->present.fex_presleep.since_anchor >= FEX_PRESLEEP_ANCHOR_EVERY)
+        {
+            chain->present.fex_presleep.since_anchor = 0;
+            chain->present.fex_presleep.anchor_left = FEX_PRESLEEP_ANCHOR_COUNT;
+        }
+    }
+
+    chain->present.fex_presleep.last_held_long = held_long && !slept;
+    chain->present.fex_presleep.last_end_ns = end_ns;
+
+    vkd3d_fex_timeline_cap(slept, held_long, !held, anchored, chain->present.fex_presleep.active,
+            chain->present.fex_presleep.step_ns, FEX_PRESLEEP_GUARD_NS);
+}
