+/* Frame start pacing: hands the game its next frame (the release of the frame latency handle it waits on before each
+ * frame). base_ns is when the release would have happened without pacing. */
+static void dxgi_vk_swap_chain_fex_release(struct dxgi_vk_swap_chain *chain, uint64_t base_ns)
+{
+    uint64_t now_ns, held_ns;
+
+    /* Noted before the release: the game reads them in its next Present(). */
+    now_ns = vkd3d_get_current_time_ns();
+    held_ns = now_ns > base_ns ? now_ns - base_ns : 0;
+    vkd3d_atomic_uint64_store_explicit(&chain->fex_start.last_release_delay_ns, held_ns, vkd3d_memory_order_relaxed);
+    vkd3d_fex_timeline_release(now_ns);
+    dxgi_vk_swap_chain_release_frame_latency_event(chain);
+    vkd3d_fex_timeline_step(VKD3D_FEX_STEP_START_DELAY, held_ns);
+}
