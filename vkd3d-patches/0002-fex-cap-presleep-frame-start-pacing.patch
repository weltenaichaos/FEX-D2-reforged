+
+    /* Frame start pacing: the release thread hands out what is still held back right away, then exits. */
+    if (chain->fex_start.locks_initialized)
+    {
+        if (chain->fex_start.thread_started)
+        {
+            pthread_mutex_lock(&chain->fex_start.lock);
+            chain->fex_start.stop = true;
+            pthread_cond_signal(&chain->fex_start.cond);
+            pthread_mutex_unlock(&chain->fex_start.lock);
+            pthread_join(chain->fex_start.thread, NULL);
+            chain->fex_start.thread_started = false;
+        }
+        if (chain->fex_start.gpu_thread_started)
+        {
+            pthread_mutex_lock(&chain->fex_start.gpu_lock);
+            chain->fex_start.gpu_stop = true;
+            pthread_cond_signal(&chain->fex_start.gpu_cond);
+            pthread_mutex_unlock(&chain->fex_start.gpu_lock);
+            pthread_join(chain->fex_start.gpu_thread, NULL);
+            chain->fex_start.gpu_thread_started = false;
+        }
+        pthread_mutex_destroy(&chain->fex_start.lock);
+        pthread_cond_destroy(&chain->fex_start.cond);
+        pthread_mutex_destroy(&chain->fex_start.gpu_lock);
+        pthread_cond_destroy(&chain->fex_start.gpu_cond);
+        chain->fex_start.locks_initialized = false;
+        chain->fex_start.enable = false;
+    }
 }
 
