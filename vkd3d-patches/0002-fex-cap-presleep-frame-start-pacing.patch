+/* Frame start pacing: does the held-back releases at their time. */
+static void *dxgi_vk_swap_chain_fex_start_worker(void *chain_)
+{
+    struct dxgi_vk_swap_chain *chain = chain_;
+    uint64_t release_ns, base_ns, now_ns;
+
+    vkd3d_set_thread_name("vkd3d-fex-start");
+
+    pthread_mutex_lock(&chain->fex_start.lock);
+    for (;;)
+    {
+        while (!chain->fex_start.stop && !chain->fex_start.count)
+            pthread_cond_wait(&chain->fex_start.cond, &chain->fex_start.lock);
+        if (!chain->fex_start.count)
+            break;
+
+        release_ns = chain->fex_start.release_ns[chain->fex_start.head];
+        base_ns = chain->fex_start.release_base_ns[chain->fex_start.head];
+        now_ns = vkd3d_get_current_time_ns();
+        if (!chain->fex_start.stop && release_ns > now_ns)
+        {
+            /* Releases are queued in time order, so nothing new can be due before this one. */
+            pthread_mutex_unlock(&chain->fex_start.lock);
+            dxgi_vk_swap_chain_platform_sleep_for_ns(&chain->frame_rate_limit.sleep_state, release_ns - now_ns);
+            pthread_mutex_lock(&chain->fex_start.lock);
+            continue;
+        }
+
+        chain->fex_start.head = (chain->fex_start.head + 1) % ARRAY_SIZE(chain->fex_start.release_ns);
+        chain->fex_start.count--;
+        pthread_mutex_unlock(&chain->fex_start.lock);
+        dxgi_vk_swap_chain_fex_release(chain, base_ns);
+        pthread_mutex_lock(&chain->fex_start.lock);
+    }
+    pthread_mutex_unlock(&chain->fex_start.lock);
+
+    return NULL;
+}
