+/* Frame start pacing: notes when each watched blit finished on the GPU. */
+static void *dxgi_vk_swap_chain_fex_gpu_worker(void *chain_)
+{
+    struct dxgi_vk_swap_chain *chain = chain_;
+    const struct vkd3d_vk_device_procs *vk_procs = &chain->queue->device->vk_procs;
+    uint64_t watched = 0, value = 0, now_ns;
+    VkSemaphoreWaitInfo wait_info;
+    uint32_t slot;
+    VkResult vr;
+
+    vkd3d_set_thread_name("vkd3d-fex-gpu");
+
+    memset(&wait_info, 0, sizeof(wait_info));
+    wait_info.sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO;
+    wait_info.pSemaphores = &chain->present.vk_internal_blit_semaphore;
+    wait_info.pValues = &value;
+    wait_info.semaphoreCount = 1;
+
+    for (;;)
+    {
+        pthread_mutex_lock(&chain->fex_start.gpu_lock);
+        while (!chain->fex_start.gpu_stop && chain->fex_start.gpu_target <= watched)
+            pthread_cond_wait(&chain->fex_start.gpu_cond, &chain->fex_start.gpu_lock);
+        if (chain->fex_start.gpu_stop)
+        {
+            pthread_mutex_unlock(&chain->fex_start.gpu_lock);
+            break;
+        }
+        value = chain->fex_start.gpu_target;
+        pthread_mutex_unlock(&chain->fex_start.gpu_lock);
+
+        /* Bounded, so a lost device or a teardown can't keep this thread. */
+        vr = VK_CALL(vkWaitSemaphores(chain->queue->device->vk_device, &wait_info, 250000000ull));
+        now_ns = vkd3d_get_current_time_ns();
+
+        pthread_mutex_lock(&chain->fex_start.gpu_lock);
+        if (vr == VK_SUCCESS)
+        {
+            slot = value % ARRAY_SIZE(chain->fex_start.gpu_done_value);
+            chain->fex_start.gpu_done_value[slot] = value;
+            chain->fex_start.gpu_done_ns[slot] = now_ns;
+        }
+        watched = value;
+        pthread_mutex_unlock(&chain->fex_start.gpu_lock);
+    }
+
+    return NULL;
+}
