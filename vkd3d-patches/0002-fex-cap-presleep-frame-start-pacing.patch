+/* FEX timeline and frame start pacing: one frame's way from the game's Present() to the screen. */
+struct fex_frame_times
+{
+    uint64_t call_ns;     /* the game called Present() */
+    uint64_t start_ns;    /* the frame latency release before that Present(): when the game started the frame */
+    uint64_t delay_ns;    /* how long frame start pacing held that release back */
+    uint64_t pickup_ns;   /* the queue thread started this present */
+    uint64_t hold_start_ns; /* the queue thread was ready to present (before the cap pre-sleep, if any) */
+    uint64_t qp_start_ns; /* vkQueuePresentKHR was called */
+    uint64_t qp_end_ns;   /* vkQueuePresentKHR returned */
+    uint64_t blit_value;  /* internal blit timeline value signalled by this frame's copy into the swapchain image */
+};
+
