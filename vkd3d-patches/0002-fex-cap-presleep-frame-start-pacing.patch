+#define FEX_START_MARGIN_FIRST_NS 6000000ll
+#define FEX_START_MARGIN_MAX_NS 30000000ll
+#define FEX_START_MARGIN_UP_NS 3000000ll   /* margin added for each frame that came late while held back */
+#define FEX_START_MARGIN_DOWN_FRAMES 600u  /* frames without a late one before the margin shrinks by 1 ms */
+#define FEX_START_NEAR_NS 1000000ll        /* less spare than this while held back: start the next frames at once */
+#define FEX_START_LATE_NS 2000000ll        /* this much past its time while held back: the frame came late */
+#define FEX_START_MAX_NS 50000000ll
+#define FEX_START_CALM_FRAMES 60u          /* frames without a near-late one before the hold-back grows again */
+#define FEX_START_STEP_NS 1000000ll        /* the most the hold-back grows per frame */
