-/* The render pass load_attachment() would have recorded for this clear. Its barriers already ran at clear time. */
+static bool d3d12_command_list_has_depth_stencil_view(struct d3d12_command_list *list);
+
+/* VKD3D fex33 (pass meter only): big clears (4M+ pixels) that got a render pass of their own are followed to the next
+ * use of their image in the same command list (fex_clears.big), and big images drawn into are remembered
+ * (fex_clears.drawn), so the gpu report can tell whether such a clear is needed. */
+static bool d3d12_command_list_fex_big_find(struct d3d12_resource * const *set, uint32_t count,
+        const struct d3d12_resource *resource)
+{
+    uint32_t i;
+
+    for (i = 0; i < count; i++)
+    {
+        if (set[i] == resource)
+            return true;
+    }
+    return false;
+}
+
+static void d3d12_command_list_fex_big_next(struct d3d12_command_list *list, const struct d3d12_resource *resource,
+        enum vkd3d_fex_big_clear_event event)
+{
+    uint32_t i;
+
+    for (i = 0; resource && i < list->fex_clears.big_count; i++)
+    {
+        if (list->fex_clears.big[i] == resource)
+        {
+            list->fex_clears.big[i] = list->fex_clears.big[--list->fex_clears.big_count];
+            vkd3d_fex_pass_meter_big_clear(list->device, event, 0);
+            return;
+        }
+    }
+}
+
+/* A render pass with draws begins: its images' big clears are used, and big images count as drawn into. */
+static void d3d12_command_list_fex_big_drawn(struct d3d12_command_list *list)
+{
+    struct d3d12_resource *resources[D3D12_SIMULTANEOUS_RENDER_TARGET_COUNT + 1];
+    uint32_t i, n = 0;
+
+    for (i = 0; i < D3D12_SIMULTANEOUS_RENDER_TARGET_COUNT; i++)
+    {
+        if ((list->rendering_info.rtv_mask & (1u << i)) && list->rtvs[i].view && list->rtvs[i].resource)
+            resources[n++] = list->rtvs[i].resource;
+    }
+    if (d3d12_command_list_has_depth_stencil_view(list) && list->dsv.resource)
+        resources[n++] = list->dsv.resource;
+
+    for (i = 0; i < n; i++)
+    {
+        d3d12_command_list_fex_big_next(list, resources[i], VKD3D_FEX_BIG_CLEAR_NEXT_DRAWN);
+        if (resources[i]->desc.Width * resources[i]->desc.Height >= VKD3D_FEX_BIG_CLEAR_PIXELS &&
+                list->fex_clears.drawn_count < VKD3D_FEX_BIG_CLEARS &&
+                !d3d12_command_list_fex_big_find(list->fex_clears.drawn, list->fex_clears.drawn_count, resources[i]))
+            list->fex_clears.drawn[list->fex_clears.drawn_count++] = resources[i];
+    }
+}
+
+static void d3d12_command_list_fex_big_barrier(struct d3d12_command_list *list, const D3D12_RESOURCE_BARRIER *barrier)
+{
+    switch (barrier->Type)
+    {
+        case D3D12_RESOURCE_BARRIER_TYPE_TRANSITION:
+            if (barrier->Transition.pResource)
+                d3d12_command_list_fex_big_next(list, impl_from_ID3D12Resource(barrier->Transition.pResource),
+                        VKD3D_FEX_BIG_CLEAR_NEXT_BARRIER);
+            break;
+        case D3D12_RESOURCE_BARRIER_TYPE_ALIASING:
+            if (barrier->Aliasing.pResourceBefore)
+                d3d12_command_list_fex_big_next(list, impl_from_ID3D12Resource(barrier->Aliasing.pResourceBefore),
+                        VKD3D_FEX_BIG_CLEAR_NEXT_BARRIER);
+            if (barrier->Aliasing.pResourceAfter)
+                d3d12_command_list_fex_big_next(list, impl_from_ID3D12Resource(barrier->Aliasing.pResourceAfter),
+                        VKD3D_FEX_BIG_CLEAR_NEXT_BARRIER);
+            break;
+        case D3D12_RESOURCE_BARRIER_TYPE_UAV:
+            if (barrier->UAV.pResource)
+                d3d12_command_list_fex_big_next(list, impl_from_ID3D12Resource(barrier->UAV.pResource),
+                        VKD3D_FEX_BIG_CLEAR_NEXT_BARRIER);
+            break;
+        default:
+            break;
+    }
+}
+
+/* The render pass load_attachment() would have recorded for this clear. Its barriers already ran at clear time.
+ * made_at/line: why it is made now (VKD3D fex33 pass meter). */
 static void d3d12_command_list_fex_emit_clear_pass(struct d3d12_command_list *list,
-        const struct vkd3d_fex_pending_clear *clear)
+        const struct vkd3d_fex_pending_clear *clear, enum vkd3d_fex_big_clear_event made_at, unsigned int line)
 {
     const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
     VkRenderingAttachmentInfo attachment_info;
@@ -4001,16 +4089,29 @@ static void d3d12_command_list_fex_emit_clear_pass(struct d3d12_command_list *li
     d3d12_command_list_sync_tiler_renderpass_writes(list, &rendering_info);
 
     d3d12_command_list_debug_mark_end_region(list);
+
+    if (list->device->fex_pass_meter &&
+            (uint64_t)view_extent.width * view_extent.height * rendering_info.layerCount >= VKD3D_FEX_BIG_CLEAR_PIXELS)
+    {
+        vkd3d_fex_pass_meter_big_clear(list->device, made_at, line);
+        if (d3d12_command_list_fex_big_find(list->fex_clears.drawn, list->fex_clears.drawn_count, clear->resource))
+            vkd3d_fex_pass_meter_big_clear(list->device, VKD3D_FEX_BIG_CLEAR_DRAWN_BEFORE, 0);
+        /* A second big clear pass of the same image with nothing in between: the first one's next use. */
+        d3d12_command_list_fex_big_next(list, clear->resource, VKD3D_FEX_BIG_CLEAR_NEXT_CLEAR);
+        if (list->fex_clears.big_count < VKD3D_FEX_BIG_CLEARS)
+            list->fex_clears.big[list->fex_clears.big_count++] = clear->resource;
+    }
 }
 
 /* Emits every waiting clear as its own render pass, in the order they were made. No render pass may be active. */
-static void d3d12_command_list_fex_flush_clears(struct d3d12_command_list *list)
+static void d3d12_command_list_fex_flush_clears(struct d3d12_command_list *list,
+        enum vkd3d_fex_big_clear_event made_at, unsigned int line)
 {
     uint32_t i, count = list->fex_clears.count;
 
     list->fex_clears.count = 0;
     for (i = 0; i < count; i++)
-        d3d12_command_list_fex_emit_clear_pass(list, &list->fex_clears.entries[i]);
+        d3d12_command_list_fex_emit_clear_pass(list, &list->fex_clears.entries[i], made_at, line);
     vkd3d_fex_pass_meter_count_clears(list->device, 0, count);
 }
 
@@ -4083,7 +4184,7 @@ static void d3d12_command_list_fex_fold_clears(struct d3d12_command_list *list,
         }
         else
         {
-            d3d12_command_list_fex_emit_clear_pass(list, clear);
+            d3d12_command_list_fex_emit_clear_pass(list, clear, VKD3D_FEX_BIG_CLEAR_MADE_AT_PASS_START, 0);
             own_pass++;
         }
     }
@@ -4115,10 +4216,14 @@ static void d3d12_command_list_load_attachment(struct d3d12_command_list *list,
     /* This does not get called with LOAD_OP_LOAD */
     list->cmd.estimated_cost += VKD3D_COMMAND_COST_LOW;
 
+    /* VKD3D fex33 pass meter: a big clear pass of this image was followed by this clear. */
+    if (list->fex_clears.big_count)
+        d3d12_command_list_fex_big_next(list, resource, VKD3D_FEX_BIG_CLEAR_NEXT_CLEAR);
+
     /* A waiting clear of this image must land before anything else touches it. */
     fex_defer = d3d12_command_list_fex_can_defer_clear(list, resource, view, clear_aspects, rect_count, load_op);
     if (!fex_defer && list->fex_clears.count && d3d12_command_list_fex_clears_touch(list, resource))
-        d3d12_command_list_fex_flush_clears(list);
+        d3d12_command_list_fex_flush_clears(list, VKD3D_FEX_BIG_CLEAR_MADE_AT_CLEAR, __LINE__);
 
     memset(initial_layouts, 0, sizeof(initial_layouts));
     memset(final_layouts, 0, sizeof(final_layouts));
@@ -5224,7 +5329,7 @@ void d3d12_command_list_end_current_render_pass_line(struct d3d12_command_list *
      * while starting a pass and a clear that waits itself keep them waiting. No render pass is active while
      * clears wait: starting one takes them all. */
     if (list->fex_clears.count && !list->fex_clears.keep)
-        d3d12_command_list_fex_flush_clears(list);
+        d3d12_command_list_fex_flush_clears(list, VKD3D_FEX_BIG_CLEAR_MADE_AT_PASS_END, line);
 
     d3d12_command_list_handle_active_queries(list, true);
 
@@ -5941,6 +6046,11 @@ static HRESULT STDMETHODCALLTYPE d3d12_command_list_Close(d3d12_command_list_ifa
     if (FAILED(hr = d3d12_command_list_build_init_commands(list)))
         return hr;
 
+    /* VKD3D fex33 pass meter: big clear passes whose image this list didn't use again. */
+    for (; list->fex_clears.big_count; list->fex_clears.big_count--)
+        vkd3d_fex_pass_meter_big_clear(list->device, VKD3D_FEX_BIG_CLEAR_NEXT_NONE, 0);
+    list->fex_clears.drawn_count = 0;
+
     vkd3d_fex_pass_meter_close_list(list);
 
     if ((vr = VK_CALL(vkEndCommandBuffer(list->cmd.vk_command_buffer))) < 0)
@@ -7652,6 +7762,8 @@ static bool d3d12_command_list_begin_render_pass(struct d3d12_command_list *list
     fex_pass_kind = (list->rendering_info.state_flags & VKD3D_RENDERING_SUSPENDED) ?
             VKD3D_FEX_PASS_KIND_RESUMED : VKD3D_FEX_PASS_KIND_DRAW;
 
+    if (list->device->fex_pass_meter)
+        d3d12_command_list_fex_big_drawn(list);
     if (list->fex_clears.count)
         d3d12_command_list_fex_fold_clears(list, &fex_fold_rt_mask, &fex_fold_ds);
 
@@ -11682,6 +11794,9 @@ static void STDMETHODCALLTYPE d3d12_command_list_ResourceBarrier(d3d12_command_l
         const D3D12_RESOURCE_BARRIER *current = &barriers[i];
         struct d3d12_resource *preserve_resource = NULL;
 
+        if (list->fex_clears.big_count)
+            d3d12_command_list_fex_big_barrier(list, current);
