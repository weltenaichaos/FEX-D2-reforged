diff --git a/libs/vkd3d/fex_pass_meter.c b/libs/vkd3d/fex_pass_meter.c
index dff279d..355bdf1 100644
--- a/libs/vkd3d/fex_pass_meter.c
+++ b/libs/vkd3d/fex_pass_meter.c
@@ -266,6 +266,8 @@ struct vkd3d_fex_pass_meter
 
     /* Counted by recording threads. */
     uint32_t clears_folded, clears_own_pass;
+    uint32_t big_clears[VKD3D_FEX_BIG_CLEAR_EVENTS]; /* VKD3D fex33 */
+    uint32_t big_clear_line[4], big_clear_line_count[4]; /* command.c lines that ended a pass and made big clears */
 
     /* Draw timing (VKD3D fex9). */
     VkQueryPool draw_pool;              /* VK_NULL_HANDLE: off */
@@ -1435,6 +1437,31 @@ void vkd3d_fex_pass_meter_count_clears(struct d3d12_device *device, uint32_t fol
         vkd3d_atomic_uint32_add(&meter->clears_own_pass, own_pass, vkd3d_memory_order_relaxed);
 }
 
+void vkd3d_fex_pass_meter_big_clear(struct d3d12_device *device, enum vkd3d_fex_big_clear_event event,
+        unsigned int line)
+{
+    struct vkd3d_fex_pass_meter *meter = device->fex_pass_meter;
+    unsigned int i;
+
+    if (!meter || event >= VKD3D_FEX_BIG_CLEAR_EVENTS)
+        return;
+    vkd3d_atomic_uint32_increment(&meter->big_clears[event], vkd3d_memory_order_relaxed);
+    if (event != VKD3D_FEX_BIG_CLEAR_MADE_AT_PASS_END || !line)
+        return;
+    /* A slot holds one line for the whole session (0 = free); returns the old value, 0 when this call took it. */
+    for (i = 0; i < ARRAY_SIZE(meter->big_clear_line); i++)
+    {
+        uint32_t old = vkd3d_atomic_uint32_compare_exchange(&meter->big_clear_line[i], 0, line,
+                vkd3d_memory_order_relaxed, vkd3d_memory_order_relaxed);
+
+        if (!old || old == line)
+        {
+            vkd3d_atomic_uint32_increment(&meter->big_clear_line_count[i], vkd3d_memory_order_relaxed);
+            return;
+        }
+    }
+}
+
 uint32_t vkd3d_fex_pass_meter_present(struct d3d12_device *device)
 {
     struct vkd3d_fex_pass_meter *meter = device->fex_pass_meter;
@@ -2415,6 +2442,43 @@ static void fex_pass_publish(struct vkd3d_fex_pass_meter *meter, double seconds)
     }
     len = vkd3d_fex_report_append(text, sizeof(text), len, "\n");
 
+    /* VKD3D fex33: big clears with their own render pass (every frame, not only measured ones). */
+    {
+        uint32_t big[VKD3D_FEX_BIG_CLEAR_EVENTS], made, lines[4], counts[4];
+
+        for (i = 0; i < VKD3D_FEX_BIG_CLEAR_EVENTS; i++)
+            big[i] = vkd3d_atomic_uint32_exchange_explicit(&meter->big_clears[i], 0, vkd3d_memory_order_relaxed);
+        for (i = 0; i < ARRAY_SIZE(lines); i++)
+        {
+            counts[i] = vkd3d_atomic_uint32_exchange_explicit(&meter->big_clear_line_count[i], 0,
+                    vkd3d_memory_order_relaxed);
+            lines[i] = vkd3d_atomic_uint32_load_explicit(&meter->big_clear_line[i], vkd3d_memory_order_relaxed);
+        }
+        made = big[VKD3D_FEX_BIG_CLEAR_MADE_AT_PASS_START] + big[VKD3D_FEX_BIG_CLEAR_MADE_AT_PASS_END] +
+                big[VKD3D_FEX_BIG_CLEAR_MADE_AT_CLEAR];
+        if (made)
+        {
+            len = vkd3d_fex_report_append(text, sizeof(text), len,
+                    "  gpu big clear passes (VKD3D fex33: clears of 4M+ pixels with a render pass of their own, every"
+                    " frame): %u | made when: a render pass that doesn't draw to the image began %u, a render pass"
+                    " ended %u (",
+                    made, big[VKD3D_FEX_BIG_CLEAR_MADE_AT_PASS_START], big[VKD3D_FEX_BIG_CLEAR_MADE_AT_PASS_END]);
+            for (i = 0, j = 0; i < ARRAY_SIZE(lines); i++)
+            {
+                if (lines[i] && counts[i])
+                    len = vkd3d_fex_report_append(text, sizeof(text), len, "%send@%u x%u", j++ ? ", " : "",
+                            lines[i], counts[i]);
+            }
+            len = vkd3d_fex_report_append(text, sizeof(text), len,
+                    "), the image was cleared again %u | image drawn into earlier in the same command list %u | next"
+                    " in the same list: cleared again %u, drawn into %u, a barrier on it %u, nothing (list closed)"
+                    " %u\n",
+                    big[VKD3D_FEX_BIG_CLEAR_MADE_AT_CLEAR], big[VKD3D_FEX_BIG_CLEAR_DRAWN_BEFORE],
+                    big[VKD3D_FEX_BIG_CLEAR_NEXT_CLEAR], big[VKD3D_FEX_BIG_CLEAR_NEXT_DRAWN],
+                    big[VKD3D_FEX_BIG_CLEAR_NEXT_BARRIER], big[VKD3D_FEX_BIG_CLEAR_NEXT_NONE]);
+        }
+    }
+
     /* The last draw sample, once. */
     draw_sample = meter->draw_text_len != 0;
     if (draw_sample)
diff --git a/libs/vkd3d/fex_shader_swap.c b/libs/vkd3d/fex_shader_swap.c
index 15fa5e1..0280e4d 100644
--- a/libs/vkd3d/fex_shader_swap.c
+++ b/libs/vkd3d/fex_shader_swap.c
@@ -10,20 +10,29 @@
  * swap off. FEX's stats log gets a '#' note in the gpu report whenever the counts change (in the next 3 reports, as FEX
  * prints each note once and may miss a report).
  *
- * VKD3D fex31: a shader can have a second FEX version. With VKD3D_FEX_SHADER_SWAP=alt (also when unset) the pipeline
- * gets both, and each bind of it on a command list takes the next one in turn, so one play session times both on the
- * device (FEX's 'turnip dispatch' lines tell them apart by local size and instruction count). 1 uses the first
- * version only, 2 the second only.
+ * VKD3D fex31: a shader can have a second version. With VKD3D_FEX_SHADER_SWAP=alt (also when unset) the pipeline gets
+ * both, and each bind of it on a command list takes the next one in turn, so one play session times both on the device
+ * (FEX's 'turnip dispatch' lines tell them apart by local size and instruction count). 1 uses the first version only,
+ * 2 the second where there is one.
+ *
+ * VKD3D fex33: a FEX version can also be an edit of vkd3d's own translation: a short script that copies runs of the
+ * translation's words in another order and adds a few new instructions (so none of the game's code is stored here).
+ * It is applied to the first translation with the expected hash, and the result must have the expected hash too, or
+ * the game's shader stays. Such an entry can take turns with the game's own shader (its second version).
  *
  * 83e2eb4a6bf5f03b (Diablo II: Resurrected): blurs a 3D lighting table of 8 x 8 x 8 cell groups. For each cell it
  * sums 2 x A x B filtered samples of one volume (8,192 per cell in D2R: 30 ms per run on an Adreno 740, in bursts of
- * up to 19 runs when the game enters an area). The FEX versions sample each distinct value once per group into
- * shared memory and sum from there. fex30's version (1 cell per thread) took 12-13 ms per run on the device, fex31's
- * 4 cells per thread 8.5 ms (2 cells per thread: 10.4 ms), held back by its shared memory reads (one per product).
- * VKD3D fex32: both versions sum 8 cells per thread and keep the last s2 values in registers, so one shared memory
- * read serves several cells: 4 x by 2 y (fex_shader_swap_83e2.comp, 3 reads per 8 products) or 8 x in a row
- * (fex_shader_swap_83e2_row.comp, 2 reads per 8 products). They also no longer wait for the texture unit right
- * after each s1 sample, and take 10 KB of shared memory per group instead of 12 (3 groups per core instead of 2).
+ * up to 19 runs when the game enters an area). The FEX version samples each distinct value once per group into shared
+ * memory and sums 8 cells in a row per thread, keeping the last 16 s2 values in registers so that each shared memory
+ * read serves several cells (fex_shader_swap_83e2_row.comp): 2.2 ms per run on the device (VKD3D fex32, where it took
+ * turns with a 4 x by 2 y version: 2.7 ms).
+ *
+ * 0e21a3b5088ba1af (Diablo II: Resurrected): places ground clutter, once per frame over a 1152 x 1152 grid (144 x 144
+ * groups of 8 x 8), 1.0-1.2 ms per frame on the device. After a coarse mask test, each point computes two layers of
+ * density noise (about 330 instructions) and only then tests whether it is on screen and whether a mask texture
+ * allows clutter there. FEX's edit (VKD3D fex33) moves those two tests ahead of the noise, each with its own early
+ * return; the noise and everything after it is unchanged, so the result is the same. Points off screen now stop after
+ * about 20 instructions instead of about 360.
  *
