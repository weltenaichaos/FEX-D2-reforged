From 185c8f661a69a3e1674562717fa13e0f37a7eadb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 10:26:59 +0000
Subject: [PATCH] FEX: frame start pacing changes the hold-back gradually

The hold-back on the game's frame start grows by at most 0.2 ms and shrinks by at most 1 ms per frame (2 ms after a frame
that nearly came late, half after one that came late), up to 20 ms. Build 56 jumped between 0 and 50 ms, which moved
the game's frame starts by up to 50 ms from one frame to the next.
---
 libs/vkd3d/fex_timeline.c  |  2 +-
 libs/vkd3d/swapchain.c     | 25 ++++++++++++++++++-------
 libs/vkd3d/vkd3d_private.h |  1 +
 3 files changed, 20 insertions(+), 8 deletions(-)

diff --git a/libs/vkd3d/fex_timeline.c b/libs/vkd3d/fex_timeline.c
index 4d724e8..93012ec 100644
--- a/libs/vkd3d/fex_timeline.c
+++ b/libs/vkd3d/fex_timeline.c
@@ -112,7 +112,7 @@ void vkd3d_fex_timeline_init(void)
             !strcmp(env, "1");
     vkd3d_atomic_uint32_store_explicit((uint32_t *)&vkd3d_fex_present_report.flags, VKD3D_FEX_REPORT_FLAG_DEVICE |
             (vkd3d_fex_timeline_on ? VKD3D_FEX_REPORT_FLAG_ON : 0) |
-            (vkd3d_fex_frame_start_on ? VKD3D_FEX_REPORT_FLAG_FRAME_START : 0) |
+            (vkd3d_fex_frame_start_on ? VKD3D_FEX_REPORT_FLAG_FRAME_START | VKD3D_FEX_REPORT_FLAG_GRADUAL_START : 0) |
             (vkd3d_fex_present_presleep_on ? VKD3D_FEX_REPORT_FLAG_PRESLEEP : 0), vkd3d_memory_order_release);
     vkd3d_atomic_uint64_store_explicit(&fex_timeline_last_publish_ns, vkd3d_get_current_time_ns(),
             vkd3d_memory_order_relaxed);
diff --git a/libs/vkd3d/swapchain.c b/libs/vkd3d/swapchain.c
index 05ec1d4..e7a2d14 100644
--- a/libs/vkd3d/swapchain.c
+++ b/libs/vkd3d/swapchain.c
@@ -3305,11 +3305,16 @@ static void *dxgi_vk_swap_chain_fex_gpu_worker(void *chain_)
 #define FEX_START_MARGIN_MAX_NS 30000000ll
 #define FEX_START_MARGIN_UP_NS 3000000ll   /* margin added for each frame that came late while held back */
 #define FEX_START_MARGIN_DOWN_FRAMES 600u  /* frames without a late one before the margin shrinks by 1 ms */
-#define FEX_START_NEAR_NS 1000000ll        /* less spare than this while held back: start the next frames at once */
+#define FEX_START_NEAR_NS 1000000ll        /* less spare than this while held back: the frame nearly came late */
 #define FEX_START_LATE_NS 2000000ll        /* this much past its time while held back: the frame came late */
-#define FEX_START_MAX_NS 50000000ll
+#define FEX_START_MAX_NS 20000000ll
 #define FEX_START_CALM_FRAMES 60u          /* frames without a near-late one before the hold-back grows again */
-#define FEX_START_STEP_NS 1000000ll        /* the most the hold-back grows per frame */
+/* The hold-back only ever changes by a little from one frame to the next: each change moves the game's frame start, so
+ * a big one makes the time the game steps its world by differ from the time the frame is on screen (build 56 jumped
+ * between 0 and 50 ms in menus). */
+#define FEX_START_STEP_NS 200000ll         /* the most the hold-back grows per frame */
+#define FEX_START_DOWN_NS 1000000ll        /* the most it shrinks per frame when the spare time got smaller */
+#define FEX_START_NEAR_DOWN_NS 2000000ll   /* ... and after a frame that nearly came late */
 
 /* Frame start pacing, run by the wait worker when a frame is done: works out how much later this frame could have
  * started without reaching the screen later, updates the hold-back and schedules the release of the frame latency
@@ -3378,15 +3383,21 @@ static void dxgi_vk_swap_chain_fex_start_frame_done(struct dxgi_vk_swap_chain *c
         target = max(target, 0);
         target = min(target, FEX_START_MAX_NS);
 
-        if (held_back && spare < FEX_START_NEAR_NS)
+        if (late)
         {
-            /* Came (nearly) too late while held back: start the next frames at once, grow again later. */
-            delay = 0;
+            /* Came late while held back: halve the hold-back, grow again later. */
+            delay /= 2;
+            chain->fex_start.calm_frames = 0;
+        }
+        else if (held_back && spare < FEX_START_NEAR_NS)
+        {
+            /* Nearly came late while held back: shrink faster, grow again later. */
+            delay -= min(delay, FEX_START_NEAR_DOWN_NS);
             chain->fex_start.calm_frames = 0;
         }
         else if (target < delay)
         {
-            delay = target;
+            delay -= min(delay - target, FEX_START_DOWN_NS);
             chain->fex_start.calm_frames++;
         }
         else if (++chain->fex_start.calm_frames >= FEX_START_CALM_FRAMES)
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index e30510d..04556f6 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -3038,6 +3038,7 @@ struct vkd3d_timestamp_profiler_submitted_work;
 #define VKD3D_FEX_REPORT_FLAG_FOLD_CLEARS 0x2u /* pass report: clear folding is on */
 #define VKD3D_FEX_REPORT_FLAG_FRAME_START 0x4u /* present report: frame start pacing is on */
 #define VKD3D_FEX_REPORT_FLAG_PRESLEEP 0x8u    /* present report: cap pre-sleep is on */
+#define VKD3D_FEX_REPORT_FLAG_GRADUAL_START 0x10u /* present report: frame start pacing changes gradually */
 #define VKD3D_FEX_REPORT_FLAG_DEVICE 0x80000000u /* a D3D12 device was created */
 struct vkd3d_fex_report
 {
-- 
2.43.0

