diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index 8205488..847fee9 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -295,10 +295,14 @@ void vkd3d_queue_destroy(struct vkd3d_queue *queue, struct d3d12_device *device)
 
 VkQueue vkd3d_queue_acquire(struct vkd3d_queue *queue)
 {
+    uint64_t fex_t0 = 0, fex_t1;
     int rc;
 
     TRACE("queue %p.\n", queue);
 
+    if (vkd3d_fex_timeline_on)
+        fex_t0 = vkd3d_get_current_time_ns();
+
     if ((rc = pthread_mutex_lock(&queue->mutex)))
     {
         ERR("Failed to lock mutex, error %d.\n", rc);
@@ -312,13 +316,28 @@ VkQueue vkd3d_queue_acquire(struct vkd3d_queue *queue)
         return VK_NULL_HANDLE;
     }
 
+    if (fex_t0)
+    {
+        /* FEX timeline: how long the shared VkQueue made threads wait, and how long holders kept it. */
+        fex_t1 = vkd3d_get_current_time_ns();
+        queue->fex_acquired_ns = fex_t1;
+        vkd3d_fex_timeline_vkqueue_lock(fex_t1 - fex_t0, UINT64_MAX);
+    }
+
     assert(queue->vk_queue);
     return queue->vk_queue;
 }
 
 void vkd3d_queue_release(struct vkd3d_queue *queue)
 {
+    uint64_t fex_acquired_ns = queue->fex_acquired_ns;
+
     TRACE("queue %p.\n", queue);
+    if (fex_acquired_ns)
+    {
+        queue->fex_acquired_ns = 0;
+        vkd3d_fex_timeline_vkqueue_lock(UINT64_MAX, vkd3d_get_current_time_ns() - fex_acquired_ns);
+    }
     if (queue->global_mutex)
         pthread_mutex_unlock(queue->global_mutex);
     pthread_mutex_unlock(&queue->mutex);
