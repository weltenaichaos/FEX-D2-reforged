+        bool has_fence[16];
+        uint64_t present_count[16];
+        uint64_t blit_value[16];
+        uint32_t head;
+        uint32_t count;
+        bool stop;
+        uint64_t completed_blit;   /* highest internal blit value whose fence was seen signalled (under lock) */
+        bool note_gpu;             /* also note GPU finish times for frame start pacing (under lock) */
+
+        /* Queue thread only. */
+        bool armed;                /* this present's copy was submitted with fences[slot] */
+        uint32_t armed_slot;
+        uint64_t armed_blit_value;
+        uint64_t pushed_blit_value; /* highest fenced blit value handed to the thread */
+    } fex_done;
 };
 
 static void dxgi_vk_swap_chain_drain_internal_blit_semaphore(struct dxgi_vk_swap_chain *chain, uint64_t value);
@@ -462,9 +498,83 @@ static void dxgi_vk_swap_chain_drain_complete_semaphore(struct dxgi_vk_swap_chai
 
 static void dxgi_vk_swap_chain_drain_internal_blit_semaphore(struct dxgi_vk_swap_chain *chain, uint64_t value)
 {
+    bool done;
+
+    /* FEX frame done thread: a copy it was handed is done once it saw the copy's fence. A host wait on the internal
+     * blit timeline itself can sit in Mesa's zero-timeout check (endless on KGSL) until every copy on the GPU is done,
+     * holding the timeline that the next copy's submit needs. Queue thread only (pushed_blit_value). */
+    if (value && chain->fex_done.enable && value <= chain->fex_done.pushed_blit_value)
+    {
+        pthread_mutex_lock(&chain->fex_done.lock);
+        while (chain->fex_done.completed_blit < value && !chain->fex_done.stop)
+            pthread_cond_wait(&chain->fex_done.cond, &chain->fex_done.lock);
+        done = chain->fex_done.completed_blit >= value;
+        pthread_mutex_unlock(&chain->fex_done.lock);
+        if (done)
+            return;
+    }
+
     dxgi_vk_swap_chain_wait_semaphore(chain, chain->present.vk_internal_blit_semaphore, value);
 }
 
+/* FEX frame done: the fence the next copy into a swapchain image carries (VK_NULL_HANDLE: none). Queue thread. */
+static VkFence dxgi_vk_swap_chain_fex_done_fence_for_blit(struct dxgi_vk_swap_chain *chain)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &chain->queue->device->vk_procs;
+    VkFenceCreateInfo fence_info;
+    uint32_t slot;
+
+    chain->fex_done.armed = false;
+    if (!chain->fex_done.enable)
+        return VK_NULL_HANDLE;
+
+    pthread_mutex_lock(&chain->fex_done.lock);
+    /* Only waits with 16 presents' copies unfinished on the GPU. */
+    while (chain->fex_done.count == ARRAY_SIZE(chain->fex_done.fences))
+        pthread_cond_wait(&chain->fex_done.cond, &chain->fex_done.lock);
+    slot = (chain->fex_done.head + chain->fex_done.count) % ARRAY_SIZE(chain->fex_done.fences);
+    pthread_mutex_unlock(&chain->fex_done.lock);
+
+    if (!chain->fex_done.fences[slot])
+    {
+        memset(&fence_info, 0, sizeof(fence_info));
+        fence_info.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+        if (VK_CALL(vkCreateFence(chain->queue->device->vk_device, &fence_info, NULL, &chain->fex_done.fences[slot])))
+        {
+            ERR("Failed to create fence.\n");
+            chain->fex_done.fences[slot] = VK_NULL_HANDLE;
+            return VK_NULL_HANDLE;
+        }
+    }
+
+    chain->fex_done.armed_slot = slot;
+    return chain->fex_done.fences[slot];
+}
+
+/* FEX frame done: hands this present to the frame done thread instead of signalling the frame done timeline with an
+ * empty submit. The entry's slot is the one the copy's fence was taken from: the thread only removes entries, which
+ * doesn't move head + count. Queue thread. */
+static void dxgi_vk_swap_chain_fex_done_push(struct dxgi_vk_swap_chain *chain, uint64_t present_count)
+{
+    uint32_t slot;
+
+    pthread_mutex_lock(&chain->fex_done.lock);
+    while (chain->fex_done.count == ARRAY_SIZE(chain->fex_done.fences))
+        pthread_cond_wait(&chain->fex_done.cond, &chain->fex_done.lock);
+    slot = (chain->fex_done.head + chain->fex_done.count) % ARRAY_SIZE(chain->fex_done.fences);
+    assert(!chain->fex_done.armed || chain->fex_done.armed_slot == slot);
+    chain->fex_done.has_fence[slot] = chain->fex_done.armed;
+    chain->fex_done.blit_value[slot] = chain->fex_done.armed ? chain->fex_done.armed_blit_value : 0;
+    chain->fex_done.present_count[slot] = present_count;
+    chain->fex_done.count++;
+    pthread_cond_broadcast(&chain->fex_done.cond);
+    pthread_mutex_unlock(&chain->fex_done.lock);
+
+    if (chain->fex_done.armed)
+        chain->fex_done.pushed_blit_value = chain->fex_done.armed_blit_value;
+    chain->fex_done.armed = false;
+}
+
 static void dxgi_vk_swap_chain_drain_user_images(struct dxgi_vk_swap_chain *chain)
 {
     dxgi_vk_swap_chain_drain_complete_semaphore(chain, chain->user.blit_count);
@@ -529,12 +639,40 @@ static void dxgi_vk_swap_chain_cleanup_low_latency(struct dxgi_vk_swap_chain *ch
 
 static void dxgi_vk_swap_chain_cleanup_waiter_thread(struct dxgi_vk_swap_chain *chain)
 {
+    const struct vkd3d_vk_device_procs *vk_procs = &chain->queue->device->vk_procs;
+    unsigned int i;
+
     dxgi_vk_swap_chain_push_present_id(chain, 0, 0, 0, NULL);
     pthread_join(chain->wait_thread.thread, NULL);
     pthread_mutex_destroy(&chain->wait_thread.lock);
     pthread_cond_destroy(&chain->wait_thread.cond);
     vkd3d_free(chain->wait_thread.wait_queue);
 
+    /* Frame done thread: after the wait worker (whose last waits it may still have to signal), before frame start
+     * pacing (whose GPU finish times it writes). It finishes the presents it was handed, then exits. */
+    if (chain->fex_done.locks_initialized)
+    {
+        if (chain->fex_done.thread_started)
+        {
+            pthread_mutex_lock(&chain->fex_done.lock);
+            chain->fex_done.stop = true;
+            pthread_cond_broadcast(&chain->fex_done.cond);
+            pthread_mutex_unlock(&chain->fex_done.lock);
+            pthread_join(chain->fex_done.thread, NULL);
+            chain->fex_done.thread_started = false;
+        }
+        for (i = 0; i < ARRAY_SIZE(chain->fex_done.fences); i++)
+        {
+            if (chain->fex_done.fences[i])
+                VK_CALL(vkDestroyFence(chain->queue->device->vk_device, chain->fex_done.fences[i], NULL));
+            chain->fex_done.fences[i] = VK_NULL_HANDLE;
+        }
+        pthread_mutex_destroy(&chain->fex_done.lock);
+        pthread_cond_destroy(&chain->fex_done.cond);
+        chain->fex_done.locks_initialized = false;
+        chain->fex_done.enable = false;
+    }
+
     /* Frame start pacing: the release thread hands out what is still held back right away, then exits. */
     if (chain->fex_start.locks_initialized)
     {
@@ -1955,14 +2093,15 @@ static void fex_timeline_note_swapchain(struct dxgi_vk_swap_chain *chain, const
