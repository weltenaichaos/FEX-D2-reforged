+/* VKD3D fex21: the 'gpu draw changes' lines; flips VKD3D_FEX_ROOT_DEDUPE in its on/off mode. */
+static size_t fex_chg_publish(struct vkd3d_fex_pass_meter *meter, char *text, size_t size, size_t len)
+{
+    static const char *const class_names[FEX_CHG_CLASSES] =
+    {
+        "new PS", "new pipeline", "PS data", "VS data only", "re-sent only", "dyn/buffers only", "nothing",
+    };
+    static const char *const type_names[] = { "table", "const", "CBV", "SRV", "UAV" };
+    static const char *const vis_names[] = { "all", "VS", "HS", "DS", "GS", "PS", "AS", "MS" };
+    uint64_t draws = 0, sent_set = 0, sent_consts = 0, same = 0, pixel_any = 0;
+    uint32_t top[FEX_CHG_TOP_KINDS], top_count = 0;
+    uint32_t i, j, k, sig_count;
+    bool dedupe_on;
+
+    dedupe_on = vkd3d_fex_root_dedupe_on();
+    if (fex_root_dedupe_alt)
+        vkd3d_atomic_uint32_store_explicit(&vkd3d_fex_root_dedupe_now, dedupe_on ? 0u : 1u, vkd3d_memory_order_relaxed);
+
+    sig_count = vkd3d_atomic_uint32_load_explicit(&meter->sig_count, vkd3d_memory_order_acquire);
+    if (sig_count > FEX_CHG_SIGS)
+        sig_count = FEX_CHG_SIGS;
+    for (i = 0; i < sig_count; i++)
+    {
+        struct fex_chg_sig *c = &meter->chg[i], *t = &meter->chg_snap[i];
+
+        t->draws = vkd3d_atomic_uint32_exchange_explicit(&c->draws, 0, vkd3d_memory_order_relaxed);
+        if (!t->draws)
+            continue;
+        for (k = 0; k < FEX_CHG_CLASSES; k++)
+            t->cls[k] = vkd3d_atomic_uint32_exchange_explicit(&c->cls[k], 0, vkd3d_memory_order_relaxed);
+        t->pixel_any = vkd3d_atomic_uint32_exchange_explicit(&c->pixel_any, 0, vkd3d_memory_order_relaxed);
+        t->sent_set = vkd3d_atomic_uint32_exchange_explicit(&c->sent_set, 0, vkd3d_memory_order_relaxed);
+        t->sent_consts = vkd3d_atomic_uint32_exchange_explicit(&c->sent_consts, 0, vkd3d_memory_order_relaxed);
+        t->same = vkd3d_atomic_uint32_exchange_explicit(&c->same, 0, vkd3d_memory_order_relaxed);
+        t->unknown = vkd3d_atomic_uint32_exchange_explicit(&c->unknown, 0, vkd3d_memory_order_relaxed);
+        for (k = 0; k < FEX_CHG_PARAMS; k++)
+        {
+            t->param[k] = c->param[k] ? vkd3d_atomic_uint32_exchange_explicit(&c->param[k], 0,
+                    vkd3d_memory_order_relaxed) : 0;
+            t->param_ps[k] = c->param_ps[k] ? vkd3d_atomic_uint32_exchange_explicit(&c->param_ps[k], 0,
+                    vkd3d_memory_order_relaxed) : 0;
+            t->ptype[k] = c->ptype[k];
+        }
+
+        draws += t->draws;
+        sent_set += t->sent_set;
+        sent_consts += t->sent_consts;
+        same += t->same;
+        pixel_any += t->pixel_any;
+        for (j = top_count; j > 0 && meter->chg_snap[top[j - 1]].draws < t->draws; j--)
+        {
+            if (j < ARRAY_SIZE(top))
+                top[j] = top[j - 1];
+        }
+        if (j < ARRAY_SIZE(top))
+        {
+            top[j] = i;
+            if (top_count < ARRAY_SIZE(top))
+                top_count++;
+        }
+    }
+
+    if (meter->gpu_publishes > FEX_DRAW_FIRST_PUBLISH && meter->gpu_publishes <= 2 * FEX_DRAW_FIRST_PUBLISH)
+        len = vkd3d_fex_report_append(text, size, len,
+                "# gpu draw changes (VKD3D fex21), measured frames only, per kind of pass (size, c = color formats, ds ="
+                " depth format): the draws after the first of a pass by what changed since the draw before (the first"
+                " that applies): 'new PS' = a pipeline with another pixel shader, 'new pipeline' = same pixel shader,"
+                " 'PS data' = a root parameter the pixel shader reads (found in its SPIR-V) set to another value, 'VS"
+                " data only' = only root parameters it doesn't read, 're-sent only' = no other value but vkd3d sent a"
+                " push descriptor set or push constants anyway, 'dyn/buffers only' = only dynamic state (viewport,"
+                " stencil reference, ...) or vertex/index buffers set; 'PS data any' = PS data whatever else changed;"
+                " 'sent set/consts' = draws vkd3d sent a push descriptor set / push constants for (the driver then"
+                " writes the shader state of every stage anew); 'same' = Set*Root* calls with the value already set,"
+                " not sent again while 'skip same' is on (VKD3D_FEX_ROOT_DEDUPE: unset = on and off by turns every"
+                " second); params: #root parameter type/visibility, %% of the draws that changed it, 'read' = the"
+                " pixel shader reads it\n");
+
+    if (!draws)
+        return len;
+    len = vkd3d_fex_report_append(text, size, len,
+            "  gpu draw changes: skip same %s | draws=%"PRIu64" PS data any %.0f%% | sent set %.0f%% consts %.0f%% |"
+            " same %.2f/draw\n", dedupe_on ? "on" : "off", draws, 100.0 * pixel_any / draws,
+            100.0 * sent_set / draws, 100.0 * sent_consts / draws, (double)same / draws);
+
+    for (i = 0; i < top_count; i++)
+    {
+        const struct fex_chg_sig *t = &meter->chg_snap[top[i]];
+        uint32_t ptop[FEX_CHG_TOP_PARAMS], ptop_count = 0;
+        double d = t->draws;
+
+        len = vkd3d_fex_report_append(text, size, len, "  gpu draw changes ");
+        len = fex_chg_describe_sig(&meter->sigs[top[i]], text, size, len);
+        len = vkd3d_fex_report_append(text, size, len, ": draws=%u |", t->draws);
+        for (k = 0; k < FEX_CHG_CLASSES; k++)
+        {
+            if (t->cls[k])
+                len = vkd3d_fex_report_append(text, size, len, " %s %.0f%%", class_names[k], 100.0 * t->cls[k] / d);
+        }
+        len = vkd3d_fex_report_append(text, size, len, " | PS data any %.0f%% | sent set %.0f%% consts %.0f%% | same"
+                " %.2f/draw", 100.0 * t->pixel_any / d, 100.0 * t->sent_set / d, 100.0 * t->sent_consts / d,
+                t->same / d);
+        if (t->unknown)
+            len = vkd3d_fex_report_append(text, size, len, " | PS reads unknown %.0f%%", 100.0 * t->unknown / d);
+
+        for (k = 0; k < FEX_CHG_PARAMS; k++)
+        {
+            if (!t->param[k])
+                continue;
+            for (j = ptop_count; j > 0 && t->param[ptop[j - 1]] < t->param[k]; j--)
+            {
+                if (j < ARRAY_SIZE(ptop))
+                    ptop[j] = ptop[j - 1];
+            }
+            if (j < ARRAY_SIZE(ptop))
+            {
+                ptop[j] = k;
+                if (ptop_count < ARRAY_SIZE(ptop))
+                    ptop_count++;
+            }
+        }
+        if (ptop_count)
+            len = vkd3d_fex_report_append(text, size, len, " | params");
+        for (j = 0; j < ptop_count; j++)
+        {
+            uint32_t p = ptop[j], type = t->ptype[p] >> 4, vis = t->ptype[p] & 0xfu;
+
+            len = vkd3d_fex_report_append(text, size, len, "%s #%u %s/%s %.0f%%", j ? "," : "", p,
+                    type < ARRAY_SIZE(type_names) ? type_names[type] : "?",
+                    vis < ARRAY_SIZE(vis_names) ? vis_names[vis] : "other", 100.0 * t->param[p] / d);
+            if (t->param_ps[p] == t->param[p])
+                len = vkd3d_fex_report_append(text, size, len, " read");
+            else if (t->param_ps[p])
+                len = vkd3d_fex_report_append(text, size, len, " (read %.0f%%)", 100.0 * t->param_ps[p] / d);
+        }
+        len = vkd3d_fex_report_append(text, size, len, "\n");
+    }
+    return len;
+}
