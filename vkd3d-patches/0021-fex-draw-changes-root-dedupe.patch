+extern uint32_t vkd3d_fex_root_dedupe_now;
+static inline bool vkd3d_fex_root_dedupe_on(void)
+{
+    return vkd3d_atomic_uint32_load_explicit(&vkd3d_fex_root_dedupe_now, vkd3d_memory_order_relaxed) != 0;
+}
