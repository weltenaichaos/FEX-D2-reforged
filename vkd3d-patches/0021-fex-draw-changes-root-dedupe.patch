+/* VKD3D fex21: a kind of pass in a few characters: size, color formats (c), depth format (ds). */
+static size_t fex_chg_describe_sig(const struct fex_pass_sig *sig, char *buf, size_t size, size_t len)
+{
+    bool first = true;
+    unsigned int i;
+
+    len = vkd3d_fex_report_append(buf, size, len, "%ux%u", sig->width, sig->height);
+    if (sig->layers > 1)
+        len = vkd3d_fex_report_append(buf, size, len, "x%u", sig->layers);
+    for (i = 0; i < sig->color_count; i++)
+    {
+        if (!sig->color_bytes[i])
+            continue;
+        len = vkd3d_fex_report_append(buf, size, len, first ? " c%u" : ",%u", sig->color_dxgi[i]);
+        first = false;
+    }
+    if (sig->has_depth || sig->has_stencil)
+        len = vkd3d_fex_report_append(buf, size, len, " ds%u", sig->ds_dxgi);
+    if (sig->kind == VKD3D_FEX_PASS_KIND_RESUMED)
+        len = vkd3d_fex_report_append(buf, size, len, " resumed");
+    return len;
+}
