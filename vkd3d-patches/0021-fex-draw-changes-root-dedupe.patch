+/* VKD3D fex21: VKD3D_FEX_ROOT_DEDUPE. */
+void vkd3d_fex_root_dedupe_init(void)
+{
+    uint32_t mode = 2;
+    char env[16];
+
+    if (vkd3d_get_env_var("VKD3D_FEX_ROOT_DEDUPE", env, sizeof(env)))
+    {
+        if (!strcmp(env, "0"))
+            mode = 0;
+        else if (!strcmp(env, "1"))
+            mode = 1;
+    }
+    fex_root_dedupe_alt = mode == 2;
+    vkd3d_atomic_uint32_store_explicit(&vkd3d_fex_root_dedupe_now, mode ? 1u : 0u, vkd3d_memory_order_relaxed);
+    INFO("FEX: root parameters set again with the same value are %s.\n",
+            mode == 0 ? "sent again" : mode == 1 ? "not sent again" :
+            "not sent again (with the pass meter: on and off by turns every second)");
+}
+
+/* VKD3D fex21: which root parameters a pixel shader reads, from its SPIR-V. */
+#define FEX_SPV_OP_TYPE_POINTER 32u
+#define FEX_SPV_OP_CONSTANT 43u
+#define FEX_SPV_OP_FUNCTION_CALL 57u
+#define FEX_SPV_OP_VARIABLE 59u
+#define FEX_SPV_OP_IMAGE_TEXEL_POINTER 60u
+#define FEX_SPV_OP_LOAD 61u
+#define FEX_SPV_OP_ACCESS_CHAIN 65u
+#define FEX_SPV_OP_IN_BOUNDS_ACCESS_CHAIN 66u
+#define FEX_SPV_OP_PTR_ACCESS_CHAIN 67u
+#define FEX_SPV_OP_ARRAY_LENGTH 68u
+#define FEX_SPV_OP_IN_BOUNDS_PTR_ACCESS_CHAIN 70u
+#define FEX_SPV_OP_DECORATE 71u
+#define FEX_SPV_OP_MEMBER_DECORATE 72u
+#define FEX_SPV_OP_COPY_OBJECT 83u
+#define FEX_SPV_DECORATION_BINDING 33u
+#define FEX_SPV_DECORATION_DESCRIPTOR_SET 34u
+#define FEX_SPV_DECORATION_OFFSET 35u
+#define FEX_SPV_STORAGE_PUSH_CONSTANT 9u
+#define FEX_SPV_MAX_MEMBERS 64u
+
+/* Root parameters whose push constant bytes overlap [begin, end). */
+static uint64_t fex_spv_push_params(const struct d3d12_root_signature *rs, uint32_t begin, uint32_t end)
+{
+    uint64_t mask = 0;
+    uint32_t pb, pe;
+    unsigned int i;
+
+    for (i = 0; i < rs->parameter_count && i < 64; i++)
+    {
+        const struct vkd3d_shader_root_parameter *p = &rs->parameters[i];
+
+        if (p->parameter_type == D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE)
+        {
+            pb = rs->descriptor_table_offset + 4 * p->descriptor_table.table_index;
+            pe = pb + 4;
+        }
+        else if (p->parameter_type == D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS)
+        {
+            pb = 4 * p->constant.constant_index;
+            pe = pb + 4 * p->constant.constant_count;
+        }
+        else if (rs->root_descriptor_raw_va_mask & (1ull << i))
+        {
+            pb = 8 * p->descriptor.raw_va_root_descriptor_index;
+            pe = pb + 8;
+        }
+        else
+            continue;
+        if (pb < end && begin < pe)
+            mask |= 1ull << i;
+    }
+    return mask;
+}
+
+/* Variables count as read when an access chain, load, function call (or a few more) uses them; push constant bytes by
+ * the constant member index of their access chains (anything else: all of them). */
+static bool fex_spv_root_reads(const uint32_t *code, size_t words, const struct d3d12_root_signature *rs,
+        uint64_t *reads)
+{
+    uint32_t member_offset[FEX_SPV_MAX_MEMBERS], member_count = 0;
+    uint32_t *set_of, *binding_of, *pointee, *const_val;
+    uint32_t bound, push_var = 0, push_struct = 0;
+    uint64_t members_read = 0;
+    bool push_all = false, ok = true;
+    uint8_t *used, *const_ok;
+    uint32_t i, j, k, n, op;
+    size_t pos;
+
+    *reads = 0;
+    if (words < 5 || code[0] != 0x07230203u)
+        return false;
+    bound = code[3];
+    if (!bound || bound > (1u << 22))
+        return false;
+
+    set_of = vkd3d_malloc(bound * sizeof(*set_of));
+    binding_of = vkd3d_malloc(bound * sizeof(*binding_of));
+    pointee = vkd3d_calloc(bound, sizeof(*pointee));
+    const_val = vkd3d_calloc(bound, sizeof(*const_val));
+    used = vkd3d_calloc(bound, 1);
+    const_ok = vkd3d_calloc(bound, 1);
+    if (!set_of || !binding_of || !pointee || !const_val || !used || !const_ok)
+    {
+        ok = false;
+        goto done;
+    }
+    memset(set_of, 0xff, bound * sizeof(*set_of));
+    memset(binding_of, 0xff, bound * sizeof(*binding_of));
+
+#define FEX_SPV_ID(x) ((x) < bound)
+#define FEX_SPV_USE(x) do { if (FEX_SPV_ID(x)) { used[x] = 1; if ((x) == push_var && push_var) push_all = true; } } while (0)
+    for (pos = 5; pos < words; pos += n)
+    {
+        n = code[pos] >> 16;
+        op = code[pos] & 0xffffu;
+        if (!n || pos + n > words)
+        {
+            ok = false;
+            goto done;
+        }
+        switch (op)
+        {
+            case FEX_SPV_OP_DECORATE:
+                if (n >= 4 && FEX_SPV_ID(code[pos + 1]))
+                {
+                    if (code[pos + 2] == FEX_SPV_DECORATION_BINDING)
+                        binding_of[code[pos + 1]] = code[pos + 3];
+                    else if (code[pos + 2] == FEX_SPV_DECORATION_DESCRIPTOR_SET)
+                        set_of[code[pos + 1]] = code[pos + 3];
+                }
+                break;
+            case FEX_SPV_OP_TYPE_POINTER:
+                if (n >= 4 && FEX_SPV_ID(code[pos + 1]))
+                    pointee[code[pos + 1]] = code[pos + 3];
+                break;
+            case FEX_SPV_OP_CONSTANT:
+                if (n >= 4 && FEX_SPV_ID(code[pos + 2]))
+                {
+                    const_val[code[pos + 2]] = code[pos + 3];
+                    const_ok[code[pos + 2]] = 1;
+                }
+                break;
+            case FEX_SPV_OP_VARIABLE:
+                if (n >= 4 && code[pos + 3] == FEX_SPV_STORAGE_PUSH_CONSTANT && !push_var &&
+                        FEX_SPV_ID(code[pos + 1]) && FEX_SPV_ID(code[pos + 2]))
+                {
+                    push_var = code[pos + 2];
+                    push_struct = pointee[code[pos + 1]];
+                }
+                break;
+            case FEX_SPV_OP_LOAD:
+            case FEX_SPV_OP_COPY_OBJECT:
+            case FEX_SPV_OP_IMAGE_TEXEL_POINTER:
+            case FEX_SPV_OP_ARRAY_LENGTH:
+                if (n >= 4)
+                    FEX_SPV_USE(code[pos + 3]);
+                break;
+            case FEX_SPV_OP_ACCESS_CHAIN:
+            case FEX_SPV_OP_IN_BOUNDS_ACCESS_CHAIN:
+                if (n >= 4 && FEX_SPV_ID(code[pos + 3]))
+                {
+                    j = code[pos + 3];
+                    used[j] = 1;
+                    if (push_var && j == push_var)
+                    {
+                        if (n >= 5 && FEX_SPV_ID(code[pos + 4]) && const_ok[code[pos + 4]] &&
+                                const_val[code[pos + 4]] < FEX_SPV_MAX_MEMBERS)
+                            members_read |= 1ull << const_val[code[pos + 4]];
+                        else
+                            push_all = true;
+                    }
+                }
+                break;
+            case FEX_SPV_OP_PTR_ACCESS_CHAIN:
+            case FEX_SPV_OP_IN_BOUNDS_PTR_ACCESS_CHAIN:
+                if (n >= 4)
+                    FEX_SPV_USE(code[pos + 3]);
+                break;
+            case FEX_SPV_OP_FUNCTION_CALL:
+                for (k = 4; k < n; k++)
+                    FEX_SPV_USE(code[pos + k]);
+                break;
+            default:
+                break;
+        }
+    }
+#undef FEX_SPV_USE
+#undef FEX_SPV_ID
+
+    /* The push constant block's member offsets (decorations come before the variable, so a second look). */
+    if (push_var && push_struct && (members_read || push_all))
+    {
+        for (i = 0; i < FEX_SPV_MAX_MEMBERS; i++)
+            member_offset[i] = UINT32_MAX;
+        for (pos = 5; pos < words; pos += n)
+        {
+            n = code[pos] >> 16;
+            op = code[pos] & 0xffffu;
+            if (op == FEX_SPV_OP_MEMBER_DECORATE && n >= 5 && code[pos + 1] == push_struct &&
+                    code[pos + 3] == FEX_SPV_DECORATION_OFFSET && code[pos + 2] < FEX_SPV_MAX_MEMBERS)
+            {
+                member_offset[code[pos + 2]] = code[pos + 4];
+                if (code[pos + 2] + 1 > member_count)
+                    member_count = code[pos + 2] + 1;
+            }
+        }
+        if (push_all)
+            *reads |= fex_spv_push_params(rs, 0, UINT32_MAX);
+        for (i = 0; i < member_count && !push_all; i++)
+        {
+            uint32_t end = UINT32_MAX;
+
+            if (!(members_read & (1ull << i)))
+                continue;
+            if (member_offset[i] == UINT32_MAX)
+            {
+                *reads |= fex_spv_push_params(rs, 0, UINT32_MAX);
+                break;
+            }
+            /* A member reaches up to the next member's offset. */
+            for (j = 0; j < member_count; j++)
+            {
+                if (member_offset[j] != UINT32_MAX && member_offset[j] > member_offset[i] && member_offset[j] < end)
+                    end = member_offset[j];
+            }
+            *reads |= fex_spv_push_params(rs, member_offset[i], end);
+        }
+    }
+
+    /* Root descriptors (push descriptors) by descriptor set and binding; the push UBO stands for all push data. */
+    for (i = 0; i < bound; i++)
+    {
+        if (!used[i] || set_of[i] == UINT32_MAX || binding_of[i] == UINT32_MAX)
+            continue;
+        if ((rs->graphics.flags & VKD3D_ROOT_SIGNATURE_USE_PUSH_CONSTANT_UNIFORM_BLOCK) &&
+                set_of[i] == rs->push_constant_ubo_binding.set && binding_of[i] == rs->push_constant_ubo_binding.binding)
+            *reads |= fex_spv_push_params(rs, 0, UINT32_MAX);
+        for (j = 0; j < rs->parameter_count && j < 64; j++)
+        {
+            const struct vkd3d_shader_root_parameter *p = &rs->parameters[j];
+
+            if (p->parameter_type == D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE ||
+                    p->parameter_type == D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS ||
+                    (rs->root_descriptor_raw_va_mask & (1ull << j)) || !p->descriptor.binding)
+                continue;
+            if (p->descriptor.binding->binding.set == set_of[i] &&
+                    p->descriptor.binding->binding.binding == binding_of[i])
+                *reads |= 1ull << j;
+        }
+    }
+
+done:
+    vkd3d_free(set_of);
+    vkd3d_free(binding_of);
+    vkd3d_free(pointee);
+    vkd3d_free(const_val);
+    vkd3d_free(used);
+    vkd3d_free(const_ok);
+    return ok;
+}
+
+void vkd3d_fex_pso_root_reads(struct d3d12_pipeline_state *state)
+{
+    struct d3d12_graphics_pipeline_state *graphics = &state->graphics;
+    const struct vkd3d_shader_code *code = NULL;
+    unsigned int i;
+
+    graphics->fex_ps_root_reads = 0;
+    graphics->fex_ps_hash = 0;
+    graphics->fex_ps_reads_known = false;
+    if (!state->device->fex_pass_meter)
+        return;
+
+    for (i = 0; i < graphics->stage_count; i++)
+    {
+        if (graphics->cached_desc.bytecode_stages[i] == VK_SHADER_STAGE_FRAGMENT_BIT)
+            code = &graphics->code[i];
+    }
+    if (!code)
+    {
+        /* No pixel shader: nothing to read. */
+        graphics->fex_ps_reads_known = true;
+        return;
+    }
+    graphics->fex_ps_hash = code->meta.hash ? code->meta.hash : 1;
+    if (!state->root_signature || !code->code || code->size < 20)
+        return;
+    graphics->fex_ps_reads_known = fex_spv_root_reads(code->code, code->size / sizeof(uint32_t),
+            state->root_signature, &graphics->fex_ps_root_reads);
+}
