From 8d0ea9672422b3fd11498218f9da879b4ecca590 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 27 Oct 2026 19:35:45 +0000
Subject: [PATCH] FEX: count what each draw changes; skip root parameters set
 again with the same value

Adreno keeps only 2 copies of a stage's register state. Every D2R draw
makes Turnip write the pixel stage's state anew (each push descriptor
set is a new copy with a new address, push constants are written for
all stages), so a draw waits for the draw two back to finish its pixel
work. Whether a driver change that leaves the pixel stage alone for
vertex-only changes can pay depends on what D2R's draws change.

Pass meter, measured frames: each draw after the first of a pass is
counted per kind of pass by what changed since the draw before it
(another pipeline with or without another pixel shader, root
parameters the pixel shader reads, other root parameters only, sent
again only, dynamic state or buffers only, nothing), plus the draws
vkd3d sent a push descriptor set / push constants for and the Set*Root*
calls with an unchanged value. The pixel shader's root parameter reads
come from its SPIR-V (descriptor set/binding of the variables it uses,
push constant members by constant index). New 'gpu draw changes' lines
in the gpu report.

VKD3D_FEX_ROOT_DEDUPE: a Set*Root* call with the value already set no
longer marks the parameter to be sent (a dirty bit that is already set
stays). Unset = on and off by turns every second while the pass meter
runs, 1 = on, 0 = off.
---
 libs/vkd3d/command.c        |  93 +++++-
 libs/vkd3d/device.c         |   1 +
 libs/vkd3d/fex_pass_meter.c | 604 ++++++++++++++++++++++++++++++++++++
 libs/vkd3d/state.c          |   1 +
 libs/vkd3d/vkd3d_private.h  |  31 ++
 5 files changed, 725 insertions(+), 5 deletions(-)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index dc44b61..ea467b5 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -6644,6 +6644,14 @@ static bool d3d12_command_list_update_graphics_pipeline(struct d3d12_command_lis
     return true;
 }
 
+/* VKD3D fex21: the pass meter notes what vkd3d sent for the next draw. */
+static inline void d3d12_command_list_fex_sent(struct d3d12_command_list *list,
+        const struct vkd3d_pipeline_bindings *bindings, uint32_t flag)
+{
+    if (bindings == &list->graphics_bindings)
+        list->fex_pass.chg_flags |= flag;
+}
+
 static void d3d12_command_list_update_descriptor_table_offsets(struct d3d12_command_list *list,
         struct vkd3d_pipeline_bindings *bindings, VkPipelineLayout layout, VkShaderStageFlags push_stages)
 {
@@ -6672,6 +6680,7 @@ static void d3d12_command_list_update_descriptor_table_offsets(struct d3d12_comm
                 root_signature->descriptor_table_offset,
                 root_signature->descriptor_table_count * sizeof(uint32_t),
                 table_offsets));
+        d3d12_command_list_fex_sent(list, bindings, VKD3D_FEX_CHG_SENT_CONSTS);
     }
 
     bindings->dirty_flags &= ~VKD3D_PIPELINE_DIRTY_DESCRIPTOR_TABLE_OFFSETS;
@@ -6837,6 +6846,7 @@ static void d3d12_command_list_update_root_constants(struct d3d12_command_list *
                 root_constant->constant_index * sizeof(uint32_t),
                 root_constant->constant_count * sizeof(uint32_t),
                 &bindings->root_constants[root_constant->constant_index]));
+        d3d12_command_list_fex_sent(list, bindings, VKD3D_FEX_CHG_SENT_CONSTS);
     }
 }
 
@@ -6982,6 +6992,7 @@ static void d3d12_command_list_update_root_descriptors(struct d3d12_command_list
                 layout, push_stages,
                 0, va_count * sizeof(*root_parameter_data.root_descriptor_vas),
                 root_parameter_data.root_descriptor_vas));
+        d3d12_command_list_fex_sent(list, bindings, VKD3D_FEX_CHG_SENT_CONSTS);
     }
 
 #ifdef VKD3D_ENABLE_DESCRIPTOR_QA
@@ -7010,6 +7021,7 @@ static void d3d12_command_list_update_root_descriptors(struct d3d12_command_list
         VK_CALL(vkCmdPushDescriptorSetKHR(list->cmd.vk_command_buffer, vk_bind_point,
                 layout, root_signature->root_descriptor_set,
                 descriptor_write_count, descriptor_writes));
+        d3d12_command_list_fex_sent(list, bindings, VKD3D_FEX_CHG_SENT_SET);
     }
 }
 
@@ -7242,6 +7254,12 @@ static void d3d12_command_list_update_dynamic_state(struct d3d12_command_list *l
     /* Make sure we only update states that are dynamic in the pipeline */
     dyn_state->dirty_flags &= list->dynamic_state.active_flags;
 
+    /* VKD3D fex21: for the pass meter (the values may be the same as before). */
+    if (dyn_state->dirty_flags & VKD3D_DYNAMIC_STATE_VERTEX_BUFFER_STRIDE)
+        list->fex_pass.chg_flags |= VKD3D_FEX_CHG_BUFFERS;
+    if (dyn_state->dirty_flags & ~VKD3D_DYNAMIC_STATE_VERTEX_BUFFER_STRIDE)
+        list->fex_pass.chg_flags |= VKD3D_FEX_CHG_DYNAMIC;
+
     if (dyn_state->viewport_count)
     {
         if (dyn_state->dirty_flags & VKD3D_DYNAMIC_STATE_VIEWPORT)
@@ -8038,6 +8056,7 @@ static bool d3d12_command_list_update_index_buffer(struct d3d12_command_list *li
                     list->index_buffer.offset, list->index_buffer.vk_type));
         }
         list->index_buffer.is_dirty = false;
+        list->fex_pass.chg_flags |= VKD3D_FEX_CHG_BUFFERS;
     }
 
     return true;
@@ -12070,6 +12089,21 @@ static void STDMETHODCALLTYPE d3d12_command_list_SetGraphicsRootSignature(d3d12_
             impl_from_ID3D12RootSignature(root_signature));
 }
 
+/* VKD3D fex21: a Set*Root* call. Notes for the pass meter what the next draw changes; same = the value was already
+ * set. The callers then skip marking the parameter to be sent again when same and VKD3D_FEX_ROOT_DEDUPE is on. That is
+ * safe because whatever makes the sent state differ from the bindings (a new root signature, another bind point,
+ * vkd3d's own shaders, a new command buffer) sets the dirty bits itself, and those stay set. */
+static inline void d3d12_command_list_fex_root_set(struct d3d12_command_list *list,
+        const struct vkd3d_pipeline_bindings *bindings, unsigned int index, bool same)
+{
+    if (bindings != &list->graphics_bindings)
+        return;
+    if (same)
+        list->fex_pass.chg_same++;
+    else if (index < 64)
+        list->fex_pass.chg_params |= 1ull << index;
+}
+
 static inline void d3d12_command_list_set_descriptor_table_embedded(struct d3d12_command_list *list,
         struct vkd3d_pipeline_bindings *bindings, unsigned int index,
         D3D12_GPU_DESCRIPTOR_HANDLE base_descriptor,
@@ -12077,14 +12111,20 @@ static inline void d3d12_command_list_set_descriptor_table_embedded(struct d3d12
         unsigned int sampler_size_log2)
 {
     const struct d3d12_root_signature *root_signature = bindings->root_signature;
+    uint32_t old_offset;
+    bool same;
 
     assert(index < ARRAY_SIZE(bindings->descriptor_tables));
+    old_offset = bindings->descriptor_tables[index];
     bindings->descriptor_tables[index] = d3d12_desc_heap_offset_from_embedded_gpu_handle(
             base_descriptor, cbv_srv_uav_size_log2, sampler_size_log2);
 
     if (root_signature)
     {
-        if (root_signature->descriptor_table_count)
+        /* VKD3D fex21: all table offsets are sent together, so they match what was sent while the flag is clear. */
+        same = old_offset == bindings->descriptor_tables[index];
+        d3d12_command_list_fex_root_set(list, bindings, index, same);
+        if (root_signature->descriptor_table_count && (!same || !vkd3d_fex_root_dedupe_on()))
             bindings->dirty_flags |= VKD3D_PIPELINE_DIRTY_DESCRIPTOR_TABLE_OFFSETS;
         if (root_signature->hoist_info.num_desc)
             bindings->dirty_flags |= VKD3D_PIPELINE_DIRTY_HOISTED_DESCRIPTORS;
@@ -12099,13 +12139,19 @@ static inline void d3d12_command_list_set_descriptor_table(struct d3d12_command_
         struct vkd3d_pipeline_bindings *bindings, unsigned int index, D3D12_GPU_DESCRIPTOR_HANDLE base_descriptor)
 {
     const struct d3d12_root_signature *root_signature = bindings->root_signature;
+    uint32_t old_offset;
+    bool same;
 
     assert(index < ARRAY_SIZE(bindings->descriptor_tables));
+    old_offset = bindings->descriptor_tables[index];
     bindings->descriptor_tables[index] = d3d12_desc_heap_offset_from_gpu_handle(base_descriptor);
 
     if (root_signature)
     {
-        if (root_signature->descriptor_table_count)
+        /* VKD3D fex21: all table offsets are sent together, so they match what was sent while the flag is clear. */
+        same = old_offset == bindings->descriptor_tables[index];
+        d3d12_command_list_fex_root_set(list, bindings, index, same);
+        if (root_signature->descriptor_table_count && (!same || !vkd3d_fex_root_dedupe_on()))
             bindings->dirty_flags |= VKD3D_PIPELINE_DIRTY_DESCRIPTOR_TABLE_OFFSETS;
         if (root_signature->hoist_info.num_desc)
             bindings->dirty_flags |= VKD3D_PIPELINE_DIRTY_HOISTED_DESCRIPTORS;
@@ -12231,11 +12277,17 @@ static void d3d12_command_list_set_root_constants(struct d3d12_command_list *lis
     const struct d3d12_root_signature *root_signature = bindings->root_signature;
     const struct vkd3d_shader_root_constant *c;
     VKD3D_UNUSED unsigned int i;
+    bool same;
 
     c = root_signature_get_32bit_constants(root_signature, index);
-    memcpy(&bindings->root_constants[c->constant_index + offset], data, count * sizeof(uint32_t));
+    /* VKD3D fex21: root constants are sent from these values, so they match what was sent while the bit is clear. */
+    same = !memcmp(&bindings->root_constants[c->constant_index + offset], data, count * sizeof(uint32_t));
+    if (!same)
+        memcpy(&bindings->root_constants[c->constant_index + offset], data, count * sizeof(uint32_t));
+    d3d12_command_list_fex_root_set(list, bindings, index, same);
 
-    bindings->root_constant_dirty_mask |= 1ull << index;
+    if (!same || !vkd3d_fex_root_dedupe_on())
+        bindings->root_constant_dirty_mask |= 1ull << index;
 
 #ifdef VKD3D_ENABLE_BREADCRUMBS
     for (i = 0; i < count; i++)
@@ -12380,17 +12432,48 @@ static void d3d12_command_list_set_root_descriptor_va(struct d3d12_command_list
     descriptor->info.va = gpu_address;
 }
 
+/* VKD3D fex21: the same descriptor as before. */
+static bool vkd3d_fex_root_descriptor_equal(const struct vkd3d_root_descriptor_info *a,
+        const struct vkd3d_root_descriptor_info *b)
+{
+    if (a->vk_descriptor_type != b->vk_descriptor_type)
+        return false;
+    switch (a->vk_descriptor_type)
+    {
+        case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+        case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+            return a->info.buffer.buffer == b->info.buffer.buffer && a->info.buffer.offset == b->info.buffer.offset &&
+                    a->info.buffer.range == b->info.buffer.range;
+        case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+        case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+            return a->info.buffer_view == b->info.buffer_view;
+        case VK_DESCRIPTOR_TYPE_MAX_ENUM:
+            return a->info.va == b->info.va;
+        default:
+            return false;
+    }
+}
+
 static void d3d12_command_list_set_root_descriptor(struct d3d12_command_list *list,
         struct vkd3d_pipeline_bindings *bindings, unsigned int index, D3D12_GPU_VIRTUAL_ADDRESS gpu_address)
 {
     struct vkd3d_root_descriptor_info *descriptor = &bindings->root_descriptors[index];
+    struct vkd3d_root_descriptor_info old_descriptor = *descriptor;
+    bool same;
 
     if (bindings->root_signature->root_descriptor_raw_va_mask & (1ull << index))
         d3d12_command_list_set_root_descriptor_va(list, descriptor, gpu_address);
     else
         d3d12_command_list_set_push_descriptor_info(list, bindings, index, gpu_address);
 
-    bindings->root_descriptor_dirty_mask |= 1ull << index;
+    /* VKD3D fex21: dirty root descriptors are sent from these values (active ones; raw VAs all together), so an active
+     * one matches what was sent while its bit is clear. */
+    same = (bindings->root_descriptor_active_mask & (1ull << index)) &&
+            vkd3d_fex_root_descriptor_equal(&old_descriptor, descriptor);
+    d3d12_command_list_fex_root_set(list, bindings, index, same);
+
+    if (!same || !vkd3d_fex_root_dedupe_on())
+        bindings->root_descriptor_dirty_mask |= 1ull << index;
     bindings->root_descriptor_active_mask |= 1ull << index;
 
     VKD3D_BREADCRUMB_AUX32(index);
diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 96861f2..baee92a 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -10066,6 +10066,7 @@ static HRESULT d3d12_device_init(struct d3d12_device *device,
     device->fex_ds_store_none = vkd3d_fex_ds_store_none_enabled();
     vkd3d_fex_timeline_init();
     vkd3d_fex_shader_copy_init();
+    vkd3d_fex_root_dedupe_init();
     device->fex_pass_meter = vkd3d_fex_pass_meter_init(device);
 
     hash_map_init(&device->vertex_input_pipelines,
diff --git a/libs/vkd3d/fex_pass_meter.c b/libs/vkd3d/fex_pass_meter.c
index e25d160..b2bc869 100644
--- a/libs/vkd3d/fex_pass_meter.c
+++ b/libs/vkd3d/fex_pass_meter.c
@@ -38,6 +38,14 @@
  * submissions. Results are reset from the CPU once read (when the driver can): a pair used again can't show the
  * timestamps of its earlier use before the GPU wrote the new ones (before fex11 it could, once the pool wrapped).
  *
+ * Draw changes (VKD3D fex21), in the measured frames: what each draw after the first of a pass changed since the draw
+ * before it, counted per kind of pass: another pipeline (with another pixel shader or not), root parameters set to
+ * another value (split by whether the pixel shader reads them: its SPIR-V is scanned when the pipeline is made),
+ * dynamic state and vertex/index buffers, and whether vkd3d sent a push descriptor set or push constants for the
+ * draw. Adreno keeps only 2 copies of a stage's state, so every draw that makes the driver write the pixel stage's
+ * state anew has to wait for the draw two back to finish its pixel work. A Set*Root* call with the value already set
+ * doesn't make vkd3d send it again (VKD3D_FEX_ROOT_DEDUPE, on and off by turns every second by default).
+ *
  * This library is free software; you can redistribute it and/or
  * modify it under the terms of the GNU Lesser General Public
  * License as published by the Free Software Foundation; either
@@ -79,6 +87,32 @@
 
 #define FEX_PASS_EVERY_LIGHT 8u      /* VKD3D_FEX_PASSES=1: 1 frame in this many gets GPU timers */
 
+/* Draw changes (VKD3D fex21). */
+#define FEX_CHG_SIGS 256u          /* kinds of pass counted (by signature index) */
+#define FEX_CHG_PARAMS 64u
+#define FEX_CHG_CLASSES 7u
+#define FEX_CHG_TOP_KINDS 3u
+#define FEX_CHG_TOP_PARAMS 6u
+
+/* Counted by the recording threads (atomics), taken by the meter thread once a second. */
+struct fex_chg_sig
+{
+    uint32_t draws;                    /* draws after the first of a pass */
+    uint32_t cls[FEX_CHG_CLASSES];     /* the first that applies: another pixel shader, another pipeline with the same
+                                        * pixel shader, root parameters the pixel shader reads, other root parameters
+                                        * only, sent again only, dynamic state or buffers only, nothing */
+    uint32_t pixel_any;                /* draws that changed a root parameter the pixel shader reads, whatever else */
+    uint32_t sent_set, sent_consts;    /* draws vkd3d sent a push descriptor set / push constants for */
+    uint32_t same;                     /* Set*Root* calls with the value already set */
+    uint32_t unknown;                  /* draws whose pipeline's pixel shader reads weren't known (visibility used) */
+    uint32_t param[FEX_CHG_PARAMS];    /* draws that changed this root parameter */
+    uint32_t param_ps[FEX_CHG_PARAMS]; /* ... while the pixel shader reads it */
+    uint8_t ptype[FEX_CHG_PARAMS];     /* root parameter type << 4 | shader visibility (15 = other), last seen */
+};
+
+uint32_t vkd3d_fex_root_dedupe_now = 1u;
+static bool fex_root_dedupe_alt;       /* on and off by turns every second while the meter runs */
+
 #define FEX_DRAW_FLAG_DIRECT 0x1u   /* vertices known on the CPU */
 #define FEX_DRAW_FLAG_NEW_PSO 0x2u  /* another VkPipeline than the draw before */
 
@@ -244,6 +278,10 @@ struct vkd3d_fex_pass_meter
     uint64_t list_waits, list_wait_ticks, list_wait_max;
     struct vkd3d_fex_transfer_totals xfer;
     uint32_t gpu_publishes;
+
+    /* VKD3D fex21 */
+    struct fex_chg_sig chg[FEX_CHG_SIGS];
+    struct fex_chg_sig chg_snap[FEX_CHG_SIGS]; /* the meter thread's copy */
 };
 
 static const char *fex_pass_op_name(uint8_t op)
@@ -689,6 +727,11 @@ void vkd3d_fex_pass_meter_begin_pass(struct d3d12_command_list *list, const VkRe
     pipelines = list->fex_pass.binds;
     list->fex_pass.binds = 0;
 
+    /* Draw changes count from the pass's first draw on. */
+    list->fex_pass.chg_params = 0;
+    list->fex_pass.chg_flags = 0;
+    list->fex_pass.chg_same = 0;
+
     memset(current, 0, sizeof(*current));
     current->pair = fex_pass_alloc_pair(list);
     current->sig = fex_pass_intern_sig(meter, &sig);
@@ -764,6 +807,15 @@ void vkd3d_fex_pass_meter_vertices(struct d3d12_command_list *list, uint64_t ver
 
 void vkd3d_fex_pass_meter_pipeline_bind(struct d3d12_command_list *list)
 {
+    uint64_t ps_hash = list->state ? list->state->graphics.fex_ps_hash : 0;
+
+    list->fex_pass.chg_flags |= VKD3D_FEX_CHG_PIPELINE;
+    if (ps_hash != list->fex_pass.last_ps_hash)
+    {
+        list->fex_pass.chg_flags |= VKD3D_FEX_CHG_NEW_PS;
+        list->fex_pass.last_ps_hash = ps_hash;
+    }
+
     if (list->fex_pass.pass_active)
         list->fex_pass.current.pipelines++;
     else
@@ -780,10 +832,106 @@ void vkd3d_fex_pass_meter_game_query_heap(struct d3d12_device *device, D3D12_QUE
         INFO("FEX pass meter: the game uses pipeline statistics, not sampling them any more.\n");
 }
 
+static uint32_t fex_chg_visibility(const struct vkd3d_shader_root_parameter *p)
+{
+    enum vkd3d_shader_visibility vis = VKD3D_SHADER_VISIBILITY_ALL;
+
+    if (p->parameter_type == D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE)
+    {
+        if (p->descriptor_table.binding_count && p->descriptor_table.first_binding)
+            vis = p->descriptor_table.first_binding->shader_visibility;
+    }
+    else if (p->parameter_type != D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS)
+    {
+        if (p->descriptor.binding)
+            vis = p->descriptor.binding->shader_visibility;
+    }
+    return (uint32_t)vis <= VKD3D_SHADER_VISIBILITY_MESH ? (uint32_t)vis : 15u;
+}
+
+/* VKD3D fex21: what this draw changed since the draw before it, for a measured pass. */
+static void fex_chg_count(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    const struct d3d12_root_signature *rs = list->graphics_bindings.root_signature;
+    const struct d3d12_graphics_pipeline_state *graphics = NULL;
+    uint32_t flags = list->fex_pass.chg_flags;
+    uint64_t params = list->fex_pass.chg_params;
+    struct fex_chg_sig *c;
+    bool pixel = false;
+    uint32_t cls, i;
+    bool known;
+
+    if (!meter || list->fex_pass.current.sig >= FEX_CHG_SIGS)
+        return;
+    c = &meter->chg[list->fex_pass.current.sig];
+    if (list->state && list->state->pipeline_type != VKD3D_PIPELINE_TYPE_COMPUTE)
+        graphics = &list->state->graphics;
+    known = graphics && graphics->fex_ps_reads_known;
+    if (!rs)
+        params = 0;
+
+    while (params)
+    {
+        const struct vkd3d_shader_root_parameter *p;
+        uint32_t vis;
+        bool reads;
+
+        i = vkd3d_bitmask_iter64(&params);
+        if (i >= rs->parameter_count || i >= FEX_CHG_PARAMS)
+            continue;
+        p = &rs->parameters[i];
+        vis = fex_chg_visibility(p);
+        reads = known ? !!(graphics->fex_ps_root_reads & (1ull << i)) :
+                (vis == VKD3D_SHADER_VISIBILITY_ALL || vis == VKD3D_SHADER_VISIBILITY_PIXEL);
+        vkd3d_atomic_uint32_add(&c->param[i], 1, vkd3d_memory_order_relaxed);
+        if (reads)
+        {
+            pixel = true;
+            vkd3d_atomic_uint32_add(&c->param_ps[i], 1, vkd3d_memory_order_relaxed);
+        }
+        c->ptype[i] = (uint8_t)(((uint32_t)p->parameter_type << 4) | vis);
+    }
+
+    if (flags & VKD3D_FEX_CHG_NEW_PS)
+        cls = 0;
+    else if (flags & VKD3D_FEX_CHG_PIPELINE)
+        cls = 1;
+    else if (pixel)
+        cls = 2;
+    else if (list->fex_pass.chg_params)
+        cls = 3;
+    else if (flags & (VKD3D_FEX_CHG_SENT_SET | VKD3D_FEX_CHG_SENT_CONSTS))
+        cls = 4;
+    else if (flags & (VKD3D_FEX_CHG_DYNAMIC | VKD3D_FEX_CHG_BUFFERS))
+        cls = 5;
+    else
+        cls = 6;
+
+    vkd3d_atomic_uint32_add(&c->draws, 1, vkd3d_memory_order_relaxed);
+    vkd3d_atomic_uint32_add(&c->cls[cls], 1, vkd3d_memory_order_relaxed);
+    if (pixel)
+        vkd3d_atomic_uint32_add(&c->pixel_any, 1, vkd3d_memory_order_relaxed);
+    if (flags & VKD3D_FEX_CHG_SENT_SET)
+        vkd3d_atomic_uint32_add(&c->sent_set, 1, vkd3d_memory_order_relaxed);
+    if (flags & VKD3D_FEX_CHG_SENT_CONSTS)
+        vkd3d_atomic_uint32_add(&c->sent_consts, 1, vkd3d_memory_order_relaxed);
+    if (list->fex_pass.chg_same)
+        vkd3d_atomic_uint32_add(&c->same, list->fex_pass.chg_same, vkd3d_memory_order_relaxed);
+    if (!known)
+        vkd3d_atomic_uint32_add(&c->unknown, 1, vkd3d_memory_order_relaxed);
+}
+
 void vkd3d_fex_pass_meter_draw(struct d3d12_command_list *list)
 {
     if (list->fex_pass.pass_active)
+    {
         list->fex_pass.current.draws++;
+        fex_chg_count(list);
+    }
+    list->fex_pass.chg_params = 0;
+    list->fex_pass.chg_flags = 0;
+    list->fex_pass.chg_same = 0;
