+/* VKD3D fex21: what a draw changed since the draw before it (fex_pass.chg_flags). */
+#define VKD3D_FEX_CHG_PIPELINE 0x1u     /* another VkPipeline bound */
+#define VKD3D_FEX_CHG_NEW_PS 0x2u       /* ... with another pixel shader */
+#define VKD3D_FEX_CHG_DYNAMIC 0x4u      /* dynamic state set: viewport, scissor, stencil reference, depth bias, ... */
+#define VKD3D_FEX_CHG_BUFFERS 0x8u      /* vertex or index buffers bound */
+#define VKD3D_FEX_CHG_SENT_SET 0x10u    /* vkCmdPushDescriptorSetKHR: root descriptors sent */
