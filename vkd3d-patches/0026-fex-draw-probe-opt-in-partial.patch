From 416587ad918e91bf5396e60bcddfc6580a7a7120 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 27 Oct 2026 22:29:35 +0000
Subject: [PATCH] FEX: draw probe only when asked for, results after every test

With GameNative's frame cap layer off, the fex24 probe ran 11 tests and
D2R ended during the 12th ('lit, one multi-draw call'); its results were
lost because the note was only written at the end. The probe now runs
only with VKD3D_FEX_DRAW_PROBE=1 (2 adds the lit multi-draw test, whose
pixel shader is otherwise not even compiled), and the progress line
carries the results so far after every test, so a crash in a later test
keeps them in the log.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WZVGoVEaHJ78mpf2D3MiER
---
 libs/vkd3d/fex_draw_probe.c | 143 ++++++++++++++++++++++++++----------
 1 file changed, 106 insertions(+), 37 deletions(-)

diff --git a/libs/vkd3d/fex_draw_probe.c b/libs/vkd3d/fex_draw_probe.c
index 0c7bff0..2e333a8 100644
--- a/libs/vkd3d/fex_draw_probe.c
+++ b/libs/vkd3d/fex_draw_probe.c
@@ -1,5 +1,5 @@
 /*
- * FEX draw probe (VKD3D fex23-fex25): times on the GPU how long small draws take when they are recorded in different
+ * FEX draw probe (VKD3D fex23-fex26): times on the GPU how long small draws take when they are recorded in different
  * ways, and puts the result in a '#' note of the gpu report (FEX's stats log). It answers whether D2R's draws are slow
  * on Adreno because of what changes before every draw (new push constants and new root constant buffers, which Turnip
  * turns into new register values for every draw) or because of the draws themselves, and whether drawing many objects
@@ -18,7 +18,10 @@
  * test it was. A test that fails stops the probe; the note then gives the tests done so far and where it stopped.
  * fex25: the probe's device also enables VK_KHR_swapchain, which GameNative's frame cap layer needs from every device
  * (see fex_probe_create_device); fex24 crashed the game's next present without it.
- * Runs while the pass meter runs (VKD3D_FEX_PASSES); VKD3D_FEX_DRAW_PROBE=0 turns it off.
+ * fex26: off unless asked for (VKD3D_FEX_DRAW_PROBE=1), as with the layer off fex24 ran 11 tests and the game ended
+ * during the 12th ('lit, one multi-draw call'); that test runs only with VKD3D_FEX_DRAW_PROBE=2. The results so far go
+ * into the log after every test, so a crash in a later test keeps them.
+ * Runs only with VKD3D_FEX_DRAW_PROBE=1 or 2, and only while the pass meter runs (VKD3D_FEX_PASSES).
  *
  * The shaders (fex_draw_probe_spv.h, glslangValidator -V --target-env vulkan1.1):
  *
@@ -188,6 +191,7 @@ struct fex_probe_setup
     double ns_per_tick;
     bool multi_draw;
     uint32_t delay_ms;
+    uint32_t test_count;    /* tests to run: all but the lit multi-draw one unless VKD3D_FEX_DRAW_PROBE=2 */
 };
 
 struct fex_probe
@@ -231,6 +235,11 @@ static char fex_probe_text[2560];
 static uint32_t fex_probe_started;  /* once per process */
 static uint32_t fex_probe_progress; /* phase << 8 | test running */
 static uint32_t fex_probe_published; /* result notes put in a report so far (meter thread only) */
+static uint32_t fex_probe_test_count = FEX_PROBE_T_COUNT;
+/* The results so far, for the progress line: the probe thread writes the slot not shown and then switches to it (a
+ * test takes over a second, the meter thread copies the text within its report). */
+static char fex_probe_partial[2][1024];
+static uint32_t fex_probe_partial_slot; /* 0 = none yet, else slot + 1 */
 
 static void fex_probe_set_progress(enum fex_probe_phase phase, uint32_t test)
 {
@@ -252,8 +261,14 @@ size_t vkd3d_fex_draw_probe_append(char *text, size_t size, size_t len, uint32_t
             return vkd3d_fex_report_append(text, size, len,
                     "  draw probe: making its own GPU device, target and pipelines\n");
         case FEX_PROBE_TESTING:
-            return vkd3d_fex_report_append(text, size, len, "  draw probe: test %u of %u running (%s)\n",
-                    test + 1, FEX_PROBE_T_COUNT, test < FEX_PROBE_T_COUNT ? fex_probe_test_names[test] : "?");
+        {
+            uint32_t slot = vkd3d_atomic_uint32_load_explicit(&fex_probe_partial_slot, vkd3d_memory_order_acquire);
+
+            return vkd3d_fex_report_append(text, size, len, "  draw probe: test %u of %u running (%s)%s%s\n",
+                    test + 1, fex_probe_test_count, test < FEX_PROBE_T_COUNT ? fex_probe_test_names[test] : "?",
+                    slot ? " | done so far, GPU us per draw (slowest round): " : "",
+                    slot ? fex_probe_partial[(slot - 1) & 1] : "");
+        }
         case FEX_PROBE_DONE:
             /* After the pass meter's own notes (reports 1-30), which leave no room for it in the 4 KB report. */
             if (gpu_publishes <= 30 || fex_probe_published >= 3)
@@ -265,12 +280,17 @@ size_t vkd3d_fex_draw_probe_append(char *text, size_t size, size_t len, uint32_t
     }
 }
 
-/* The text's length after snprintf wrote n more characters at len (it cuts at the end of the buffer). */
-static size_t fex_probe_len(size_t len, int n)
+/* The text's length after snprintf wrote n more characters at len into a buffer of 'size' (it cuts at the end). */
+static size_t fex_probe_len_in(size_t size, size_t len, int n)
 {
     if (n < 0)
         return len;
-    return len + (size_t)n >= sizeof(fex_probe_text) ? sizeof(fex_probe_text) - 1 : len + (size_t)n;
+    return len + (size_t)n >= size ? size - 1 : len + (size_t)n;
+}
+
+static size_t fex_probe_len(size_t len, int n)
+{
+    return fex_probe_len_in(sizeof(fex_probe_text), len, n);
 }
 
 static void fex_probe_sleep_ms(uint32_t ms)
@@ -584,6 +604,9 @@ static bool fex_probe_create_pipelines(struct fex_probe *p)
     {
         if ((i == 3 || i == 5) && !p->setup.multi_draw)
             continue;
+        /* The lit multi-draw test's pixel shader only when that test runs. */
+        if (i == 5 && p->setup.test_count <= FEX_PROBE_T_LIT_MULTI_DRAW)
+            continue;
         memset(&module_info, 0, sizeof(module_info));
         module_info.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
         module_info.codeSize = spirv[i].size;
@@ -1010,13 +1033,14 @@ static void fex_probe_destroy(struct fex_probe *p)
     p->vk_device = VK_NULL_HANDLE;
 }
 
-/* The result note: 'status' says how the probe ended when it didn't finish. */
-static void fex_probe_report(struct fex_probe *p, uint64_t cpu_ns, const char *status)
+/* Each test's GPU time per draw into buf at len: the tests done, and with 'all' also the ones not run ('-') or left
+ * out ('off'). */
+static size_t fex_probe_values(const struct fex_probe *p, char *buf, size_t size, size_t len, bool all)
 {
     uint64_t best[FEX_PROBE_T_COUNT], worst[FEX_PROBE_T_COUNT];
-    double empty_us = 0.0;
-    uint32_t round, test;
-    size_t len;
+    const double us_per_tick = p->setup.ns_per_tick / 1000.0;
+    uint32_t round, test, shown = 0;
+    const char *sep;
 
     for (test = 0; test < p->tests_done; test++)
     {
@@ -1030,34 +1054,72 @@ static void fex_probe_report(struct fex_probe *p, uint64_t cpu_ns, const char *s
                 worst[test] = p->ticks[test][round];
         }
     }
-    if (p->tests_done)
-        empty_us = best[FEX_PROBE_T_EMPTY] * p->setup.ns_per_tick / 1000.0;
-
-    len = fex_probe_len(0, snprintf(fex_probe_text, sizeof(fex_probe_text),
-            "# draw probe (VKD3D fex25): GPU time per draw, 1000 small draws per test (8-pixel triangles into a"
-            " 2048x2048 target, one render pass per round, best of %u rounds, slowest round in brackets, the empty"
-            " pass's own %.0f us taken off; on a GPU device of its own, %.1f s after the game's was made, took %.1f s; "
-            "VKD3D_FEX_DRAW_PROBE=0 turns it off)%s%s: ", FEX_PROBE_ROUNDS, empty_us, p->setup.delay_ms / 1000.0,
-            cpu_ns / 1e9, status ? " " : "", status ? status : ""));
 
     for (test = FEX_PROBE_T_EMPTY + 1; test < FEX_PROBE_T_COUNT; test++)
     {
-        const bool last = test + 1 == FEX_PROBE_T_COUNT;
-
-        if (test >= p->tests_done)
-            len = fex_probe_len(len, snprintf(fex_probe_text + len, sizeof(fex_probe_text) - len, "%s -%s",
-                    fex_probe_test_names[test], last ? "\n" : " | "));
+        if (!all && test >= p->tests_done)
+            break;
+        sep = shown++ ? " | " : "";
+        if (test >= p->setup.test_count)
+            len = fex_probe_len_in(size, len, snprintf(buf + len, size - len, "%s%s off (VKD3D_FEX_DRAW_PROBE=2"
+                    " runs it)", sep, fex_probe_test_names[test]));
+        else if (test >= p->tests_done)
+            len = fex_probe_len_in(size, len, snprintf(buf + len, size - len, "%s%s -", sep,
+                    fex_probe_test_names[test]));
         else if (!p->pipelines[fex_probe_test_pipeline(test)])
-            len = fex_probe_len(len, snprintf(fex_probe_text + len, sizeof(fex_probe_text) - len,
-                    "%s n/a (no multi-draw)%s", fex_probe_test_names[test], last ? "\n" : " | "));
+            len = fex_probe_len_in(size, len, snprintf(buf + len, size - len, "%s%s n/a (no multi-draw)", sep,
+                    fex_probe_test_names[test]));
         else
-            len = fex_probe_len(len, snprintf(fex_probe_text + len, sizeof(fex_probe_text) - len,
-                    "%s %.2f us (%.2f)%s", fex_probe_test_names[test],
-                    ((double)best[test] - (double)best[FEX_PROBE_T_EMPTY]) * p->setup.ns_per_tick / 1000.0
-                    / FEX_PROBE_DRAWS,
-                    ((double)worst[test] - (double)best[FEX_PROBE_T_EMPTY]) * p->setup.ns_per_tick / 1000.0
-                    / FEX_PROBE_DRAWS, last ? "\n" : " | "));
+            len = fex_probe_len_in(size, len, snprintf(buf + len, size - len, "%s%s %.2f us (%.2f)", sep,
+                    fex_probe_test_names[test],
+                    ((double)best[test] - (double)best[FEX_PROBE_T_EMPTY]) * us_per_tick / FEX_PROBE_DRAWS,
+                    ((double)worst[test] - (double)best[FEX_PROBE_T_EMPTY]) * us_per_tick / FEX_PROBE_DRAWS));
     }
+    if (!shown && p->tests_done)
+        len = fex_probe_len_in(size, len, snprintf(buf + len, size - len, "empty pass %.0f us",
+                best[FEX_PROBE_T_EMPTY] * us_per_tick));
+    return len;
+}
+
+/* After each test: the results so far for the progress line (kept in the log even if a later test ends the game). */
+static void fex_probe_publish_partial(const struct fex_probe *p)
+{
+    uint32_t slot = vkd3d_atomic_uint32_load_explicit(&fex_probe_partial_slot, vkd3d_memory_order_acquire);
+    uint32_t next = slot ? slot & 1 : 0; /* the slot not shown now */
+    size_t len;
+
+    len = fex_probe_values(p, fex_probe_partial[next], sizeof(fex_probe_partial[next]), 0, false);
+    fex_probe_partial[next][len] = 0;
+    vkd3d_atomic_uint32_store_explicit(&fex_probe_partial_slot, next + 1, vkd3d_memory_order_release);
+}
+
+/* The result note: 'status' says how the probe ended when it didn't finish. */
+static void fex_probe_report(struct fex_probe *p, uint64_t cpu_ns, const char *status)
+{
+    double empty_us = 0.0;
+    uint64_t best;
+    uint32_t round;
+    size_t len;
+
+    if (p->tests_done)
+    {
+        best = UINT64_MAX;
+        for (round = 0; round < FEX_PROBE_ROUNDS; round++)
+        {
+            if (p->ticks[FEX_PROBE_T_EMPTY][round] < best)
+                best = p->ticks[FEX_PROBE_T_EMPTY][round];
+        }
+        empty_us = best * p->setup.ns_per_tick / 1000.0;
+    }
+
+    len = fex_probe_len(0, snprintf(fex_probe_text, sizeof(fex_probe_text),
+            "# draw probe (VKD3D fex26): GPU time per draw, 1000 small draws per test (8-pixel triangles into a"
+            " 2048x2048 target, one render pass per round, best of %u rounds, slowest round in brackets, the empty"
+            " pass's own %.0f us taken off; on a GPU device of its own, %.1f s after the game's was made, took %.1f s;"
+            " runs with VKD3D_FEX_DRAW_PROBE=1)%s%s: ", FEX_PROBE_ROUNDS, empty_us, p->setup.delay_ms / 1000.0,
+            cpu_ns / 1e9, status ? " " : "", status ? status : ""));
+    len = fex_probe_values(p, fex_probe_text, sizeof(fex_probe_text), len, true);
+    len = fex_probe_len(len, snprintf(fex_probe_text + len, sizeof(fex_probe_text) - len, "\n"));
 
     len = fex_probe_len(len, snprintf(fex_probe_text + len, sizeof(fex_probe_text) - len,
             "# draw probe tests: 'both (like D2R)' = new push constants and new root constant buffers (push"
@@ -1107,7 +1169,7 @@ static void *fex_probe_thread(void *arg)
     if (!fex_probe_create_commands(p))
         goto fail;
 
-    for (test = 0; test < FEX_PROBE_T_COUNT; test++)
+    for (test = 0; test < p->setup.test_count; test++)
     {
         if (!p->pipelines[fex_probe_test_pipeline(test)])
         {
@@ -1132,6 +1194,7 @@ static void *fex_probe_thread(void *arg)
             break;
         }
         p->tests_done = test + 1;
+        fex_probe_publish_partial(p);
     }
 
     fex_probe_report(p, vkd3d_get_current_time_ns() - start_ns, status[0] ? status : NULL);
@@ -1167,10 +1230,14 @@ void vkd3d_fex_draw_probe(struct d3d12_device *device)
     struct vkd3d_instance *instance = device->vkd3d_instance;
     pthread_t thread;
     struct fex_probe *p;
+    long delay, level;
     char env[16];
-    long delay;
 
-    if (vkd3d_get_env_var("VKD3D_FEX_DRAW_PROBE", env, sizeof(env)) && !strcmp(env, "0"))
+    /* fex26: only when asked for (1 = all tests but the lit multi-draw one, 2 = all). */
+    if (!vkd3d_get_env_var("VKD3D_FEX_DRAW_PROBE", env, sizeof(env)))
+        return;
+    level = strtol(env, NULL, 10);
+    if (level <= 0)
         return;
     if (!family || !family->timestamp_bits || !device->vk_info.KHR_push_descriptor ||
             !instance->vk_procs.vkCreateDevice || !instance->vk_procs.vkGetDeviceProcAddr)
@@ -1204,6 +1271,8 @@ void vkd3d_fex_draw_probe(struct d3d12_device *device)
     p->setup.multi_draw = device->device_info.features2.features.multiDrawIndirect &&
             device->device_info.vulkan_1_1_features.shaderDrawParameters;
     p->setup.delay_ms = (uint32_t)delay * 1000u;
+    p->setup.test_count = level >= 2 ? FEX_PROBE_T_COUNT : FEX_PROBE_T_LIT_MULTI_DRAW;
+    fex_probe_test_count = p->setup.test_count;
 
     /* The probe's device is made from the game's VkInstance: keep it alive while the probe runs. */
     vkd3d_instance_incref(instance);
-- 
