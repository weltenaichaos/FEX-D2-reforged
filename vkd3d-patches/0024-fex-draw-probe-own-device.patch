+/* Called when the game's device is made: starts the probe thread (once per process). */
+void vkd3d_fex_draw_probe(struct d3d12_device *device)
+{
+    struct vkd3d_queue_family_info *family = device->queue_families[VKD3D_QUEUE_FAMILY_GRAPHICS];
+    struct vkd3d_instance *instance = device->vkd3d_instance;
+    pthread_t thread;
+    struct fex_probe *p;
+    char env[16];
+    long delay;
+
+    if (vkd3d_get_env_var("VKD3D_FEX_DRAW_PROBE", env, sizeof(env)) && !strcmp(env, "0"))
+        return;
+    if (!family || !family->timestamp_bits || !device->vk_info.KHR_push_descriptor ||
+            !instance->vk_procs.vkCreateDevice || !instance->vk_procs.vkGetDeviceProcAddr)
+    {
