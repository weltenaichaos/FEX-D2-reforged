-const char *vkd3d_fex_draw_probe_result(void)
+/* For the gpu report (pass meter thread): while the probe runs, which test it is on; once done, its result (in 3
+ * reports from report 31 on, as FEX prints each note once). */
+size_t vkd3d_fex_draw_probe_append(char *text, size_t size, size_t len, uint32_t gpu_publishes)
 {
-    if (vkd3d_atomic_uint32_load_explicit(&fex_probe_state, vkd3d_memory_order_acquire) != 2)
-        return NULL;
-    return fex_probe_text[0] ? fex_probe_text : NULL;
+    uint32_t progress = vkd3d_atomic_uint32_load_explicit(&fex_probe_progress, vkd3d_memory_order_acquire);
+    uint32_t test = progress & 0xffu;
+
+    switch (progress >> 8)
+    {
+        case FEX_PROBE_WAITING:
+            return vkd3d_fex_report_append(text, size, len, "  draw probe: waiting to start\n");
+        case FEX_PROBE_SETTING_UP:
+            return vkd3d_fex_report_append(text, size, len,
+                    "  draw probe: making its own GPU device, target and pipelines\n");
+        case FEX_PROBE_TESTING:
+            return vkd3d_fex_report_append(text, size, len, "  draw probe: test %u of %u running (%s)\n",
+                    test + 1, FEX_PROBE_T_COUNT, test < FEX_PROBE_T_COUNT ? fex_probe_test_names[test] : "?");
+        case FEX_PROBE_DONE:
+            /* After the pass meter's own notes (reports 1-30), which leave no room for it in the 4 KB report. */
+            if (gpu_publishes <= 30 || fex_probe_published >= 3)
+                return len;
+            fex_probe_published++;
+            return vkd3d_fex_report_append(text, size, len, "%s", fex_probe_text);
+        default:
+            return len;
+    }
 }
 
