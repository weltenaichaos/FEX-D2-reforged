+    if (vkd3d_get_env_var("VKD3D_FEX_DRAW_PROBE_DELAY", env, sizeof(env)))
+    {
+        delay = strtol(env, NULL, 10);
+        if (delay < 0 || delay > 600)
+            delay = FEX_PROBE_DEFAULT_DELAY_S;
+    }
+    p->setup.instance = instance;
+    p->setup.create_device = instance->vk_procs.vkCreateDevice;
+    p->setup.get_device_proc_addr = instance->vk_procs.vkGetDeviceProcAddr;
+    p->setup.physical_device = device->vk_physical_device;
+    p->setup.features = device->device_info.features2.features;
+    p->setup.memory_properties = device->memory_properties;
+    p->setup.family_index = family->vk_family_index;
+    p->setup.timestamp_bits = family->timestamp_bits;
+    p->setup.ns_per_tick = device->device_info.properties2.properties.limits.timestampPeriod;
+    p->setup.multi_draw = device->device_info.features2.features.multiDrawIndirect &&
+            device->device_info.vulkan_1_1_features.shaderDrawParameters;
