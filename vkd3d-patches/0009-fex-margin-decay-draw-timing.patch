 #define FEX_PASS_STATS_VALUES 4u   /* input assembly vertices, vertex shader runs, primitives after clipping, fragment
                                     * shader runs (in this order: the order of their bits) */
 
+/* Draw timing (VKD3D fex9). */
+#define FEX_DRAW_MAX 2040u          /* draws timed in one sampled pass; the end timestamp goes at slot draw_count */
+#define FEX_DRAW_PSOS 512u          /* pipelines told apart in one sample */
+#define FEX_DRAW_HASH 1024u         /* open addressing: pipeline state -> index + 1 */
+#define FEX_DRAW_ISO_EVERY 8u       /* isolated samples: one draw in this many runs alone */
+#define FEX_DRAW_ISO_MAX 1000u
+#define FEX_DRAW_SLOT_ISO 2048u     /* isolated draw k: before at FEX_DRAW_SLOT_ISO + 2k, after at + 2k + 1 */
+#define FEX_DRAW_SLOT_BEGIN 4094u   /* top of pipe before vkCmdBeginRendering */
+#define FEX_DRAW_SLOTS 4096u
+#define FEX_DRAW_ISO_ROUND 4u       /* every 4th sample is an isolated one */
+#define FEX_DRAW_MIN_DRAWS 50u      /* only a kind of pass with this many draws per pass gets sampled */
+#define FEX_DRAW_FIRST_PUBLISH 10u  /* the '#' notes go out with the first reports, samples only after them */
+#define FEX_DRAW_TOP_PSOS 4u
+
+#define FEX_DRAW_FLAG_DIRECT 0x1u   /* vertices known on the CPU */
+#define FEX_DRAW_FLAG_NEW_PSO 0x2u  /* another VkPipeline than the draw before */
+
+enum { FEX_DRAW_IDLE, FEX_DRAW_ARMED, FEX_DRAW_RECORDING, FEX_DRAW_SUBMITTED };
+
+struct fex_draw_rec
+{
+    uint16_t pso;      /* index into psos, 0xffff = too many pipelines */
+    uint16_t flags;
+    uint32_t vertices; /* indices or vertices x instances, direct draws only */
+};
+
+struct fex_draw_pso
+{
+    struct d3d12_pipeline_state *state; /* internal reference held until the sample is resolved */
+    VkPipeline pipeline;                /* the one bound at its first draw */
+    uint64_t vs_hash, ps_hash;          /* the game's shaders (D3D bytecode hashes) */
+};
+
+struct fex_draw_pso_sum
+{
+    uint64_t ticks, vertices;
+    uint32_t count, direct;
+};
+
+struct vkd3d_fex_draw_sample
+{
+    /* Written by the recording thread that took the sample. */
+    struct fex_draw_rec draws[FEX_DRAW_MAX];
+    uint16_t iso_draw[FEX_DRAW_ISO_MAX];
+    struct fex_draw_pso psos[FEX_DRAW_PSOS];
+    uint16_t hash[FEX_DRAW_HASH];
+    uint32_t draw_count, pso_count, iso_count;
+    VkPipeline prev_pipeline;
+    uint16_t sig;
+    bool isolate, truncated, iso_open, ended, pso_overflow;
+    uint64_t submit_ns;
+
+    /* The meter thread's scratch space while it resolves the sample. */
+    struct fex_draw_pso_sum sums[FEX_DRAW_PSOS];
+    double iso_us[FEX_DRAW_ISO_MAX];
+};
+
+struct fex_draw_norm
+{
+    uint64_t vs_hash, ps_hash;
+    double us;
+};
