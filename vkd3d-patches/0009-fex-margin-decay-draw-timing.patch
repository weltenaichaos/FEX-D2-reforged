     list->fex_pass.records = NULL;
     list->fex_pass.records_size = 0;
@@ -759,6 +1033,511 @@ void vkd3d_fex_pass_meter_count_clears(struct d3d12_device *device, uint32_t fol
         vkd3d_atomic_uint32_add(&meter->clears_own_pass, own_pass, vkd3d_memory_order_relaxed);
 }
 
+/* Driver shader statistics shown per pipeline (Turnip's names), the rest only listed once by name. */
+static const struct
+{
+    const char *name;
+    const char *label;
+    bool skip_zero;
+}
+fex_draw_stat_names[] =
+{
+    { "Max Waves Per Core", "waves", false },
+    { "Instruction Count", "inst", false },
+    { "Registers used", "full", false },
+    { "Half-registers used", "half", false },
+    { "cat5 instructions", "tex", false },
+    { "cat6 instructions", "mem", false },
+    { "LDP Count", "spill-ld", true },
+    { "STP Count", "spill-st", true },
+    { "Estimated cycles stalled on SY", "sy", true },
+    { "Estimated cycles stalled on SS", "ss", true },
+    { "Loops", "loops", true },
+};
+
+static double fex_draw_stat_value(const VkPipelineExecutableStatisticKHR *st)
+{
+    switch (st->format)
+    {
+        case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_BOOL32_KHR: return st->value.b32;
+        case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_INT64_KHR: return (double)st->value.i64;
+        case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_UINT64_KHR: return (double)st->value.u64;
+        case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_FLOAT64_KHR: return st->value.f64;
+        default: return 0.0;
+    }
+}
+
+/* The driver's statistics of a pipeline's shaders: " | FS w128 waves 16 inst 120 ...". With names set, also lists
+ * every statistic name of the first shader (once per run, so a renamed statistic still shows up). */
+static size_t fex_draw_describe_shaders(struct vkd3d_fex_pass_meter *meter, VkPipeline pipeline, char *buf,
+        size_t size, size_t len, char *names, size_t names_size)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &meter->device->vk_procs;
+    VkPipelineExecutablePropertiesKHR props[8];
+    VkPipelineExecutableStatisticKHR stats[48];
+    VkPipelineExecutableInfoKHR exe_info;
+    size_t names_len = 0;
+    VkPipelineInfoKHR info;
+    uint32_t count, n, i, j, k;
+
+    if (!meter->draw_stats || !pipeline)
+        return len;
+
+    memset(&info, 0, sizeof(info));
+    info.sType = VK_STRUCTURE_TYPE_PIPELINE_INFO_KHR;
+    info.pipeline = pipeline;
+    memset(props, 0, sizeof(props));
+    for (i = 0; i < ARRAY_SIZE(props); i++)
+        props[i].sType = VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_PROPERTIES_KHR;
+    count = ARRAY_SIZE(props);
+    if (VK_CALL(vkGetPipelineExecutablePropertiesKHR(meter->device->vk_device, &info, &count, props)) < 0)
+        return vkd3d_fex_report_append(buf, size, len, " | no shader statistics");
+
+    for (i = 0; i < count; i++)
+    {
+        /* The binning pass's copy of the vertex shader (position only) adds nothing here. */
+        if (strstr(props[i].name, "Binning") || strstr(props[i].name, "binning"))
+            continue;
+
+        memset(stats, 0, sizeof(stats));
+        for (k = 0; k < ARRAY_SIZE(stats); k++)
+            stats[k].sType = VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_STATISTIC_KHR;
+        memset(&exe_info, 0, sizeof(exe_info));
+        exe_info.sType = VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INFO_KHR;
+        exe_info.pipeline = pipeline;
+        exe_info.executableIndex = i;
+        n = ARRAY_SIZE(stats);
+        if (VK_CALL(vkGetPipelineExecutableStatisticsKHR(meter->device->vk_device, &exe_info, &n, stats)) < 0)
+            continue;
+
+        len = vkd3d_fex_report_append(buf, size, len, " | %s w%u", props[i].name, props[i].subgroupSize);
+        for (j = 0; j < ARRAY_SIZE(fex_draw_stat_names); j++)
+        {
+            for (k = 0; k < n; k++)
+            {
+                double value;
+
+                if (strcmp(stats[k].name, fex_draw_stat_names[j].name))
+                    continue;
+                value = fex_draw_stat_value(&stats[k]);
+                if (value != 0.0 || !fex_draw_stat_names[j].skip_zero)
+                    len = vkd3d_fex_report_append(buf, size, len, " %s %.0f", fex_draw_stat_names[j].label, value);
+                break;
+            }
+        }
+
+        if (names && !names_len)
+        {
+            names_len = vkd3d_fex_report_append(names, names_size, names_len,
+                    "# gpu draws: the driver's shader statistics (%s):", props[i].name);
+            for (k = 0; k < n; k++)
+                names_len = vkd3d_fex_report_append(names, names_size, names_len, "%s %s", k ? "," : "",
+                        stats[k].name);
+            names_len = vkd3d_fex_report_append(names, names_size, names_len, "\n");
+        }
+    }
+    return len;
+}
+
+static int fex_draw_compare_double(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+
+    return x < y ? -1 : x > y;
+}
+
+static const struct fex_draw_norm *fex_draw_find_norm(const struct vkd3d_fex_pass_meter *meter,
+        const struct fex_draw_pso *pso)
+{
+    uint32_t i;
+
+    for (i = 0; i < meter->draw_norm_count; i++)
+    {
+        if (meter->draw_norm[i].vs_hash == pso->vs_hash && meter->draw_norm[i].ps_hash == pso->ps_hash)
+            return &meter->draw_norm[i];
+    }
+    return NULL;
+}
+
+/* (value, available) of a draw pool slot, as read back into draw_results. */
+static bool fex_draw_result(const struct vkd3d_fex_pass_meter *meter, uint32_t slot, uint64_t *value)
+{
+    if (!meter->draw_results[2 * slot + 1])
+        return false;
+    *value = meter->draw_results[2 * slot];
+    return true;
+}
+
+static size_t fex_draw_describe_pass(struct vkd3d_fex_pass_meter *meter, uint64_t pass_ticks, char *buf, size_t size,
+        size_t len)
+{
+    const struct vkd3d_fex_draw_sample *s = meter->draw_sample;
+    const double ms = meter->ns_per_tick / 1e6;
+    const struct fex_pass_sig *sig = s->sig < FEX_PASS_MAX_SIGS ? &meter->sigs[s->sig] : NULL;
+
+    len = vkd3d_fex_report_append(buf, size, len, "  gpu draws #%u%s (pass %ux%u, %.2f ms",
+            meter->draw_samples, s->isolate ? " alone" : "", sig ? sig->width : 0, sig ? sig->height : 0,
+            pass_ticks * ms);
+    if (s->sig == meter->draw_arm_sig && meter->draw_arm_avg_ms > 0.0)
+        len = vkd3d_fex_report_append(buf, size, len, ", this kind averaged %.2f ms the second before",
+                meter->draw_arm_avg_ms);
+    return vkd3d_fex_report_append(buf, size, len, ")");
+}
+
+/* A normal sample: time per draw = from its timestamp to the next draw's. */
+static size_t fex_draw_describe_normal(struct vkd3d_fex_pass_meter *meter, char *buf, size_t size, size_t len)
+{
+    static const double bucket_us[] = { 2.0, 5.0, 10.0, 20.0, 50.0 };
+    static const char *const bucket_names[] = { "<2us", "2-5", "5-10", "10-20", "20-50", "50+" };
+    struct vkd3d_fex_draw_sample *s = meter->draw_sample;
+    const double us_per_tick = meter->ns_per_tick / 1000.0;
+    const double ms = meter->ns_per_tick / 1e6;
+    uint64_t begin, end, first, last, t0, t1, ticks;
+    uint64_t new_ticks = 0, same_ticks = 0, small_ticks = 0, large_ticks = 0, vertices = 0, timed_ticks = 0;
+    uint32_t new_count = 0, same_count = 0, small_count = 0, large_count = 0, direct = 0, timed = 0;
+    uint32_t bucket_count[6] = { 0 }, missing = 0, unordered = 0, used_psos = 0;
+    uint64_t bucket_ticks[6] = { 0 };
+    uint32_t slowest[4], slowest_count = 0, top[FEX_DRAW_TOP_PSOS], top_count = 0;
+    uint64_t slowest_ticks[4];
+    uint32_t i, j, n = s->draw_count;
+    char names[640];
+
+    names[0] = '\0';
+    if (!fex_draw_result(meter, FEX_DRAW_SLOT_BEGIN, &begin) || !fex_draw_result(meter, n, &end) ||
+            !fex_draw_result(meter, 0, &first) || !fex_draw_result(meter, n - 1, &last) || end < begin || end < last)
+    {
+        len = fex_draw_describe_pass(meter, 0, buf, size, len);
+        return vkd3d_fex_report_append(buf, size, len, ": timestamps missing\n");
+    }
+
+    memset(s->sums, 0, sizeof(*s->sums) * (s->pso_count ? s->pso_count : 1));
+    /* The last draw's time would include finishing the whole pass: shown apart. */
+    for (i = 0; i + 1 < n; i++)
+    {
+        const struct fex_draw_rec *rec = &s->draws[i];
+        double us;
+        unsigned int b;
+
+        if (!fex_draw_result(meter, i, &t0) || !fex_draw_result(meter, i + 1, &t1))
+        {
+            missing++;
+            continue;
+        }
+        if (t1 < t0)
+        {
+            unordered++;
+            continue;
+        }
+        ticks = t1 - t0;
+        us = ticks * us_per_tick;
+        timed++;
+        timed_ticks += ticks;
+
+        for (b = 0; b < ARRAY_SIZE(bucket_us) && us >= bucket_us[b]; b++)
+            ;
+        bucket_count[b]++;
+        bucket_ticks[b] += ticks;
+
+        if (rec->flags & FEX_DRAW_FLAG_NEW_PSO)
+        {
+            new_count++;
+            new_ticks += ticks;
+        }
+        else
+        {
+            same_count++;
+            same_ticks += ticks;
+        }
+        if (rec->flags & FEX_DRAW_FLAG_DIRECT)
+        {
+            direct++;
+            vertices += rec->vertices;
+            if (rec->vertices <= 64)
+            {
+                small_count++;
+                small_ticks += ticks;
+            }
+            else
+            {
+                large_count++;
+                large_ticks += ticks;
+            }
+        }
+        if (rec->pso < s->pso_count)
+        {
+            struct fex_draw_pso_sum *sum = &s->sums[rec->pso];
+
+            sum->ticks += ticks;
+            sum->count++;
+            if (rec->flags & FEX_DRAW_FLAG_DIRECT)
+            {
+                sum->vertices += rec->vertices;
+                sum->direct++;
+            }
+        }
+
+        /* The 4 slowest draws. */
+        for (j = slowest_count; j > 0 && slowest_ticks[j - 1] < ticks; j--)
+        {
+            if (j < ARRAY_SIZE(slowest))
+            {
+                slowest[j] = slowest[j - 1];
+                slowest_ticks[j] = slowest_ticks[j - 1];
+            }
+        }
+        if (j < ARRAY_SIZE(slowest))
+        {
+            slowest[j] = i;
+            slowest_ticks[j] = ticks;
+            if (slowest_count < ARRAY_SIZE(slowest))
+                slowest_count++;
+        }
+    }
+
+    /* The costliest pipelines; every pipeline's time per draw is kept for the next isolated sample. */
+    meter->draw_norm_count = 0;
+    for (i = 0; i < s->pso_count; i++)
+    {
+        if (!s->sums[i].count)
+            continue;
+        used_psos++;
+        meter->draw_norm[meter->draw_norm_count].vs_hash = s->psos[i].vs_hash;
+        meter->draw_norm[meter->draw_norm_count].ps_hash = s->psos[i].ps_hash;
+        meter->draw_norm[meter->draw_norm_count].us = s->sums[i].ticks * us_per_tick / s->sums[i].count;
+        meter->draw_norm_count++;
+
+        for (j = top_count; j > 0 && s->sums[top[j - 1]].ticks < s->sums[i].ticks; j--)
+        {
+            if (j < ARRAY_SIZE(top))
+                top[j] = top[j - 1];
+        }
+        if (j < ARRAY_SIZE(top))
+        {
+            top[j] = i;
+            if (top_count < ARRAY_SIZE(top))
+                top_count++;
+        }
+    }
+
+    len = fex_draw_describe_pass(meter, end - begin, buf, size, len);
+    len = vkd3d_fex_report_append(buf, size, len, ": %u draws%s, %u pipelines%s | %.2f ms in %u timed draws = %.1f us/draw"
+            " (last draw + finishing the pass %.2f ms, first draw began %.2f ms into the pass%s)",
+            n, s->truncated ? " (more not timed)" : "", used_psos, s->pso_overflow ? "+" : "", timed_ticks * ms, timed,
+            timed ? timed_ticks * us_per_tick / timed : 0.0, (end - last) * ms, first >= begin ? (first - begin) * ms : 0.0,
+            first >= begin && (first - begin) * 10 > end - begin ? ", tiled: the times are the last tile's" : "");
+    len = vkd3d_fex_report_append(buf, size, len, " | new pipeline %u draws %.1f us avg, same %u %.1f us",
+            new_count, new_count ? new_ticks * us_per_tick / new_count : 0.0,
+            same_count, same_count ? same_ticks * us_per_tick / same_count : 0.0);
+    len = vkd3d_fex_report_append(buf, size, len, " | per draw");
+    for (i = 0; i < ARRAY_SIZE(bucket_count); i++)
+        len = vkd3d_fex_report_append(buf, size, len, " %s %u (%.2f ms)", bucket_names[i], bucket_count[i],
+                bucket_ticks[i] * ms);
+    len = vkd3d_fex_report_append(buf, size, len, " | vtx/draw %.0f, <=64 vtx %u draws %.1f us, more %u %.1f us",
+            direct ? (double)vertices / direct : 0.0, small_count, small_count ? small_ticks * us_per_tick / small_count : 0.0,
+            large_count, large_count ? large_ticks * us_per_tick / large_count : 0.0);
+    if (slowest_count)
+    {
+        len = vkd3d_fex_report_append(buf, size, len, " | slowest");
+        for (i = 0; i < slowest_count; i++)
+            len = vkd3d_fex_report_append(buf, size, len, "%s #%u %.0f us (%u vtx%s)", i ? "," : "", slowest[i],
+                    slowest_ticks[i] * us_per_tick, s->draws[slowest[i]].vertices,
+                    (s->draws[slowest[i]].flags & FEX_DRAW_FLAG_NEW_PSO) ? ", new pipeline" : "");
+    }
+    if (missing || unordered)
+        len = vkd3d_fex_report_append(buf, size, len, " | missing %u, out of order %u", missing, unordered);
+    len = vkd3d_fex_report_append(buf, size, len, "\n");
+
+    for (i = 0; i < top_count; i++)
+    {
+        const struct fex_draw_pso_sum *sum = &s->sums[top[i]];
+        const struct fex_draw_pso *pso = &s->psos[top[i]];
+
+        len = vkd3d_fex_report_append(buf, size, len, "    pso %u: %u draws %.2f ms %.1f us/draw vtx/draw %.0f"
+                " vs %016"PRIx64" ps %016"PRIx64, i + 1, sum->count, sum->ticks * ms, sum->ticks * us_per_tick / sum->count,
+                sum->direct ? (double)sum->vertices / sum->direct : 0.0, pso->vs_hash, pso->ps_hash);
+        len = fex_draw_describe_shaders(meter, pso->pipeline, buf, size, len,
+                meter->draw_names_sent ? NULL : names, sizeof(names));
+        len = vkd3d_fex_report_append(buf, size, len, "\n");
+    }
+    if (names[0])
+    {
+        meter->draw_names_sent = true;
+        len = vkd3d_fex_report_append(buf, size, len, "%s", names);
+    }
+    return len;
+}
+
+/* An isolated sample: every 8th draw alone, the GPU idle before and after it. */
+static size_t fex_draw_describe_isolated(struct vkd3d_fex_pass_meter *meter, char *buf, size_t size, size_t len)
+{
+    struct vkd3d_fex_draw_sample *s = meter->draw_sample;
+    const double us_per_tick = meter->ns_per_tick / 1000.0;
+    double alone_sum = 0.0, matched_alone = 0.0, matched_normal = 0.0, small_sum = 0.0;
+    uint32_t i, timed = 0, matched = 0, small = 0;
+    uint64_t begin, end, t0, t1;
+
+    if (!fex_draw_result(meter, FEX_DRAW_SLOT_BEGIN, &begin) || !fex_draw_result(meter, s->draw_count, &end) ||
+            end < begin)
+    {
+        len = fex_draw_describe_pass(meter, 0, buf, size, len);
+        return vkd3d_fex_report_append(buf, size, len, ": timestamps missing\n");
+    }
+
+    for (i = 0; i < s->iso_count; i++)
+    {
+        const struct fex_draw_rec *rec = &s->draws[s->iso_draw[i]];
+        const struct fex_draw_norm *norm;
+        double us;
+
+        if (!fex_draw_result(meter, FEX_DRAW_SLOT_ISO + 2 * i, &t0) ||
+                !fex_draw_result(meter, FEX_DRAW_SLOT_ISO + 2 * i + 1, &t1) || t1 < t0)
+            continue;
+        us = (t1 - t0) * us_per_tick;
+        s->iso_us[timed++] = us;
+        alone_sum += us;
+        if ((rec->flags & FEX_DRAW_FLAG_DIRECT) && rec->vertices <= 64)
+        {
+            small++;
+            small_sum += us;
+        }
+        if (rec->pso < s->pso_count && (norm = fex_draw_find_norm(meter, &s->psos[rec->pso])))
+        {
+            matched++;
+            matched_alone += us;
+            matched_normal += norm->us;
+        }
+    }
+
+    len = fex_draw_describe_pass(meter, end - begin, buf, size, len);
+    len = vkd3d_fex_report_append(buf, size, len, ": %u draws, %u timed alone", s->draw_count, timed);
+    if (timed)
+    {
+        qsort(s->iso_us, timed, sizeof(*s->iso_us), fex_draw_compare_double);
+        len = vkd3d_fex_report_append(buf, size, len, ": avg %.1f us, median %.1f, 90%% under %.1f, <=64 vtx avg %.1f us"
+                " | the same pipelines in the last normal sample: alone %.1f us vs normal flow %.1f us per draw"
+                " (%u matched) = alone/normal %.2f", alone_sum / timed, s->iso_us[timed / 2],
+                s->iso_us[(timed * 9) / 10 < timed ? (timed * 9) / 10 : timed - 1],
+                small ? small_sum / small : 0.0, matched ? matched_alone / matched : 0.0,
+                matched ? matched_normal / matched : 0.0, matched,
+                matched_normal > 0.0 ? matched_alone / matched_normal : 0.0);
+    }
+    return vkd3d_fex_report_append(buf, size, len, "\n");
+}
+
+/* On the meter thread: reads a submitted sample once the GPU wrote its end, formats it and frees it. */
+static void fex_draw_resolve(struct vkd3d_fex_pass_meter *meter)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &meter->device->vk_procs;
+    const VkQueryResultFlags flags = VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT;
+    struct vkd3d_fex_draw_sample *s = meter->draw_sample;
+    uint64_t *r = meter->draw_results;
+    VkDevice vk_device = meter->device->vk_device;
+    uint32_t n = s->draw_count;
+    bool late;
+    VkResult vr;
+
+    if (vkd3d_atomic_uint32_load_explicit(&meter->draw_state, vkd3d_memory_order_acquire) != FEX_DRAW_SUBMITTED)
+        return;
+
+    late = vkd3d_get_current_time_ns() - s->submit_ns > 2000000000ull;
+    if (!s->ended || !n)
+    {
+        /* No end timestamp to wait for: give the GPU time to finish before the queries are reset again. */
+        if (!late)
+            return;
+        meter->draw_lost++;
+        goto done;
+    }
+
+    memset(&r[2 * n], 0, 2 * sizeof(*r));
+    vr = VK_CALL(vkGetQueryPoolResults(vk_device, meter->draw_pool, n, 1, 2 * sizeof(*r), &r[2 * n],
+            2 * sizeof(*r), flags));
+    if (vr < 0 || !r[2 * n + 1])
+    {
+        if (late)
+        {
+            meter->draw_lost++;
+            goto done;
+        }
+        return;
+    }
+
+    memset(r, 0, 2 * sizeof(*r) * n);
+    memset(&r[2 * FEX_DRAW_SLOT_BEGIN], 0, 2 * sizeof(*r));
+    VK_CALL(vkGetQueryPoolResults(vk_device, meter->draw_pool, 0, n, 2 * sizeof(*r) * n, r, 2 * sizeof(*r), flags));
+    VK_CALL(vkGetQueryPoolResults(vk_device, meter->draw_pool, FEX_DRAW_SLOT_BEGIN, 1, 2 * sizeof(*r),
+            &r[2 * FEX_DRAW_SLOT_BEGIN], 2 * sizeof(*r), flags));
+    if (s->iso_count)
+    {
+        memset(&r[2 * FEX_DRAW_SLOT_ISO], 0, 4 * sizeof(*r) * s->iso_count);
+        VK_CALL(vkGetQueryPoolResults(vk_device, meter->draw_pool, FEX_DRAW_SLOT_ISO, 2 * s->iso_count,
+                4 * sizeof(*r) * s->iso_count, &r[2 * FEX_DRAW_SLOT_ISO], 2 * sizeof(*r), flags));
+    }
+
+    meter->draw_samples++;
+    meter->draw_text_len = 0;
+    if (s->isolate)
+        meter->draw_text_len = fex_draw_describe_isolated(meter, meter->draw_text, sizeof(meter->draw_text), 0);
+    else
+        meter->draw_text_len = fex_draw_describe_normal(meter, meter->draw_text, sizeof(meter->draw_text), 0);
+
+done:
+    fex_draw_release(s);
+    vkd3d_atomic_uint32_store_explicit(&meter->draw_state, FEX_DRAW_IDLE, vkd3d_memory_order_release);
+}
+
+/* On the meter thread, once a second: sets up the next sample for the kind of pass with the most GPU time (and at
+ * least FEX_DRAW_MIN_DRAWS draws per pass). A sample nobody took in the last second is set up again. */
+static void fex_draw_arm(struct vkd3d_fex_pass_meter *meter, uint32_t sig_count)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &meter->device->vk_procs;
+    struct vkd3d_fex_draw_sample *s = meter->draw_sample;
+    uint64_t best_ticks = 0;
+    uint32_t i, state, best = 0xffffffffu;
+
+    state = vkd3d_atomic_uint32_load_explicit(&meter->draw_state, vkd3d_memory_order_acquire);
+    if (state == FEX_DRAW_ARMED)
+    {
