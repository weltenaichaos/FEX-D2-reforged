 {
     struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
@@ -289,6 +512,8 @@ void vkd3d_fex_pass_meter_begin_list(struct d3d12_command_list *list)
     list->fex_pass.stats_next = list->fex_pass.stats_end = 0;
     list->fex_pass.binds = 0;
     list->fex_pass.stats_active = false;
+    if (list->fex_pass.draw)
+        fex_draw_abandon(list);
     if (!meter || !(list->vk_queue_flags & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)))
         return;
 
@@ -393,6 +618,23 @@ void vkd3d_fex_pass_meter_begin_pass(struct d3d12_command_list *list, const VkRe
         }
     }
     list->fex_pass.pass_active = true;
+
+    /* A sampled pass that was dropped without its end: the sample can't be used. */
+    if (list->fex_pass.draw_open)
+        list->fex_pass.draw_open = false;
+    if (meter->draw_pool && kind != VKD3D_FEX_PASS_KIND_CLEAR && !list->fex_pass.draw &&
+            vkd3d_atomic_uint32_load_explicit(&meter->draw_state, vkd3d_memory_order_acquire) == FEX_DRAW_ARMED &&
+            current->sig == vkd3d_atomic_uint32_load_explicit(&meter->draw_hot_sig, vkd3d_memory_order_relaxed) &&
+            vkd3d_atomic_uint32_compare_exchange(&meter->draw_state, FEX_DRAW_ARMED, FEX_DRAW_RECORDING,
+            vkd3d_memory_order_acq_rel, vkd3d_memory_order_relaxed) == FEX_DRAW_ARMED)
+    {
+        list->fex_pass.draw = meter->draw_sample;
+        list->fex_pass.draw_open = true;
+        meter->draw_sample->sig = current->sig;
+        VK_CALL(vkCmdWriteTimestamp2(list->cmd.vk_command_buffer, VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT,
+                meter->draw_pool, FEX_DRAW_SLOT_BEGIN));
+    }
+
     fex_pass_write_begin(list, current->pair);
 }
 
@@ -402,10 +644,14 @@ void vkd3d_fex_pass_meter_inside_pass(struct d3d12_command_list *list)
     struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
     const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
 
-    if (!meter || !list->fex_pass.pass_active || list->fex_pass.current.inside_pair == VKD3D_FEX_PASS_NO_QUERY)
+    if (!meter || !list->fex_pass.pass_active)
         return;
-    VK_CALL(vkCmdWriteTimestamp2(list->cmd.vk_command_buffer, VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT,
-            meter->pool, 2 * list->fex_pass.current.inside_pair));
+    if (list->fex_pass.current.inside_pair != VKD3D_FEX_PASS_NO_QUERY)
