+/* Draw timing (VKD3D fex9). The sample's pipelines hold an internal reference so their VkPipelines still exist when the
+ * meter thread asks the driver for their shader statistics. */
+static void fex_draw_release(struct vkd3d_fex_draw_sample *s)
+{
+    uint32_t i;
+
+    for (i = 0; i < s->pso_count; i++)
+    {
+        if (s->psos[i].state)
+            d3d12_pipeline_state_dec_ref(s->psos[i].state);
+        s->psos[i].state = NULL;
+    }
+    s->pso_count = 0;
+}
+
+/* The list is reset or freed with the sample never submitted: its commands never run, the queries stay unwritten. */
+static void fex_draw_abandon(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    struct vkd3d_fex_draw_sample *s = list->fex_pass.draw;
+
+    list->fex_pass.draw = NULL;
+    list->fex_pass.draw_open = false;
+    if (!meter || !s)
+        return;
+    fex_draw_release(s);
+    vkd3d_atomic_uint32_increment(&meter->draw_abandoned, vkd3d_memory_order_relaxed);
+    vkd3d_atomic_uint32_store_explicit(&meter->draw_state, FEX_DRAW_IDLE, vkd3d_memory_order_release);
+}
+
+static uint16_t fex_draw_pso_index(struct vkd3d_fex_draw_sample *s, struct d3d12_command_list *list)
+{
+    struct d3d12_pipeline_state *state = list->state;
+    struct fex_draw_pso *pso;
+    uint32_t h, n, index;
+    size_t i;
+
+    if (!state)
+        return 0xffff;
+
+    h = (uint32_t)(((uintptr_t)state >> 4) * 2654435761u) % FEX_DRAW_HASH;
+    for (n = 0; n < FEX_DRAW_HASH; n++, h = (h + 1) % FEX_DRAW_HASH)
+    {
+        if (!s->hash[h])
+            break;
+        if (s->psos[s->hash[h] - 1].state == state)
+            return s->hash[h] - 1;
+    }
+    if (n == FEX_DRAW_HASH || s->pso_count >= FEX_DRAW_PSOS)
+    {
+        s->pso_overflow = true;
+        return 0xffff;
+    }
+
+    index = s->pso_count++;
+    pso = &s->psos[index];
+    pso->state = state;
+    pso->pipeline = list->current_pipeline;
+    pso->vs_hash = pso->ps_hash = 0;
+    if (d3d12_pipeline_state_is_graphics(state))
+    {
+        for (i = 0; i < state->graphics.stage_count && i < VKD3D_MAX_SHADER_STAGES; i++)
+        {
+            if (state->graphics.stages[i].stage == VK_SHADER_STAGE_VERTEX_BIT)
+                pso->vs_hash = state->graphics.code[i].meta.hash;
+            else if (state->graphics.stages[i].stage == VK_SHADER_STAGE_FRAGMENT_BIT)
+                pso->ps_hash = state->graphics.code[i].meta.hash;
+        }
+    }
+    d3d12_pipeline_state_inc_ref(state);
+    s->hash[h] = index + 1;
+    return index;
+}
+
+/* Before every draw of the sampled pass: a top of pipe timestamp at the draw's slot. An isolated draw also gets an
+ * all-commands timestamp before it (the driver waits for the GPU to go idle first) and one before whatever comes next. */
+static void fex_draw_stamp(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    struct vkd3d_fex_draw_sample *s = list->fex_pass.draw;
+    struct fex_draw_rec *rec;
+    uint32_t i;
+
+    if (s->iso_open)
+    {
+        VK_CALL(vkCmdWriteTimestamp2(list->cmd.vk_command_buffer, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+                meter->draw_pool, FEX_DRAW_SLOT_ISO + 2 * (s->iso_count - 1) + 1));
+        s->iso_open = false;
+    }
+    if (s->draw_count >= FEX_DRAW_MAX)
+    {
+        s->truncated = true;
+        return;
+    }
+
+    i = s->draw_count++;
+    rec = &s->draws[i];
+    rec->pso = fex_draw_pso_index(s, list);
+    rec->flags = list->current_pipeline != s->prev_pipeline ? FEX_DRAW_FLAG_NEW_PSO : 0;
+    rec->vertices = 0;
+    s->prev_pipeline = list->current_pipeline;
+
+    if (s->isolate && !(i % FEX_DRAW_ISO_EVERY) && s->iso_count < FEX_DRAW_ISO_MAX)
+    {
+        VK_CALL(vkCmdWriteTimestamp2(list->cmd.vk_command_buffer, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+                meter->draw_pool, FEX_DRAW_SLOT_ISO + 2 * s->iso_count));
+        s->iso_draw[s->iso_count++] = i;
+        s->iso_open = true;
+    }
+    VK_CALL(vkCmdWriteTimestamp2(list->cmd.vk_command_buffer, VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT,
+            meter->draw_pool, i));
+}
+
+/* Right after vkCmdEndRendering: the end timestamp waits for everything in the pass. */
+static void fex_draw_end(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    struct vkd3d_fex_draw_sample *s = list->fex_pass.draw;
+
+    if (s->iso_open)
+    {
+        VK_CALL(vkCmdWriteTimestamp2(list->cmd.vk_command_buffer, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+                meter->draw_pool, FEX_DRAW_SLOT_ISO + 2 * (s->iso_count - 1) + 1));
+        s->iso_open = false;
+    }
+    VK_CALL(vkCmdWriteTimestamp2(list->cmd.vk_command_buffer, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+            meter->draw_pool, s->draw_count));
+    s->ended = true;
+    list->fex_pass.draw_open = false;
+}
+
