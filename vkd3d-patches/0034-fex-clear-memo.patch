From eed108b62b3c49bac17b0d26663fe72c0530c2b2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 20:33:57 +0000
Subject: [PATCH] FEX: big depth clears skipped by the GPU while the image is
 still clear

D2R clears its second 4096 x 4096 shadow map in a render pass of its own
every frame (0.55-0.69 ms on an Adreno 740), though nothing draws into
it: the same empty image is cleared again and again.

A whole single-plane depth image of 4M+ pixels in memory of its own gets
a slot in a device-wide buffer the first time such a clear of it gets a
render pass of its own. 0 means the image still holds the depth value of
that clear; anything else means it may not. The clear then runs as
vkCmdClearAttachments in a LOAD/STORE pass under conditional rendering on
its slot, so the GPU skips it while the slot is 0, and sets the slot to 0
after. Render passes with the image as a writable depth attachment, other
clears, copies, resolves and discards of it set the slot to 1 (once per
command list until the next memo clear). Barriers order every write and
read of a slot, within and across command lists. An image the memo knows
is no longer discarded before a clear that waits, so a skipped clear
leaves its contents as they were. Clears with another value, while the
game's predication is active or with the memo off are done in full.

VKD3D_FEX_CLEAR_MEMO: unset or 1 = on, 0 = off, 2 or alt = on and off by
turns every second with the pass meter. Needs VKD3D_FEX_FOLD_CLEARS=1 and
VK_EXT_conditional_rendering. New 'gpu clear memo' line in the gpu
report; the memo clear passes show as 'clear-pass ... dLS' (load,
store) in the pass lines, clears done in full as 'dCS'.
---
 libs/vkd3d/command.c        | 432 +++++++++++++++++++++++++++++++++++-
 libs/vkd3d/device.c         |   2 +
 libs/vkd3d/fex_pass_meter.c |  28 +++
 libs/vkd3d/vkd3d_private.h  |  54 +++++
 4 files changed, 506 insertions(+), 10 deletions(-)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index a6a5dab..4cd839c 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -2121,6 +2121,8 @@ static HRESULT d3d12_command_list_begin_command_buffer(struct d3d12_command_list
     list->fex_clears.keep = false;
     list->fex_clears.big_count = 0;
     list->fex_clears.drawn_count = 0;
+    list->fex_memo.count = 0;
+    list->fex_memo.pending_count = 0;
 
     return S_OK;
 }
@@ -4036,16 +4038,384 @@ static void d3d12_command_list_fex_big_barrier(struct d3d12_command_list *list,
     }
 }
 
+/* VKD3D fex34: "still clear" memo, see struct vkd3d_fex_clear_memo. resource->fex_memo holds slot << 32 | the bits of
+ * the depth value the slot is about; VKD3D_FEX_MEMO_NO_SLOT once no slot was left for it. */
+uint32_t vkd3d_fex_clear_memo_now = 1u;
+static bool fex_clear_memo_alt; /* on and off by turns every second with the pass meter */
+#define VKD3D_FEX_MEMO_NO_SLOT (0xffffffffull << 32)
+#define VKD3D_FEX_MEMO_STATE_DIRTY 1u
+#define VKD3D_FEX_MEMO_STATE_CLEAN 2u
+
+/* The image's slot, 0 = none. */
+static uint32_t d3d12_resource_fex_memo_slot(struct d3d12_resource *resource, uint32_t *value_bits)
+{
+    uint64_t memo = vkd3d_atomic_uint64_load_explicit(&resource->fex_memo, vkd3d_memory_order_relaxed);
+    uint32_t slot = (uint32_t)(memo >> 32);
+
+    if (value_bits)
+        *value_bits = (uint32_t)memo;
+    return slot < VKD3D_FEX_CLEAR_MEMO_SLOTS ? slot : 0;
+}
+
+/* Only whole single-plane depth images of 4M+ pixels in memory of their own, which nothing outside this device writes. */
+static bool d3d12_command_list_fex_memo_eligible(const struct d3d12_command_list *list,
+        const struct vkd3d_fex_pending_clear *clear)
+{
+    const struct d3d12_resource *resource = clear->resource;
+
+    return list->type == D3D12_COMMAND_LIST_TYPE_DIRECT &&
+            clear->aspects == VK_IMAGE_ASPECT_DEPTH_BIT &&
+            clear->view->format->vk_aspect_mask == VK_IMAGE_ASPECT_DEPTH_BIT &&
+            resource->format->vk_aspect_mask == VK_IMAGE_ASPECT_DEPTH_BIT &&
+            resource->desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D &&
+            resource->desc.MipLevels == 1 && resource->desc.DepthOrArraySize == 1 &&
+            resource->desc.SampleDesc.Count == 1 &&
+            (resource->flags & VKD3D_RESOURCE_COMMITTED) && (resource->flags & VKD3D_RESOURCE_ALLOCATION) &&
+            !(resource->flags & (VKD3D_RESOURCE_RESERVED | VKD3D_RESOURCE_LINEAR_STAGING_COPY |
+                    VKD3D_RESOURCE_EXTERNAL)) &&
+            !(resource->heap_flags & D3D12_HEAP_FLAG_SHARED) &&
+            clear->view->info.texture.miplevel_idx == 0 && clear->view->info.texture.layer_idx == 0 &&
+            (uint64_t)resource->desc.Width * resource->desc.Height >= VKD3D_FEX_BIG_CLEAR_PIXELS;
+}
+
+/* Hands an eligible image a slot for this clear value if it has none yet; returns the slot, 0 = none. */
+static uint32_t d3d12_command_list_fex_memo_take_slot(struct d3d12_command_list *list,
+        const struct vkd3d_fex_pending_clear *clear, uint32_t *value_bits)
+{
+    struct vkd3d_fex_clear_memo *memo = list->device->fex_clear_memo;
+    struct d3d12_resource *resource = clear->resource;
+    uint64_t want, old;
+    uint32_t slot;
+
+    if ((slot = d3d12_resource_fex_memo_slot(resource, value_bits)))
+        return slot;
+    if (vkd3d_atomic_uint64_load_explicit(&resource->fex_memo, vkd3d_memory_order_relaxed))
+        return 0; /* no slot was left for it */
+
+    slot = vkd3d_atomic_uint32_increment(&memo->next_slot, vkd3d_memory_order_relaxed) - 1;
+    if (slot >= VKD3D_FEX_CLEAR_MEMO_SLOTS)
+    {
+        want = VKD3D_FEX_MEMO_NO_SLOT;
+        slot = 0;
+    }
+    else
+    {
+        memcpy(value_bits, &clear->value.depthStencil.depth, sizeof(*value_bits));
+        want = (uint64_t)slot << 32 | *value_bits;
+    }
+
+    old = vkd3d_atomic_uint64_compare_exchange(&resource->fex_memo, 0, want,
+            vkd3d_memory_order_relaxed, vkd3d_memory_order_relaxed);
+    if (old)
+    {
+        /* Another list got there first; the slot taken here stays unused. */
+        return d3d12_resource_fex_memo_slot(resource, value_bits);
+    }
+    vkd3d_fex_pass_meter_clear_memo(list->device, slot ? VKD3D_FEX_MEMO_NEW : VKD3D_FEX_MEMO_FULL);
+    return slot;
+}
+
+static int d3d12_command_list_fex_memo_find(const struct d3d12_command_list *list, uint32_t slot)
+{
+    uint32_t i;
+
+    for (i = 0; i < list->fex_memo.count; i++)
+    {
+        if (list->fex_memo.slot[i] == slot)
+            return i;
+    }
+    return -1;
+}
+
+static void d3d12_command_list_fex_memo_set_state(struct d3d12_command_list *list, uint32_t slot, uint8_t state)
+{
+    int i = d3d12_command_list_fex_memo_find(list, slot);
+
+    if (i < 0)
+    {
+        if (list->fex_memo.count >= VKD3D_FEX_CLEAR_MEMO_LIST_SLOTS)
+            return; /* not remembered: every later mark of it is recorded */
+        i = list->fex_memo.count++;
+        list->fex_memo.slot[i] = slot;
+    }
+    list->fex_memo.state[i] = state;
+}
+
+static void d3d12_command_list_fex_memo_fill(struct d3d12_command_list *list, uint32_t slot, uint32_t value)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+
+    VK_CALL(vkCmdFillBuffer(list->cmd.vk_command_buffer, list->device->fex_clear_memo->vk_buffer,
+            (VkDeviceSize)slot * sizeof(uint32_t), sizeof(uint32_t), value));
+}
+
+/* Marks that commands of this list may write the image: its next memo clear runs in full. While a render pass is
+ * active the mark waits for the pass to end; it only has to land before the next memo clear of the image. */
+static void d3d12_command_list_fex_memo_dirty(struct d3d12_command_list *list, struct d3d12_resource *resource)
+{
+    uint32_t slot, i;
+    int idx;
+
+    if (!list->device->fex_clear_memo || !resource || !(slot = d3d12_resource_fex_memo_slot(resource, NULL)))
+        return;
+
+    idx = d3d12_command_list_fex_memo_find(list, slot);
+    if (idx >= 0 && list->fex_memo.state[idx] == VKD3D_FEX_MEMO_STATE_DIRTY)
+        return;
+    d3d12_command_list_fex_memo_set_state(list, slot, VKD3D_FEX_MEMO_STATE_DIRTY);
+    vkd3d_fex_pass_meter_clear_memo(list->device, VKD3D_FEX_MEMO_DIRTY);
+
+    if (!(list->rendering_info.state_flags & VKD3D_RENDERING_ACTIVE))
+    {
+        d3d12_command_list_fex_memo_fill(list, slot, 1);
+        return;
+    }
+
+    for (i = 0; i < list->fex_memo.pending_count; i++)
+    {
+        if (list->fex_memo.pending[i] == slot)
+            return;
+    }
+    if (list->fex_memo.pending_count < VKD3D_FEX_CLEAR_MEMO_LIST_SLOTS)
+        list->fex_memo.pending[list->fex_memo.pending_count++] = slot;
+    else
+        list->fex_memo.pending[0] = 0; /* too many: all slots are marked when the pass ends */
+}
+
+/* Records the marks that waited for the render pass to end. */
+static void d3d12_command_list_fex_memo_flush(struct d3d12_command_list *list)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    uint32_t i, count = list->fex_memo.pending_count;
+    struct vkd3d_fex_clear_memo *memo;
+    uint32_t used;
+
+    list->fex_memo.pending_count = 0;
+    if (!count || !(memo = list->device->fex_clear_memo))
+        return;
+
+    if (!list->fex_memo.pending[0])
+    {
+        used = vkd3d_atomic_uint32_load_explicit(&memo->next_slot, vkd3d_memory_order_relaxed);
+        used = min(used, VKD3D_FEX_CLEAR_MEMO_SLOTS);
+        if (used > 1)
+        {
+            VK_CALL(vkCmdFillBuffer(list->cmd.vk_command_buffer, memo->vk_buffer, sizeof(uint32_t),
+                    (VkDeviceSize)(used - 1) * sizeof(uint32_t), 1));
+        }
+        for (i = 0; i < list->fex_memo.count; i++)
+            list->fex_memo.state[i] = VKD3D_FEX_MEMO_STATE_DIRTY;
+        return;
+    }
+
+    for (i = 0; i < count; i++)
+        d3d12_command_list_fex_memo_fill(list, list->fex_memo.pending[i], 1);
+}
+
+/* The memo clear: a LOAD/STORE pass whose vkCmdClearAttachments the GPU skips while the image's slot is 0, then the
+ * slot is set to 0. Barriers order the slot's writes and reads with every other mark, in this and other lists. */
+static void d3d12_command_list_fex_memo_clear(struct d3d12_command_list *list,
+        const struct vkd3d_fex_pending_clear *clear, uint32_t slot, VkRenderingAttachmentInfo *attachment_info,
+        VkRenderingInfo *rendering_info)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    VkConditionalRenderingBeginInfoEXT cond_info;
+    VkClearAttachment clear_attachment;
+    VkMemoryBarrier2 vk_barrier;
+    VkDependencyInfo dep_info;
+    VkClearRect clear_rect;
+
+    memset(&vk_barrier, 0, sizeof(vk_barrier));
+    vk_barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2;
+    memset(&dep_info, 0, sizeof(dep_info));
+    dep_info.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+    dep_info.memoryBarrierCount = 1;
+    dep_info.pMemoryBarriers = &vk_barrier;
+
+    /* Earlier marks (fills) land before the slot is read and before it is set again. */
+    vk_barrier.srcStageMask = VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT;
+    vk_barrier.srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    vk_barrier.dstStageMask = VK_PIPELINE_STAGE_2_CONDITIONAL_RENDERING_BIT_EXT | VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT;
+    vk_barrier.dstAccessMask = VK_ACCESS_2_CONDITIONAL_RENDERING_READ_BIT_EXT | VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &dep_info));
+
+    memset(&cond_info, 0, sizeof(cond_info));
+    cond_info.sType = VK_STRUCTURE_TYPE_CONDITIONAL_RENDERING_BEGIN_INFO_EXT;
+    cond_info.buffer = list->device->fex_clear_memo->vk_buffer;
+    cond_info.offset = (VkDeviceSize)slot * sizeof(uint32_t);
+    VK_CALL(vkCmdBeginConditionalRenderingEXT(list->cmd.vk_command_buffer, &cond_info));
+
+    attachment_info->loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+    attachment_info->storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+
+    if (list->device->fex_pass_meter)
+    {
+        const struct vkd3d_format *fex_color_formats[1] = { clear->view->format };
+
+        vkd3d_fex_pass_meter_begin_pass(list, rendering_info, fex_color_formats,
+                clear->resource->desc.SampleDesc.Count, clear->view->format, VKD3D_FEX_PASS_KIND_CLEAR);
+    }
+
+    VK_CALL(vkCmdBeginRendering(list->cmd.vk_command_buffer, rendering_info));
+
+    memset(&clear_attachment, 0, sizeof(clear_attachment));
+    clear_attachment.aspectMask = VK_IMAGE_ASPECT_DEPTH_BIT;
+    clear_attachment.clearValue = clear->value;
+    memset(&clear_rect, 0, sizeof(clear_rect));
+    clear_rect.rect = rendering_info->renderArea;
+    clear_rect.baseArrayLayer = 0;
+    clear_rect.layerCount = rendering_info->layerCount;
+    VK_CALL(vkCmdClearAttachments(list->cmd.vk_command_buffer, 1, &clear_attachment, 1, &clear_rect));
+
+    VK_CALL(vkCmdEndRendering(list->cmd.vk_command_buffer));
+    vkd3d_fex_pass_meter_end_pass(list, __LINE__);
+    d3d12_command_list_sync_tiler_renderpass_writes(list, rendering_info);
+
+    VK_CALL(vkCmdEndConditionalRenderingEXT(list->cmd.vk_command_buffer));
+
+    /* The slot was read; now it says "still clear". */
+    vk_barrier.srcStageMask = VK_PIPELINE_STAGE_2_CONDITIONAL_RENDERING_BIT_EXT;
+    vk_barrier.srcAccessMask = VK_ACCESS_2_NONE;
+    vk_barrier.dstStageMask = VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT;
+    vk_barrier.dstAccessMask = VK_ACCESS_2_NONE;
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &dep_info));
+
+    d3d12_command_list_fex_memo_fill(list, slot, 0);
+
+    /* Later marks and reads of the slot (this or later lists) come after this write. */
+    vk_barrier.srcStageMask = VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT;
+    vk_barrier.srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    vk_barrier.dstStageMask = VK_PIPELINE_STAGE_2_CONDITIONAL_RENDERING_BIT_EXT | VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT;
+    vk_barrier.dstAccessMask = VK_ACCESS_2_CONDITIONAL_RENDERING_READ_BIT_EXT | VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &dep_info));
+
+    d3d12_command_list_fex_memo_set_state(list, slot, VKD3D_FEX_MEMO_STATE_CLEAN);
+    vkd3d_fex_pass_meter_clear_memo(list->device, VKD3D_FEX_MEMO_CLEAR);
+}
+
+void vkd3d_fex_clear_memo_init(struct d3d12_device *device)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    struct vkd3d_fex_clear_memo *memo;
+    uint32_t mode = 1, *map, i;
+    void *ptr = NULL;
+    char env[16];
+
+    device->fex_clear_memo = NULL;
+
+    /* On unless asked otherwise (0 off, 2 on and off by turns every second with the pass meter). */
+    if (vkd3d_get_env_var("VKD3D_FEX_CLEAR_MEMO", env, sizeof(env)))
+    {
+        if (!strcmp(env, "0"))
+            mode = 0;
+        else if (!strcmp(env, "2") || !strcmp(env, "alt"))
+            mode = 2;
+    }
+    if (!mode)
+    {
+        INFO("FEX: big depth clears are always done in full (VKD3D_FEX_CLEAR_MEMO=0).\n");
+        return;
+    }
+    if (!device->fex_fold_clears || !device->vk_info.EXT_conditional_rendering)
+    {
+        INFO("FEX: big depth clears are always done in full (the clear memo needs %s).\n",
+                device->fex_fold_clears ? "VK_EXT_conditional_rendering" : "VKD3D_FEX_FOLD_CLEARS=1");
+        return;
+    }
+
+    if (!(memo = vkd3d_calloc(1, sizeof(*memo))))
+        return;
+    if (FAILED(vkd3d_create_buffer_explicit_usage(device,
+            VK_BUFFER_USAGE_CONDITIONAL_RENDERING_BIT_EXT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+            VKD3D_FEX_CLEAR_MEMO_SLOTS * sizeof(uint32_t), "fex-clear-memo", &memo->vk_buffer)))
+        goto fail;
+    if (FAILED(vkd3d_allocate_internal_buffer_memory(device, memo->vk_buffer,
+            VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT | VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+            VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, &memo->memory)))
+    {
+        memo->memory.vk_memory = VK_NULL_HANDLE;
+        goto fail;
+    }
+    if (VK_CALL(vkMapMemory(device->vk_device, memo->memory.vk_memory, 0, VK_WHOLE_SIZE, 0, &ptr)) != VK_SUCCESS)
+        goto fail;
+    map = ptr;
+    for (i = 0; i < VKD3D_FEX_CLEAR_MEMO_SLOTS; i++)
+        map[i] = 1;
+    VK_CALL(vkUnmapMemory(device->vk_device, memo->memory.vk_memory));
+
+    memo->next_slot = 1;
+    fex_clear_memo_alt = mode == 2;
+    vkd3d_atomic_uint32_store_explicit(&vkd3d_fex_clear_memo_now, 1u, vkd3d_memory_order_relaxed);
+    device->fex_clear_memo = memo;
+    INFO("FEX: big depth clears skipped while the image is still clear%s.\n",
+            mode == 2 ? " (with the pass meter: on and off by turns every second)" : "");
+    return;
+
+fail:
+    WARN("FEX: no clear memo buffer, big depth clears are always done in full.\n");
+    if (memo->memory.vk_memory)
+        vkd3d_free_device_memory(device, &memo->memory);
+    if (memo->vk_buffer)
+        VK_CALL(vkDestroyBuffer(device->vk_device, memo->vk_buffer, NULL));
+    vkd3d_free(memo);
+}
+
+void vkd3d_fex_clear_memo_cleanup(struct d3d12_device *device)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    struct vkd3d_fex_clear_memo *memo = device->fex_clear_memo;
+
+    if (!memo)
+        return;
+    device->fex_clear_memo = NULL;
+    VK_CALL(vkDestroyBuffer(device->vk_device, memo->vk_buffer, NULL));
+    vkd3d_free_device_memory(device, &memo->memory);
+    vkd3d_free(memo);
+}
+
+void vkd3d_fex_clear_memo_flip(struct d3d12_device *device)
+{
+    (void)device;
+    if (fex_clear_memo_alt)
+        vkd3d_atomic_uint32_store_explicit(&vkd3d_fex_clear_memo_now, vkd3d_fex_clear_memo_on() ? 0u : 1u,
+                vkd3d_memory_order_relaxed);
+}
+
+static bool vk_fex_depth_layout_read_only(VkImageLayout layout)
+{
+    return layout == VK_IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL ||
+            layout == VK_IMAGE_LAYOUT_DEPTH_READ_ONLY_STENCIL_ATTACHMENT_OPTIMAL ||
+            layout == VK_IMAGE_LAYOUT_DEPTH_READ_ONLY_OPTIMAL ||
+            layout == VK_IMAGE_LAYOUT_READ_ONLY_OPTIMAL;
+}
+
 /* The render pass load_attachment() would have recorded for this clear. Its barriers already ran at clear time.
  * made_at/line: why it is made now (VKD3D fex33 pass meter). */
 static void d3d12_command_list_fex_emit_clear_pass(struct d3d12_command_list *list,
         const struct vkd3d_fex_pending_clear *clear, enum vkd3d_fex_big_clear_event made_at, unsigned int line)
 {
     const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    enum vkd3d_fex_memo_event memo_event = VKD3D_FEX_MEMO_EVENTS;
+    uint32_t memo_slot = 0, memo_bits = 0, value_bits;
     VkRenderingAttachmentInfo attachment_info;
     VkRenderingInfo rendering_info;
     VkExtent3D view_extent;
 
+    /* VKD3D fex34: a big depth clear the GPU skips while the image still holds this value. */
+    if (list->device->fex_clear_memo && d3d12_command_list_fex_memo_eligible(list, clear) &&
+            (memo_slot = d3d12_command_list_fex_memo_take_slot(list, clear, &memo_bits)))
+    {
+        memcpy(&value_bits, &clear->value.depthStencil.depth, sizeof(value_bits));
+        if (!vkd3d_fex_clear_memo_on())
+            memo_event = VKD3D_FEX_MEMO_PLAIN_OFF;
+        else if (memo_bits != value_bits)
+            memo_event = VKD3D_FEX_MEMO_PLAIN_VALUE;
+        else if (list->predication.enabled_on_command_buffer)
+            memo_event = VKD3D_FEX_MEMO_PLAIN_PRED;
+        else
+            memo_event = VKD3D_FEX_MEMO_CLEAR;
+    }
+
     memset(&attachment_info, 0, sizeof(attachment_info));
     attachment_info.sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO;
     attachment_info.imageView = clear->view->vk_image_view;
