-            fex_swap_83e2_2cells_comp, sizeof(fex_swap_83e2_2cells_comp),
-            "3D lighting table blur", "4 cells per thread", "2 cells per thread" },
+            fex_swap_83e2_row_comp, sizeof(fex_swap_83e2_row_comp),
+            "3D lighting table blur", "8 cells per thread, 4 x by 2 y", "8 cells per thread in a row" },
