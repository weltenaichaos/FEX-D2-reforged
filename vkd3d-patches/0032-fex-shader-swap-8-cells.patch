new file mode 100644
index 0000000..188f980
--- /dev/null
+++ b/libs/vkd3d/fex_shader_swap_83e2_row.comp
@@ -0,0 +1,532 @@
+#version 460
+// Drop-in replacement for D2R's compute shader 83e2eb4a6bf5f03b (VKD3D shader hash), same interface.
+//
+// The game's shader blurs a 3D lighting table: for each output cell (x, y, z) of a W x H x D volume it sums, over
+// i < A and j < B, the product of two filtered samples of one source volume,
+//   s1 = src(i / A, (y + 0.5) / H, j / B) at mip level 'lod'     (depends on i, j, y only)
+//   s2 = src((x + 0.5) / W - i / A + 1, 1 - j / B, (z + 0.5) / D) at level 0   (depends on x, i, j, z)
+// then mixes the average with the cell's own sample. That is 2 * A * B samples per cell (8,192 in D2R: A = B = 64,
+// W = H = D = 32), while a group of 8 x 8 x 8 cells only needs A x B x 8 distinct s1 values and, as s2 depends on x
+// and i only through x * A - i * W, few distinct s2 values.
+//
+// This version (VKD3D fex32, 8 cells per thread): each group walks (j, block of IC i values) in steps. In each step
+// the group samples every distinct s1 and s2 value of the step once, with the same coordinates and sampler as the
+// game (s2 from one representative (x, i) pair), into shared memory; then every cell sums its IC products from there.
+// The next step's samples are fetched while the current step is summed. Each thread sums the 8 cells of one row
+// (x0 .. x0 + 7, one y, one z), which share their s1 values. When A = 2 W (D2R), cell x + 1 reads at i the s2 value
+// cell x reads at i - 2, so each s2 value read from shared memory serves all eight x (the last 16 values stay in
+// registers): 2 shared memory reads per 8 products, where fex31's 4-cell version needs 8 (shared memory reads were
+// what limited it on the Adreno 740: 8.5 ms per run).
+// For A = 2 W and 32 i per step, a step's sums are straight-line code in which every read names a fixed register (a
+// loop would copy the window each pass). Also new against fex31: the s1 samples are turned into (x + w, y + w,
+// z + w, w) only when stored one step later, so a thread no longer waits for the texture unit right after asking;
+// and the s2 table has 48 slots per z (46 used in D2R), so a group takes 10 KB of shared memory and 3 groups fit a
+// core instead of 2. Sums run in a different order than the game's (float rounding only).
+#extension GL_EXT_nonuniform_qualifier : require
+
+layout(local_size_x = 1, local_size_y = 8, local_size_z = 8) in;
+
+layout(push_constant) uniform RootConstants
+{
+    uint r0, r1, r2, r3, r4, r5, r6;
+} registers;
+
+layout(set = 1, binding = 1) uniform texture3D SrcTex[];
+layout(set = 1, binding = 1) uniform writeonly image3D DstImg[];
+layout(set = 3, binding = 7, std140) uniform CB
+{
+    vec4 v[8];
+} cb;
+layout(set = 0, binding = 0) uniform sampler Smp[];
+#define src sampler3D(SrcTex[registers.r4], Smp[registers.r5 + 5u])
+
+const int MAX_IC = 32;  // i values per step (s1 table: MAX_IC x 8 y)
+const int SLOTS = 48;   // s2 slots per z per step (10 KB of shared memory in all: 3 groups fit a core)
+const int THREADS = 64;
+const int S2 = MAX_IC * 8; // start of the s2 table
+
+// s1 table [i][y] (stored as (x + w, y + w, z + w, w) of the sample), then s2 table [z][slot]. One array, so that
+// the loops index both tables from a register with small fixed offsets.
+shared vec4 sh[MAX_IC * 8 + 8 * SLOTS];
+
+float to_float_u(uint u) { return float(u); }
+float to_float_s(uint u) { return float(int(u)); }
+
+// The raw s1 sample. It is turned into (x + w, y + w, z + w, w) only when stored, one step later, so that the
+// thread does not wait for the texture unit right after asking.
+vec4 s1_sample(float rA, float rB, float lod, float fi, float fv, float fj)
+{
+    return textureLod(src, vec3(rA * fi, fv, rB * fj), lod);
+}
+
+vec4 s2_sample(float rA, float rB, float fi, float fu, float fj, float fw)
+{
+    return textureLod(src, vec3(fma(-fi, rA, fu) + 1.0, fma(-fj, rB, 1.0), fw), 0.0);
+}
+
+void main()
+{
+    uvec3 base = gl_WorkGroupID * uvec3(8u, 8u, 8u);
+    uvec3 l = gl_LocalInvocationID;
+    // This thread's cells: x = x0 + k (k < 8), y = yb, z = zc.
+    uint x0 = base.x, yb = base.y + l.y, zc = base.z + l.z;
+    uvec4 dims = floatBitsToUint(cb.v[6]);
+    float W = to_float_s(dims.x), H = to_float_s(dims.y), D = to_float_s(dims.z);
+    float fy0 = to_float_u(yb), fz = to_float_u(zc);
+
+    uint Abits = floatBitsToUint(cb.v[7].x), Bbits = floatBitsToUint(cb.v[7].z); // float[28], float[30]
+    float A = to_float_s(Abits), B = to_float_s(Bbits);
+    float lod = to_float_u(floatBitsToUint(cb.v[5].w)); // float[23]
+    float rA = 1.0 / A, rB = 1.0 / B;
+    float v0 = (fy0 + 0.5) / H, w = (fz + 0.5) / D;
+
+    int Ai = int(Abits), Bi = int(Bbits), Wi = int(dims.x);
+    // Group-uniform: the shared path only for sane sizes, else the game's loop.
+    bool fast = Ai >= 1 && Ai <= 65536 && Bi >= 1 && Bi <= 65536 && Wi >= 1;
+
+    // The game's sums (x, y, z, w): acc[k] for cell (x0 + k, yb, zc).
+    vec4 acc[8];
+    for (int k = 0; k < 8; k++)
+        acc[k] = vec4(0.0);
+
+    if (fast)
+    {
+        // Whole group outside the volume: nothing to write (uniform, so no barrier is skipped by part of the group).
