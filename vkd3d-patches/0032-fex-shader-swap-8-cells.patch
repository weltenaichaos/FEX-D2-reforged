+                    a += 8;
+                    b += sstep;
+                }
+            }
+        }
+    }
+    else
+    {
+        // The game's loop, for each of the eight cells.
+        for (int k = 0; k < 8; k++)
+        {
+            float fx = to_float_u(x0 + uint(k));
+            if (!(fx < W && fy0 < H && fz < D))
+                continue;
+            float u = (fx + 0.5) / W, v = v0;
+            vec4 a8 = vec4(0.0);
+            for (float i = 0.0; !(i >= A); i += 1.0)
+            {
+                float a1 = rA * i;
+                float cx = fma(-i, rA, u) + 1.0;
+                for (float j = 0.0; !(j >= B); j += 1.0)
+                {
+                    vec4 a = textureLod(src, vec3(a1, v, rB * j), lod);
+                    vec4 b = textureLod(src, vec3(cx, fma(-j, rB, 1.0), w), 0.0);
+                    a8.x = fma(a.w + a.x, b.x, a8.x);
+                    a8.y = fma(a.w + a.y, b.y, a8.y);
+                    a8.z = fma(a.w + a.z, b.z, a8.z);
+                    a8.w = fma(a.w, b.w, a8.w);
+                }
+            }
+            acc[k] = a8;
+        }
+    }
+
+    float kk = rB * rA;
+    float e = exp2(cb.v[4].y * -0.5); // float[17]
+    for (int k = 0; k < 8; k++)
+    {
+        float fx = to_float_u(x0 + uint(k));
+        if (!(fx < W && fy0 < H && fz < D))
+            continue;
+        vec4 a8 = acc[k];
+        vec4 cs = textureLod(src, vec3((fx + 0.5) / W, v0, w), 0.0);
+        vec4 o;
+        o.x = fma(e, fma(-a8.x, kk, cs.x), kk * a8.x);
+        o.y = fma(e, fma(-a8.y, kk, cs.y), kk * a8.y);
+        o.z = fma(e, fma(-a8.z, kk, cs.z), kk * a8.z);
+        o.w = fma(e, fma(-a8.w, kk, cs.w), kk * a8.w);
+        imageStore(DstImg[registers.r3], ivec3(uvec3(x0 + uint(k), yb, zc)), o);
+    }
+}
