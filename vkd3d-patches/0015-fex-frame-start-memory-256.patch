+/* Frames whose spare times frame start pacing remembers outside GPU-bound pacing (VKD3D_FEX_START_WINDOW, 64-1024;
+ * VKD3D fex15: 256 unless set, was 64). */
+extern uint32_t vkd3d_fex_frame_start_window;
 /* Cap pre-sleep (VKD3D_FEX_PRESENT_PRESLEEP=1, swapchain.c): sleep out a frame cap's wait before vkQueuePresentKHR,
  * without holding the VkQueue the game's other queues share. */
 extern bool vkd3d_fex_present_presleep_on;
@@ -3190,7 +3193,7 @@ void vkd3d_fex_timeline_step(enum vkd3d_fex_present_step step, uint64_t ns);
 void vkd3d_fex_timeline_present(uint32_t sync_interval, uint32_t queued);
 void vkd3d_fex_timeline_release(uint64_t now_ns);
 void vkd3d_fex_timeline_pacing(uint64_t delay_ns, uint64_t margin_ns, int64_t spare_ns, bool late, bool caused,
-        bool gpu_busy, bool unseen, int64_t aim_ns, bool ceiling, bool gpu_bound);
+        bool gpu_busy, bool unseen, int64_t aim_ns, bool ceiling, bool gpu_bound, int64_t memory_less_ns);
 /* GPU time of a frame the GPU went to straight from the frame before (VKD3D fex10); pass_frame as returned by
  * vkd3d_fex_pass_meter_present(). */
 void vkd3d_fex_timeline_gpu_frame(uint64_t ns, uint32_t pass_frame);
