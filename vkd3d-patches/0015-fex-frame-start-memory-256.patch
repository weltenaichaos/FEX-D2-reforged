     int64_t pacing_spare_min_ns;
     int64_t pacing_aim_ns;      /* hold-back the last frame's spare times allowed, before the ceiling */
     uint32_t pacing_ceiling;    /* frames whose spare times allowed more than the ceiling */
+    uint32_t pacing_memory;     /* frames the longer memory (VKD3D fex15) held back less than the last 64 frames would */
+    int64_t pacing_memory_less_ns; /* ... and by how much in all */
     uint32_t pacing_gpu_bound;  /* frames paced as GPU-bound (VKD3D fex10) */
     /* GPU time of frames the GPU went to straight from the frame before, by whether they had pass meter timers */
     struct fex_timeline_stat gpu_frame[3];
@@ -140,6 +143,14 @@ void vkd3d_fex_timeline_init(void)
         if (ms >= 1 && ms <= 90)
             vkd3d_fex_frame_start_max_ms = ms;
     }
+    /* Frames of spare times remembered outside GPU-bound pacing (VKD3D fex15: 256 unless set; 64-1024 taken, 64 = fex14
+     * and before). */
+    if (vkd3d_get_env_var("VKD3D_FEX_START_WINDOW", env, sizeof(env)))
+    {
+        unsigned long frames = strtoul(env, NULL, 10);
+        if (frames >= 64 && frames <= 1024)
+            vkd3d_fex_frame_start_window = frames;
+    }
     vkd3d_atomic_uint32_store_explicit((uint32_t *)&vkd3d_fex_present_report.flags, VKD3D_FEX_REPORT_FLAG_DEVICE |
             (vkd3d_fex_timeline_on ? VKD3D_FEX_REPORT_FLAG_ON : 0) |
             (vkd3d_fex_frame_start_on ? VKD3D_FEX_REPORT_FLAG_FRAME_START | VKD3D_FEX_REPORT_FLAG_GRADUAL_START |
@@ -152,7 +163,8 @@ void vkd3d_fex_timeline_init(void)
     if (vkd3d_fex_timeline_on)
         INFO("FEX timeline on.\n");
     if (vkd3d_fex_frame_start_on)
-        INFO("FEX frame start pacing on, up to %u ms.\n", vkd3d_fex_frame_start_max_ms);
+        INFO("FEX frame start pacing on, up to %u ms, spare times of the last %u frames.\n",
