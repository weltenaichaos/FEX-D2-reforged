+
+enum fex_swap_mode
+{
+    FEX_SWAP_OFF,   /* 0: the game's shaders */
+    FEX_SWAP_FIRST, /* 1: the first FEX version */
+    FEX_SWAP_ALT,   /* 2: the second FEX version where there is one */
+    FEX_SWAP_TURNS, /* alt (or unset): binds take turns between both versions */
 };
 
