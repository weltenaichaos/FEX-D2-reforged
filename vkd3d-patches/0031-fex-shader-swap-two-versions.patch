+    int Ai = int(Abits), Bi = int(Bbits), Wi = int(dims.x);
+    // Group-uniform: the shared path only for sane sizes, else the game's loop.
+    bool fast = Ai >= 1 && Ai <= 65536 && Bi >= 1 && Bi <= 65536 && Wi >= 1;
+
+    vec4 acc0 = vec4(0.0), acc1 = vec4(0.0); // x, y, z, w of the game's sums for the two cells
+
+    if (fast)
+    {
+        // Whole group outside the volume: nothing to write (uniform, so no barrier is skipped by part of the group).
+        if (float(base.x) >= W || float(base.y) >= H || float(base.z) >= D)
+            return;
+        int x0 = int(base.x), y0 = int(base.y), z0 = int(base.z);
+        int tid = int(gl_LocalInvocationIndex);
+
+        // s2 depends on x and i through x * A - i * W = g * (x * a2 - i * w2). Slot of (x, i) in a step of IC i
+        // values: (7 - x) * a2 + i * w2, which needs 7 * a2 + (IC - 1) * w2 + 1 slots. When that does not fit,
+        // slot = x * 8 + i with IC = 8. Either way the slot grows by sstep per i.
+        int ga = Ai, gb = Wi;
+        while (gb != 0) { int t = ga % gb; ga = gb; gb = t; }
+        int a2 = Ai / ga, w2 = Wi / ga;
+        int IC = 8, S = SLOTS, sstep = 1;
+        bool shared_slots = false;
+        if (7 * a2 <= SLOTS - 1)
+        {
+            int icg = min(MAX_IC, (SLOTS - 1 - 7 * a2) / w2 + 1);
+            if (icg >= 8)
+            {
+                shared_slots = true;
+                IC = min(icg, Ai);
+                S = 7 * a2 + (IC - 1) * w2 + 1;
+                sstep = w2;
+            }
+        }
+        if (!shared_slots)
+            IC = min(8, Ai);
+        int steps = Bi * ((Ai + IC - 1) / IC);
+
+        // This thread's share of a step's samples: s1 value tid (i = tid / 8, y = tid % 8) when i < IC, and s2
+        // entries tid and tid + 256 (z = e / 64, slot = e % 64).
+        int f1i = tid >> 3;
+        bool f1on = f1i < IC;
+        float f1v = (float(uint(y0 + (tid & 7))) + 0.5) / H;
+        int f2x[2], f2i[2];
+        float f2u[2], f2w[2];
+        for (int k = 0; k < 2; k++)
+        {
+            int e = tid + k * THREADS, s = e & (SLOTS - 1);
+            f2x[k] = -1; f2i[k] = 0;
+            if (shared_slots)
+            {
+                for (int xl = 0; xl < 8 && s < S; xl++)
+                {
+                    int t = s - (7 - xl) * a2;
+                    if (t >= 0 && t % w2 == 0 && t / w2 < IC)
+                    {
+                        f2x[k] = xl; f2i[k] = t / w2;
+                        break;
+                    }
+                }
+            }
+            else if ((s & 7) < IC)
+            {
+                f2x[k] = s >> 3; f2i[k] = s & 7;
+            }
+            f2u[k] = (float(uint(x0 + max(f2x[k], 0))) + 0.5) / W;
+            f2w[k] = (float(uint(z0 + (e >> 6))) + 0.5) / D;
+        }
+
+        // Slots this thread's cells read: s1 [i * 8 + y] and [i * 8 + y + 4], s2 [sb + i * sstep].
+        int sb = S2 + int(l.z) * SLOTS + (shared_slots ? (7 - int(l.x)) * a2 : int(l.x) * 8);
+
+        vec4 p1 = vec4(0.0), p2 = vec4(0.0), p3 = vec4(0.0);
+        // Fetch step 0 (j = 0, i from 0).
+        if (f1on && f1i < Ai)
+            p1 = s1_sample(rA, rB, lod, float(f1i), f1v, 0.0);
+        if (f2x[0] >= 0 && f2i[0] < Ai)
+            p2 = s2_sample(rA, rB, float(f2i[0]), f2u[0], 0.0, f2w[0]);
+        if (f2x[1] >= 0 && f2i[1] < Ai)
+            p3 = s2_sample(rA, rB, float(f2i[1]), f2u[1], 0.0, f2w[1]);
+        int i0 = 0, nj = 0, ni0 = 0;
+        for (int st = 0; st < steps; st++)
+        {
+            if (st > 0)
+                barrier();
+            if (f1on)
+                sh[tid] = p1;
+            sh[S2 + tid] = p2;
+            sh[S2 + tid + THREADS] = p3;
+            barrier();
+
+            // Fetch the next step while this one is summed.
+            i0 = ni0;
+            ni0 += IC;
+            if (ni0 >= Ai)
+            {
+                ni0 = 0;
+                nj++;
+            }
+            if (st + 1 < steps)
+            {
+                float fj = float(nj);
+                p1 = vec4(0.0);
+                p2 = vec4(0.0);
+                p3 = vec4(0.0);
+                if (f1on && ni0 + f1i < Ai)
+                    p1 = s1_sample(rA, rB, lod, float(ni0 + f1i), f1v, fj);
+                if (f2x[0] >= 0 && ni0 + f2i[0] < Ai)
+                    p2 = s2_sample(rA, rB, float(ni0 + f2i[0]), f2u[0], fj, f2w[0]);
+                if (f2x[1] >= 0 && ni0 + f2i[1] < Ai)
+                    p3 = s2_sample(rA, rB, float(ni0 + f2i[1]), f2u[1], fj, f2w[1]);
+            }
+
+            int n = min(IC, Ai - i0);
+            int a = int(l.y), b = sb, ii = 0;
+            if (sstep == 1)
+            {
+                // Fixed offsets: 4 products per round for both cells.
+                for (; ii + 4 <= n; ii += 4)
+                {
+                    vec4 b0 = sh[b], b1 = sh[b + 1], b2 = sh[b + 2], b3 = sh[b + 3];
+                    vec4 c0 = sh[a], c1 = sh[a + 8], c2 = sh[a + 16], c3 = sh[a + 24];
+                    vec4 d0 = sh[a + 4], d1 = sh[a + 12], d2 = sh[a + 20], d3 = sh[a + 28];
+                    acc0 = fma(c0, b0, acc0);
+                    acc1 = fma(d0, b0, acc1);
+                    acc0 = fma(c1, b1, acc0);
+                    acc1 = fma(d1, b1, acc1);
+                    acc0 = fma(c2, b2, acc0);
+                    acc1 = fma(d2, b2, acc1);
+                    acc0 = fma(c3, b3, acc0);
+                    acc1 = fma(d3, b3, acc1);
+                    a += 32;
+                    b += 4;
+                }
+            }
+            for (; ii < n; ii++)
+            {
+                vec4 bb = sh[b];
+                acc0 = fma(sh[a], bb, acc0);
+                acc1 = fma(sh[a + 4], bb, acc1);
+                a += 8;
+                b += sstep;
+            }
+        }
+    }
+    else
+    {
+        // The game's loop, for each of the two cells.
+        for (int c = 0; c < 2; c++)
+        {
+            if (!(c == 0 ? in0 : in1))
+                continue;
+            float v = c == 0 ? v0 : v1;
+            vec4 acc = vec4(0.0);
+            for (float i = 0.0; !(i >= A); i += 1.0)
+            {
+                float a1 = rA * i;
+                float cx = fma(-i, rA, u) + 1.0;
+                for (float j = 0.0; !(j >= B); j += 1.0)
+                {
+                    vec4 a = textureLod(src, vec3(a1, v, rB * j), lod);
+                    vec4 b = textureLod(src, vec3(cx, fma(-j, rB, 1.0), w), 0.0);
+                    acc.x = fma(a.w + a.x, b.x, acc.x);
+                    acc.y = fma(a.w + a.y, b.y, acc.y);
+                    acc.z = fma(a.w + a.z, b.z, acc.z);
+                    acc.w = fma(a.w, b.w, acc.w);
+                }
+            }
+            if (c == 0)
+                acc0 = acc;
+            else
+                acc1 = acc;
+        }
+    }
+
+    float k = rB * rA;
+    float e = exp2(cb.v[4].y * -0.5); // float[17]
+    for (int c = 0; c < 2; c++)
+    {
+        if (!(c == 0 ? in0 : in1))
+            continue;
+        vec4 acc = c == 0 ? acc0 : acc1;
+        vec4 cs = textureLod(src, vec3(u, c == 0 ? v0 : v1, w), 0.0);
+        vec4 o;
+        o.x = fma(e, fma(-acc.x, k, cs.x), k * acc.x);
+        o.y = fma(e, fma(-acc.y, k, cs.y), k * acc.y);
+        o.z = fma(e, fma(-acc.z, k, cs.z), k * acc.z);
+        o.w = fma(e, fma(-acc.w, k, cs.w), k * acc.w);
+        imageStore(DstImg[registers.r3], ivec3(c == 0 ? id0 : id1), o);
+    }
+}
