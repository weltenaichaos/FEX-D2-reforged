     uint32_t repeat[FEX_SWAP_COUNT];     /* reports that still carry the note (FEX prints each note once) */
 } fex_swap = { PTHREAD_ONCE_INIT };
 
+static const char *fex_swap_mode_text(void)
+{
+    switch (fex_swap.mode)
+    {
+        case FEX_SWAP_FIRST: return "first version";
+        case FEX_SWAP_ALT: return "second version";
+        case FEX_SWAP_TURNS: return "both versions in turns";
+        default: return "off";
+    }
+}
+
 static void fex_swap_init_once(void)
 {
     char env[16];
 
-    fex_swap.enabled = !vkd3d_get_env_var("VKD3D_FEX_SHADER_SWAP", env, sizeof(env)) || strcmp(env, "0");
-    if (fex_swap.enabled)
-    {
-        INFO("FEX: shader swap is on.\n");
-        vkd3d_atomic_uint32_or((uint32_t *)&vkd3d_fex_gpu_report.flags, VKD3D_FEX_REPORT_FLAG_SHADER_SWAP,
-                vkd3d_memory_order_release);
-    }
+    if (!vkd3d_get_env_var("VKD3D_FEX_SHADER_SWAP", env, sizeof(env)) || !strcmp(env, "alt"))
+        fex_swap.mode = FEX_SWAP_TURNS;
+    else if (!strcmp(env, "0"))
+        fex_swap.mode = FEX_SWAP_OFF;
+    else if (!strcmp(env, "2"))
+        fex_swap.mode = FEX_SWAP_ALT;
+    else
+        fex_swap.mode = FEX_SWAP_FIRST;
+    fex_swap.enabled = fex_swap.mode != FEX_SWAP_OFF;
+    INFO("FEX: shader swap: %s.\n", fex_swap_mode_text());
