+/* VKD3D fex31: the second FEX version of a swapped compute shader, as a pipeline of its own with the same create
+ * info (layout, flags, stage). Not put in the PSO's pipeline cache. On failure the PSO keeps the first version only. */
+static void vkd3d_fex_create_second_compute_pipeline(struct d3d12_pipeline_state *state,
+        struct d3d12_device *device, const VkComputePipelineCreateInfo *first_info)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    VkComputePipelineCreateInfo pipeline_info = *first_info;
+    struct vkd3d_shader_code second;
+    const uint32_t *code;
+    size_t size;
+    VkResult vr;
+
+    if (!vkd3d_fex_shader_swap_second(&state->compute.code, &code, &size))
+        return;
+    memset(&second, 0, sizeof(second));
+    second.code = code;
+    second.size = size;
+    second.meta.hash = state->compute.code.meta.hash;
