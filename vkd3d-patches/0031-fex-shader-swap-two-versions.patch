+// then mixes the average with the cell's own sample. That is 2 * A * B samples per cell (8,192 in D2R: A = B = 64,
+// W = H = D = 32), which keeps the Adreno 740 texture unit busy for 30 ms per run, while a group of 8 x 8 x 8 cells
+// only needs A x B x 8 distinct s1 values and, as s2 depends on x and i only through x * A - i * W, few distinct s2
+// values.
 //
-// This version: each group walks (j, block of IC i values) in steps. In each step the group samples every distinct
-// s1 and s2 value of the step once, with the same coordinates and sampler as the game (s2 from one representative
-// (x, i) pair), into shared memory; then every cell sums its IC products from there. The next step's samples are
-// fetched while the current step is summed. Sums run in a different order (float rounding only).
+// This version (VKD3D fex31, 4 cells per thread): each group walks (j, block of IC i values) in steps. In each step
+// the group samples every distinct s1 and s2 value of the step once, with the same coordinates and sampler as the
+// game (s2 from one representative (x, i) pair), into shared memory; then every cell sums its IC products from there.
+// The next step's samples are fetched while the current step is summed. Each thread sums four cells, x and x + 4 by
+// y and y + 4: the two y cells share their s2 values and the two x cells their s1 values. s2 slots run in i order,
+// so with one slot per i (W divides A, the D2R case) the sums read shared memory at fixed offsets. Sums run in a
+// different order than the game's (float rounding only).
 #extension GL_EXT_nonuniform_qualifier : require
 
-layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;
+layout(local_size_x = 4, local_size_y = 4, local_size_z = 8) in;
 
 layout(push_constant) uniform RootConstants
 {
@@ -33,50 +37,85 @@ layout(set = 0, binding = 0) uniform sampler Smp[];
 
 const int MAX_IC = 32;  // i values per step (s1 table: MAX_IC x 8 y)
 const int SLOTS = 64;   // s2 slots per z per step
+const int THREADS = 128;
+const int S2 = MAX_IC * 8; // start of the s2 table
 
-shared vec4 s1t[MAX_IC * 8]; // [i][y], stored as (x + w, y + w, z + w, w) of the sample
-shared vec4 s2t[8 * SLOTS];  // [z][slot]
+// s1 table [i][y] (stored as (x + w, y + w, z + w, w) of the sample), then s2 table [z][slot]. One array, so that
+// the loops index both tables from a register with small fixed offsets.
+shared vec4 sh[MAX_IC * 8 + 8 * SLOTS];
 
 float to_float_u(uint u) { return float(u); }
 float to_float_s(uint u) { return float(int(u)); }
 
+vec4 s1_sample(float rA, float rB, float lod, float fi, float fv, float fj)
+{
+    vec4 s = textureLod(src, vec3(rA * fi, fv, rB * fj), lod);
+    return vec4(s.w + s.x, s.w + s.y, s.w + s.z, s.w);
+}
+
+vec4 s2_sample(float rA, float rB, float fi, float fu, float fj, float fw)
+{
+    return textureLod(src, vec3(fma(-fi, rA, fu) + 1.0, fma(-fj, rB, 1.0), fw), 0.0);
+}
+
+// s2 representative (x in the group, i in the step) of entry e of a step's s2 table, x = -1 if no cell reads it.
+ivec2 s2_rep(int e, bool shared_slots, int S, int a2, int w2, int IC)
+{
+    int s = e & (SLOTS - 1);
+    if (shared_slots)
+    {
+        for (int xl = 0; xl < 8 && s < S; xl++)
+        {
+            int t = s - (7 - xl) * a2;
+            if (t >= 0 && t % w2 == 0 && t / w2 < IC)
+                return ivec2(xl, t / w2);
+        }
+    }
+    else if ((s & 7) < IC)
+        return ivec2(s >> 3, s & 7);
+    return ivec2(-1, 0);
+}
+
