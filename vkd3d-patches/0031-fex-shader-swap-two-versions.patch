+
+/* Called at device creation, so the flags are in the gpu report before FEX announces it. */
+uint32_t vkd3d_fex_shader_swap_flags(void)
+{
+    pthread_once(&fex_swap.once, fex_swap_init_once);
+    if (!fex_swap.enabled)
+        return 0;
+    return VKD3D_FEX_REPORT_FLAG_SHADER_SWAP |
+            (fex_swap.mode == FEX_SWAP_TURNS ? VKD3D_FEX_REPORT_FLAG_SHADER_SWAP_TURNS : 0);
