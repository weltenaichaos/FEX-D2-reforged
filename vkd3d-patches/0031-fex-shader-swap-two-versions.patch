     /* Keeps the FEX version out of vkd3d's SPIR-V caches (vkd3d_shader_code_serialize_*). */
     spirv->meta.flags |= VKD3D_SHADER_META_FLAG_REPLACED;
-    INFO("FEX: shader %016"PRIx64" (%s) swapped for the FEX version.\n", spirv->meta.hash, fex_swaps[i].what);
+    INFO("FEX: shader %016"PRIx64" (%s) swapped for the FEX version (%s).\n", spirv->meta.hash, fex_swaps[i].what,
+            alt ? fex_swaps[i].alt_what : fex_swaps[i].code_what);
     vkd3d_atomic_uint32_increment(&fex_swap.swapped[i], vkd3d_memory_order_relaxed);
 }
 
+bool vkd3d_fex_shader_swap_second(const struct vkd3d_shader_code *spirv, const uint32_t **code, size_t *size)
+{
+    int i;
+
+    if (fex_swap.mode != FEX_SWAP_TURNS || !(spirv->meta.flags & VKD3D_SHADER_META_FLAG_REPLACED) ||
+            (i = fex_swap_find(spirv->meta.hash)) < 0 || !fex_swaps[i].alt_code ||
+            spirv->size != fex_swaps[i].size || memcmp(spirv->code, fex_swaps[i].code, spirv->size))
+        return false;
+    *code = fex_swaps[i].alt_code;
+    *size = fex_swaps[i].alt_size;
+    return true;
+}
+
+void vkd3d_fex_shader_swap_paired(const struct vkd3d_shader_code *spirv)
+{
+    int i;
+
+    if ((i = fex_swap_find(spirv->meta.hash)) >= 0)
+    {
+        INFO("FEX: shader %016"PRIx64" (%s): binds take turns between %s and %s.\n", spirv->meta.hash,
+                fex_swaps[i].what, fex_swaps[i].code_what, fex_swaps[i].alt_what);
+        vkd3d_atomic_uint32_increment(&fex_swap.paired[i], vkd3d_memory_order_relaxed);
+    }
+}
+
+bool vkd3d_fex_shader_swap_take_second(void)
+{
+    return vkd3d_atomic_uint32_increment(&fex_swap.turn, vkd3d_memory_order_relaxed) & 1;
+}
