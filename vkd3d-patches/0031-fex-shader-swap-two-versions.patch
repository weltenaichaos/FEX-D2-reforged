@@ -51,25 +70,52 @@ static struct
 {
     pthread_once_t once;
     bool enabled;
+    enum fex_swap_mode mode;
+    uint32_t turn;                       /* binds of pipelines with two versions */
     uint32_t swapped[FEX_SWAP_COUNT];    /* pipelines made with the FEX version */
+    uint32_t paired[FEX_SWAP_COUNT];     /* of those, pipelines that also got the second version */
     uint32_t kept[FEX_SWAP_COUNT];       /* pipelines that kept the game's shader: other SPIR-V */
