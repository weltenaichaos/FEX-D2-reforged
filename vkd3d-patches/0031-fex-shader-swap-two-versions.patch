-                " game's shader kept in %u (its SPIR-V %016"PRIx64" is not the %016"PRIx64" the FEX version was"
-                " written for) and in %u with the swap off\n",
-                fex_swaps[i].dxbc_hash, fex_swaps[i].what, n[0], n[1],
-                vkd3d_atomic_uint64_load_explicit(&fex_swap.other_hash[i], vkd3d_memory_order_relaxed),
+                "# shader swap (VKD3D fex31, %s): compute shader %016"PRIx64" (%s): FEX's version in %u pipelines"
+                " (%s), %u of them also with %s (binds take turns) | the game's shader kept in %u (its SPIR-V"
+                " %016"PRIx64" is not the %016"PRIx64" the FEX version was written for) and in %u with the swap"
+                " off\n",
+                fex_swap_mode_text(), fex_swaps[i].dxbc_hash, fex_swaps[i].what, n[0],
+                fex_swap.mode == FEX_SWAP_ALT && fex_swaps[i].alt_code ? fex_swaps[i].alt_what
+                        : fex_swaps[i].code_what,
+                n[3], fex_swaps[i].alt_code ? fex_swaps[i].alt_what : "a second version",
