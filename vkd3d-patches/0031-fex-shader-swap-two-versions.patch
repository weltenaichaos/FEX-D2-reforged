index 54b9714..29dd760 100644
--- a/libs/vkd3d/fex_shader_swap_83e2.comp
+++ b/libs/vkd3d/fex_shader_swap_83e2.comp
@@ -5,17 +5,21 @@
 // i < A and j < B, the product of two filtered samples of one source volume,
 //   s1 = src(i / A, (y + 0.5) / H, j / B) at mip level 'lod'     (depends on i, j, y only)
