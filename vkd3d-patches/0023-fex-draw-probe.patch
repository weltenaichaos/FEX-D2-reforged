+     * FEX prints each note once). */
+    if (meter->gpu_publishes > 3 * FEX_DRAW_FIRST_PUBLISH && meter->gpu_publishes <= 3 * FEX_DRAW_FIRST_PUBLISH + 3 &&
+            (probe = vkd3d_fex_draw_probe_result()))
+        len = vkd3d_fex_report_append(text, sizeof(text), len, "%s", probe);
+
     vkd3d_fex_memory_take(&mem);
     for (i = 0; i < VKD3D_FEX_MEM_COUNT; i++)
         any_mem |= mem.n[i] != 0;
