diff --git a/libs/vkd3d/fex_shader_swap.c b/libs/vkd3d/fex_shader_swap.c
new file mode 100644
index 0000000..97e1740
--- /dev/null
+++ b/libs/vkd3d/fex_shader_swap.c
@@ -0,0 +1,166 @@
+/*
+ * FEX shader swap (VKD3D fex30): for the compute shaders listed below, vkd3d hands the driver FEX's own SPIR-V instead
+ * of its translation of the game's shader. Each FEX version has the same interface (descriptor sets and bindings, push
+ * constants, constant buffer) and gives the same results up to float rounding, with far less GPU work.
+ *
+ * The swap only happens when the translated SPIR-V is exactly the one the FEX version was written against (its hash),
+ * so a different root signature or shader converter keeps the game's shader. A listed shader is never taken from a
+ * pipeline cache (SPIR-V or driver module identifier): it is translated again each time, so the swap sees the
+ * translation and turning the swap off can't pick up the FEX version from a cache. VKD3D_FEX_SHADER_SWAP=0 turns the
+ * swap off. FEX's stats log gets a '#' note in the gpu report whenever the counts change (in the next 3 reports, as FEX
+ * prints each note once and may miss a report).
+ *
+ * 83e2eb4a6bf5f03b (Diablo II: Resurrected): blurs a 3D lighting table of 8 x 8 x 8 cell groups. For each cell it
+ * sums 2 x A x B filtered samples of one volume (8,192 per cell in D2R: 30 ms per run on an Adreno 740, in bursts of
+ * up to 19 runs when the game enters an area). The FEX version samples each distinct value once per group into
+ * shared memory and sums from there (fex_shader_swap_83e2.comp).
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+
+#include "vkd3d_private.h"
+#include <stdio.h>
+#include <string.h>
+#include <inttypes.h>
+
+#include "fex_shader_swap_spv.h"
+
+struct fex_swap
+{
+    vkd3d_shader_hash_t dxbc_hash;  /* the game's shader (vkd3d's D3D bytecode hash) */
+    vkd3d_shader_hash_t spirv_hash; /* vkd3d's translation the FEX version matches */
+    const uint32_t *code;
+    size_t size;
+    const char *what;
+};
+
+static const struct fex_swap fex_swaps[] =
+{
+    { 0x83e2eb4a6bf5f03bull, 0xceec199cf0b2a1d2ull, fex_swap_83e2_comp, sizeof(fex_swap_83e2_comp),
+            "3D lighting table blur" },
+};
+
+#define FEX_SWAP_COUNT ARRAY_SIZE(fex_swaps)
+
+static struct
+{
+    pthread_once_t once;
+    bool enabled;
+    uint32_t swapped[FEX_SWAP_COUNT];    /* pipelines made with the FEX version */
+    uint32_t kept[FEX_SWAP_COUNT];       /* pipelines that kept the game's shader: other SPIR-V */
+    uint32_t off[FEX_SWAP_COUNT];        /* pipelines that kept the game's shader: switch off */
+    uint64_t other_hash[FEX_SWAP_COUNT]; /* the last SPIR-V hash that did not match */
+    uint32_t noted[FEX_SWAP_COUNT][3];   /* counts in the last note */
+    uint32_t repeat[FEX_SWAP_COUNT];     /* reports that still carry the note (FEX prints each note once) */
+} fex_swap = { PTHREAD_ONCE_INIT };
+
+static void fex_swap_init_once(void)
+{
+    char env[16];
+
+    fex_swap.enabled = !vkd3d_get_env_var("VKD3D_FEX_SHADER_SWAP", env, sizeof(env)) || strcmp(env, "0");
+    if (fex_swap.enabled)
+    {
+        INFO("FEX: shader swap is on.\n");
+        vkd3d_atomic_uint32_or((uint32_t *)&vkd3d_fex_gpu_report.flags, VKD3D_FEX_REPORT_FLAG_SHADER_SWAP,
+                vkd3d_memory_order_release);
+    }
+}
+
+static int fex_swap_find(vkd3d_shader_hash_t hash)
+{
+    unsigned int i;
+
+    for (i = 0; i < FEX_SWAP_COUNT; i++)
+    {
+        if (fex_swaps[i].dxbc_hash == hash)
+            return (int)i;
+    }
+    return -1;
+}
+
+bool vkd3d_fex_shader_swap_listed(VkShaderStageFlagBits stage, const D3D12_SHADER_BYTECODE *code)
+{
+    struct vkd3d_shader_code dxbc;
+
+    if (stage != VK_SHADER_STAGE_COMPUTE_BIT || !code->pShaderBytecode || !code->BytecodeLength)
+        return false;
+    pthread_once(&fex_swap.once, fex_swap_init_once);
+    dxbc.code = code->pShaderBytecode;
+    dxbc.size = code->BytecodeLength;
+    return fex_swap_find(vkd3d_shader_hash(&dxbc)) >= 0;
+}
+
+void vkd3d_fex_shader_swap(VkShaderStageFlagBits stage, struct vkd3d_shader_code *spirv)
+{
+    vkd3d_shader_hash_t hash;
+    void *code;
+    int i;
+
+    if (stage != VK_SHADER_STAGE_COMPUTE_BIT || !spirv->code || !spirv->size)
+        return;
+    /* Already replaced through VKD3D_SHADER_OVERRIDE. */
+    if (spirv->meta.flags & VKD3D_SHADER_META_FLAG_REPLACED)
+        return;
+    if ((i = fex_swap_find(spirv->meta.hash)) < 0)
+        return;
+    pthread_once(&fex_swap.once, fex_swap_init_once);
+
+    if (!fex_swap.enabled)
+    {
+        vkd3d_atomic_uint32_increment(&fex_swap.off[i], vkd3d_memory_order_relaxed);
+        return;
+    }
+    if ((hash = vkd3d_shader_hash(spirv)) != fex_swaps[i].spirv_hash)
+    {
+        WARN("FEX: shader %016"PRIx64" translated to SPIR-V %016"PRIx64", not %016"PRIx64": kept.\n",
+                spirv->meta.hash, hash, fex_swaps[i].spirv_hash);
+        vkd3d_atomic_uint64_store_explicit(&fex_swap.other_hash[i], hash, vkd3d_memory_order_relaxed);
+        vkd3d_atomic_uint32_increment(&fex_swap.kept[i], vkd3d_memory_order_relaxed);
+        return;
+    }
+    if (!(code = vkd3d_malloc(fex_swaps[i].size)))
+        return;
+    memcpy(code, fex_swaps[i].code, fex_swaps[i].size);
+    vkd3d_shader_free_shader_code(spirv);
+    spirv->code = code;
+    spirv->size = fex_swaps[i].size;
+    /* Keeps the FEX version out of vkd3d's SPIR-V caches (vkd3d_shader_code_serialize_*). */
+    spirv->meta.flags |= VKD3D_SHADER_META_FLAG_REPLACED;
+    INFO("FEX: shader %016"PRIx64" (%s) swapped for the FEX version.\n", spirv->meta.hash, fex_swaps[i].what);
+    vkd3d_atomic_uint32_increment(&fex_swap.swapped[i], vkd3d_memory_order_relaxed);
+}
+
+size_t vkd3d_fex_shader_swap_append(char *text, size_t size, size_t len)
+{
+    uint32_t n[3];
+    unsigned int i;
+
+    for (i = 0; i < FEX_SWAP_COUNT; i++)
+    {
+        n[0] = vkd3d_atomic_uint32_load_explicit(&fex_swap.swapped[i], vkd3d_memory_order_relaxed);
+        n[1] = vkd3d_atomic_uint32_load_explicit(&fex_swap.kept[i], vkd3d_memory_order_relaxed);
+        n[2] = vkd3d_atomic_uint32_load_explicit(&fex_swap.off[i], vkd3d_memory_order_relaxed);
+        if (memcmp(n, fex_swap.noted[i], sizeof(n)))
+        {
+            memcpy(fex_swap.noted[i], n, sizeof(n));
+            fex_swap.repeat[i] = 3;
+        }
+        if (!fex_swap.repeat[i])
+            continue;
+        fex_swap.repeat[i]--;
+        len = vkd3d_fex_report_append(text, size, len,
+                "# shader swap (VKD3D fex30): compute shader %016"PRIx64" (%s): FEX's version in %u pipelines | the"
+                " game's shader kept in %u (its SPIR-V %016"PRIx64" is not the %016"PRIx64" the FEX version was"
+                " written for) and in %u with the swap off\n",
+                fex_swaps[i].dxbc_hash, fex_swaps[i].what, n[0], n[1],
+                vkd3d_atomic_uint64_load_explicit(&fex_swap.other_hash[i], vkd3d_memory_order_relaxed),
+                fex_swaps[i].spirv_hash, n[2]);
+    }
+    return len;
+}
diff --git a/libs/vkd3d/fex_shader_swap_83e2.comp b/libs/vkd3d/fex_shader_swap_83e2.comp
new file mode 100644
index 0000000..54b9714
--- /dev/null
+++ b/libs/vkd3d/fex_shader_swap_83e2.comp
@@ -0,0 +1,224 @@
+#version 460
+// Drop-in replacement for D2R's compute shader 83e2eb4a6bf5f03b (VKD3D shader hash), same interface.
+//
+// The game's shader blurs a 3D lighting table: for each output cell (x, y, z) of a W x H x D volume it sums, over
+// i < A and j < B, the product of two filtered samples of one source volume,
+//   s1 = src(i / A, (y + 0.5) / H, j / B) at mip level 'lod'     (depends on i, j, y only)
+//   s2 = src((x + 0.5) / W - i / A + 1, 1 - j / B, (z + 0.5) / D) at level 0   (depends on x, i, j, z)
+// then mixes the average with the cell's own sample. That is 2 * A * B samples per cell (8,192 in D2R, which keeps
+// the Adreno 740 texture unit busy for 30 ms per run), while a group of 8 x 8 x 8 cells only needs A x B x 8
+// distinct s1 values and, as s2 depends on x and i only through x * A - i * W, few distinct s2 values.
+//
+// This version: each group walks (j, block of IC i values) in steps. In each step the group samples every distinct
+// s1 and s2 value of the step once, with the same coordinates and sampler as the game (s2 from one representative
+// (x, i) pair), into shared memory; then every cell sums its IC products from there. The next step's samples are
+// fetched while the current step is summed. Sums run in a different order (float rounding only).
+#extension GL_EXT_nonuniform_qualifier : require
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;
+
+layout(push_constant) uniform RootConstants
+{
+    uint r0, r1, r2, r3, r4, r5, r6;
+} registers;
+
+layout(set = 1, binding = 1) uniform texture3D SrcTex[];
+layout(set = 1, binding = 1) uniform writeonly image3D DstImg[];
+layout(set = 3, binding = 7, std140) uniform CB
+{
+    vec4 v[8];
+} cb;
+layout(set = 0, binding = 0) uniform sampler Smp[];
+#define src sampler3D(SrcTex[registers.r4], Smp[registers.r5 + 5u])
+
+const int MAX_IC = 32;  // i values per step (s1 table: MAX_IC x 8 y)
+const int SLOTS = 64;   // s2 slots per z per step
+
+shared vec4 s1t[MAX_IC * 8]; // [i][y], stored as (x + w, y + w, z + w, w) of the sample
+shared vec4 s2t[8 * SLOTS];  // [z][slot]
+
+float to_float_u(uint u) { return float(u); }
+float to_float_s(uint u) { return float(int(u)); }
+
+void main()
+{
+    uvec3 id = gl_GlobalInvocationID;
+    float fx = to_float_u(id.x), fy = to_float_u(id.y), fz = to_float_u(id.z);
+    uvec4 dims = floatBitsToUint(cb.v[6]);
+    float W = to_float_s(dims.x), H = to_float_s(dims.y), D = to_float_s(dims.z);
+    bool inside = fx < W && fy < H && fz < D;
+
+    uint Abits = floatBitsToUint(cb.v[7].x), Bbits = floatBitsToUint(cb.v[7].z); // float[28], float[30]
+    float A = to_float_s(Abits), B = to_float_s(Bbits);
+    float lod = to_float_u(floatBitsToUint(cb.v[5].w)); // float[23]
+    float rA = 1.0 / A, rB = 1.0 / B;
+    float u = (fx + 0.5) / W, v = (fy + 0.5) / H, w = (fz + 0.5) / D;
+
+    int Ai = int(Abits), Bi = int(Bbits), Wi = int(dims.x);
+    // Group-uniform: the shared path only for sane sizes, else the game's loop.
+    bool fast = Ai >= 1 && Ai <= 65536 && Bi >= 1 && Bi <= 65536 && Wi >= 1;
+
+    vec4 acc = vec4(0.0); // x, y, z, w of the game's sums
+
+    if (fast)
+    {
+        uvec3 base = gl_WorkGroupID * gl_WorkGroupSize;
+        // Whole group outside the volume: nothing to write (uniform, so no barrier is skipped by part of the group).
+        if (float(base.x) >= W || float(base.y) >= H || float(base.z) >= D)
+            return;
+        int x0 = int(base.x), y0 = int(base.y), z0 = int(base.z);
+        int tid = int(gl_LocalInvocationIndex);
+        ivec3 l = ivec3(gl_LocalInvocationID);
+
+        // s2 depends on x and i through x * A - i * W = g * (x * a2 - i * w2). Slot of (x, i) in a step of IC i
+        // values: x * a2 - i * w2 + (IC - 1) * w2, which needs 7 * a2 + (IC - 1) * w2 + 1 slots. When that does not
+        // fit, slot = x * 8 + i with IC = 8.
+        int ga = Ai, gb = Wi;
+        while (gb != 0) { int t = ga % gb; ga = gb; gb = t; }
+        int a2 = Ai / ga, w2 = Wi / ga;
+        int IC = 8, S = SLOTS, sbase = 0, sstep = 1;
+        bool shared_slots = false;
+        if (7 * a2 <= SLOTS - 1)
+        {
+            int icg = min(MAX_IC, (SLOTS - 1 - 7 * a2) / w2 + 1);
+            if (icg >= 8)
+            {
+                shared_slots = true;
+                IC = min(icg, Ai);
+                S = 7 * a2 + (IC - 1) * w2 + 1;
+                sstep = -w2;
+            }
+        }
+        if (!shared_slots)
+            IC = min(8, Ai);
+
+        int nI = (Ai + IC - 1) / IC;
+        int steps = Bi * nI;
+
+        // This thread's share of the samples of a step: one s1 value (tid < IC * 8), one s2 slot (tid < 8 * 64).
+        int f1i = tid >> 3, f1y = tid & 7;
+        bool f1on = f1i < IC;
+        float f1v = (float(uint(y0 + f1y)) + 0.5) / H;
+        int f2z = tid >> 6, f2s = tid & (SLOTS - 1);
+        float f2w = (float(uint(z0 + f2z)) + 0.5) / D;
+        // Representative (x, i) of slot f2s.
+        int f2x = -1, f2i = 0;
+        if (shared_slots)
+        {
+            for (int xl = 0; xl < 8 && f2s < S; xl++)
+            {
+                int t = xl * a2 + (IC - 1) * w2 - f2s;
+                if (t >= 0 && t % w2 == 0 && t / w2 < IC)
+                {
+                    f2x = xl; f2i = t / w2;
+                    break;
+                }
+            }
+        }
+        else
+        {
+            f2x = f2s >> 3; f2i = f2s & 7;
+            if (f2i >= IC)
+                f2x = -1;
+        }
+        float f2u = (float(uint(x0 + max(f2x, 0))) + 0.5) / W;
+
+        // Slots this cell reads: s1t[i * 8 + y], s2t[z * 64 + sb + i * sstep].
+        int sb = shared_slots ? l.x * a2 + (IC - 1) * w2 : l.x * 8;
+        int s2c = l.z * SLOTS + sb;
+
+        vec4 p1 = vec4(0.0), p2 = vec4(0.0);
+        // Fetch step 0 (j = 0, i from 0).
+        if (f1on && f1i < Ai)
+        {
+            vec4 s = textureLod(src, vec3(rA * float(f1i), f1v, 0.0), lod);
+            p1 = vec4(s.w + s.x, s.w + s.y, s.w + s.z, s.w);
+        }
+        if (f2x >= 0 && f2i < Ai)
+            p2 = textureLod(src, vec3(fma(-float(f2i), rA, f2u) + 1.0, 1.0, f2w), 0.0);
+        int i0 = 0, nj = 0, ni0 = 0;
+        for (int st = 0; st < steps; st++)
+        {
+            if (st > 0)
+                barrier();
+            if (f1on)
+                s1t[tid] = p1;
+            s2t[tid] = p2;
+            barrier();
+
+            // Fetch the next step while this one is summed.
+            i0 = ni0;
+            ni0 += IC;
+            if (ni0 >= Ai)
+            {
+                ni0 = 0;
+                nj++;
+            }
+            if (st + 1 < steps)
+            {
+                float fj = float(nj);
+                p1 = vec4(0.0);
+                p2 = vec4(0.0);
+                if (f1on && ni0 + f1i < Ai)
+                {
+                    vec4 s = textureLod(src, vec3(rA * float(ni0 + f1i), f1v, rB * fj), lod);
+                    p1 = vec4(s.w + s.x, s.w + s.y, s.w + s.z, s.w);
+                }
+                if (f2x >= 0 && ni0 + f2i < Ai)
+                    p2 = textureLod(src, vec3(fma(-float(ni0 + f2i), rA, f2u) + 1.0, fma(-fj, rB, 1.0), f2w), 0.0);
+            }
+
+            // Sum this step: 4 products per round so the shared memory reads go out together.
+            int n = min(IC, Ai - i0);
+            int a = l.y, b = s2c, ii = 0;
+            for (; ii + 4 <= n; ii += 4)
+            {
+                vec4 a0 = s1t[a], a1 = s1t[a + 8], a2v = s1t[a + 16], a3 = s1t[a + 24];
+                vec4 b0 = s2t[b], b1 = s2t[b + sstep], b2 = s2t[b + 2 * sstep], b3 = s2t[b + 3 * sstep];
+                acc = fma(a0, b0, acc);
+                acc = fma(a1, b1, acc);
+                acc = fma(a2v, b2, acc);
+                acc = fma(a3, b3, acc);
+                a += 32;
+                b += 4 * sstep;
+            }
+            for (; ii < n; ii++)
+            {
+                acc = fma(s1t[a], s2t[b], acc);
+                a += 8;
+                b += sstep;
+            }
+        }
+    }
+    else if (inside)
+    {
+        // The game's loop.
+        for (float i = 0.0; !(i >= A); i += 1.0)
+        {
+            float a1 = rA * i;
+            float cx = fma(-i, rA, u) + 1.0;
+            for (float j = 0.0; !(j >= B); j += 1.0)
+            {
+                vec4 a = textureLod(src, vec3(a1, v, rB * j), lod);
+                vec4 b = textureLod(src, vec3(cx, fma(-j, rB, 1.0), w), 0.0);
+                acc.x = fma(a.w + a.x, b.x, acc.x);
+                acc.y = fma(a.w + a.y, b.y, acc.y);
+                acc.z = fma(a.w + a.z, b.z, acc.z);
+                acc.w = fma(a.w, b.w, acc.w);
+            }
+        }
+    }
+
+    if (inside)
+    {
+        float k = rB * rA;
+        vec4 c = textureLod(src, vec3(u, v, w), 0.0);
+        float e = exp2(cb.v[4].y * -0.5); // float[17]
+        vec4 o;
+        o.x = fma(e, fma(-acc.x, k, c.x), k * acc.x);
+        o.y = fma(e, fma(-acc.y, k, c.y), k * acc.y);
+        o.z = fma(e, fma(-acc.z, k, c.z), k * acc.z);
+        o.w = fma(e, fma(-acc.w, k, c.w), k * acc.w);
