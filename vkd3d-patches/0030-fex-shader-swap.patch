diff --git a/libs/vkd3d/state.c b/libs/vkd3d/state.c
index ee012e7..911d99e 100644
--- a/libs/vkd3d/state.c
+++ b/libs/vkd3d/state.c
@@ -2859,6 +2859,8 @@ static HRESULT vkd3d_compile_shader_stage(struct d3d12_pipeline_state *state, st
     }
 
     vkd3d_fex_shader_copy_spirv(stage, spirv_code);
+    /* VKD3D fex30: FEX's own version of a listed compute shader. */
+    vkd3d_fex_shader_swap(stage, spirv_code);
     return S_OK;
 }
 
@@ -3238,6 +3240,17 @@ static HRESULT d3d12_pipeline_state_init_compute(struct d3d12_pipeline_state *st
             VK_SHADER_STAGE_COMPUTE_BIT, &state->compute.code,
             &state->compute.identifier_create_info);
 
+    /* VKD3D fex30: a compute shader FEX has its own version of is translated again, never taken from a cache (SPIR-V
+     * or driver module identifier), so the swap sees the translation and, with the swap off, no cached FEX version is
+     * used. */
+    if (vkd3d_fex_shader_swap_listed(VK_SHADER_STAGE_COMPUTE_BIT, &desc->cs))
+    {
+        vkd3d_shader_free_shader_code(&state->compute.code);
+        memset(&state->compute.code, 0, sizeof(state->compute.code));
+        state->compute.identifier_create_info.identifierSize = 0;
+        state->compute.identifier_create_info.pIdentifier = NULL;
+    }
+
     hr = vkd3d_create_compute_pipeline(state, device, &desc->cs);
 
     if (FAILED(hr))
