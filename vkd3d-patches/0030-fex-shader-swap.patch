+/* VKD3D fex30: FEX shader swap (fex_shader_swap.c). listed: the D3D bytecode is a compute shader FEX has its own
+ * version of (never taken from a pipeline cache); swap: replaces vkd3d's translation of a listed shader with FEX's
+ * version when the translation is the expected one (VKD3D_FEX_SHADER_SWAP=0 turns it off); append: '#' notes for the
+ * gpu report. */
+bool vkd3d_fex_shader_swap_listed(VkShaderStageFlagBits stage, const D3D12_SHADER_BYTECODE *code);
