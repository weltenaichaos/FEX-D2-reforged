+/* VKD3D fex22: one timed Dispatch. */
+static void fex_pass_note_dispatch(struct vkd3d_fex_pass_meter *meter, const struct vkd3d_fex_pass_record *rec,
+        uint64_t ticks)
+{
+    struct fex_dispatch_stats *d = NULL;
+    uint32_t i;
+
+    meter->dispatch_count++;
+    meter->dispatch_ticks += ticks;
+    for (i = 0; i < meter->dispatch_shaders; i++)
+    {
+        if (meter->dispatches[i].hash == rec->vertices)
+        {
+            d = &meter->dispatches[i];
+            break;
+        }
+    }
+    if (!d)
+    {
+        if (meter->dispatch_shaders == FEX_DISPATCH_SHADERS)
+        {
+            meter->dispatch_unlisted += ticks;
+            return;
+        }
+        d = &meter->dispatches[meter->dispatch_shaders++];
+        memset(d, 0, sizeof(*d));
+        d->hash = rec->vertices;
+    }
+    d->count++;
+    d->groups += rec->draws;
+    d->ticks += ticks;
+    if (ticks > d->max_ticks)
+        d->max_ticks = ticks;
+    d->x = rec->direct_draws;
+    d->y = rec->pipelines;
+    d->z = rec->end_line;
+}
