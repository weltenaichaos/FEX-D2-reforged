+/* VKD3D fex22: right before vkCmdDispatch (no render pass runs then). The begin timestamp waits for the GPU to finish
+ * everything before it, so the pair times the dispatch alone. */
+void vkd3d_fex_pass_meter_dispatch_begin(struct d3d12_command_list *list)
+{
+    struct vkd3d_fex_pass_meter *meter = list->device->fex_pass_meter;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+
+    if (!meter || !list->fex_pass.list_active || list->fex_pass.pass_active || list->is_inside_render_pass)
+        return;
+    list->fex_pass.dispatch_pair = fex_pass_alloc_pair(list);
+    VK_CALL(vkCmdWriteTimestamp2(list->cmd.vk_command_buffer, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+            meter->pool, 2 * list->fex_pass.dispatch_pair));
+    list->fex_pass.dispatch_open = true;
+}
+
+void vkd3d_fex_pass_meter_dispatch_end(struct d3d12_command_list *list, uint32_t x, uint32_t y, uint32_t z)
+{
+    const struct d3d12_pipeline_state *state = list->state;
+    struct vkd3d_fex_pass_record rec;
+    uint64_t groups = (uint64_t)x * y * z;
+
+    list->fex_pass.dispatch_open = false;
+    fex_pass_write_end(list, list->fex_pass.dispatch_pair);
+    memset(&rec, 0, sizeof(rec));
+    rec.pair = list->fex_pass.dispatch_pair;
+    rec.sig = 0xffff;
+    rec.kind = VKD3D_FEX_PASS_KIND_DISPATCH;
+    rec.draws = groups > UINT32_MAX ? UINT32_MAX : (uint32_t)groups;
+    rec.direct_draws = x;
+    rec.pipelines = y;
+    rec.end_line = z > 0xffff ? 0xffff : z;
+    rec.vertices = state && d3d12_pipeline_state_is_compute(state) ? state->compute.code.meta.hash : 0;
+    rec.inside_pair = VKD3D_FEX_PASS_NO_QUERY;
+    rec.stats_slot = VKD3D_FEX_PASS_NO_QUERY;
+    fex_pass_add_record(list, &rec);
+}
