 /* VKD3D fex11: the gpu report (memory, vkd3d's transfers, GPU time outside render passes), once a second. */
+/* VKD3D fex22: the dispatch line, costliest compute shaders first. */
+static size_t fex_dispatch_publish(struct vkd3d_fex_pass_meter *meter, char *text, size_t size, size_t len, double ms)
+{
+    uint32_t top[FEX_DISPATCH_TOP], top_count = 0, i, j;
+
+    if (meter->gpu_publishes > 2 * FEX_DRAW_FIRST_PUBLISH && meter->gpu_publishes <= 3 * FEX_DRAW_FIRST_PUBLISH)
+        len = vkd3d_fex_report_append(text, size, len,
+                "# gpu dispatches (VKD3D fex22), measured frames only (per frame = figure / 'frames measured'): each"
+                " Dispatch timed alone (the GPU finishes everything before it first, so dispatches the game let overlap"
+                " run one after another in these frames); by compute shader (its D3D bytecode hash; the shader copy"
+                " holds its bytecode and SPIR-V as 'compute shader dxbc/spirv'): n = dispatches, groups = thread groups"
+                " per dispatch on average (x*y*z of the last one), gpu ms in all, longest, us per dispatch\n");
+
+    if (!meter->dispatch_count)
+        return len;
+
+    for (i = 0; i < meter->dispatch_shaders; i++)
+    {
+        for (j = top_count; j > 0 && meter->dispatches[top[j - 1]].ticks < meter->dispatches[i].ticks; j--)
+        {
+            if (j < ARRAY_SIZE(top))
+                top[j] = top[j - 1];
+        }
+        if (j < ARRAY_SIZE(top))
+        {
+            top[j] = i;
+            if (top_count < ARRAY_SIZE(top))
+                top_count++;
+        }
+    }
+    len = vkd3d_fex_report_append(text, size, len, "  gpu dispatches: n=%"PRIu64" gpu=%.2fms shaders=%u |",
+            meter->dispatch_count, meter->dispatch_ticks * ms, meter->dispatch_shaders);
+    for (i = 0; i < top_count; i++)
+    {
+        const struct fex_dispatch_stats *d = &meter->dispatches[top[i]];
+
+        len = vkd3d_fex_report_append(text, size, len,
+                " %016"PRIx64" n=%"PRIu64" groups=%.0f (%ux%ux%u) %.2fms max %.2f %.0fus;", d->hash, d->count,
+                (double)d->groups / d->count, d->x, d->y, d->z, d->ticks * ms, d->max_ticks * ms,
+                d->ticks * ms * 1000.0 / d->count);
+    }
+    if (meter->dispatch_shaders > top_count)
+        len = vkd3d_fex_report_append(text, size, len, " %u other shaders", meter->dispatch_shaders - top_count);
+    if (meter->dispatch_unlisted)
+        len = vkd3d_fex_report_append(text, size, len, " (+%.2fms not told apart)", meter->dispatch_unlisted * ms);
+    return vkd3d_fex_report_append(text, size, len, "\n");
+}
