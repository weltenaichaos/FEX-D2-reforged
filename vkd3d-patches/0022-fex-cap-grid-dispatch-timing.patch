+/* VKD3D fex22: while the pass meter runs, the shader copy takes every compute shader's D3D bytecode and SPIR-V once,
+ * so the costly ones in the 'gpu dispatches' line can be studied off the device. A pipeline made from the driver's
+ * cache by identifier has no SPIR-V at hand: it is compiled again just for the copy (once per shader). */
+static void d3d12_pipeline_state_fex_copy_compute(struct d3d12_pipeline_state *state, struct d3d12_device *device,
+        const D3D12_SHADER_BYTECODE *code)
+{
+    struct vkd3d_shader_code dxbc = {code->pShaderBytecode, code->BytecodeLength};
+    struct vkd3d_shader_code spirv;
+    vkd3d_shader_hash_t hash;
+
+    if (!device->fex_pass_meter || !code->pShaderBytecode || !code->BytecodeLength)
+        return;
+    hash = state->compute.code.meta.hash ? state->compute.code.meta.hash : vkd3d_shader_hash(&dxbc);
+    if (!vkd3d_fex_shader_copy_cs_claim(device, hash))
+        return;
+
+    vkd3d_fex_shader_copy_cs(hash, VKD3D_FEX_COPY_CS_DXBC, dxbc.code, dxbc.size);
+    if (state->compute.code.code && state->compute.code.size)
+    {
+        vkd3d_fex_shader_copy_cs(hash, VKD3D_FEX_COPY_CS_SPIRV, state->compute.code.code, state->compute.code.size);
+        return;
+    }
+    memset(&spirv, 0, sizeof(spirv));
+    if (SUCCEEDED(vkd3d_compile_shader_stage(state, device, VK_SHADER_STAGE_COMPUTE_BIT, code, &spirv, NULL)))
+    {
+        vkd3d_fex_shader_copy_cs(hash, VKD3D_FEX_COPY_CS_SPIRV, spirv.code, spirv.size);
+        vkd3d_shader_free_shader_code(&spirv);
+    }
+}
