+/* VKD3D fex22: true once per compute shader while compute copies are on and there is room; the caller then copies its
+ * D3D bytecode and SPIR-V with vkd3d_fex_shader_copy_cs. */
+bool vkd3d_fex_shader_copy_cs_claim(struct d3d12_device *device, vkd3d_shader_hash_t hash)
+{
+    bool claim = false;
+    unsigned int i;
+
+    if (!hash || !fex_copy_enabled() || !fex_copy.compute)
+        return false;
+
+    pthread_mutex_lock(&fex_copy.lock);
+    for (i = 0; i < fex_copy.cs_count; i++)
+        if (fex_copy.cs_hashes[i] == hash)
+            break;
+    if (i == fex_copy.cs_count && fex_copy.cs_count < FEX_COPY_CS_MAX && fex_copy.cs_bytes < FEX_COPY_CS_BUDGET)
+    {
+        fex_copy.cs_hashes[fex_copy.cs_count++] = hash;
+        fex_copy_device_locked(device);
+        claim = true;
+    }
+    pthread_mutex_unlock(&fex_copy.lock);
+    return claim;
+}
+
+void vkd3d_fex_shader_copy_cs(vkd3d_shader_hash_t hash, uint32_t kind, const void *data, size_t size)
+{
+    if (!data || !size)
+        return;
+    pthread_mutex_lock(&fex_copy.lock);
+    fex_copy.cs_bytes += size;
+    fex_copy_publish_locked(hash, 0, kind, 0, VK_SHADER_STAGE_COMPUTE_BIT, data, size);
+    pthread_mutex_unlock(&fex_copy.lock);
+}
